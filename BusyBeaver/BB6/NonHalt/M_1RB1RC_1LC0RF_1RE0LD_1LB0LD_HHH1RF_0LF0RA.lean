namespace M23
open List

inductive St | A | B | C | D | E | F | H
  deriving DecidableEq, Repr

structure Cfg where
  st : St
  L : List Bool
  h : Bool
  R : List Bool
  deriving DecidableEq, Repr

def mR (s : St) (w : Bool) (c : Cfg) : Cfg := ⟨s, w :: c.L, c.R.headD false, c.R.tail⟩
def mL (s : St) (w : Bool) (c : Cfg) : Cfg := ⟨s, c.L.tail, c.L.headD false, w :: c.R⟩

def step (c : Cfg) : Cfg :=
  match c.st, c.h with
  | .A, false => mR .B true c
  | .A, true  => mR .C true c
  | .B, false => mL .C true c
  | .B, true  => mR .F false c
  | .C, false => mR .E true c
  | .C, true  => mL .D false c
  | .D, false => mL .B true c
  | .D, true  => mL .D false c
  | .E, false => { c with st := .H }
  | .E, true  => mR .F true c
  | .F, false => mL .F false c
  | .F, true  => mR .A false c
  | .H, _     => c

def run : Nat → Cfg → Cfg
  | 0, c => c
  | n + 1, c => run n (step c)

theorem run_add (m n : Nat) (c : Cfg) : run (m + n) c = run n (run m c) := by
  induction m generalizing c with
  | zero => simp [run]
  | succ m ih =>
    rw [Nat.succ_add]
    simp only [run]
    exact ih (step c)

def pw : Nat → List Bool → List Bool
  | 0, _ => []
  | k + 1, u => u ++ pw k u

@[simp] theorem pw_zero (u : List Bool) : pw 0 u = [] := rfl
@[simp] theorem pw_succ (k : Nat) (u : List Bool) : pw (k + 1) u = u ++ pw k u := rfl

theorem pw_comm (k : Nat) (u : List Bool) : u ++ pw k u = pw k u ++ u := by
  induction k with
  | zero => simp
  | succ k ih => rw [pw_succ, List.append_assoc, ← ih]

theorem pw_succ' (k : Nat) (u : List Bool) : pw (k + 1) u = pw k u ++ u := by
  rw [pw_succ, pw_comm]

theorem pw_add (a b : Nat) (u : List Bool) : pw (a + b) u = pw a u ++ pw b u := by
  induction a with
  | zero => simp
  | succ a ih => rw [Nat.succ_add, pw_succ, pw_succ, ih, List.append_assoc]

abbrev U : List Bool := [true, true, false]

def ckpt (n : Nat) (W : List Bool) : Cfg := ⟨.C, [], false, pw n U ++ W⟩

def mvDir : St → Bool → Option Bool
  | .A, _ => some true
  | .B, false => some false
  | .B, true => some true
  | .C, false => some true
  | .C, true => some false
  | .D, _ => some false
  | .E, false => none
  | .E, true => some true
  | .F, false => some false
  | .F, true => some true
  | .H, _ => none

def stepB (c : Cfg) : Option Cfg :=
  match mvDir c.st c.h with
  | some true => if c.R.isEmpty then none else some (step c)
  | some false => if c.L.isEmpty then none else some (step c)
  | none => some (step c)

def runB : Nat → Cfg → Option Cfg
  | 0, c => some c
  | n + 1, c => (stepB c).bind (runB n)

theorem runB_add (m n : Nat) : ∀ {c c1 c2 : Cfg},
    runB m c = some c1 → runB n c1 = some c2 → runB (m + n) c = some c2 := by
  induction m with
  | zero =>
    intro c c1 c2 h1 h2
    simp only [runB, Option.some.injEq] at h1
    subst h1
    simpa using h2
  | succ m ih =>
    intro c c1 c2 h1 h2
    simp only [runB, Option.bind_eq_some_iff] at h1
    obtain ⟨c', hc', hm⟩ := h1
    rw [Nat.succ_add]
    simp only [runB, hc', Option.bind_some]
    exact ih hm h2

def ext (c : Cfg) (Lt Rt : List Bool) : Cfg := ⟨c.st, c.L ++ Lt, c.h, c.R ++ Rt⟩

theorem stepB_frame {c c' : Cfg} (Lt Rt : List Bool) (h : stepB c = some c') :
    step (ext c Lt Rt) = ext c' Lt Rt := by
  obtain ⟨s, L, x, R⟩ := c
  cases s <;> cases x <;> simp only [stepB, mvDir] at h <;>
    first
    | (cases R with
        | nil => simp at h
        | cons r rs => simp at h; subst h; simp [ext, step, mR])
    | (cases L with
        | nil => simp at h
        | cons l ls => simp at h; subst h; simp [ext, step, mL])
    | (simp at h; subst h; simp [ext, step])

theorem runB_frame (n : Nat) (Lt Rt : List Bool) :
    ∀ {c c' : Cfg}, runB n c = some c' → run n (ext c Lt Rt) = ext c' Lt Rt := by
  induction n with
  | zero => intro c c' h; simp [runB] at h; subst h; rfl
  | succ n ih =>
    intro c c' h
    simp only [runB, Option.bind_eq_some_iff] at h
    obtain ⟨c1, h1, h2⟩ := h
    show run n (step (ext c Lt Rt)) = _
    rw [stepB_frame Lt Rt h1]
    exact ih h2

abbrev X : List Bool := [false, false, true]
abbrev Y : List Bool := [true, false, false]
abbrev Z : List Bool := [true, false, true]

theorem rot (x : Bool) (l : List Bool) (k : Nat) (T : List Bool) :
    x :: (pw k (l ++ [x]) ++ T) = pw k (x :: l) ++ x :: T := by
  induction k with
  | zero => simp
  | succ k ih => simp [ih]

theorem rotX (k : Nat) (T : List Bool) : true :: (pw k X ++ T) = pw k Y ++ true :: T :=
  rot true [false, false] k T

theorem rotZ (k : Nat) (T : List Bool) : true :: (pw k Z ++ T) = pw k U ++ true :: T :=
  rot true [true, false] k T

theorem splitZ (k : Nat) (T : List Bool) :
    pw (k + 1) Z ++ T = true :: false :: (pw k U ++ true :: T) := by
  rw [pw_succ, ← rotZ]; simp

theorem rsweep (k : Nat) (L R : List Bool) :
    run (3 * k) ⟨.A, L, false, pw k U ++ R⟩ = ⟨.A, pw k X ++ L, false, R⟩ := by
  induction k generalizing L with
  | zero => rfl
  | succ k ih =>
    rw [show 3 * (k + 1) = 3 + 3 * k by omega, run_add]
    have h3 : run 3 ⟨.A, L, false, pw (k + 1) U ++ R⟩ = ⟨.A, X ++ L, false, pw k U ++ R⟩ := by
      simp [run, step, mR]
    rw [h3, ih, pw_succ', append_assoc]

theorem lsweep (k : Nat) (L R : List Bool) :
    run (3 * k) ⟨.B, pw k Y ++ L, false, R⟩ = ⟨.B, L, false, pw k Z ++ R⟩ := by
  induction k generalizing R with
  | zero => rfl
  | succ k ih =>
    rw [show 3 * (k + 1) = 3 + 3 * k by omega, run_add]
    have h3 : run 3 ⟨.B, pw (k + 1) Y ++ L, false, R⟩ = ⟨.B, pw k Y ++ L, false, Z ++ R⟩ := by
      simp [run, step, mL]
    rw [h3, ih, pw_succ', append_assoc]

theorem start (R : List Bool) :
    run 3 ⟨.C, [], false, U ++ R⟩ = ⟨.A, [false, true, true], false, R⟩ := by
  simp [run, step, mR]

theorem bounce1 (L W' : List Bool) :
    run 4 ⟨.A, X ++ L, false, false :: W'⟩ = ⟨.B, true :: L, false, Z ++ W'⟩ := by
  simp [run, step, mR, mL]

theorem leftEnd1 (R : List Bool) :
    run 5 ⟨.B, [true, false, true, true], false, true :: false :: R⟩
      = ⟨.A, [false, false, true], false, U ++ R⟩ := by
  simp [run, step, mR, mL]

theorem leftEnd2 (R : List Bool) :
    run 4 ⟨.B, [true], false, R⟩ = ⟨.C, [], false, U ++ true :: R⟩ := by
  simp [run, step, mR, mL]

def wordHyp (W' : List Bool) (a J J' : Nat) (V : List Bool) : Prop :=
  runB a ⟨.A, pw J X, false, true :: W'⟩ = some ⟨.B, true :: pw J' X, false, V⟩

def evSteps (k a m : Nat) : Nat := 3 + 3 * (k + 1) + 4 + 3 * k + 5 + 3 * (k + 1) + a + 3 * m + 4

theorem event (k J J' a : Nat) (W' V : List Bool) (hJ : J ≤ k + 2)
    (hw : wordHyp W' a J J' V) :
    run (evSteps k a (J' + (k + 2 - J))) (ckpt (k + 2) (false :: W'))
      = ckpt (J' + (k + 2 - J) + 1) (true :: V) := by
  have e1 : run 3 (ckpt (k + 2) (false :: W'))
      = ⟨.A, [false, true, true], false, pw (k + 1) U ++ false :: W'⟩ := by
    rw [ckpt, pw_succ, append_assoc, start]
  have e2 := rsweep (k + 1) [false, true, true] (false :: W')
  have e3 : run 4 ⟨.A, pw (k + 1) X ++ [false, true, true], false, false :: W'⟩
      = ⟨.B, pw k Y ++ [true, false, true, true], false, Z ++ W'⟩ := by
    rw [pw_succ, append_assoc, bounce1, rotX]
  have e4 := lsweep k [true, false, true, true] (Z ++ W')
  have e5 : run 5 ⟨.B, [true, false, true, true], false, pw k Z ++ (Z ++ W')⟩
      = ⟨.A, [false, false, true], false, pw (k + 1) U ++ true :: W'⟩ := by
    rw [← append_assoc, ← pw_succ', splitZ, leftEnd1, pw_succ, append_assoc]
  have e6 := rsweep (k + 1) [false, false, true] (true :: W')
  have e7 : run a ⟨.A, pw (k + 1) X ++ [false, false, true], false, true :: W'⟩
      = ⟨.B, pw (J' + (k + 2 - J)) Y ++ [true], false, V⟩ := by
    have hsplit : pw (k + 1) X ++ [false, false, true] = pw J X ++ pw (k + 2 - J) X := by
      rw [← pw_succ', ← pw_add]; congr 1; omega
    have hf := runB_frame a (pw (k + 2 - J) X) [] hw
    simp only [ext, append_nil] at hf
    rw [hsplit, hf, ← rotX, pw_add, append_nil, cons_append]
  have e8 := lsweep (J' + (k + 2 - J)) [true] V
  have e9 : run 4 ⟨.B, [true], false, pw (J' + (k + 2 - J)) Z ++ V⟩
      = ckpt (J' + (k + 2 - J) + 1) (true :: V) := by
    rw [leftEnd2, rotZ, ckpt, pw_succ, append_assoc]
  simp only [evSteps, run_add]
  rw [e1, e2, e3, e4, e5, e6, e7, e8, e9]

def isRetFast : List Bool → Option Nat
  | [true] => some 0
  | [true, false, false, true, false, false, true] => some 2
  | _ => none

theorem isRetFast_sound {L : List Bool} {j : Nat} (h : isRetFast L = some j) :
    L = true :: pw j X := by
  unfold isRetFast at h
  split at h
  · simp only [Option.some.injEq] at h; subst h; rfl
  · simp only [Option.some.injEq] at h; subst h; rfl
  · cases h

def stepB1 (c : Cfg) : Option Cfg :=
  match c.st, c.h with
  | .A, false => match c.R with | r :: rs => some ⟨.B, true :: c.L, r, rs⟩ | [] => none
  | .A, true  => match c.R with | r :: rs => some ⟨.C, true :: c.L, r, rs⟩ | [] => none
  | .B, false => match c.L with | l :: ls => some ⟨.C, ls, l, true :: c.R⟩ | [] => none
  | .B, true  => match c.R with | r :: rs => some ⟨.F, false :: c.L, r, rs⟩ | [] => none
  | .C, false => match c.R with | r :: rs => some ⟨.E, true :: c.L, r, rs⟩ | [] => none
  | .C, true  => match c.L with | l :: ls => some ⟨.D, ls, l, false :: c.R⟩ | [] => none
  | .D, false => match c.L with | l :: ls => some ⟨.B, ls, l, true :: c.R⟩ | [] => none
  | .D, true  => match c.L with | l :: ls => some ⟨.D, ls, l, false :: c.R⟩ | [] => none
  | .E, false => some ⟨.H, c.L, false, c.R⟩
  | .E, true  => match c.R with | r :: rs => some ⟨.F, true :: c.L, r, rs⟩ | [] => none
  | .F, false => match c.L with | l :: ls => some ⟨.F, ls, l, false :: c.R⟩ | [] => none
  | .F, true  => match c.R with | r :: rs => some ⟨.A, false :: c.L, r, rs⟩ | [] => none
  | .H, h     => some ⟨.H, c.L, h, c.R⟩

theorem stepB1_eq (c : Cfg) : stepB1 c = stepB c := by
  obtain ⟨st, L, h, R⟩ := c
  cases st <;> cases h <;> first
    | (cases R <;> rfl)
    | (cases L <;> rfl)
    | rfl

def stepFastA (L R : List Bool) : Option Cfg :=
  match R with
  | true :: true :: false :: true :: true :: false :: R' =>
    some ⟨.A, false :: false :: true :: false :: false :: true :: L, false, R'⟩
  | true :: true :: false :: R' =>
    some ⟨.A, false :: false :: true :: L, false, R'⟩
  | true :: true :: true :: false :: R' =>
    some ⟨.C, true :: false :: false :: true :: L, false, R'⟩
  | false :: R' =>
    some ⟨.B, true :: L, false, R'⟩
  | _ => stepB1 ⟨.A, L, false, R⟩

theorem stepFastA_sound (L R : List Bool) {c' : Cfg} (h : stepFastA L R = some c') :
    ∃ k, runB k ⟨.A, L, false, R⟩ = some c' := by
  unfold stepFastA at h
  split at h
  · simp only [Option.some.injEq] at h; subst h; exact ⟨6, rfl⟩
  · simp only [Option.some.injEq] at h; subst h; exact ⟨3, rfl⟩
  · simp only [Option.some.injEq] at h; subst h; exact ⟨4, rfl⟩
  · simp only [Option.some.injEq] at h; subst h; exact ⟨1, rfl⟩
  · rw [stepB1_eq] at h; exact ⟨1, by simp [runB, h]⟩

def stepFastC (L R : List Bool) : Option Cfg :=
  match R with
  | true :: true :: false :: true :: true :: false :: R' =>
    some ⟨.A, false :: false :: true :: false :: true :: true :: L, false, R'⟩
  | true :: true :: false :: R' =>
    some ⟨.A, false :: true :: true :: L, false, R'⟩
  | true :: true :: true :: false :: R' =>
    some ⟨.C, true :: false :: true :: true :: L, false, R'⟩
  | true :: false :: false :: R' =>
    some ⟨.B, true :: false :: true :: L, false, R'⟩
  | _ => stepB1 ⟨.C, L, false, R⟩

theorem stepFastC_sound (L R : List Bool) {c' : Cfg} (h : stepFastC L R = some c') :
    ∃ k, runB k ⟨.C, L, false, R⟩ = some c' := by
  unfold stepFastC at h
  split at h
  · simp only [Option.some.injEq] at h; subst h; exact ⟨6, rfl⟩
  · simp only [Option.some.injEq] at h; subst h; exact ⟨3, rfl⟩
  · simp only [Option.some.injEq] at h; subst h; exact ⟨4, rfl⟩
  · simp only [Option.some.injEq] at h; subst h; exact ⟨5, rfl⟩
  · rw [stepB1_eq] at h; exact ⟨1, by simp [runB, h]⟩

def stepFastB (L R : List Bool) : Option Cfg :=
  match L with
  | true :: false :: false :: true :: false :: false :: L' =>
    some ⟨.B, L', false, true :: false :: true :: true :: false :: true :: R⟩
  | true :: false :: false :: L' =>
    some ⟨.B, L', false, true :: false :: true :: R⟩
  | true :: true :: false :: false :: L' =>
    some ⟨.B, L', false, true :: false :: false :: true :: R⟩
  | true :: true :: true :: false :: false :: L' =>
    some ⟨.B, L', false, true :: false :: false :: false :: true :: R⟩
  | _ => stepB1 ⟨.B, L, false, R⟩

theorem stepFastB_sound (L R : List Bool) {c' : Cfg} (h : stepFastB L R = some c') :
    ∃ k, runB k ⟨.B, L, false, R⟩ = some c' := by
  unfold stepFastB at h
  split at h
  · simp only [Option.some.injEq] at h; subst h; exact ⟨6, rfl⟩
  · simp only [Option.some.injEq] at h; subst h; exact ⟨3, rfl⟩
  · simp only [Option.some.injEq] at h; subst h; exact ⟨4, rfl⟩
  · simp only [Option.some.injEq] at h; subst h; exact ⟨5, rfl⟩
  · rw [stepB1_eq] at h; exact ⟨1, by simp [runB, h]⟩

def stepFast (c : Cfg) : Option Cfg :=
  match c.st, c.h with
  | .A, false => stepFastA c.L c.R
  | .C, false => stepFastC c.L c.R
  | .B, false => stepFastB c.L c.R
  | _, _ => stepB1 c

theorem stepFast_sound (c : Cfg) {c' : Cfg} (h : stepFast c = some c') :
    ∃ k, runB k c = some c' := by
  obtain ⟨st, L, x, R⟩ := c
  cases st <;> cases x <;> simp only [stepFast] at h
  · exact stepFastA_sound L R h
  · rw [stepB1_eq] at h; exact ⟨1, by simp [runB, h]⟩
  · exact stepFastB_sound L R h
  · rw [stepB1_eq] at h; exact ⟨1, by simp [runB, h]⟩
  · exact stepFastC_sound L R h
  all_goals (rw [stepB1_eq] at h; exact ⟨1, by simp [runB, h]⟩)

def seekFast : Nat → Cfg → Option (Nat × List Bool)
  | 0, _ => none
  | f + 1, c =>
    match c.st, c.h, isRetFast c.L with
    | .B, false, some j => some (j, c.R)
    | _, _, _ =>
      match stepFast c with
      | some c' => seekFast f c'
      | none => none

theorem seekFast_sound (f : Nat) : ∀ {c : Cfg} {j : Nat} {V : List Bool},
    seekFast f c = some (j, V) → ∃ a, runB a c = some ⟨.B, true :: pw j X, false, V⟩ := by
  induction f with
  | zero => intro c j V h; simp [seekFast] at h
  | succ f ih =>
    intro c j V h
    obtain ⟨s, L, x, R⟩ := c
    simp only [seekFast] at h
    split at h
    · rename_i jj hj
      simp only [Option.some.injEq, Prod.mk.injEq] at h
      obtain ⟨rfl, rfl⟩ := h
      rw [isRetFast_sound hj]
      exact ⟨0, rfl⟩
    · split at h
      · rename_i c' hc'
        obtain ⟨k, hk⟩ := stepFast_sound _ hc'
        obtain ⟨a, ha⟩ := ih h
        exact ⟨k + a, runB_add k a hk ha⟩
      · cases h

def win (W' : List Bool) : Cfg := ⟨.A, pw 2 X, false, true :: W'⟩

def wordMapFast (fuel : Nat) (W' : List Bool) : Option (Nat × List Bool) :=
  seekFast fuel (win W')

theorem event_map_fast (k fuel J' : Nat) (W' V : List Bool)
    (h : wordMapFast fuel W' = some (J', V)) :
    ∃ a, run (evSteps k a (J' + k)) (ckpt (k + 2) (false :: W')) = ckpt (J' + k + 1) (true :: V) := by
  obtain ⟨a, ha⟩ := seekFast_sound fuel h
  refine ⟨a, ?_⟩
  have := event k 2 J' a W' V (by omega) ha
  simpa using this


theorem stepB_ext {c c' : Cfg} (Lt Rt : List Bool) (h : stepB c = some c') :
    stepB (ext c Lt Rt) = some (ext c' Lt Rt) := by
  obtain ⟨s, L, x, R⟩ := c
  cases s <;> cases x <;> simp only [stepB, mvDir, ext] at h ⊢ <;>
    first
    | (cases R with
        | nil => simp at h
        | cons r rs => simp at h; subst h; simp [step, mR])
    | (cases L with
        | nil => simp at h
        | cons l ls => simp at h; subst h; simp [step, mL])
    | (simp at h; subst h; simp [step])

theorem runB_ext (n : Nat) (Lt Rt : List Bool) :
    ∀ {c c' : Cfg}, runB n c = some c' → runB n (ext c Lt Rt) = some (ext c' Lt Rt) := by
  induction n with
  | zero => intro c c' h; simp [runB] at h ⊢; subst h; rfl
  | succ n ih =>
    intro c c' h
    simp only [runB, Option.bind_eq_some_iff] at h ⊢
    obtain ⟨c1, h1, h2⟩ := h
    exact ⟨ext c1 Lt Rt, stepB_ext Lt Rt h1, ih h2⟩

def seekToC : Nat → Cfg → Option (List Bool)
  | 0, _ => none
  | f + 1, c =>
    match c.st, c.h, c.R with
    | .C, false, [] => some c.L
    | _, _, _ =>
      match stepFast c with
      | some c' => seekToC f c'
      | none => none

theorem seekToC_sound (f : Nat) : ∀ {c : Cfg} {L_P : List Bool},
    seekToC f c = some L_P → ∃ a, runB a c = some ⟨.C, L_P, false, []⟩ := by
  induction f with
  | zero => intro c L_P h; simp [seekToC] at h
  | succ f ih =>
    intro c L_P h
    obtain ⟨s, L, x, R⟩ := c
    simp only [seekToC] at h
    split at h
    · simp only [Option.some.injEq] at h; subst h; exact ⟨0, rfl⟩
    · split at h
      · rename_i c' hc'
        obtain ⟨k, hk⟩ := stepFast_sound _ hc'
        obtain ⟨a, ha⟩ := ih h
        exact ⟨k + a, runB_add k a hk ha⟩
      · cases h

def seekToB0 : Nat → Cfg → Option (List Bool)
  | 0, _ => none
  | f + 1, c =>
    match c.st, c.h, c.L with
    | .B, false, [true] => some c.R
    | _, _, _ =>
      match stepFast c with
      | some c' => seekToB0 f c'
      | none => none

theorem seekToB0_sound (f : Nat) : ∀ {c : Cfg} {V : List Bool},
    seekToB0 f c = some V → ∃ a, runB a c = some ⟨.B, [true], false, V⟩ := by
  induction f with
  | zero => intro c V h; simp [seekToB0] at h
  | succ f ih =>
    intro c V h
    obtain ⟨s, L, x, R⟩ := c
    simp only [seekToB0] at h
    split at h
    · simp only [Option.some.injEq] at h; subst h; exact ⟨0, rfl⟩
    · split at h
      · rename_i c' hc'
        obtain ⟨k, hk⟩ := stepFast_sound _ hc'
        obtain ⟨a, ha⟩ := ih h
        exact ⟨k + a, runB_add k a hk ha⟩
      · cases h

def ValidCPrefix (P : List Bool) : Prop :=
  ∃ a1 a3 L_P R_back,
    runB a1 ⟨.A, [], false, true :: P⟩ = some ⟨.C, L_P, false, []⟩ ∧
    runB a3 ⟨.B, true :: L_P, false, []⟩ = some ⟨.B, [true], false, R_back⟩ ∧
    R_back ++ [true, false] = [true, false, false] ++ P

theorem validCPrefix_base : ValidCPrefix [true, true, false] :=
  ⟨4, 4, [true, false, false, true], [true, false, false, true], rfl, rfl, rfl⟩

def ValidCSeg (B : List Bool) : Prop :=
  ∃ b1 b3 L_B R_B,
    runB b1 ⟨.C, [], false, B⟩ = some ⟨.C, L_B, false, []⟩ ∧
    runB b3 ⟨.B, true :: L_B, false, []⟩ = some ⟨.B, [true], false, R_B⟩ ∧
    R_B ++ [true, false] = [true, false] ++ B

def checkCSeg (B : List Bool) : Bool :=
  match seekToC 400 ⟨.C, [], false, B⟩ with
  | some L_B =>
    match seekToB0 400 ⟨.B, true :: L_B, false, []⟩ with
    | some R_B => decide (R_B ++ [true, false] = [true, false] ++ B)
    | none => false
  | none => false

theorem checkCSeg_sound {B : List Bool} (h : checkCSeg B = true) : ValidCSeg B := by
  unfold checkCSeg at h
  split at h
  · rename_i L_B h1
    split at h
    · rename_i R_B h2
      simp only [decide_eq_true_eq] at h
      obtain ⟨b1, hb1⟩ := seekToC_sound 400 h1
      obtain ⟨b3, hb3⟩ := seekToB0_sound 400 h2
      exact ⟨b1, b3, L_B, R_B, hb1, hb3, h⟩
    · cases h
  · cases h

theorem validCPrefix_append {P B : List Bool} (hP : ValidCPrefix P) (hB : ValidCSeg B) :
    ValidCPrefix (P ++ B) := by
  obtain ⟨a1, a3, L_P, R_back, ha1, ha3, heqP⟩ := hP
  obtain ⟨b1, b3, L_B, R_B, hb1, hb3, heqB⟩ := hB
  refine ⟨a1 + b1, b3 + a3, L_B ++ L_P, R_back ++ R_B, ?_, ?_, ?_⟩
  · have e1 := runB_ext a1 [] B ha1
    simp only [ext, append_nil] at e1
    have e2 := runB_ext b1 L_P [] hb1
    simp only [ext, append_nil] at e2
    exact runB_add a1 b1 e1 e2
  · have e1 := runB_ext b3 L_P [] hb3
    simp only [ext, append_nil, cons_append] at e1
    have e2 := runB_ext a3 [] R_B ha3
    simp only [ext, append_nil] at e2
    exact runB_add b3 a3 e1 e2
  · rw [append_assoc, heqB, ← append_assoc, heqP, append_assoc]

theorem wordHyp_prefix {P S S_raw : List Bool} {a2 : Nat} (hP : ValidCPrefix P)
    (hS : runB a2 ⟨.C, [], false, S⟩ = some ⟨.B, [true], false, true :: false :: S_raw⟩) :
    ∃ a V, wordHyp (P ++ S) a 2 2 V ∧ true :: V = U ++ (false :: P ++ S_raw) := by
  obtain ⟨a1, a3, L_P, R_back, ha1, ha3, heqP⟩ := hP
  refine ⟨(a1 + a2) + a3, R_back ++ (true :: false :: S_raw), ?_, ?_⟩
  · unfold wordHyp
    have e1 := runB_ext a1 (pw 2 X) S ha1
    simp only [ext, nil_append] at e1
    have e2 := runB_ext a2 (L_P ++ pw 2 X) [] hS
    simp only [ext, nil_append, append_nil, cons_append] at e2
    have e3 := runB_ext a3 (pw 2 X) (true :: false :: S_raw) ha3
    simp only [ext, nil_append, cons_append] at e3
    exact runB_add (a1 + a2) a3 (runB_add a1 a2 e1 e2) e3
  · have h1 : R_back ++ (true :: false :: S_raw) = (R_back ++ [true, false]) ++ S_raw := by simp
    rw [h1, heqP]
    simp [U]
end M23


namespace Cert

abbrev Machine := Nat → Bool → Option (Bool × Bool × Nat)

structure Cfg where
  q : Nat
  L : List Bool
  h : Bool
  R : List Bool
  deriving DecidableEq, Repr

abbrev halted (M : Machine) (c : Cfg) : Prop := M c.q c.h = none


def step (M : Machine) (c : Cfg) : Cfg :=
  match M c.q c.h with
  | none => c
  | some (w, true, s) => ⟨s, w :: c.L, c.R.headD false, c.R.tail⟩
  | some (w, false, s) => ⟨s, c.L.tail, c.L.headD false, w :: c.R⟩

def run (M : Machine) : Nat → Cfg → Cfg
  | 0, c => c
  | n + 1, c => run M n (step M c)

def blank (q : Nat) : Cfg := ⟨q, [], false, []⟩

theorem run_add (M : Machine) (m n : Nat) (c : Cfg) :
    run M (m + n) c = run M n (run M m c) := by
  induction m generalizing c with
  | zero => simp [run]
  | succ m ih => rw [Nat.succ_add]; simp only [run]; exact ih _

theorem step_of_halted {M : Machine} {c : Cfg} (h : halted M c) : step M c = c := by
  unfold halted at h; simp [step, h]

theorem run_of_halted {M : Machine} {c : Cfg} (h : halted M c) : ∀ n, run M n c = c := by
  intro n; induction n with
  | zero => rfl
  | succ n ih => simp only [run, step_of_halted h, ih]

theorem halted_mono {M : Machine} {c : Cfg} {n n' : Nat} (hn : n ≤ n')
    (h : halted M (run M n c)) : halted M (run M n' c) := by
  obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hn
  rw [run_add, run_of_halted h]; exact h

def strip : List Bool → List Bool
  | [] => []
  | true :: xs => true :: strip xs
  | false :: xs =>
    match strip xs with
    | [] => []
    | y :: ys => false :: y :: ys

abbrev eqv (x y : List Bool) : Prop := strip x = strip y

theorem strip_headD (x : List Bool) : (strip x).headD false = x.headD false := by
  cases x with
  | nil => rfl
  | cons b xs =>
    cases b
    · simp only [strip]; split <;> rfl
    · rfl

theorem strip_tail (x : List Bool) : (strip x).tail = strip x.tail := by
  cases x with
  | nil => rfl
  | cons b xs =>
    cases b
    · simp only [strip, List.tail_cons]; split
      · rename_i h; simp [h]
      · rename_i y ys h; simp [h]
    · rfl

theorem eqv_headD {x y : List Bool} (h : eqv x y) : x.headD false = y.headD false := by
  rw [← strip_headD x, h, strip_headD]

theorem eqv_tail {x y : List Bool} (h : eqv x y) : eqv x.tail y.tail := by
  unfold eqv; rw [← strip_tail, ← strip_tail, h]

theorem eqv_cons {x y : List Bool} (w : Bool) (h : eqv x y) : eqv (w :: x) (w :: y) := by
  unfold eqv at *; cases w <;> simp only [strip, h]

theorem strip_strip (x : List Bool) : strip (strip x) = strip x := by
  induction x with
  | nil => rfl
  | cons b ys ih =>
    cases b
    · dsimp only [strip]
      cases h : strip ys with
      | nil => rfl
      | cons y ys' =>
        have ih' : strip (y :: ys') = y :: ys' := by rw [← h, ih]
        simp only [strip, ih']
    · simp only [strip, ih]

theorem strip_append (x y : List Bool) : strip (x ++ y) = strip (x ++ strip y) := by
  induction x with
  | nil => simp [strip_strip]
  | cons b xs ih => cases b <;> simp only [List.cons_append, strip, ih]

theorem strip_replicate (k : Nat) : strip (List.replicate k false) = [] := by
  induction k with
  | zero => rfl
  | succ k ih => simp [List.replicate_succ, strip, ih]

theorem eqv_pad (x : List Bool) (k : Nat) : eqv (x ++ List.replicate k false) x := by
  unfold eqv; rw [strip_append, strip_replicate, List.append_nil]

theorem eqv_append {x y y' : List Bool} (h : eqv y y') : eqv (x ++ y) (x ++ y') := by
  unfold eqv at *; rw [strip_append, h, ← strip_append]

theorem eqv_strip (x : List Bool) : eqv (strip x) x := strip_strip x

abbrev eqvC (c d : Cfg) : Prop := c.q = d.q ∧ c.h = d.h ∧ eqv c.L d.L ∧ eqv c.R d.R


theorem eqvC_refl (c : Cfg) : eqvC c c := ⟨rfl, rfl, rfl, rfl⟩

theorem eqvC_trans {c d e : Cfg} (h1 : eqvC c d) (h2 : eqvC d e) : eqvC c e := by
  obtain ⟨a1, b1, c1, d1⟩ := h1; obtain ⟨a2, b2, c2, d2⟩ := h2
  exact ⟨a1.trans a2, b1.trans b2, Eq.trans c1 c2, Eq.trans d1 d2⟩

theorem step_eqvC (M : Machine) {c d : Cfg} (h : eqvC c d) : eqvC (step M c) (step M d) := by
  obtain ⟨q, L, x, R⟩ := c
  obtain ⟨q', L', x', R'⟩ := d
  obtain ⟨hq, hh, hL, hR⟩ := h
  simp only at hq hh; subst hq; subst hh
  unfold step
  cases M q x with
  | none => exact ⟨rfl, rfl, hL, hR⟩
  | some t =>
    obtain ⟨w, d, s⟩ := t
    cases d
    · exact ⟨rfl, eqv_headD hL, eqv_tail hL, eqv_cons _ hR⟩
    · exact ⟨rfl, eqv_headD hR, eqv_cons _ hL, eqv_tail hR⟩

theorem run_eqvC (M : Machine) (n : Nat) : ∀ {c d : Cfg}, eqvC c d → eqvC (run M n c) (run M n d) := by
  induction n with
  | zero => intro c d h; exact h
  | succ n ih => intro c d h; exact ih (step_eqvC M h)

def M : Machine
  | 0, false => some (true, true, 1)
  | 0, true  => some (true, true, 2)
  | 1, false => some (true, false, 2)
  | 1, true  => some (false, true, 5)
  | 2, false => some (true, true, 4)
  | 2, true  => some (false, false, 3)
  | 3, false => some (true, false, 1)
  | 3, true  => some (false, false, 3)
  | 4, false => none
  | 4, true  => some (true, true, 5)
  | 5, false => some (false, false, 5)
  | 5, true  => some (false, true, 0)
  | _, _ => none

def stIdx : M23.St → Nat
  | .A => 0 | .B => 1 | .C => 2 | .D => 3 | .E => 4 | .F => 5 | .H => 4

def fC (c : M23.Cfg) : Cfg := ⟨stIdx c.st, c.L, c.h, c.R⟩

def goodC (c : M23.Cfg) : Prop := c.st = .H → c.h = false

theorem step_f (c : M23.Cfg) (hg : goodC c) :
    fC (M23.step c) = step M (fC c) ∧ goodC (M23.step c) := by
  obtain ⟨s, L, x, R⟩ := c
  unfold goodC at *
  cases s <;> cases x <;> simp_all [M23.step, M23.mR, M23.mL, step, M, fC, stIdx]

theorem run_f (n : Nat) : ∀ (c : M23.Cfg), goodC c → fC (M23.run n c) = run M n (fC c) := by
  induction n with
  | zero => intro c _; rfl
  | succ n ih =>
    intro c hg
    obtain ⟨h1, h2⟩ := step_f c hg
    simp only [M23.run, run]; rw [ih _ h2, h1]

def ck (n : Nat) (W : List Bool) : Cfg := ⟨2, [], false, M23.pw n M23.U ++ W⟩

theorem ck_f (n : Nat) (W : List Bool) : fC (M23.ckpt n W) = ck n W := rfl

def units : List Bool → Nat × List Bool
  | true :: true :: false :: r =>
    match units r with
    | (u, rest) => (u + 1, rest)
  | l => (0, l)

theorem units_spec (l : List Bool) : M23.pw (units l).1 M23.U ++ (units l).2 = l := by
  induction l using units.induct with
  | case1 r u rest h_eq ih =>
    unfold units
    rw [h_eq]
    simp only [M23.pw_succ, List.append_assoc]
    have h1 : (units r).1 = u := by rw [h_eq]
    have h2 : (units r).2 = rest := by rw [h_eq]
    rw [← h1, ← h2, ih]
    rfl
  | case2 l h =>
    unfold units; split
    · rename_i r; exact absurd rfl (h r)
    · rfl

def PAD : Nat := 12

def evStep (p : Nat × List Bool) : Option (Nat × List Bool) :=
  match p.2 with
  | false :: W' =>
    if 2 ≤ p.1 then
      match M23.wordMapFast 450 (W' ++ List.replicate PAD false) with
      | some (J', V) => some (J' + (p.1 - 2) + 1 + (units (true :: V)).1,
                              strip (units (true :: V)).2)
      | none => none
    else none
  | _ => none

theorem evStep_sound {p p' : Nat × List Bool} (h : evStep p = some p') :
    ∃ m, eqvC (run M m (ck p.1 p.2)) (ck p'.1 p'.2) := by
  obtain ⟨n, W⟩ := p
  rcases W with _ | ⟨b, W'⟩
  · simp [evStep] at h
  cases b
  case true => simp [evStep] at h
  by_cases hn : 2 ≤ n
  case neg => simp [evStep, hn] at h
  cases hw : M23.wordMapFast 450 (W' ++ List.replicate PAD false) with
  | none => simp [evStep, hn, hw] at h
  | some r =>
    obtain ⟨J', V⟩ := r
    simp only [evStep, hn, if_true, hw, Option.some.injEq] at h
    subst h
    obtain ⟨k, rfl⟩ : ∃ k, n = k + 2 := ⟨n - 2, by omega⟩
    obtain ⟨a, ev⟩ := M23.event_map_fast k 450 J' (W' ++ List.replicate PAD false) V hw
    have hr := run_f (M23.evSteps k a (J' + k)) (M23.ckpt (k + 2) (false :: (W' ++ List.replicate PAD false))) (by unfold goodC M23.ckpt; intro h; cases h)
    rw [ev, ck_f, ck_f] at hr
    refine ⟨M23.evSteps k a (J' + k), ?_⟩
    have e1 : eqvC (ck (k + 2) (false :: W'))
        (ck (k + 2) (false :: (W' ++ List.replicate PAD false))) := by
      refine ⟨rfl, rfl, rfl, ?_⟩
      show eqv _ _
      apply eqv_append
      show strip _ = strip _
      rw [← List.cons_append]; exact (eqv_pad _ _).symm
    have e2 := run_eqvC M (M23.evSteps k a (J' + k)) e1
    rw [← hr] at e2
    refine eqvC_trans e2 ⟨rfl, rfl, rfl, ?_⟩
    show eqv _ _
    have hu := units_spec (true :: V)
    simp only [ck]
    rw [show k + 2 - 2 = k by omega]
    have e3 : M23.pw (J' + k + 1) M23.U ++ (true :: V)
        = M23.pw (J' + k + 1 + (units (true :: V)).1) M23.U ++ (units (true :: V)).2 := by
      rw [M23.pw_add (J' + k + 1), List.append_assoc, hu]
    rw [e3]
    exact eqv_append (eqv_strip _).symm

