  rw [M23.pw_add k 8 M23.U, List.append_assoc, rrun_pw_U k _ rrun_base_8]
  exact inMid_seed

theorem eqvC_symm {c d : Cfg} (h : eqvC c d) : eqvC d c :=
  ⟨h.1.symm, h.2.1.symm, h.2.2.1.symm, h.2.2.2.symm⟩

theorem init_A_eqv : eqvC (run M 247 (blank 0)) (ck (cp_0.1 + 2) cp_0.2) := by
  decide +kernel

theorem startA_inv : ∃ m, Inv (run M m (blank 0)) := by
  obtain ⟨m, hm⟩ := reach_A_all
  refine ⟨247 + m, ?_⟩
  rw [run_add]
  have he := eqvC_trans (run_eqvC M m init_A_eqv) hm
  exact Inv_of_eqvC (eqvC_symm he) (Inv_ck_cp15 111095)

theorem nonhalt_A : ∀ n, ¬ halted M (run M n (blank 0)) :=
  nonhalt_of_start startA_inv

