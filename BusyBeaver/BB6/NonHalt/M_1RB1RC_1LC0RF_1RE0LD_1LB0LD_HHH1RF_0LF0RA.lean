theorem rrun_U_1552 : rstep (rstep (rstep 1552 false) true) true = 1552 := by
  decide +kernel

theorem rrun_pw_U (k : Nat) (R : List Bool) (hR : rrun R = 1552) :
    rrun (M23.pw k M23.U ++ R) = 1552 := by
  induction k with
  | zero => exact hR
  | succ k ih =>
    rw [M23.pw_succ]
    change rstep (rstep (rstep (rrun (M23.pw k M23.U ++ R)) false) true) true = 1552
    rw [ih]
    exact rrun_U_1552

theorem rrun_base_8 : rrun (M23.pw 8 M23.U ++ cp_15.2) = 1552 := by
