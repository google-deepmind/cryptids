lemma pairOnes_one (n : Nat) (R : ListBlank (Fin 2)) :
    pairOnes n (1 >> R) = 1 >> pairOnes n R := by
  induction n with
  | zero => rfl
  | succ n ih => simp only [pairOnes, ih]

lemma pairOnes_snoc (n : Nat) (R : ListBlank (Fin 2)) :
    pairOnes n (1 >> 1 >> R) = 1 >> 1 >> pairOnes n R := by
  rw [pairOnes_one n (1 >> R), pairOnes_one n R]

lemma ozTail_snoc (p : Nat) (S : ListBlank (Fin 2)) :
    ozTail p (0 >> 1 >> S) = ozTail (p + 1) S := by
  induction p with
  | zero => rfl
  | succ p ih => simp only [ozTail, ih]

lemma ozTail_add (a b : Nat) (R : ListBlank (Fin 2)) :
    ozTail (a + b) R = ozTail a (ozTail b R) := by
  induction a with
  | zero => simp [ozTail]
  | succ a ih => simp [ozTail, Nat.succ_add, ih]

lemma w7Run_snoc (n : Nat) (L : ListBlank (Fin 2)) :
    w7Run n (0 >> 0 >> 1 >> 0 >> 1 >> 0 >> 1 >> L) =
    0 >> 0 >> 1 >> 0 >> 1 >> 0 >> 1 >> w7Run n L := by
  induction n with
  | zero => rfl
  | succ n ih => simp only [w7Run, ih]

lemma block_A_loop (m : Nat) (X R : ListBlank (Fin 2)) :
    (mkC 0 1 (0 >> X) (pairOnes m R)) [target_tm]⊢*
    (mkC 0 1 (ozTail m (0 >> X)) R) := by
  induction m generalizing R with
  | zero => exact ⟨0, rfl⟩
  | succ m ih =>
    have h1 := ih (1 >> 1 >> R)
    rw [pairOnes_snoc m R] at h1
    have h2 : (mkC 0 1 (ozTail m (0 >> X)) (1 >> 1 >> R)) [target_tm]⊢⁺
              (mkC 0 1 (ozTail (m + 1) (0 >> X)) R) := by
      cases m with
      | zero => exact block_A_step X R
      | succ m' => exact block_A_step (1 >> ozTail m' (0 >> X)) R
    exact (step_star_plus h1 h2).elim fun n ⟨_, hn⟩ => ⟨n, hn⟩

lemma block_A (m : Nat) (X R : ListBlank (Fin 2)) :
    (mkC 0 1 (0 >> X) (pairOnes m (0 >> 0 >> 1 >> R))) [target_tm]⊢⁺
    (mkC 0 1 (0 >> 1 >> 0 >> ozTail m (0 >> X)) R) := by
  have h1 := block_A_loop m X (0 >> 0 >> 1 >> R)
  have h2 : (mkC 0 1 (ozTail m (0 >> X)) (0 >> 0 >> 1 >> R)) [target_tm]⊢⁺
            (mkC 0 1 (0 >> 1 >> 0 >> ozTail m (0 >> X)) R) := by
    cases m with
    | zero => exact block_A_end X R
    | succ m' => exact block_A_end (1 >> ozTail m' (0 >> X)) R
  exact step_star_plus h1 h2

lemma d_left_loop (m : Nat) (L R : ListBlank (Fin 2)) :
    (mkC 3 1 (pairOnes m L) R) [target_tm]⊢*
    (mkC 3 1 L (pairOnes m R)) := by
  induction m generalizing L R with
  | zero => exact ⟨0, rfl⟩
  | succ m ih =>
    have h1 := d_left_two (pairOnes m L) R
    have h2 := ih L (1 >> 1 >> R)
    rw [pairOnes_snoc m R] at h2
    exact (step_plus_star h1 h2).elim fun n ⟨_, hn⟩ => ⟨n, hn⟩

lemma shift_pair (m : Nat) (L R : ListBlank (Fin 2)) :
    (mkC 4 1 (0 >> pairOnes (m + 1) (0 >> L)) R) [target_tm]⊢⁺
    (mkC 4 1 (0 >> L) (1 >> pairOnes m (0 >> 0 >> R))) := by
  have h1 := shift_entry_3 (pairOnes m (0 >> L)) R
  have h2 := d_left_loop m (0 >> L) (1 >> 0 >> 0 >> R)
  have h3 := shift_exit_2 L (pairOnes m (1 >> 0 >> 0 >> R))
  have h123 := step_plus_trans (step_plus_star h1 h2) h3
  rw [pairOnes_one m (0 >> 0 >> R)] at h123
  exact h123

lemma e_left_loop (p : Nat) (L S : ListBlank (Fin 2)) :
    (mkC 4 1 (pairOnes p L) (1 >> S)) [target_tm]⊢*
    (mkC 4 1 L (1 >> ozTail p S)) := by
  induction p generalizing L S with
  | zero => exact ⟨0, rfl⟩
  | succ p ih =>
    have h1 := e_left_two (pairOnes p L) (1 >> S)
    have h2 : (mkC 4 1 (pairOnes p L) (1 >> (0 >> 1 >> S))) [target_tm]⊢*
