def mkC (q : Fin 6) (h : Fin 2) (l r : ListBlank (Fin 2)) : Cfg (Fin 2) (Fin 6) :=
  ⟨some q, ⟨h, l, r⟩⟩

@[simp] lemma zMs (M : Machine Γ Λ) (config : Cfg Γ Λ) (n : Nat) :
    multiStep M config (n + 1) = Option.bind (multiStep M config n) (step M) := by
  rw [multiStep, Function.iterate_succ', Function.comp_apply, multiStep]

@[simp] lemma zZcd : (0 : Fin 2) >> default = default := by
  apply Turing.ListBlank.ext; intro i; cases i <;> rfl

@[simp] lemma zHd : (default : ListBlank (Fin 2)).head = 0 := rfl

@[simp] lemma zTl : (default : ListBlank (Fin 2)).tail = default := by
  apply Turing.ListBlank.ext; intro i; cases i <;> rfl

lemma zMa {Γ Λ : Type*} [Inhabited Γ] [Inhabited Λ]
    (tm : Machine Γ Λ) (c₁ : Cfg Γ Λ) (n m : Nat) :
    multiStep tm c₁ (n + m) = (multiStep tm c₁ n).bind (fun c₂ => multiStep tm c₂ m) := by
  induction m with
  | zero => simp [multiStep]
  | succ m' ih =>
    rw [Nat.add_succ, zMs, ih, Option.bind_assoc]
    simp_rw [zMs]

lemma zMt {Γ Λ : Type*} [Inhabited Γ] [Inhabited Λ]
    (tm : Machine Γ Λ) (c₁ c₂ c₃ : Cfg Γ Λ) (n m : Nat)
    (h₁ : c₁ [tm]⊢^{n} c₂) (h₂ : c₂ [tm]⊢^{m} c₃) :
    c₁ [tm]⊢^{n + m} c₃ := by
  rw [zMa, h₁]; simp [h₂]

lemma step_plus_trans {c₁ c₂ c₃ : Cfg (Fin 2) (Fin 6)}
    (h₁ : c₁ [target_tm]⊢⁺ c₂) (h₂ : c₂ [target_tm]⊢⁺ c₃) :
    c₁ [target_tm]⊢⁺ c₃ := by
  rcases h₁ with ⟨n, hn, h₁⟩; rcases h₂ with ⟨m, hm, h₂⟩
  exact ⟨n + m, by omega, zMt target_tm c₁ c₂ c₃ n m h₁ h₂⟩

