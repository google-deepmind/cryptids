lemma isNotHalt_of_invariant
    (Inv : Cfg (Fin 2) (Fin 6) → Prop)
    (h_init : ∃ c₀, ((init []) [target_tm]⊢⁺ c₀) ∧ Inv c₀)
    (h_step : ∀ c, Inv c → ∃ c', (c [target_tm]⊢⁺ c') ∧ Inv c') :
    IsNotHalt target_tm := by
  rcases h_init with ⟨c₀, ⟨n₀, _, hn₀⟩, hinv₀⟩
  exact BusyBeaver.Counter.does_not_halt_of_invariant Inv ⟨c₀, ⟨n₀, hn₀⟩, hinv₀⟩ h_step

structure SymCfg where
  q : Fin 6
  head : Fin 2
  l : List (Fin 2)
  r : List (Fin 2)

def realTape : List (Fin 2) → ListBlank (Fin 2) → ListBlank (Fin 2)
  | [], tail => tail
  | x :: xs, tail => x >> realTape xs tail

def realCfg (s : SymCfg) (L R : ListBlank (Fin 2)) : Cfg (Fin 2) (Fin 6) :=
  mkC s.q s.head (realTape s.l L) (realTape s.r R)

def pushSym (b : Bool) (w : Fin 2) (xs : List (Fin 2)) : List (Fin 2) :=
  match b, xs, w with
  | true, [], 0 => []
  | _, _, _ => w :: xs

def popSym (b : Bool) (xs : List (Fin 2)) : Option (Fin 2 × List (Fin 2)) :=
  match xs with
  | x :: xs' => some (x, xs')
  | [] => if b then some (0, []) else none

def stepSym (bl br : Bool) (s : SymCfg) : Option SymCfg :=
  match target_tm s.q s.head with
  | none => none
  | some (none, _) => none
  | some (some q', Stmt.write w Dir.right) =>
    match popSym br s.r with
    | none => none
    | some (h', r') => some ⟨q', h', pushSym bl w s.l, r'⟩
  | some (some q', Stmt.write w Dir.left) =>
    match popSym bl s.l with
    | none => none
    | some (h', l') => some ⟨q', h', l', pushSym br w s.r⟩

def runSym (bl br : Bool) : Nat → SymCfg → Option SymCfg
  | 0, s => some s
  | n + 1, s => (stepSym bl br s).bind (runSym bl br n)

lemma realTape_pushSym (b : Bool) (w : Fin 2) (xs : List (Fin 2)) (X : ListBlank (Fin 2))
    (hX : b = true → X = default) :
    realTape (pushSym b w xs) X = w >> realTape xs X := by
  cases b
  · rfl
  · rw [hX rfl]
    cases xs with
    | nil =>
      match w with
      | 0 => simp [pushSym, realTape]
      | 1 => rfl
    | cons _ _ => rfl

lemma stepSym_sound (bl br : Bool) (s s' : SymCfg) (L R : ListBlank (Fin 2))
    (hL : bl = true → L = default) (hR : br = true → R = default)
    (h : stepSym bl br s = some s') :
    step target_tm (realCfg s L R) = some (realCfg s' L R) := by
  rcases s with ⟨q, hd, l, r⟩
  simp only [stepSym] at h
  cases htm : target_tm q hd with
  | none => simp [htm] at h
  | some res =>
    rcases res with ⟨q_opt, stmt⟩
    cases q_opt with
    | none => simp [htm] at h
    | some q' =>
      rcases stmt with ⟨w, d⟩
      cases d with
      | right =>
        simp only [htm] at h
        cases r with
        | cons r0 rs =>
          simp only [popSym, Option.some.injEq] at h
          subst h
          simp [step, realCfg, mkC, htm, Tape.write, Tape.move, Tape.mk', realTape,
            realTape_pushSym bl w l L hL]
        | nil =>
          cases br with
          | false => simp [popSym] at h
          | true =>
            simp only [popSym, ↓reduceIte, Option.some.injEq] at h
            subst h
            rw [hR rfl]
            simp [step, realCfg, mkC, htm, Tape.write, Tape.move, Tape.mk', realTape,
              realTape_pushSym bl w l L hL]
      | left =>
        simp only [htm] at h
        cases l with
        | cons l0 ls =>
          simp only [popSym, Option.some.injEq] at h
          subst h
          simp [step, realCfg, mkC, htm, Tape.write, Tape.move, Tape.mk', realTape,
            realTape_pushSym br w r R hR]
        | nil =>
          cases bl with
          | false => simp [popSym] at h
          | true =>
            simp only [popSym, ↓reduceIte, Option.some.injEq] at h
            subst h
            rw [hL rfl]
            simp [step, realCfg, mkC, htm, Tape.write, Tape.move, Tape.mk', realTape,
              realTape_pushSym br w r R hR]

lemma runSym_sound (bl br : Bool) (n : Nat) (s s' : SymCfg) (L R : ListBlank (Fin 2))
    (hL : bl = true → L = default) (hR : br = true → R = default)
    (h : runSym bl br n s = some s') :
    multiStep target_tm (realCfg s L R) n = some (realCfg s' L R) := by
  induction n generalizing s with
  | zero =>
    simp only [runSym, Option.some.injEq] at h
    subst h; rfl
  | succ n ih =>
    simp only [runSym] at h
    cases hs₁ : stepSym bl br s with
    | none => simp [hs₁] at h
    | some s₁ =>
      simp only [hs₁, Option.bind] at h
      have h1 : multiStep target_tm (realCfg s L R) 1 = some (realCfg s₁ L R) :=
        stepSym_sound bl br s s₁ L R hL hR hs₁
      have eq_n : n + 1 = 1 + n := by omega
      rw [eq_n]
      exact zMt target_tm (realCfg s L R) (realCfg s₁ L R) (realCfg s' L R) 1 n h1 (ih s₁ h)

