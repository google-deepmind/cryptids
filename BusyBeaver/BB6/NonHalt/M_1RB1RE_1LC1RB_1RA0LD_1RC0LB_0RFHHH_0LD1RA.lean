lemma emit (r : ListBlank (Fin 2)) :
    (([O,I] +> default) <{{A}} (H_R +> r)) [qi]⊢* ((U.reverse +> default) {{D}}> r):= by
  have h := run_local_spec (tm := qi) (n := 31)
    (s1 := ⟨[O,I,O,O,O], H_R, A, .left⟩)
    (s2 := ⟨U.reverse, [], D, .right⟩)
    (by decide +kernel) default r
  simpa only [cfg_of, Counter.cfg_of, append_cons, append_nil, O_cons_default] using h

lemma segs_step (segs : List (List ℕ × qK)) (t e : ℕ) (xs ys : qK) (k : ℕ) (r : ListBlank (Fin 2))
    (h : qZ_segs segs = some (t, e, xs, ys)) :
    ((U.reverse +> default) {{D}}> ((W ^ k) +> (qg xs) +> r)) [qi]⊢*
    ((U.reverse +> default) {{D}}> ((W ^ (k + e)) +> (qg ys) +> r)) := by
  apply calls_spec emit t
  have hw := walls wall_1 t k
  have hb := qZ_segs_spec wall_1 one segs t e xs ys h
  have hc := q3 hw hb r r rfl
  simpa only [qh, List.append_assoc, append_assoc] using hc

def step_many : List (List (List ℕ × qK)) → ℕ → Runs → Option (ℕ × Runs)
  | [], k, r0 => some (k, r0)
  | segs :: rest, k, r0 =>
    match qZ_segs segs with
    | some (_, e, xs, ys) =>
      match qm xs r0 with
      | some r1 =>
        q6 (Nat.add k e) (fun k' =>
          q9 (qL ys r1) (fun r2 =>
            step_many rest k' r2))
      | none => none
    | none => none

lemma step_many_spec (txs : List (List (List ℕ × qK))) (k : ℕ) (r0 : Runs) (ke : ℕ) (rf : Runs)
    (h : step_many txs k r0 = some (ke, rf)) :
    ((U.reverse +> default) {{D}}> ((W ^ k) +> Runs.denote r0)) [qi]⊢*
    ((U.reverse +> default) {{D}}> ((W ^ ke) +> Runs.denote rf)) := by
  induction txs generalizing k r0 with
  | nil =>
    unfold step_many at h
    injection h with hpair; injection hpair with hke hrf; subst hke hrf
    exact ⟨0, rfl⟩
  | cons segs rest ih =>
    unfold step_many at h
    cases hb : qZ_segs segs with
    | none => rw [hb] at h; contradiction
    | some texy =>
      rcases texy with ⟨t, e, xs, ys⟩
      rw [hb] at h
      dsimp -failIfUnchanged only at h
      cases hrc : qm xs r0 with
      | none => rw [hrc] at h; contradiction
      | some r1 =>
        rw [hrc] at h
        simp only [strictNat_eq, strictRuns_eq, Nat.add_eq] at h
        have h_step := segs_step segs t e xs ys k (Runs.denote r1) hb
        rw [← qa1 hrc, ← qaf ys r1] at h_step
        exact q1 h_step (ih (k + e) (qL ys r1) h)

def qC_many (k : ℕ) (txs : List (List (List ℕ × qK))) (c : RMConfig) : Option RMConfig :=
  match Nat.beq c.state.1 3 with
  | true =>
    match qk .right c with
    | ⟨zl, zr, _, _⟩ =>
      match Runs.remove_one U.reverse zl, Runs.remove_exact W k zr with
      | some l0, some r0 =>
        match Runs.zeros l0 with
        | true =>
          match step_many txs k r0 with
          | some (ke, rf) =>
            some ⟨zl, Runs.consN W ke rf, D, .right⟩
          | none => none
        | false => none
      | _, _ => none
  | false => none

lemma qP_many {k : ℕ} {txs : List (List (List ℕ × qK))} {c c' : RMConfig}
    (h : qC_many k txs c = some c') :
    (c.denote) [qi]⊢* (c'.denote) := by
  unfold qC_many at h
  cases hq : Nat.beq c.state.1 3
  · rw [hq] at h; contradiction
  · rw [hq] at h
    have hq_eq : c.state = D := Fin.ext (Nat.beq_eq.mp hq)
    rw [← qR .right c]
    have hd_z : (qk .right c).dir = .right := qa3 .right c
    have hq_z : (qk .right c).state = D := by rw [qG, hq_eq]
    rcases hz : qk .right c with ⟨l, r, qz, dz⟩
    rw [hz] at hd_z hq_z h
    dsimp -failIfUnchanged only at hd_z hq_z h
    subst hd_z hq_z
    cases hl0 : Runs.remove_one U.reverse l with
    | none => rw [hl0] at h; contradiction
    | some l0 =>
      rw [hl0] at h
      cases hr0 : Runs.remove_exact W k r with
      | none => rw [hr0] at h; contradiction
      | some r0 =>
        rw [hr0] at h
        dsimp -failIfUnchanged only at h
        cases hz0 : Runs.zeros l0
        · rw [hz0] at h; contradiction
        · rw [hz0] at h
          cases hsm : step_many txs k r0 with
          | none => rw [hsm] at h; contradiction
          | some kerf =>
            rcases kerf with ⟨ke, rf⟩
            rw [hsm] at h
            injection h with hc'; subst hc'
            unfold RMConfig.denote
            dsimp -failIfUnchanged only
            have hl_den : Runs.denote l = U.reverse +> default := by
              rw [Runs.remove_one_spec hl0, Runs.zeros_spec hz0]
            rw [hl_den, Runs.consN_spec, Runs.remove_exact_spec hr0]
            exact step_many_spec txs k r0 ke rf hsm

def Runs.toList : Runs → List (Fin 2)
  | [] => []
  | (w, n) :: xs => w ^ n ++ Runs.toList xs

def Runs.push_runs : Runs → Runs → Runs
  | [], ys => ys
  | (w, n) :: xs, ys => q9 (Runs.push_runs xs ys) (fun zs => Runs.push w n zs)

lemma Runs.push_runs_spec (xs ys : Runs) :
    Runs.denote (Runs.push_runs xs ys) = Runs.toList xs +> Runs.denote ys := by
  induction xs with
  | nil => rfl
  | cons wn xs ih =>
    rcases wn with ⟨w, n⟩
    simp only [Runs.push_runs, Runs.toList, strictRuns_eq, Runs.push_spec, ih, append_assoc]

structure MacroRule where
  q1 : Fin 6
  d1 : Dir
  l_in : List (Fin 2)
  r_in : List (Fin 2)
  q2 : Fin 6
  d2 : Dir
  l_out : Runs
  r_out : Runs

def MacroRule.Valid (tm : Machine (Fin 2) (Fin 6)) (m : MacroRule) : Prop :=
  ∀ (l r : ListBlank (Fin 2)),
    (cfg_of m.q1 m.d1 (m.l_in +> l) (m.r_in +> r)) [tm]⊢*
    (cfg_of m.q2 m.d2 (Runs.toList m.l_out +> l) (Runs.toList m.r_out +> r))

lemma check_macro_spec {tm : Machine (Fin 2) (Fin 6)} {n : ℕ} {m : MacroRule}
    (h : run_local tm n ⟨m.l_in, m.r_in, m.q1, m.d1⟩ = some ⟨Runs.toList m.l_out, Runs.toList m.r_out, m.q2, m.d2⟩) :
    MacroRule.Valid tm m := by
  intro L R
  exact run_local_spec h L R

def apply_macro (m : MacroRule) (c : RMConfig) : Option RMConfig :=
  match Nat.beq c.state.1 m.q1.1 with
  | true =>
    match qk m.d1 c with
    | ⟨zl, zr, _, _⟩ =>
      match Runs.remove_word 16 m.l_in zl, Runs.remove_word 16 m.r_in zr with
      | some l', some r' =>
        q9 (Runs.push_runs m.l_out l') (fun l1 =>
          q9 (Runs.push_runs m.r_out r') (fun r1 =>
            some ⟨l1, r1, m.q2, m.d2⟩))
      | _, _ => none
  | false => none

lemma apply_macro_spec {tm : Machine (Fin 2) (Fin 6)} {m : MacroRule} {c c' : RMConfig}
    (hv : MacroRule.Valid tm m) (h : apply_macro m c = some c') :
    (c.denote) [tm]⊢* (c'.denote) := by
  unfold apply_macro at h
  cases hq : Nat.beq c.state.1 m.q1.1
  · rw [hq] at h; contradiction
  · rw [hq] at h
    have hq_eq : c.state = m.q1 := Fin.ext (Nat.beq_eq.mp hq)
    rw [← qR m.d1 c]
    have hd_z : (qk m.d1 c).dir = m.d1 := qa3 m.d1 c
    have hq_z : (qk m.d1 c).state = m.q1 := by rw [qG, hq_eq]
    rcases hz : qk m.d1 c with ⟨l, r, qz, dz⟩
    rw [hz] at hd_z hq_z h
    dsimp -failIfUnchanged only at hd_z hq_z h
    subst hd_z hq_z
    cases hl : Runs.remove_word 16 m.l_in l with
    | none => rw [hl] at h; contradiction
    | some l' =>
      rw [hl] at h
      cases hr : Runs.remove_word 16 m.r_in r with
      | none => rw [hr] at h; contradiction
      | some r' =>
        rw [hr] at h
        simp only [strictRuns_eq] at h
        injection h with hc'; subst hc'
        have h_lhs : (RMConfig.mk l r m.q1 m.d1).denote = cfg_of m.q1 m.d1 (m.l_in +> Runs.denote l') (m.r_in +> Runs.denote r') := by
          cases m.d1 <;> simp [RMConfig.denote, cfg_of, Counter.cfg_of, Runs.remove_word_spec hl, Runs.remove_word_spec hr]
        have h_rhs : (RMConfig.mk (Runs.push_runs m.l_out l') (Runs.push_runs m.r_out r') m.q2 m.d2).denote =
            cfg_of m.q2 m.d2 (Runs.toList m.l_out +> Runs.denote l') (Runs.toList m.r_out +> Runs.denote r') := by
          cases m.d2 <;> simp [RMConfig.denote, cfg_of, Counter.cfg_of, Runs.push_runs_spec]
        rw [h_lhs, h_rhs]
        exact hv (Runs.denote l') (Runs.denote r')

