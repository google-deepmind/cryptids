  rcases qae hr with ⟨r2,hr₁,hr₂⟩
  exact sideCalls_add (h₁ r1 r2 hr₁) (h₂ r2 r3 hr₂)
lemma qb {tm : Machine (Fin 2) (Fin 6)} {w1 w₂ : List (Fin 2)}
    (h : ∀ l r,((H_L +> l) {{D}}> (w1 +> r)) [tm]⊢* (l <{{A}} (H_R +> w₂ +> r))) :
    q4 tm 1 0 w1 w₂:= by
  intro r1 r2 hr
  change r1=r2 at hr
  subst hr
  exact ⟨w₂ +> r1,fun l => h l r1,rfl⟩
lemma qq {tm : Machine (Fin 2) (Fin 6)} {w1 w_mid w₂ : List (Fin 2)}
    (hR : ∀ l r,((H_L +> l) {{D}}> (w1 +> r)) [tm]⊢* ((H_L +> w_mid +> l) {{D}}> r))
    (hL : ∀ l r,((w_mid +> l) <{{A}} (H_R +> r)) [tm]⊢* (l <{{A}} (H_R +> w₂ +> r))) :
    q4 tm 1 1 w1 w₂:= by
  intro r1 r2 hr
  rcases hr with ⟨r',hcall,rfl⟩
  refine ⟨w₂ +> r',fun l => ?_,rfl⟩
  exact q1 (hR l r1) (q1 (hcall (w_mid +> l)) (hL l r'))
lemma wall_n {tm : Machine (Fin 2) (Fin 6)}
    (hwall1 : q4 tm 1 1 W W) (n : ℕ) :
    q4 tm 1 1 (W ^ n) (W ^ n):= by
  induction n with
  | zero => exact segCalls_nil tm 1
  | succ n ih =>
    rw [pow_succ_list]
    exact q3 hwall1 ih
lemma walls {tm : Machine (Fin 2) (Fin 6)}
    (hwall1 : q4 tm 1 1 W W) (t n : ℕ) :
    q4 tm t t (W ^ n) (W ^ n):= by
  induction t with
  | zero => exact qd tm (W ^ n)
  | succ t ih =>
    have h1:=qP (wall_n hwall1 n) ih
    rwa [Nat.add_comm 1 t] at h1
lemma prefix_rule {tm : Machine (Fin 2) (Fin 6)}
    (hwall1 : q4 tm 1 1 W W)
    {t u a b c : ℕ} {p p' : Digit}
    (h : q4 tm t u (q0 p ++ W ^ b) (W ^ a ++ q0 p' ++ W ^ c)) (k : ℕ) :
    q4 tm t u (W ^ k ++ (q0 p ++ W ^ b)) (W ^ (k + a) ++ q0 p' ++ W ^ c):= by
  have hw:=walls hwall1 t k
  have hc:=q3 hw h
  simpa only [qh,List.append_assoc] using hc
structure Effect where
  phase : Digit
  used : ℕ
  given : ℕ
  sent : ℕ
deriving DecidableEq
def qN : Digit → ℕ → Effect
  | p,0 => ⟨p,0,0,0⟩
  | p,t + 1 =>
    let a:=qN (qQ p) t
    ⟨a.phase,take p + a.used,qY p + a.given,qo p + a.sent⟩
lemma total_spec {tm : Machine (Fin 2) (Fin 6)}
    (hwall1 : q4 tm 1 1 W W)
    (hone : ∀ p n,q4 tm 1 (qo p) (q0 p ++ W ^ (take p + n)) (W ^ (qY p) ++ q0 (qQ p) ++ W ^ n))
    (t : ℕ) (p : Digit) (n : ℕ) :
    let a:=qN p t
    q4 tm t a.sent (q0 p ++ W ^ (a.used + n)) (W ^ a.given ++ q0 a.phase ++ W ^ n):= by
  induction t generalizing p n with
  | zero =>
    dsimp -failIfUnchanged [qN]
    simpa only [Nat.zero_add,pow_zero_list,List.nil_append] using qd tm (q0 p ++ W ^ n)
  | succ t ih =>
    dsimp -failIfUnchanged [qN]
    have h1:=hone p ((qN (qQ p) t).used + n)
    have h2:=prefix_rule hwall1 (ih (qQ p) n) (qY p)
    rw [← List.append_assoc] at h2
    have h3:=qP h1 h2
    rw [Nat.add_comm 1 t,← Nat.add_assoc] at h3
    exact h3
lemma total_add (p : Digit) (t u : ℕ) :
    qN p (t + u) =
      let a:=qN p t
      let b:=qN a.phase u
      ⟨b.phase,a.used + b.used,a.given + b.given,a.sent + b.sent⟩:= by
  induction t generalizing p with
  | zero =>
    rw [Nat.zero_add]
    dsimp -failIfUnchanged only [qN]
    rcases qN p u with ⟨ph,us,gv,sn⟩
    simp only [Nat.zero_add]
  | succ t ih =>
    rw [Nat.succ_add]
    dsimp -failIfUnchanged only [qN]
    rw [ih (qQ p)]
    dsimp -failIfUnchanged only
    congr 1 <;> omega
lemma total_cycle (p : Digit) :
    qN p (qD p)=⟨p,qM p,qU p,qy p⟩:= by
  cases p <;> rfl
lemma total_period (p : Digit) (k r : ℕ) :
    qN p (k * qD p + r) =
      let a:=qN p r
      ⟨a.phase,k * qM p + a.used,k * qU p + a.given,k * qy p + a.sent⟩:= by
  induction k with
  | zero =>
    simp only [Nat.zero_mul,Nat.zero_add]
  | succ k ih =>
    have h_eq : (k + 1) * qD p + r=qD p + (k * qD p + r):= by ring
    rw [h_eq,total_add,total_cycle]
    dsimp -failIfUnchanged only
    rw [ih]
    dsimp -failIfUnchanged only
    congr 1 <;> ring
def qN_fast : Digit → ℕ → Effect
  | p, 0 => ⟨p, 0, 0, 0⟩
  | p, t + 1 =>
    match qN_fast (qQ p) t with
    | ⟨ph, u, g, s⟩ =>
      ⟨ph, Nat.add (take p) u, Nat.add (qY p) g, Nat.add (qo p) s⟩
lemma qN_fast_eq (p : Digit) (t : ℕ) : qN_fast p t = qN p t := by
  induction t generalizing p with
  | zero => rfl
  | succ t ih =>
    unfold qN_fast qN
    rw [ih (qQ p)]
    rfl
def qF (p : Digit) (t : ℕ) : Effect :=
  let per := qD p
  q6 (Nat.div t per) (fun k =>
    q6 (Nat.mod t per) (fun r =>
      match qN_fast p r with
      | ⟨ph, u, g, s⟩ =>
        qad ph (fun ph' =>
          q6 (Nat.add (Nat.mul k (qM p)) u) (fun u' =>
            q6 (Nat.add (Nat.mul k (qU p)) g) (fun g' =>
              q6 (Nat.add (Nat.mul k (qy p)) s) (fun s' =>
                ⟨ph', u', g', s'⟩))))))
lemma totalN_spec (p : Digit) (t : ℕ) : qF p t=qN p t:= by
  unfold qF
  simp only [strictNat_eq,strictDigit_eq,qN_fast_eq]
  have h_div : t=(t / qD p) * qD p + t % qD p:=(Nat.div_add_mod' t (qD p)).symm
  conv_rhs => rw [h_div,total_period]
  rcases qN p (t % qD p) with ⟨ph,u,g,s⟩
  rfl
lemma totalN_rule {tm : Machine (Fin 2) (Fin 6)}
    (hwall1 : q4 tm 1 1 W W)
    (hone : ∀ p n,q4 tm 1 (qo p) (q0 p ++ W ^ (take p + n)) (W ^ (qY p) ++ q0 (qQ p) ++ W ^ n))
    (p : Digit) (t n : ℕ) (h : (qF p t).used ≤ n) :
    let a:=qF p t
    q4 tm t a.sent (q0 p ++ W ^ n) (W ^ a.given ++ q0 a.phase ++ W ^ (n - a.used)):= by
  dsimp -failIfUnchanged only
  have h_spec:=total_spec hwall1 hone t p (n - (qF p t).used)
  rw [← totalN_spec p t] at h_spec
  dsimp -failIfUnchanged only at h_spec
  have h_add : (qF p t).used + (n - (qF p t).used)=n:=Nat.add_sub_of_le h
  rwa [h_add] at h_spec
abbrev qK:=List (Digit × ℕ)
def qg : qK → List (Fin 2)
  | [] => []
  | (p,n) :: xs => q0 p ++ W ^ n ++ qg xs

def qZ_open : ℕ → qK → Option (ℕ × qK × ℕ)
  | t, [] => some (0, [], t)
  | t, (p, n) :: xs =>
    match Nat.beq t 0 with
    | true => some (0, (p, n) :: xs, 0)
    | false =>
      match qF p t with
      | ⟨ph, u, g, s⟩ =>
        match Nat.ble u n with
        | true =>
          match qZ_open s xs with
          | some (e, ys, u_out) =>
            q6 (Nat.add (Nat.sub n u) e) (fun m =>
              some (g, (ph, m) :: ys, u_out))
          | none => none
        | false => none

lemma qZ_open_spec {tm : Machine (Fin 2) (Fin 6)}
    (hwall1 : q4 tm 1 1 W W)
    (hone : ∀ p n, q4 tm 1 (qo p) (q0 p ++ W ^ (take p + n)) (W ^ (qY p) ++ q0 (qQ p) ++ W ^ n))
    (t : ℕ) (xs : qK) (e : ℕ) (ys : qK) (u_out : ℕ) (h : qZ_open t xs = some (e, ys, u_out)) :
    q4 tm t u_out (qg xs) (W ^ e ++ qg ys) := by
  induction xs generalizing t e ys u_out with
  | nil =>
    unfold qZ_open at h
    injection h with hp1; injection hp1 with he hp2; injection hp2 with hys hu
    subst he hys hu
    exact segCalls_nil tm t
  | cons pn xs ih =>
    rcases pn with ⟨p, n⟩
    unfold qZ_open at h
    cases ht : Nat.beq t 0
    · rw [ht] at h
      dsimp -failIfUnchanged only at h
      cases hle : Nat.ble (qF p t).used n
      · rw [hle] at h; contradiction
      · rw [hle] at h
        cases hb : qZ_open (qF p t).sent xs with
        | none => rw [hb] at h; contradiction
        | some eys =>
          rcases eys with ⟨e', ys', u'⟩
          rw [hb] at h
          simp only [strictNat_eq, Nat.add_eq, Nat.sub_eq] at h
          injection h with hp1; injection hp1 with he hp2; injection hp2 with hys hu
          subst he hys hu
          have h1 := totalN_rule hwall1 hone p t n (ble_true hle)
          have h2 := ih (qF p t).sent e' ys' u' hb
          have h3 := q3 h1 h2
          simpa only [qg, qh, List.append_assoc] using h3
    · rw [ht] at h
      injection h with hp1; injection hp1 with he hp2; injection hp2 with hys hu
      subst he hys hu
      have ht0 : t = 0 := Nat.beq_eq.mp ht; subst ht0
      simpa using qd tm (qg ((p, n) :: xs))

def qZ_open_many : List ℕ → ℕ → ℕ → qK → ℕ → Option (ℕ × ℕ × qK × ℕ)
  | [], t_acc, e_acc, xs, u_acc => some (t_acc, e_acc, xs, u_acc)
  | t :: ts, t_acc, e_acc, xs, u_acc =>
    match qZ_open t xs with
    | some (e, ys, u_out) =>
      q6 (Nat.add t_acc t) (fun t' =>
        q6 (Nat.add e_acc e) (fun e' =>
          q6 (Nat.add u_acc u_out) (fun u' =>
            qZ_open_many ts t' e' ys u')))
    | none => none

lemma qZ_open_many_spec {tm : Machine (Fin 2) (Fin 6)}
    (hwall1 : q4 tm 1 1 W W)
    (hone : ∀ p n, q4 tm 1 (qo p) (q0 p ++ W ^ (take p + n)) (W ^ (qY p) ++ q0 (qQ p) ++ W ^ n))
    (ts : List ℕ) (t_acc e_acc : ℕ) (xs : qK) (u_acc : ℕ)
    (tf ef : ℕ) (yf : qK) (uf : ℕ)
    (w0 : List (Fin 2))
    (h_acc : q4 tm t_acc u_acc w0 (W ^ e_acc ++ qg xs))
    (h : qZ_open_many ts t_acc e_acc xs u_acc = some (tf, ef, yf, uf)) :
    q4 tm tf uf w0 (W ^ ef ++ qg yf) := by
  induction ts generalizing t_acc e_acc xs u_acc with
  | nil =>
    unfold qZ_open_many at h
    injection h with hp1; injection hp1 with ht hp2; injection hp2 with he hp3; injection hp3 with hxs hu
    subst ht he hxs hu
    exact h_acc
  | cons t ts ih =>
    unfold qZ_open_many at h
    cases ho : qZ_open t xs with
    | none => rw [ho] at h; contradiction
    | some eyu =>
      rcases eyu with ⟨e, ys, u_out⟩
      rw [ho] at h
      simp only [strictNat_eq, Nat.add_eq] at h
      have h_step := qZ_open_spec hwall1 hone t xs e ys u_out ho
      have h_w := walls hwall1 t e_acc
      have h_step_w : q4 tm t u_out (W ^ e_acc ++ qg xs) (W ^ (e_acc + e) ++ qg ys) := by
        simpa only [qh, List.append_assoc] using q3 h_w h_step
      have h_next := qP h_acc h_step_w
      exact ih (t_acc + t) (e_acc + e) ys (u_acc + u_out) h_next h

lemma qg_append (xs1 xs2 : qK) : qg (xs1 ++ xs2) = qg xs1 ++ qg xs2 := by
  induction xs1 with
  | nil => rfl
  | cons pn rest ih =>
    rcases pn with ⟨p, n⟩
    simp only [List.cons_append, qg, ih, List.append_assoc]

def append_qK : qK → ℕ → qK → Option qK
  | [], e2, ys2 =>
    match Nat.beq e2 0 with
    | true => some ys2
    | false => none
  | [(p, n)], e2, ys2 =>
    q6 (Nat.add n e2) (fun m => some ((p, m) :: ys2))
  | (p, n) :: rest, e2, ys2 =>
    match append_qK rest e2 ys2 with
    | some ys' => some ((p, n) :: ys')
    | none => none

lemma append_qK_spec {ys1 : qK} {e2 : ℕ} {ys2 ys : qK}
    (h : append_qK ys1 e2 ys2 = some ys) :
    qg ys1 ++ (W ^ e2 ++ qg ys2) = qg ys := by
  induction ys1 generalizing ys with
  | nil =>
    unfold append_qK at h
    cases he : Nat.beq e2 0
    · rw [he] at h; contradiction
    · rw [he] at h; injection h with hys; subst hys
      have he0 : e2 = 0 := Nat.beq_eq.mp he; subst he0
      rfl
  | cons pn rest ih =>
    rcases pn with ⟨p, n⟩
    cases rest with
    | nil =>
      unfold append_qK at h
      simp only [strictNat_eq, Nat.add_eq] at h
      injection h with hys; subst hys
      simp only [qg, List.append_nil, qh, List.append_assoc]
    | cons pn2 rest2 =>
      unfold append_qK at h
      cases ha : append_qK (pn2 :: rest2) e2 ys2 with
      | none => rw [ha] at h; contradiction
      | some ys' =>
        rw [ha] at h; injection h with hys; subst hys
        change (q0 p ++ W ^ n) ++ qg (pn2 :: rest2) ++ (W ^ e2 ++ qg ys2) = (q0 p ++ W ^ n) ++ qg ys'
        rw [List.append_assoc (q0 p ++ W ^ n), ih ha]

def qZ_segs : List (List ℕ × qK) → Option (ℕ × ℕ × qK × qK)
  | [] => none
  | [(ts, xs)] =>
    match qZ_open_many ts 0 0 xs 0 with
    | some (t, e, ys, u) =>
      match Nat.beq u 0 with
      | true => some (t, e, xs, ys)
      | false => none
    | none => none
  | (ts, xs) :: seg2 :: rest =>
    match qZ_open_many ts 0 0 xs 0, qZ_segs (seg2 :: rest) with
    | some (t1, e1, ys1, u1), some (t2, e2, xs2, ys2) =>
      match Nat.beq u1 t2 with
      | true =>
        match append_qK ys1 e2 ys2 with
        | some ys => some (t1, e1, xs ++ xs2, ys)
        | none => none
      | false => none
    | _, _ => none

lemma qZ_segs_spec {tm : Machine (Fin 2) (Fin 6)}
    (hwall1 : q4 tm 1 1 W W)
    (hone : ∀ p n, q4 tm 1 (qo p) (q0 p ++ W ^ (take p + n)) (W ^ (qY p) ++ q0 (qQ p) ++ W ^ n))
    (segs : List (List ℕ × qK)) (t e : ℕ) (xs ys : qK)
    (h : qZ_segs segs = some (t, e, xs, ys)) :
    q4 tm t 0 (qg xs) (W ^ e ++ qg ys) := by
  induction segs generalizing t e xs ys with
  | nil => contradiction
  | cons seg1 rest ih =>
    rcases seg1 with ⟨ts1, xs1⟩
    cases rest with
    | nil =>
      unfold qZ_segs at h
      cases hm : qZ_open_many ts1 0 0 xs1 0 with
      | none => rw [hm] at h; contradiction
      | some teyu =>
        rcases teyu with ⟨t1, e1, ys1, u1⟩
        rw [hm] at h
        dsimp -failIfUnchanged only at h
        cases hu : Nat.beq u1 0
        · rw [hu] at h; contradiction
        · rw [hu] at h
          injection h with hp1; injection hp1 with ht hp2; injection hp2 with he hp3; injection hp3 with hxs hys
          subst ht he hxs hys
          have hu0 : u1 = 0 := Nat.beq_eq.mp hu; subst hu0
          exact qZ_open_many_spec hwall1 hone ts1 0 0 xs1 0 t1 e1 ys1 0 (qg xs1) (qd tm (qg xs1)) hm
    | cons seg2 rest2 =>
      unfold qZ_segs at h
      cases hm1 : qZ_open_many ts1 0 0 xs1 0 with
      | none => rw [hm1] at h; contradiction
      | some teyu1 =>
        rcases teyu1 with ⟨t1, e1, ys1, u1⟩
        rw [hm1] at h
        cases hm2 : qZ_segs (seg2 :: rest2) with
        | none => rw [hm2] at h; contradiction
        | some texy2 =>
          rcases texy2 with ⟨t2, e2, xs2, ys2⟩
          rw [hm2] at h
          dsimp -failIfUnchanged only at h
          cases hut : Nat.beq u1 t2
          · rw [hut] at h; contradiction
          · rw [hut] at h
            cases hap : append_qK ys1 e2 ys2 with
            | none => rw [hap] at h; contradiction
            | some ys_all =>
              rw [hap] at h
              injection h with hp1; injection hp1 with ht hp2; injection hp2 with he hp3; injection hp3 with hxs hys
              subst ht he hxs hys
              have hut_eq : u1 = t2 := Nat.beq_eq.mp hut; subst hut_eq
              have h1 := qZ_open_many_spec hwall1 hone ts1 0 0 xs1 0 t1 e1 ys1 u1 (qg xs1) (qd tm (qg xs1)) hm1
              have h2 := ih u1 e2 xs2 ys2 hm2
              have h3 := q3 h1 h2
              rw [← qg_append, List.append_assoc (W ^ e1), append_qK_spec hap] at h3
              exact h3

lemma calls_spec {tm : Machine (Fin 2) (Fin 6)}
    (hemit : ∀ r,(([O,I] +> default) <{{A}} (H_R +> r)) [tm]⊢* ((U.reverse +> default) {{D}}> r))
    (t : ℕ) (r r' : ListBlank (Fin 2)) (h : qj tm t r r') :
    ((U.reverse +> default) {{D}}> r) [tm]⊢* ((U.reverse +> default) {{D}}> r'):= by
  induction t generalizing r with
  | zero =>
    change r=r' at h
    subst h
    exact ⟨0,rfl⟩
  | succ t ih =>
    rcases h with ⟨r1,hstep,hrest⟩
    have hU : U.reverse +> (default : ListBlank (Fin 2))=H_L +> ([O,I] +> default):=rfl
    rw [hU]
    exact q1 (hstep ([O,I] +> default)) (q1 (hemit r1) (ih r1 hrest))

abbrev Runs:=List (List (Fin 2) × ℕ)

def q9 (r : Runs) (f : Runs → α) : α :=
  match r with
  | [] => f []
  | head :: tail => f (head :: tail)
@[simp] lemma strictRuns_eq (r : Runs) (f : Runs → α) : q9 r f=f r:= by
  cases r <;> rfl

def Runs.denote : Runs → ListBlank (Fin 2)
  | [] => default
  | (w,n) :: xs => (w ^ n) +> Runs.denote xs

def Runs.cons1 (w : List (Fin 2)) (xs : Runs) : Runs := (w, 1) :: xs
lemma Runs.cons1_spec (w : List (Fin 2)) (xs : Runs) :
    Runs.denote (Runs.cons1 w xs) = w +> Runs.denote xs := by
  simp [Runs.cons1, Runs.denote, pow_succ_list]

def Runs.consN (w : List (Fin 2)) (n : ℕ) (xs : Runs) : Runs :=
  match Nat.beq n 0 with
  | true => xs
  | false => q6 n (fun n' => (w, n') :: xs)
lemma Runs.consN_spec (w : List (Fin 2)) (n : ℕ) (xs : Runs) :
    Runs.denote (Runs.consN w n xs) = (w ^ n) +> Runs.denote xs := by
  unfold Runs.consN
  cases hn : Nat.beq n 0
  · simp [strictNat_eq, Runs.denote]
  · have hn0 : n = 0 := Nat.beq_eq.mp hn
    subst hn0
    simp [Runs.denote]

def Runs.push (w : List (Fin 2)) (n : ℕ) (xs : Runs) : Runs :=
  match w with
  | [] => xs
  | b :: w' =>
    match Nat.beq n 0 with
    | true => xs
    | false =>
      match xs with
      | [] => q6 n (fun n' => [(b :: w', n')])
      | (v, m) :: ys =>
        match eqL2 (b :: w') v with
        | true => q6 (Nat.add n m) (fun nm => (b :: w', nm) :: ys)
        | false => q6 n (fun n' => (b :: w', n') :: (v, m) :: ys)

lemma Runs.push_spec (w : List (Fin 2)) (n : ℕ) (xs : Runs) :
    Runs.denote (Runs.push w n xs)=(w ^ n) +> Runs.denote xs:= by
  cases w with
  | nil => simp [Runs.push,nil_pow_list]
  | cons b w' =>
    unfold Runs.push
    cases hn : Nat.beq n 0
    · cases xs with
      | nil => rfl
      | cons vm ys =>
        rcases vm with ⟨v,m⟩
        dsimp -failIfUnchanged only
        cases hv : eqL2 (b :: w') v
        · rfl
        · have hv_eq : b :: w'=v:=eqL2_iff.mp hv
          subst hv_eq
          simp only [strictNat_eq, Nat.add_eq, Runs.denote, qh, append_assoc]
    · have hn0 : n=0:=Nat.beq_eq.mp hn
      subst hn0
      simp

def Runs.pop : Runs → Fin 2 × Runs
  | [] => (O, [])
  | ([], _) :: xs => Runs.pop xs
  | (b :: w, n) :: xs =>
    match Nat.beq n 0 with
    | true => Runs.pop xs
    | false =>
      match Nat.beq n 1 with
      | true =>
        match w with
        | [] => (b, xs)
        | b2 :: w' => q9 (Runs.push (b2 :: w') 1 xs) (fun xs2 => (b, xs2))
      | false =>
        q6 (Nat.sub n 1) (fun n' =>
          match w with
          | [] => (b, ([b], n') :: xs)
          | b2 :: w' => (b, Runs.cons1 (b2 :: w') ((b :: b2 :: w', n') :: xs)))

lemma Runs.pop_spec (xs : Runs) :
    Runs.denote xs=(Runs.pop xs).1 >> Runs.denote (Runs.pop xs).2:= by
  induction xs with
  | nil =>
    simp only [Runs.pop,Runs.denote,O_cons_default]
  | cons wn xs ih =>
    rcases wn with ⟨w,n⟩
    cases w with
    | nil =>
      simpa [Runs.pop,Runs.denote,nil_pow_list] using ih
    | cons b w =>
      unfold Runs.pop
      cases hn : Nat.beq n 0
      · have hn_pos : 0 < n := Nat.pos_of_ne_zero (by intro h0; subst h0; exact Bool.noConfusion hn)
        have hn_eq : n = (n - 1) + 1 := (Nat.sub_add_cancel hn_pos).symm
        cases hn1 : Nat.beq n 1
        · simp only [strictNat_eq, Nat.sub_eq]
          cases w with
          | nil =>
            dsimp -failIfUnchanged only [Runs.denote]
            conv_lhs => rw [hn_eq, pow_succ_list]
            simp [pow_succ_list, append_assoc]
          | cons b2 w' =>
            dsimp -failIfUnchanged only [Runs.denote, Runs.cons1]
            conv_lhs => rw [hn_eq, pow_succ_list]
            simp [pow_succ_list, append_assoc]
        · have hn1_eq : n = 1 := Nat.beq_eq.mp hn1
          subst hn1_eq
          cases w with
          | nil => simp [Runs.denote, pow_succ_list]
          | cons b2 w' =>
            simp [strictRuns_eq, Runs.push_spec, Runs.denote, pow_succ_list]
      · have hn0 : n = 0 := Nat.beq_eq.mp hn
        subst hn0
        simpa [Runs.denote] using ih

def Runs.remove : List (Fin 2) → Runs → Option Runs
  | [], xs => q9 xs (fun xs' => some xs')
  | b :: w, xs =>
    match Runs.pop xs with
    | (b', xs') =>
      match Nat.beq b.1 b'.1 with
      | true => Runs.remove w xs'
      | false => none

lemma Runs.remove_spec {w : List (Fin 2)} {xs ys : Runs}
    (h : Runs.remove w xs=some ys) :
    Runs.denote xs=w +> Runs.denote ys:= by
  induction w generalizing xs with
  | nil =>
    unfold Runs.remove at h
    simp only [strictRuns_eq] at h
    injection h with hys; subst hys; rfl
  | cons b w ih =>
    unfold Runs.remove at h
    dsimp -failIfUnchanged only at h
    cases hb : Nat.beq b.1 (Runs.pop xs).1.1
    · rw [hb] at h; contradiction
    · rw [hb] at h
      have hb_eq : b = (Runs.pop xs).1 := Fin.ext (Nat.beq_eq.mp hb)
      rw [Runs.pop_spec xs, ← hb_eq, ih h]
      rfl

def Runs.remove_word : ℕ → List (Fin 2) → Runs → Option Runs
  | 0, w, xs => Runs.remove w xs
  | _ + 1, [], xs => some xs
  | _ + 1, w, [] => Runs.remove w []
  | fuel + 1, w, (v, nv) :: ys =>
    match Nat.beq nv 0 with
    | true => Runs.remove_word fuel w ys
    | false =>
      match strip_prefix w v with
      | some ([], []) =>
        match Nat.beq nv 1 with
        | true => some ys
        | false => q6 (Nat.sub nv 1) (fun nv' => some ((v, nv') :: ys))
      | some ([], v_rem) =>
        match Nat.beq nv 1 with
        | true => q9 (Runs.push v_rem 1 ys) (fun ys2 => some ys2)
        | false =>
          q6 (Nat.sub nv 1) (fun nv' =>
            some (Runs.cons1 v_rem ((v, nv') :: ys)))
      | some (w_rem, []) =>
        match Nat.beq nv 1 with
        | true => Runs.remove_word fuel w_rem ys
        | false =>
          q6 (Nat.sub nv 1) (fun nv' =>
            Runs.remove_word fuel w_rem ((v, nv') :: ys))
      | _ => none

lemma Runs.remove_word_spec {fuel : ℕ} {w : List (Fin 2)} {xs ys : Runs}
    (h : Runs.remove_word fuel w xs = some ys) :
    Runs.denote xs = w +> Runs.denote ys := by
  induction fuel generalizing w xs ys with
  | zero => exact Runs.remove_spec h
  | succ fuel ih =>
    cases w with
    | nil =>
      unfold Runs.remove_word at h
      injection h with hys; subst hys; rfl
    | cons b1 w' =>
      cases xs with
      | nil =>
        unfold Runs.remove_word at h
        exact Runs.remove_spec h
      | cons vn ys0 =>
        rcases vn with ⟨v, nv⟩
        unfold Runs.remove_word at h
        cases hnv : Nat.beq nv 0
        · rw [hnv] at h
          have hnv_pos : 0 < nv := Nat.pos_of_ne_zero (by intro h0; subst h0; exact Bool.noConfusion hnv)
          have hnv_eq : nv = 1 + (nv - 1) := (Nat.add_sub_of_le hnv_pos).symm
          have h_v_pow : v ^ nv = v ++ v ^ (nv - 1) := by
            conv_lhs => rw [hnv_eq, qh, pow_succ_list, pow_zero_list, List.append_nil]
          cases hsp : strip_prefix (b1 :: w') v with
          | none => rw [hsp] at h; contradiction
          | some wv =>
            rcases wv with ⟨w_rem, v_rem⟩
            rw [hsp] at h
            rcases strip_prefix_spec hsp with ⟨hsp1, hsp2⟩
            cases w_rem with
            | nil =>
              cases v_rem with
              | nil =>
                dsimp -failIfUnchanged only at h
                have hv_eq : v = b1 :: w' := by simpa using hsp1 rfl
                cases hnv1 : Nat.beq nv 1
                · rw [hnv1] at h
                  simp only [strictNat_eq, Nat.sub_eq] at h
                  injection h with hys; subst hys
                  have h_v_pow2 : v ^ nv = (b1 :: w') ++ v ^ (nv - 1) :=
                    h_v_pow.trans (congrArg (· ++ v ^ (nv - 1)) hv_eq)
                  rw [Runs.denote, h_v_pow2, Runs.denote, append_assoc]
                · rw [hnv1] at h
                  injection h with hys; subst hys
                  have hnv1_eq : nv = 1 := Nat.beq_eq.mp hnv1; subst hnv1_eq
                  rw [Runs.denote, hv_eq]
                  simp [pow_succ_list]
              | cons bv v_tail =>
                dsimp -failIfUnchanged only at h
                have hv_eq := hsp1 rfl
                cases hnv1 : Nat.beq nv 1
                · rw [hnv1] at h
                  simp only [strictNat_eq, Nat.sub_eq] at h
                  injection h with hys; subst hys
                  have h_v_pow2 : v ^ nv = (b1 :: w' ++ (bv :: v_tail)) ++ v ^ (nv - 1) :=
                    h_v_pow.trans (congrArg (· ++ v ^ (nv - 1)) hv_eq)
                  rw [Runs.denote, h_v_pow2, Runs.cons1_spec, Runs.denote]
                  simp [append_assoc]
                · rw [hnv1] at h
                  simp only [strictRuns_eq] at h
                  injection h with hys; subst hys
                  have hnv1_eq : nv = 1 := Nat.beq_eq.mp hnv1; subst hnv1_eq
                  rw [Runs.denote, Runs.push_spec, hv_eq]
                  simp [pow_succ_list, append_assoc]
            | cons bw w_tail =>
              cases v_rem with
              | nil =>
                dsimp -failIfUnchanged only at h
                have hw_eq := hsp2 rfl
                cases hnv1 : Nat.beq nv 1
                · rw [hnv1] at h
                  simp only [strictNat_eq, Nat.sub_eq] at h
                  have h_ih := ih h
                  rw [Runs.denote] at h_ih
                  rw [Runs.denote, h_v_pow, append_assoc, h_ih, hw_eq, append_assoc]
                · rw [hnv1] at h
                  have hnv1_eq : nv = 1 := Nat.beq_eq.mp hnv1; subst hnv1_eq
                  have h_ih := ih h
                  rw [Runs.denote, h_ih, hw_eq]
                  simp [pow_succ_list, append_assoc]
              | cons bv v_tail =>
                dsimp -failIfUnchanged only at h
                contradiction
        · rw [hnv] at h
          have hnv0 : nv = 0 := Nat.beq_eq.mp hnv
          subst hnv0
          simpa [Runs.denote] using ih h

def Runs.remove_fast : ℕ → List (Fin 2) → ℕ → Runs → Option Runs
  | 0, _, n, xs =>
    match Nat.beq n 0 with
    | true => some xs
    | false => none
  | fuel + 1, w, n, xs =>
    match Nat.beq n 0 with
    | true => some xs
    | false =>
      match xs with
      | (x, nx) :: ys =>
        match strip_prefix w x with
        | some ([], []) =>
          match Nat.ble nx n with
          | true =>
            match Nat.beq nx n with
            | true => some ys
            | false => q6 (Nat.sub n nx) (fun n' => Runs.remove_fast fuel w n' ys)
          | false =>
            q6 (Nat.sub nx n) (fun nx' => some ((x, nx') :: ys))
        | some (w_rem, []) =>
          match Nat.beq nx 1 with
          | true =>
            match ys with
            | (v, m) :: ys' =>
              match eqL2 v (w_rem ++ x) with
              | true =>
                match Nat.ble m n with
                | false =>
                  q6 (Nat.sub m n) (fun m' =>
                    some (Runs.cons1 x ((v, m') :: ys')))
                | true =>
                  match Nat.beq m n with
                  | true => q9 (Runs.push x 1 ys') (fun zs => some zs)
                  | false =>
                    match Nat.beq (Nat.add m 1) n with
                    | true => Runs.remove_word 16 w_rem ys'
                    | false =>
                      match Nat.beq (Nat.add m 2) n with
                      | true => Runs.remove_word 16 (w_rem ++ w) ys'
                      | false =>
                        q6 (Nat.sub n m) (fun n' =>
                          q9 (Runs.push x 1 ys') (fun zs =>
                            Runs.remove_fast fuel w n' zs))
              | false =>
                match Runs.remove_word 16 w_rem ys with
                | some zs => q6 (Nat.sub n 1) (fun n' => Runs.remove_fast fuel w n' zs)
                | none => none
            | [] => none
          | false =>
            match Runs.remove_word 16 w ((x, nx) :: ys) with
            | some zs => q6 (Nat.sub n 1) (fun n' => Runs.remove_fast fuel w n' zs)
            | none => none
        | some ([], x_rem) =>
          match Nat.beq nx 1 with
          | true =>
            q9 (Runs.push x_rem 1 ys) (fun zs =>
              q6 (Nat.sub n 1) (fun n' => Runs.remove_fast fuel w n' zs))
          | false =>
            match Nat.beq nx 0 with
            | true => none
            | false =>
              q6 (Nat.sub nx 1) (fun nx' =>
                q6 (Nat.sub n 1) (fun n' =>
                  Runs.remove_fast fuel w n' (Runs.cons1 x_rem ((x, nx') :: ys))))
        | _ => none
      | [] => none

lemma Runs.remove_fast_spec {fuel : ℕ} {w : List (Fin 2)} {n : ℕ} {xs ys : Runs}
    (h : Runs.remove_fast fuel w n xs = some ys) :
    Runs.denote xs = (w ^ n) +> Runs.denote ys := by
  induction fuel generalizing n xs ys with
  | zero =>
    unfold Runs.remove_fast at h
    cases hn : Nat.beq n 0
    · rw [hn] at h; contradiction
    · rw [hn] at h
      injection h with hys; subst hys
      have hn0 : n = 0 := Nat.beq_eq.mp hn; subst hn0
      simp
  | succ fuel ih =>
    unfold Runs.remove_fast at h
    cases hn : Nat.beq n 0
    · rw [hn] at h
      have hn_pos : 0 < n := Nat.pos_of_ne_zero (by intro h0; subst h0; exact Bool.noConfusion hn)
      have hn_eq1 : n = (n - 1) + 1 := (Nat.sub_add_cancel hn_pos).symm
      rcases xs with _ | ⟨⟨x, nx⟩, ys0⟩
      · contradiction
      · simp only [] at h
        cases hsp : strip_prefix w x with
        | none => rw [hsp] at h; contradiction
        | some wx =>
          rcases wx with ⟨w_rem, x_rem⟩
          rw [hsp] at h
          rcases strip_prefix_spec hsp with ⟨hsp1, hsp2⟩
          cases w_rem with
          | nil =>
            cases x_rem with
            | nil =>
              dsimp -failIfUnchanged only at h
              have hwx_eq : x = w := by simpa using hsp1 rfl
              subst hwx_eq
              cases hble : Nat.ble nx n
              · rw [hble] at h
                simp only [strictNat_eq, Nat.sub_eq] at h
                injection h with hys; subst hys
                have hlt : n < nx := ble_false hble
                have hnx_eq : nx = n + (nx - n) := (Nat.add_sub_of_le (Nat.le_of_lt hlt)).symm
                rw [Runs.denote, Runs.denote]
                conv_lhs => rw [hnx_eq, qh, append_assoc]
              · rw [hble] at h
                have hle : nx ≤ n := ble_true hble
                cases hbeq : Nat.beq nx n
                · rw [hbeq] at h
                  simp only [strictNat_eq, Nat.sub_eq] at h
                  rw [Runs.denote, ih h, ← append_assoc, ← qh, Nat.add_sub_of_le hle]
                · rw [hbeq] at h
                  injection h with hys; subst hys
                  have hnx_eq : nx = n := Nat.beq_eq.mp hbeq; subst hnx_eq
                  rfl
            | cons bx x_tail =>
              dsimp -failIfUnchanged only at h
              have hx_eq : x = w ++ (bx :: x_tail) := hsp1 rfl
              cases hnx1 : Nat.beq nx 1
              · rw [hnx1] at h
                cases hnx0 : Nat.beq nx 0
                · rw [hnx0] at h
                  simp only [strictNat_eq, Nat.sub_eq] at h
                  have hnx_pos : 0 < nx := Nat.pos_of_ne_zero (by intro h0; subst h0; exact Bool.noConfusion hnx0)
                  have hnx_eq : nx = 1 + (nx - 1) := (Nat.add_sub_of_le hnx_pos).symm
                  have h_x_pow : x ^ nx = (w ++ (bx :: x_tail)) ++ x ^ (nx - 1) := by
                    conv_lhs => rw [hnx_eq, qh, pow_succ_list, pow_zero_list, List.append_nil]
                    rw [← hx_eq]
                  have h_ih := ih h
                  rw [Runs.cons1_spec, Runs.denote] at h_ih
                  rw [Runs.denote, h_x_pow, append_assoc, append_assoc, h_ih]
                  conv_rhs => rw [hn_eq1, pow_succ_list, append_assoc]
                · rw [hnx0] at h; contradiction
              · rw [hnx1] at h
                simp only [strictRuns_eq, strictNat_eq, Nat.sub_eq] at h
                have hnx1_eq : nx = 1 := Nat.beq_eq.mp hnx1; subst hnx1_eq
                have h_ih := ih h
                rw [Runs.push_spec] at h_ih
                simp only [pow_succ_list, pow_zero_list, List.append_nil] at h_ih
                rw [Runs.denote, pow_succ_list, pow_zero_list, List.append_nil, hx_eq, append_assoc, h_ih]
                conv_rhs => rw [hn_eq1, pow_succ_list, append_assoc]
          | cons bw w_tail =>
            cases x_rem with
            | nil =>
              dsimp -failIfUnchanged only at h
              have hw_eq : w = x ++ (bw :: w_tail) := hsp2 rfl
              cases hnx1 : Nat.beq nx 1
              · rw [hnx1] at h
                cases hrem : Runs.remove_word 16 w ((x, nx) :: ys0) with
                | none => rw [hrem] at h; contradiction
                | some zs =>
                  rw [hrem] at h
                  simp only [strictNat_eq, Nat.sub_eq] at h
                  rw [Runs.remove_word_spec hrem, ih h]
                  conv_rhs => rw [hn_eq1, pow_succ_list, append_assoc]
              · rw [hnx1] at h
                have hnx1_eq : nx = 1 := Nat.beq_eq.mp hnx1; subst hnx1_eq
                have hx1 : x ^ (1 : ℕ) = x := by simp [pow_succ_list]
                rcases ys0 with _ | ⟨⟨v, m⟩, ys'⟩
                · contradiction
                · dsimp -failIfUnchanged only at h
                  cases heq : eqL2 v ((bw :: w_tail) ++ x)
                  · rw [heq] at h
                    cases hrem : Runs.remove_word 16 (bw :: w_tail) ((v, m) :: ys') with
                    | none => rw [hrem] at h; contradiction
                    | some zs =>
                      rw [hrem] at h
                      simp only [strictNat_eq, Nat.sub_eq] at h
                      rw [Runs.denote, hx1, Runs.remove_word_spec hrem, ← append_assoc, ← hw_eq, ih h]
                      conv_rhs => rw [hn_eq1, pow_succ_list, append_assoc]
                  · rw [heq] at h
                    have hv_eq : v = (bw :: w_tail) ++ x := eqL2_iff.mp heq
                    have hxveq : x ++ v = w ++ x := by rw [hv_eq, hw_eq, List.append_assoc]
                    have heq1 : x ++ v ^ 1 = w ^ 1 ++ x := by simpa [pow_succ_list] using hxveq
                    cases hble : Nat.ble m n
                    · rw [hble] at h
                      simp only [strictNat_eq, Nat.sub_eq] at h
                      injection h with hys; subst hys
                      have hlt : n < m := ble_false hble
                      have hm_eq : m = n + (m - n) := (Nat.add_sub_of_le (Nat.le_of_lt hlt)).symm
                      have hk_comm := commute_power heq1 n
                      simp only [Nat.mul_one] at hk_comm
                      rw [Runs.denote, Runs.denote, Runs.cons1_spec, Runs.denote, hx1]
                      conv_lhs => rw [hm_eq, qh]
                      rw [append_assoc (v ^ n), ← append_assoc x, hk_comm, append_assoc]
                    · rw [hble] at h
                      have hle : m ≤ n := ble_true hble
                      have hk_comm := commute_power heq1 m
                      simp only [Nat.mul_one] at hk_comm
                      cases hbeq0 : Nat.beq m n
                      · rw [hbeq0] at h
                        cases hbeq1 : Nat.beq (Nat.add m 1) n
                        · rw [hbeq1] at h
                          cases hbeq2 : Nat.beq (Nat.add m 2) n
                          · rw [hbeq2] at h
                            simp only [strictNat_eq, strictRuns_eq, Nat.sub_eq] at h
                            have h_ih := ih h
                            rw [Runs.push_spec, hx1] at h_ih
                            rw [Runs.denote, Runs.denote, hx1, ← append_assoc, hk_comm, append_assoc, h_ih, ← append_assoc, ← qh, Nat.add_sub_of_le hle]
                          · rw [hbeq2] at h
                            have hn_m2 : m + 2 = n := Nat.beq_eq.mp hbeq2; subst hn_m2
                            have hrem := Runs.remove_word_spec h
                            rw [Runs.denote, Runs.denote, hx1, ← append_assoc, hk_comm, append_assoc, hrem]
                            rw [append_assoc (bw :: w_tail) w, ← append_assoc x (bw :: w_tail), ← hw_eq, ← append_assoc (w ^ m) w, pow_shift, ← append_assoc (w ^ (m + 1)) w, pow_shift]
                        · rw [hbeq1] at h
                          have hn_m1 : m + 1 = n := Nat.beq_eq.mp hbeq1; subst hn_m1
                          have hrem := Runs.remove_word_spec h
                          rw [Runs.denote, Runs.denote, hx1, ← append_assoc, hk_comm, append_assoc, hrem]
                          rw [← append_assoc x, ← hw_eq, ← append_assoc (w ^ m), pow_shift]
                      · rw [hbeq0] at h
                        simp only [strictRuns_eq] at h
                        injection h with hys; subst hys
                        have hm_n : m = n := Nat.beq_eq.mp hbeq0; subst hm_n
                        rw [Runs.denote, Runs.denote, Runs.push_spec, hx1, ← append_assoc, hk_comm, append_assoc]
            | cons bx x_tail =>
              dsimp -failIfUnchanged only at h
              contradiction
    · rw [hn] at h
      injection h with hys; subst hys
      have hn0 : n = 0 := Nat.beq_eq.mp hn; subst hn0
      simp

def Runs.zeros : Runs → Bool
  | [] => true
  | (w, _) :: xs =>
    match w.all (fun b => Nat.beq b.1 0) with
    | true => Runs.zeros xs
    | false => false

lemma Runs.zeros_spec {xs : Runs} (h : Runs.zeros xs = true) : Runs.denote xs = default := by
  induction xs with
  | nil => rfl
  | cons wn xs ih =>
    rcases wn with ⟨w, n⟩
    unfold Runs.zeros at h
    cases hw : w.all (fun b => Nat.beq b.1 0)
    · rw [hw] at h; contradiction
    · rw [hw] at h
      have hw' : w.all (fun b => b == 0) = true := by
        rw [List.all_eq_true] at hw ⊢
        intro x hx
        rw [beq_iff_eq]
        exact Fin.ext (Nat.beq_eq.mp (hw x hx))
      rw [Runs.denote, ih h, qaa hw' n]

structure RMConfig where
  left : Runs
  right : Runs
  state : Fin 6
  dir : Dir
deriving DecidableEq

def eqRuns : Runs → Runs → Bool
  | [], [] => true
  | (w1, n1) :: xs, (w2, n2) :: ys =>
    match Nat.beq n1 n2 with
    | true =>
      match eqL2 w1 w2 with
      | true => eqRuns xs ys
      | false => false
    | false => false
  | _, _ => false

lemma eqRuns_iff {xs ys : Runs} : eqRuns xs ys = true ↔ xs = ys := by
  induction xs generalizing ys with
  | nil => cases ys <;> simp [eqRuns]
  | cons x xs ih =>
    rcases x with ⟨w1, n1⟩
    cases ys with
    | nil => simp [eqRuns]
    | cons y ys =>
      rcases y with ⟨w2, n2⟩
      unfold eqRuns
      cases hn : Nat.beq n1 n2
      · have hne : n1 ≠ n2 := by
          intro heq; subst heq; have htrue : Nat.beq n1 n1 = true := Nat.beq_eq.mpr rfl; rw [htrue] at hn; contradiction
        simp [hne]
      · have heq_n : n1 = n2 := Nat.beq_eq.mp hn
        subst heq_n
        cases hw : eqL2 w1 w2
        · have hne_w : w1 ≠ w2 := by
            intro heq; subst heq; have htrue : eqL2 w1 w1 = true := eqL2_iff.mpr rfl; rw [htrue] at hw; contradiction
          simp [hne_w]
        · have heq_w : w1 = w2 := eqL2_iff.mp hw
          subst heq_w
          simp [ih]

@[inline] def eqDir : Dir → Dir → Bool
  | .left, .left => true
  | .right, .right => true
  | _, _ => false

lemma eqDir_iff {d1 d2 : Dir} : eqDir d1 d2 = true ↔ d1 = d2 := by
  cases d1 <;> cases d2 <;> simp [eqDir]

def eqOptCfg (o : Option RMConfig) (c : RMConfig) : Bool :=
  match o with
  | none => false
  | some ⟨l1, r1, q1, d1⟩ =>
    match Nat.beq q1.1 c.state.1 with
    | true =>
      match eqDir d1 c.dir with
      | true =>
        match eqRuns l1 c.left with
        | true => eqRuns r1 c.right
        | false => false
      | false => false
    | false => false

lemma eqOptCfg_spec {o : Option RMConfig} {c : RMConfig} (h : eqOptCfg o c = true) :
    o = some c := by
  rcases o with _ | ⟨l1, r1, q1, d1⟩
  · contradiction
  · rcases c with ⟨l2, r2, q2, d2⟩
    unfold eqOptCfg at h
    dsimp -failIfUnchanged only at h
    cases hq : Nat.beq q1.1 q2.1
    · rw [hq] at h; contradiction
    · rw [hq] at h
      cases hd : eqDir d1 d2
      · rw [hd] at h; contradiction
      · rw [hd] at h
        cases hl : eqRuns l1 l2
        · rw [hl] at h; contradiction
        · rw [hl] at h
          have hq_eq : q1 = q2 := Fin.ext (Nat.beq_eq.mp hq)
          have hd_eq : d1 = d2 := eqDir_iff.mp hd
          have hl_eq : l1 = l2 := eqRuns_iff.mp hl
          have hr_eq : r1 = r2 := eqRuns_iff.mp h
          subst hq_eq hd_eq hl_eq hr_eq
          rfl

def RMConfig.denote (c : RMConfig) : Cfg (Fin 2) (Fin 6) :=
  match c.dir with
  | .left => Runs.denote c.left <{{c.state}} Runs.denote c.right
  | .right => Runs.denote c.left {{c.state}}> Runs.denote c.right

def qk (d : Dir) (c : RMConfig) : RMConfig :=
  match d, c.dir with
  | .left, .right =>
    match Runs.pop c.right with
    | (b, r') =>
      q9 (Runs.push [b] 1 c.left) (fun l' =>
        ⟨l', r', c.state, .left⟩)
  | .right, .left =>
    match Runs.pop c.left with
    | (b, l') =>
      q9 (Runs.push [b] 1 c.right) (fun r' =>
        ⟨l', r', c.state, .right⟩)
  | _, _ => c

lemma qR (d : Dir) (c : RMConfig) : (qk d c).denote = c.denote := by
  rcases c with ⟨l, r, q, cd⟩
  cases d <;> cases cd <;> try rfl
  · unfold qk RMConfig.denote
    simp only [strictRuns_eq]
    rw [Runs.push_spec, Runs.pop_spec r]
    simp only [pow_succ_list, pow_zero_list, List.append_nil, append_cons, append_nil,
               Turing.ListBlank.head_cons, Turing.ListBlank.tail_cons]
  · unfold qk RMConfig.denote
    simp only [strictRuns_eq]
    rw [Runs.push_spec, Runs.pop_spec l]
    simp only [pow_succ_list, pow_zero_list, List.append_nil, append_cons, append_nil,
               Turing.ListBlank.head_cons, Turing.ListBlank.tail_cons]

lemma qa3 (d : Dir) (c : RMConfig) : (qk d c).dir = d := by
  rcases c with ⟨l, r, q, cd⟩
  cases d <;> cases cd <;> simp [qk]

lemma qG (d : Dir) (c : RMConfig) : (qk d c).state = c.state := by
  rcases c with ⟨l, r, q, cd⟩
  cases d <;> cases cd <;> simp [qk]

structure Scan where
  q : Fin 6
  dir : Dir
  scan_in : List (Fin 2)
  scan_out : List (Fin 2)
  context : List (Fin 2)

def qc (tm : Machine (Fin 2) (Fin 6)) (s : Scan) : Prop :=
  ∀ (n : ℕ) (l r : ListBlank (Fin 2)),
    match s.dir with
    | .right =>
      ((s.context +> l) {{s.q}}> ((s.scan_in ^ n) +> r)) [tm]⊢*
      ((s.context +> (s.scan_out ^ n) +> l) {{s.q}}> r)
    | .left =>
      (((s.scan_in ^ n) +> l) <{{s.q}} (s.context +> r)) [tm]⊢*
      (l <{{s.q}} (s.context +> (s.scan_out ^ n) +> r))

lemma qt {tm : Machine (Fin 2) (Fin 6)} {s : Scan} (hd : s.dir = .right)
    (hbase : ∀ l r, ((s.context +> l) {{s.q}}> (s.scan_in +> r)) [tm]⊢*
                    ((s.context +> s.scan_out +> l) {{s.q}}> r)) :
    qc tm s := by
  unfold qc
  intro n l r
  rw [hd]
  dsimp -failIfUnchanged only
  induction n generalizing l r with
  | zero => exact ⟨0, rfl⟩
  | succ n ih =>
    rw [pow_succ_list, append_assoc]
    have h1 := hbase l ((s.scan_in ^ n) +> r)
    have h2 := ih (s.scan_out +> l) r
    rw [← append_assoc (s.scan_out ^ n) s.scan_out l, pow_shift] at h2
    exact q1 h1 h2

lemma qe {tm : Machine (Fin 2) (Fin 6)} {s : Scan} (hd : s.dir = .left)
    (hbase : ∀ l r, ((s.scan_in +> l) <{{s.q}} (s.context +> r)) [tm]⊢*
                    (l <{{s.q}} (s.context +> s.scan_out +> r))) :
    qc tm s := by
  unfold qc
  intro n l r
  rw [hd]
  dsimp -failIfUnchanged only
  induction n generalizing l r with
  | zero => exact ⟨0, rfl⟩
  | succ n ih =>
    rw [pow_succ_list, append_assoc]
    have h1 := hbase ((s.scan_in ^ n) +> l) r
    have h2 := ih l (s.scan_out +> r)
    rw [← append_assoc (s.scan_out ^ n) s.scan_out r, pow_shift] at h2
    exact q1 h1 h2

def ql := Runs.remove_fast 16

def qA (s : Scan) (n : ℕ) (l r : Runs) : Option (Runs × Runs) :=
  match s.dir with
  | .left =>
    match Runs.remove_word 16 s.context r, ql s.scan_in n l with
    | some r', some l' =>
      q9 (Runs.push s.scan_out n r') (fun r1 =>
        match s.context with
        | [] => some (l', r1)
        | c0 :: cs => some (l', Runs.cons1 (c0 :: cs) r1))
    | _, _ => none
  | .right =>
    match Runs.remove_word 16 s.context l, ql s.scan_in n r with
    | some l', some r' =>
      q9 (Runs.push s.scan_out n l') (fun l1 =>
        match s.context with
        | [] => some (l1, r')
        | c0 :: cs => some (Runs.cons1 (c0 :: cs) l1, r'))
    | _, _ => none

lemma qab {tm : Machine (Fin 2) (Fin 6)} {s : Scan} {n : ℕ} {l r l' r' : Runs}
    (hv : qc tm s) (h : qA s n l r = some (l', r')) :
    (RMConfig.denote ⟨l, r, s.q, s.dir⟩) [tm]⊢* (RMConfig.denote ⟨l', r', s.q, s.dir⟩) := by
  unfold qc at hv
  rcases s with ⟨q, d, sin, sout, ctx⟩
  have hv_n := hv n
  unfold qA ql at h
  cases d
  · dsimp -failIfUnchanged only at h hv_n
    cases hr : Runs.remove_word 16 ctx r with
    | none => rw [hr] at h; contradiction
    | some r0 =>
      rw [hr] at h
      cases hl : Runs.remove_fast 16 sin n l with
      | none => rw [hl] at h; contradiction
      | some l0 =>
        rw [hl] at h
        simp only [strictRuns_eq] at h
        cases ctx with
        | nil =>
          injection h with hpair; injection hpair with hl' hr'; subst hl' hr'
          unfold RMConfig.denote; dsimp -failIfUnchanged only
          rw [Runs.push_spec, Runs.remove_word_spec hr, Runs.remove_fast_spec hl, append_nil]
          simpa only [append_nil] using hv_n (Runs.denote l0) (Runs.denote r0)
        | cons c0 cs =>
          injection h with hpair; injection hpair with hl' hr'; subst hl' hr'
          unfold RMConfig.denote; dsimp -failIfUnchanged only
          rw [Runs.cons1_spec, Runs.push_spec, Runs.remove_word_spec hr, Runs.remove_fast_spec hl]
          exact hv_n (Runs.denote l0) (Runs.denote r0)
  · dsimp -failIfUnchanged only at h hv_n
    cases hl : Runs.remove_word 16 ctx l with
    | none => rw [hl] at h; contradiction
    | some l0 =>
      rw [hl] at h
      cases hr : Runs.remove_fast 16 sin n r with
      | none => rw [hr] at h; contradiction
      | some r0 =>
        rw [hr] at h
        simp only [strictRuns_eq] at h
        cases ctx with
        | nil =>
          injection h with hpair; injection hpair with hl' hr'; subst hl' hr'
          unfold RMConfig.denote; dsimp -failIfUnchanged only
          rw [Runs.push_spec, Runs.remove_word_spec hl, Runs.remove_fast_spec hr, append_nil]
          simpa only [append_nil] using hv_n (Runs.denote l0) (Runs.denote r0)
        | cons c0 cs =>
          injection h with hpair; injection hpair with hl' hr'; subst hl' hr'
          unfold RMConfig.denote; dsimp -failIfUnchanged only
          rw [Runs.cons1_spec, Runs.push_spec, Runs.remove_word_spec hl, Runs.remove_fast_spec hr]
          exact hv_n (Runs.denote l0) (Runs.denote r0)

def use_scan (s : Scan) (n : ℕ) (c : RMConfig) : Option RMConfig :=
  match Nat.beq c.state.1 s.q.1 with
  | true =>
    match qk s.dir c with
    | ⟨zl, zr, _, _⟩ =>
      match qA s n zl zr with
      | some (l, r) => some ⟨l, r, s.q, s.dir⟩
      | none => none
  | false => none

lemma use_scan_spec {tm : Machine (Fin 2) (Fin 6)} {s : Scan} {n : ℕ} {c c' : RMConfig}
    (hv : qc tm s) (h : use_scan s n c = some c') :
    (c.denote) [tm]⊢* (c'.denote) := by
  unfold use_scan at h
  cases hq : Nat.beq c.state.1 s.q.1
  · rw [hq] at h; contradiction
  · rw [hq] at h
    have hq_eq : c.state = s.q := Fin.ext (Nat.beq_eq.mp hq)
    rw [← qR s.dir c]
    have hd_z : (qk s.dir c).dir = s.dir := qa3 s.dir c
    have hq_z : (qk s.dir c).state = s.q := by rw [qG, hq_eq]
    rcases hz : qk s.dir c with ⟨l, r, qz, dz⟩
    rw [hz] at hd_z hq_z h
    dsimp -failIfUnchanged only at hd_z hq_z h
    subst hd_z hq_z
    cases hs : qA s n l r with
    | none => rw [hs] at h; contradiction
    | some lr =>
      rcases lr with ⟨l', r'⟩
      rw [hs] at h
      injection h with hc'; subst hc'
      exact qab hv hs

def Runs.remove_one (w : List (Fin 2)) (xs : Runs) : Option Runs :=
  match xs with
  | (v, 1) :: ys =>
    match eqL2 w v with
    | true => some ys
    | false => Runs.remove_word 16 w xs
  | _ => Runs.remove_word 16 w xs

lemma Runs.remove_one_spec {w : List (Fin 2)} {xs ys : Runs}
    (h : Runs.remove_one w xs = some ys) :
    Runs.denote xs = w +> Runs.denote ys := by
  unfold Runs.remove_one at h
  rcases xs with _ | ⟨⟨v, _ | _ | m⟩, rest⟩
  · exact Runs.remove_word_spec h
  · exact Runs.remove_word_spec h
  · simp only [Nat.zero_add] at h ⊢
    cases hwv : eqL2 w v
    · simp only [hwv] at h
      exact Runs.remove_word_spec h
    · simp only [hwv] at h
      injection h with hys; subst hys
      have hwv_eq : w = v := eqL2_iff.mp hwv
      subst hwv_eq
      simp [Runs.denote, pow_succ_list]
  · exact Runs.remove_word_spec h

def Runs.remove_exact (w : List (Fin 2)) (n : ℕ) (xs : Runs) : Option Runs :=
  match Nat.beq n 0 with
  | true => some xs
  | false =>
    match xs with
    | (v, m) :: ys =>
      match eqL2 w v with
      | true =>
        match Nat.ble m n with
        | false =>
          q6 (Nat.sub m n) (fun m' => some ((v, m') :: ys))
        | true =>
          match Nat.beq n m with
          | true => some ys
          | false => q6 (Nat.sub n m) (fun n' => Runs.remove_fast 16 w n' ys)
      | false =>
        match Nat.beq n 1 with
        | true => Runs.remove_word 16 w ((v, m) :: ys)
        | false => Runs.remove_fast 16 w n ((v, m) :: ys)
    | [] => none

lemma Runs.remove_exact_spec {w : List (Fin 2)} {n : ℕ} {xs ys : Runs}
    (h : Runs.remove_exact w n xs = some ys) :
    Runs.denote xs = (w ^ n) +> Runs.denote ys := by
  unfold Runs.remove_exact at h
  cases hn0 : Nat.beq n 0
  · rw [hn0] at h
    rcases xs with _ | ⟨⟨v, m⟩, rest⟩
    · contradiction
    · dsimp -failIfUnchanged only at h
      cases hwv : eqL2 w v
      · rw [hwv] at h
        cases hn1 : Nat.beq n 1
        · rw [hn1] at h
          exact Runs.remove_fast_spec h
        · rw [hn1] at h
          have hn1_eq : n = 1 := Nat.beq_eq.mp hn1; subst hn1_eq
          simpa [pow_succ_list] using Runs.remove_word_spec h
      · rw [hwv] at h
        have hwv_eq : w = v := eqL2_iff.mp hwv; subst hwv_eq
        cases hble : Nat.ble m n
        · rw [hble] at h
          simp only [strictNat_eq, Nat.sub_eq] at h
          injection h with hys; subst hys
          have hlt : n < m := ble_false hble
          have hm_eq : m = n + (m - n) := (Nat.add_sub_of_le (Nat.le_of_lt hlt)).symm
          rw [Runs.denote, Runs.denote]
          conv_lhs => rw [hm_eq, qh, append_assoc]
        · rw [hble] at h
          have hle : m ≤ n := ble_true hble
          cases hnm : Nat.beq n m
          · rw [hnm] at h
            simp only [strictNat_eq, Nat.sub_eq] at h
            rw [Runs.denote, Runs.remove_fast_spec h, ← append_assoc, ← qh, Nat.add_sub_of_le hle]
          · rw [hnm] at h
            injection h with hys; subst hys
            have hnm_eq : n = m := Nat.beq_eq.mp hnm; subst hnm_eq
            rfl
  · rw [hn0] at h
    injection h with hys; subst hys
    have hn : n = 0 := Nat.beq_eq.mp hn0; subst hn
    simp

def qm : qK → Runs → Option Runs
  | [], r => some r
  | (p, n) :: xs, r =>
    match Runs.remove_one (q0 p) r with
    | none => none
    | some r1 =>
      match Runs.remove_exact W n r1 with
      | none => none
      | some r2 => qm xs r2

lemma qa1 {xs : qK} {r r' : Runs}
    (h : qm xs r = some r') :
    Runs.denote r = (qg xs) +> Runs.denote r' := by
  induction xs generalizing r with
  | nil =>
    unfold qm at h
    injection h with hr'; subst hr'; rfl
  | cons pn xs ih =>
    rcases pn with ⟨p, n⟩
    unfold qm at h
    cases hr1 : Runs.remove_one (q0 p) r with
    | none => rw [hr1] at h; contradiction
    | some r1 =>
      rw [hr1] at h
      dsimp -failIfUnchanged only at h
      cases hr2 : Runs.remove_exact W n r1 with
      | none => rw [hr2] at h; contradiction
      | some r2 =>
        rw [hr2] at h
        dsimp -failIfUnchanged only at h
        rw [Runs.remove_one_spec hr1, Runs.remove_exact_spec hr2, ih h, qg, append_assoc, append_assoc]

def qL : qK → Runs → Runs
  | [], r => r
  | (p, n) :: xs, r =>
    q9 (qL xs r) (fun r1 =>
      match Nat.beq n 0 with
      | true => Runs.push (q0 p) 1 r1
      | false =>
        q9 (Runs.push W n r1) (fun r2 =>
          Runs.cons1 (q0 p) r2))

lemma qaf (xs : qK) (r : Runs) :
    Runs.denote (qL xs r) = (qg xs) +> Runs.denote r := by
  induction xs with
  | nil => rfl
  | cons pn xs ih =>
    rcases pn with ⟨p, n⟩
    unfold qL qg
    simp only [strictRuns_eq]
    cases hn : Nat.beq n 0
    · simp only [strictRuns_eq, Runs.cons1_spec, Runs.push_spec, ih, append_assoc]
    · have hn0 : n = 0 := Nat.beq_eq.mp hn; subst hn0
      have hw1 : (q0 p) ^ (1 : ℕ) = q0 p := by simp [pow_succ_list]
      simp only [Runs.push_spec, ih, hw1, pow_zero_list, List.append_nil, append_assoc]

def qah (c : Cfg (Fin 2) (Fin 6)) : Cfg (Fin 2) (Fin 6) :=
  ⟨c.q,⟨c.tape.1,c.tape.right,c.tape.left⟩⟩
lemma qa6 (c : Cfg (Fin 2) (Fin 6)) :
    step target_tm_alias (qah c)=(step qi c).map qah:= by
  rcases c with ⟨_ | ⟨q,hq⟩,⟨⟨b,hb⟩,l,r⟩⟩
  · rfl
  · rcases q with _ | _ | _ | _ | _ | _ | q <;> try omega
    all_goals (rcases b with _ | _ | b <;> first | omega | rfl)
lemma qa4 (c : Cfg (Fin 2) (Fin 6)) (n : ℕ) :
    multiStep target_tm_alias (qah c) n=(multiStep qi c n).map qah:= by
  induction n with
  | zero => rfl
  | succ n ih =>
    rw [multiStep_succ,multiStep_succ,ih]
    cases multiStep qi c n with
    | none => rfl
    | some c' => simp [qa6]
lemma qI (h : IsDoesNotHalt qi) : IsDoesNotHalt target_tm_alias:= by
  intro cfg ⟨n,hn⟩
  have hinit : qah (init [])=init []:=rfl
  rw [← hinit,qa4] at hn
  cases hms : multiStep qi (init []) n with
  | none => rw [hms] at hn; contradiction
  | some c0 =>
    rw [hms] at hn
    injection hn with hcfg
    subst hcfg
    rw [qa6]
    cases hstep : step qi c0 with
    | none =>
      have hsome:=h c0 ⟨n,hms⟩
      rw [hstep] at hsome
      contradiction
    | some _ => rfl
abbrev cfg_of := @Counter.cfg_of (Fin 2) (Fin 6)
abbrev LocalState := Counter.LocalState (Fin 2) (Fin 6)
abbrev step_local := @Counter.step_local (Fin 2) (Fin 6)
abbrev step_local_spec := @Counter.step_local_spec (Fin 2) (Fin 6) _ _
abbrev run_local := @Counter.run_local (Fin 2) (Fin 6)
abbrev run_local_spec := @Counter.run_local_spec (Fin 2) (Fin 6) _ _
lemma run_local_plus_spec {tm : Machine (Fin 2) (Fin 6)} {n : ℕ} {s1 s2 : LocalState}
    (h : run_local tm (n + 1) s1 = some s2) (L R : ListBlank (Fin 2)) :
    (cfg_of s1.q s1.d (s1.l +> L) (s1.r +> R)) [tm]⊢⁺
    (cfg_of s2.q s2.d (s2.l +> L) (s2.r +> R)) :=
  Counter.run_local_plus_eq L R h rfl rfl
lemma qb_local {n : ℕ} {w1 w2 : List (Fin 2)}
    (h : run_local qi n ⟨H_L, w1, D, .right⟩ = some ⟨[], H_R ++ w2, A, .left⟩) :
    q4 qi 1 0 w1 w2 := by
  apply qb
  intro l r
  simpa only [cfg_of, Counter.cfg_of, append_assoc, append_nil] using run_local_spec h l r
lemma qq_local {nR nL : ℕ} {w1 w_mid w2 : List (Fin 2)}
    (hR : run_local qi nR ⟨H_L, w1, D, .right⟩ = some ⟨H_L ++ w_mid, [], D, .right⟩)
    (hL : run_local qi nL ⟨w_mid, H_R, A, .left⟩ = some ⟨[], H_R ++ w2, A, .left⟩) :
    q4 qi 1 1 w1 w2 := by
  apply qq (w_mid := w_mid)
  · intro l r
    simpa only [cfg_of, Counter.cfg_of, append_assoc, append_nil] using run_local_spec hR l r
  · intro l r
    simpa only [cfg_of, Counter.cfg_of, append_assoc, append_nil] using run_local_spec hL l r
