def eqL2 : List (Fin 2) → List (Fin 2) → Bool
  | [], [] => true
  | a :: as, b :: bs =>
    match Nat.beq a.1 b.1 with
    | true => eqL2 as bs
    | false => false
  | _, _ => false

lemma eqL2_iff {u v : List (Fin 2)} : eqL2 u v = true ↔ u = v := by
  induction u generalizing v with
  | nil => cases v <;> simp [eqL2]
  | cons a as ih =>
    cases v with
    | nil => simp [eqL2]
    | cons b bs =>
      unfold eqL2
      cases h : Nat.beq a.1 b.1
      · have hne : a ≠ b := by
          intro heq; subst heq; have htrue : Nat.beq a.1 a.1 = true := Nat.beq_eq.mpr rfl; rw [htrue] at h; contradiction
        simp [hne]
      · have heq : a = b := Fin.ext (Nat.beq_eq.mp h)
        subst heq
        simp [ih]

def strip_prefix : List (Fin 2) → List (Fin 2) → Option (List (Fin 2) × List (Fin 2))
  | [], v => some ([], v)
  | w, [] => some (w, [])
  | b1 :: w', b2 :: v' =>
    match Nat.beq b1.1 b2.1 with
    | true => strip_prefix w' v'
    | false => none

lemma strip_prefix_spec {w v w_rem v_rem : List (Fin 2)}
    (h : strip_prefix w v = some (w_rem, v_rem)) :
    (w_rem = [] → v = w ++ v_rem) ∧ (v_rem = [] → w = v ++ w_rem) := by
  induction w generalizing v with
  | nil =>
    unfold strip_prefix at h
    injection h with hp; injection hp with hw hv
    subst hw hv
    refine ⟨fun _ => rfl, fun hv0 => ?_⟩
    subst hv0; rfl
  | cons b1 w' ih =>
    cases v with
    | nil =>
      unfold strip_prefix at h
      injection h with hp; injection hp with hw hv
      subst hw hv
      refine ⟨fun hw0 => by contradiction, fun _ => rfl⟩
    | cons b2 v' =>
      unfold strip_prefix at h
      cases hb : Nat.beq b1.1 b2.1
      · rw [hb] at h; contradiction
      · rw [hb] at h
        have hb_eq : b1 = b2 := Fin.ext (Nat.beq_eq.mp hb)
        subst hb_eq
        rcases ih h with ⟨ih1, ih2⟩
        refine ⟨fun hw0 => congrArg (b1 :: ·) (ih1 hw0), fun hv0 => congrArg (b1 :: ·) (ih2 hv0)⟩

