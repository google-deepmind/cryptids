lemma sideCalls_add {tm : Machine (Fin 2) (Fin 6)} {t u : ℕ} {r1 r2 r3 : ListBlank (Fin 2)}
    (h₁ : qj tm t r1 r2) (h₂ : qj tm u r2 r3) :
    qj tm (t + u) r1 r3:= by
  induction t generalizing r1 with
  | zero =>
    rw [Nat.zero_add]
    change r1=r2 at h₁
    subst h₁
    exact h₂
  | succ t ih =>
    rcases h₁ with ⟨rm,hstep,hrest⟩
    rw [Nat.succ_add]
    exact ⟨rm,hstep,ih hrest⟩
lemma qae {tm : Machine (Fin 2) (Fin 6)} {t u : ℕ} {r1 r3 : ListBlank (Fin 2)}
    (h : qj tm (t + u) r1 r3) :
    ∃ r2,qj tm t r1 r2 ∧ qj tm u r2 r3:= by
  induction t generalizing r1 with
  | zero =>
    rw [Nat.zero_add] at h
    exact ⟨r1,rfl,h⟩
  | succ t ih =>
    rw [Nat.succ_add] at h
    rcases h with ⟨rm,hstep,hrest⟩
    rcases ih hrest with ⟨r2,h₁,h₂⟩
    exact ⟨r2,⟨rm,hstep,h₁⟩,h₂⟩
