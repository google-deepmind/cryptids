  | s0 | s1 | s2 | s3 | s4 | s5 | s6 | s7 | s8 | s9 | s10 | s11 | s12 | s13 | s14
def exec_scan (s : ScanId) (n : ℕ) (c : RMConfig) : Option RMConfig :=
  match s with
  | .s0 => use_scan scan_0 n c
  | .s1 => use_scan scan_1 n c
  | .s2 => use_scan scan_2 n c
  | .s3 => use_scan scan_3 n c
  | .s4 => use_scan scan_4 n c
  | .s5 => use_scan scan_5 n c
  | .s6 => use_scan scan_6 n c
  | .s7 => use_scan scan_7 n c
  | .s8 => use_scan scan_8 n c
  | .s9 => use_scan scan_9 n c
  | .s10 => use_scan scan_10 n c
  | .s11 => use_scan scan_11 n c
  | .s12 => use_scan scan_12 n c
  | .s13 => use_scan scan_13 n c
  | .s14 => use_scan scan_14 n c
lemma exec_scan_spec {s : ScanId} {n : ℕ} {c c' : RMConfig}
    (h : exec_scan s n c = some c') :
    (c.denote) [qi]⊢* (c'.denote) := by
  cases s
  · exact use_scan_spec scan_0_valid h
  · exact use_scan_spec scan_1_valid h
  · exact use_scan_spec scan_2_valid h
  · exact use_scan_spec scan_3_valid h
  · exact use_scan_spec scan_4_valid h
  · exact use_scan_spec scan_5_valid h
  · exact use_scan_spec scan_6_valid h
  · exact use_scan_spec scan_7_valid h
  · exact use_scan_spec scan_8_valid h
  · exact use_scan_spec scan_9_valid h
  · exact use_scan_spec scan_10_valid h
  · exact use_scan_spec scan_11_valid h
  · exact use_scan_spec scan_12_valid h
  · exact use_scan_spec scan_13_valid h
  · exact use_scan_spec scan_14_valid h
def exec_scan2 (s1 s2 : ScanId) : List (ℕ × ℕ) → RMConfig → Option RMConfig
  | [], c => some c
  | (n1, n2) :: rest, c =>
    match exec_scan s1 n1 c with
    | some c1 =>
      match exec_scan s2 n2 c1 with
      | some c2 => exec_scan2 s1 s2 rest c2
      | none => none
    | none => none
lemma exec_scan2_spec {s1 s2 : ScanId} {ns : List (ℕ × ℕ)} {c c' : RMConfig}
    (h : exec_scan2 s1 s2 ns c = some c') :
    (c.denote) [qi]⊢* (c'.denote) := by
  induction ns generalizing c with
  | nil =>
    injection h with heq; subst heq; exact ⟨0, rfl⟩
  | cons p rest ih =>
    rcases p with ⟨n1, n2⟩
    unfold exec_scan2 at h
    cases ho1 : exec_scan s1 n1 c with
    | none => rw [ho1] at h; contradiction
    | some c1 =>
      rw [ho1] at h; dsimp -failIfUnchanged only at h
      cases ho2 : exec_scan s2 n2 c1 with
      | none => rw [ho2] at h; contradiction
      | some c2 =>
        rw [ho2] at h; dsimp -failIfUnchanged only at h
        exact q1 (exec_scan_spec ho1) (q1 (exec_scan_spec ho2) (ih h))
def exec_mac_scan : List (MacroId × ScanId × ℕ) → RMConfig → Option RMConfig
  | [], c => some c
  | (m, s, n) :: rest, c =>
    match exec_macro m c with
    | some c1 =>
      match exec_scan s n c1 with
      | some c2 => exec_mac_scan rest c2
      | none => none
    | none => none
lemma exec_mac_scan_spec {ms : List (MacroId × ScanId × ℕ)} {c c' : RMConfig}
    (h : exec_mac_scan ms c = some c') :
    (c.denote) [qi]⊢* (c'.denote) := by
  induction ms generalizing c with
  | nil =>
    injection h with heq; subst heq; exact ⟨0, rfl⟩
  | cons p rest ih =>
    rcases p with ⟨m, s, n⟩
    unfold exec_mac_scan at h
    cases ho1 : exec_macro m c with
    | none => rw [ho1] at h; contradiction
    | some c1 =>
      rw [ho1] at h; dsimp -failIfUnchanged only at h
      cases ho2 : exec_scan s n c1 with
      | none => rw [ho2] at h; contradiction
      | some c2 =>
        rw [ho2] at h; dsimp -failIfUnchanged only at h
        exact q1 (exec_macro_spec ho1) (q1 (exec_scan_spec ho2) (ih h))
def exec_mac_scan2 (s1 s2 : ScanId) : List (MacroId × ℕ × ℕ) → RMConfig → Option RMConfig
  | [], c => some c
  | (m, n1, n2) :: rest, c =>
    match exec_macro m c with
    | some c1 =>
      match exec_scan s1 n1 c1 with
      | some c2 =>
        match exec_scan s2 n2 c2 with
        | some c3 => exec_mac_scan2 s1 s2 rest c3
        | none => none
      | none => none
    | none => none
lemma exec_mac_scan2_spec {s1 s2 : ScanId} {ns : List (MacroId × ℕ × ℕ)} {c c' : RMConfig}
    (h : exec_mac_scan2 s1 s2 ns c = some c') :
    (c.denote) [qi]⊢* (c'.denote) := by
  induction ns generalizing c with
  | nil =>
    injection h with heq; subst heq; exact ⟨0, rfl⟩
  | cons p rest ih =>
    rcases p with ⟨m, n1, n2⟩
    unfold exec_mac_scan2 at h
    cases ho1 : exec_macro m c with
    | none => rw [ho1] at h; contradiction
    | some c1 =>
      rw [ho1] at h; dsimp -failIfUnchanged only at h
      cases ho2 : exec_scan s1 n1 c1 with
      | none => rw [ho2] at h; contradiction
      | some c2 =>
        rw [ho2] at h; dsimp -failIfUnchanged only at h
        cases ho3 : exec_scan s2 n2 c2 with
        | none => rw [ho3] at h; contradiction
        | some c3 =>
          rw [ho3] at h; dsimp -failIfUnchanged only at h
          exact q1 (exec_macro_spec ho1) (q1 (exec_scan_spec ho2) (q1 (exec_scan_spec ho3) (ih h)))
inductive Cmd where
  | m (m : MacroId)
  | b (k : ℕ) (txs : List (List (List ℕ × qK)))
  | s (s : ScanId) (n : ℕ)
  | s2 (s1 s2 : ScanId) (ns : List (ℕ × ℕ))
  | ms (ms : List (MacroId × ScanId × ℕ))
  | ms2 (s1 s2 : ScanId) (ns : List (MacroId × ℕ × ℕ))
def exec_cmd (cmd : Cmd) (c : RMConfig) : Option RMConfig :=
  match cmd with
  | .m m => exec_macro m c
  | .b k txs => qC_many k txs c
  | .s s n => exec_scan s n c
  | .s2 s1 s2 ns => exec_scan2 s1 s2 ns c
  | .ms ms => exec_mac_scan ms c
  | .ms2 s1 s2 ns => exec_mac_scan2 s1 s2 ns c
lemma exec_cmd_spec {cmd : Cmd} {c c' : RMConfig}
    (h : exec_cmd cmd c = some c') :
    (c.denote) [qi]⊢* (c'.denote) := by
  cases cmd with
  | m m => exact exec_macro_spec h
  | b k txs => exact qP_many h
  | s s n => exact exec_scan_spec h
  | s2 s1 s2 ns => exact exec_scan2_spec h
  | ms ms => exact exec_mac_scan_spec h
  | ms2 s1 s2 ns => exact exec_mac_scan2_spec h
def q7 : List Cmd → RMConfig → Option RMConfig
  | [], c => some c
  | cmd :: rest, c =>
    match exec_cmd cmd c with
    | some c' => q7 rest c'
    | none => none
lemma q2 {cs : List Cmd} {c c' : RMConfig}
    (h : q7 cs c = some c') :
    (c.denote) [qi]⊢* (c'.denote) := by
  induction cs generalizing c with
  | nil =>
    injection h with heq; subst heq; exact ⟨0, rfl⟩
  | cons cmd rest ih =>
    unfold q7 at h
    cases hc : exec_cmd cmd c with
    | none => rw [hc] at h; contradiction
    | some c₁ =>
      rw [hc] at h
      exact q1 (exec_cmd_spec hc) (ih h)

def qa8 (l : ListBlank (Fin 2)) : Cfg (Fin 2) (Fin 6) :=
  (([O,O,I,O] +> l) <{{A}} ([I,O,I,I,O,I,I,I,I,I,O,I,I,I,I,I,I,O] +> default))
lemma qag (l : ListBlank (Fin 2)) :
    (qa8 l) [qi]⊢⁺ (qa8 (I >> l)):= by
  have h := run_local_plus_spec (tm := qi) (n := 124)
    (s1 := ⟨[O,O,I,O], [I,O,I,I,O,I,I,I,I,I,O,I,I,I,I,I,I,O,O], A, .left⟩)
    (s2 := ⟨[O,O,I,O,I], [I,O,I,I,O,I,I,I,I,I,O,I,I,I,I,I,I,O], A, .left⟩)
    (by decide +kernel) l default
  simpa only [qa8, cfg_of, Counter.cfg_of, append_cons, append_nil, O_cons_default] using h

def qJ (c : RMConfig) : Bool :=
  match Nat.beq c.state.1 0 with
  | true =>
    match qk .left c with
    | ⟨zl, zr, _, _⟩ =>
      match Runs.remove_word 16 [O,O,I,O] zl,
            Runs.remove_word 16 [I,O,I,I,O,I,I,I,I,I,O,I,I,I,I,I,I,O] zr with
      | some _, some r0 => Runs.zeros r0
      | _, _ => false
  | false => false

lemma qa5 {c : RMConfig} (h : qJ c = true) :
    ∃ l, c.denote = qa8 l := by
  unfold qJ at h
  cases hq : Nat.beq c.state.1 0
  · rw [hq] at h; contradiction
  · rw [hq] at h
    have hq_eq : c.state = A := Fin.ext (Nat.beq_eq.mp hq)
    rw [← qR .left c]
    have hd_z : (qk .left c).dir = .left := qa3 .left c
    have hq_z : (qk .left c).state = A := by rw [qG, hq_eq]
    rcases hz : qk .left c with ⟨l, r, qz, dz⟩
    rw [hz] at hd_z hq_z h
    dsimp -failIfUnchanged only at hd_z hq_z h
    subst hd_z hq_z
    cases hl : Runs.remove_word 16 [O,O,I,O] l with
    | none => rw [hl] at h; contradiction
    | some l0 =>
      rw [hl] at h
      cases hr : Runs.remove_word 16 [I,O,I,I,O,I,I,I,I,I,O,I,I,I,I,I,I,O] r with
      | none => rw [hr] at h; contradiction
      | some r0 =>
        rw [hr] at h
        refine ⟨Runs.denote l0, ?_⟩
        unfold RMConfig.denote qa8
        dsimp -failIfUnchanged only
        rw [Runs.remove_word_spec hl, Runs.remove_word_spec hr, Runs.zeros_spec h]

lemma step_chunk {c c' : RMConfig} (cs : List Cmd) (h : eqOptCfg (q7 cs c) c' = true) :
    (c.denote) [qi]⊢* (c'.denote) :=
  q2 (eqOptCfg_spec h)

lemma qn {M : Machine Γ Λ} {c₁ c₂ : Cfg Γ Λ}
    (h : c₁ [M]⊢⁺ c₂) : (step M c₁).isSome:= by
  rcases h with ⟨n,hn,hms⟩
  cases n with
  | zero => omega
  | succ n =>
    rw [Nat.add_comm n 1,qC,multiStep_one] at hms
    cases hstep : step M c₁ with
    | none => rw [hstep] at hms; simp at hms
    | some c' => rfl
lemma qT (M : Machine Γ Λ) (c : Cfg Γ Λ) (n : Nat) :
    multiStep M c (n + 1)=(step M c).bind (fun c' => multiStep M c' n):= by
  rw [Nat.add_comm n 1,qC,multiStep_one]
lemma qu {M : Machine Γ Λ} {c0 c₁ c : Cfg Γ Λ}
    {n m : Nat} (h1 : c0 [M]⊢^{n} c₁) (h2 : c0 [M]⊢^{m} c) :
    (m ≤ n ∧ c [M]⊢^{n - m} c₁) ∨ (n < m ∧ c₁ [M]⊢^{m - n} c):= by
  induction n generalizing c0 m with
  | zero =>
    simp only [multiStep_zero,Option.some.injEq] at h1
    subst h1
    rcases m with _ | m
    · simp only [multiStep_zero,Option.some.injEq] at h2
      subst h2
      left; exact ⟨by omega,rfl⟩
    · right; exact ⟨by omega,h2⟩
  | succ n ih =>
    rcases m with _ | m
    · simp only [multiStep_zero,Option.some.injEq] at h2
      subst h2
      left; exact ⟨by omega,h1⟩
    · rw [qT] at h1 h2
      cases hs : step M c0 with
      | none => rw [hs] at h1; simp at h1
      | some c0' =>
        simp only [hs,Option.bind] at h1 h2
        rcases ih h1 h2 with ⟨hle,h⟩ | ⟨hlt,h⟩
        · left; refine ⟨by omega,?_⟩; simpa only [Nat.succ_sub_succ_eq_sub] using h
        · right; refine ⟨by omega,?_⟩; simpa only [Nat.succ_sub_succ_eq_sub] using h
lemma qv {M : Machine Γ Λ} {c c' : Cfg Γ Λ}
    (h : c [M]⊢* c') (h' : (step M c').isSome) : (step M c).isSome:= by
  rcases h with ⟨k,hk⟩
  cases k with
  | zero =>
    simp only [multiStep_zero,Option.some.injEq] at hk
    subst hk; exact h'
  | succ k =>
    exact qn ⟨k + 1,by omega,hk⟩
lemma qX (l : ListBlank (Fin 2)) :
    (step qi (qa8 l)).isSome :=
  qn (qag l)
lemma qS (k : Nat) :
    ∀ c l,((qa8 l) [qi]⊢^{k} c) → (step qi c).isSome:= by
  induction k using Nat.strong_induction_on with
  | h k ih =>
    intro c l hreach
    rcases qag l with ⟨m,hm_pos,hm⟩
    rcases qu hm hreach with ⟨_,hd⟩ | ⟨hlt,hd⟩
    · exact qv ⟨m - k,hd⟩ (qX ((1 : Fin 2) >> l))
    · exact ih (k - m) (by omega) c ((1 : Fin 2) >> l) hd
lemma qB {c0 : Cfg (Fin 2) (Fin 6)} {l : ListBlank (Fin 2)}
    (h0 : c0 [qi]⊢* qa8 l) :
    ∀ cfg,(c0 [qi]⊢* cfg) → (step qi cfg).isSome:= by
  intro cfg ⟨k,hk⟩
  rcases h0 with ⟨m,hm⟩
  rcases qu hm hk with ⟨_,hd⟩ | ⟨_,hd⟩
  · exact qv ⟨m - k,hd⟩ (qX l)
  · exact qS (k - m) cfg l hd
