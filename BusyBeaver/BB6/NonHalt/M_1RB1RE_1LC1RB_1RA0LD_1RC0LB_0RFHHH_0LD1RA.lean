lemma qe_local {n : ℕ} {s : Scan} (hd : s.dir = .left)
    (h : run_local qi n ⟨s.scan_in, s.context, s.q, .left⟩ = some ⟨[], s.context ++ s.scan_out, s.q, .left⟩) :
    qc qi s := by
  apply qe hd
  intro l r
  simpa only [cfg_of, Counter.cfg_of, append_assoc, append_nil] using run_local_spec h l r
lemma qt_local {n : ℕ} {s : Scan} (hd : s.dir = .right)
    (h : run_local qi n ⟨s.context, s.scan_in, s.q, .right⟩ = some ⟨s.context ++ s.scan_out, [], s.q, .right⟩) :
    qc qi s := by
  apply qt hd
