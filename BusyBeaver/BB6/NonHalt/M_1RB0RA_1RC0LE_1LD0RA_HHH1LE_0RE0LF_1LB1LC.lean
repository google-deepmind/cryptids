theorem validCSeg_of_lt {i : Nat} (h : i < 14) : M23.ValidCSeg (segBits i) := by
  have hall := validCSeg_all
  rw [List.all_eq_true] at hall
  exact M23.checkCSeg_sound (hall i (List.mem_range.mpr h))
