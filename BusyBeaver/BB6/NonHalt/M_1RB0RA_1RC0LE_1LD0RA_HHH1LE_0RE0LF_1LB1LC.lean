open List
inductive St | A | B | C | D | E | F | H
  deriving DecidableEq, Repr
structure Cfg where
  st : St
  L : List Bool
  h : Bool
  R : List Bool
  deriving DecidableEq, Repr
def mR (s : St) (w : Bool) (c : Cfg) : Cfg := ⟨s, w :: c.L, c.R.headD false, c.R.tail⟩
def mL (s : St) (w : Bool) (c : Cfg) : Cfg := ⟨s, c.L.tail, c.L.headD false, w :: c.R⟩
def step (c : Cfg) : Cfg :=
  match c.st, c.h with
  | .A, false => mR .B true c
  | .A, true  => mR .C true c
  | .B, false => mL .C true c
  | .B, true  => mR .F false c
  | .C, false => mR .E true c
  | .C, true  => mL .D false c
  | .D, false => mL .B true c
  | .D, true  => mL .D false c
  | .E, false => { c with st := .H }
  | .E, true  => mR .F true c
  | .F, false => mL .F false c
  | .F, true  => mR .A false c
  | .H, _     => c
def run : Nat → Cfg → Cfg
  | 0, c => c
  | n + 1, c => run n (step c)
theorem run_add (m n : Nat) (c : Cfg) : run (m + n) c = run n (run m c) := by
  induction m generalizing c with
  | zero => simp [run]
  | succ m ih =>
    rw [Nat.succ_add]
    simp only [run]
    exact ih (step c)
def pw : Nat → List Bool → List Bool
  | 0, _ => []
  | k + 1, u => u ++ pw k u
@[simp] theorem pw_zero (u : List Bool) : pw 0 u = [] := rfl
@[simp] theorem pw_succ (k : Nat) (u : List Bool) : pw (k + 1) u = u ++ pw k u := rfl
theorem pw_comm (k : Nat) (u : List Bool) : u ++ pw k u = pw k u ++ u := by
  induction k with
  | zero => simp
  | succ k ih => rw [pw_succ, List.append_assoc, ← ih]
theorem pw_succ' (k : Nat) (u : List Bool) : pw (k + 1) u = pw k u ++ u := by
  rw [pw_succ, pw_comm]
theorem pw_add (a b : Nat) (u : List Bool) : pw (a + b) u = pw a u ++ pw b u := by
  induction a with
  | zero => simp
  | succ a ih => rw [Nat.succ_add, pw_succ, pw_succ, ih, List.append_assoc]
abbrev U : List Bool := [true, true, false]
def ckpt (n : Nat) (W : List Bool) : Cfg := ⟨.C, [], false, pw n U ++ W⟩
def mvDir : St → Bool → Option Bool
  | .A, _ => some true
  | .B, false => some false
  | .B, true => some true
  | .C, false => some true
  | .C, true => some false
  | .D, _ => some false
  | .E, false => none
  | .E, true => some true
  | .F, false => some false
  | .F, true => some true
  | .H, _ => none
def stepB (c : Cfg) : Option Cfg :=
  match mvDir c.st c.h with
  | some true => if c.R.isEmpty then none else some (step c)
  | some false => if c.L.isEmpty then none else some (step c)
  | none => some (step c)
def runB : Nat → Cfg → Option Cfg
  | 0, c => some c
  | n + 1, c => (stepB c).bind (runB n)
theorem runB_add (m n : Nat) : ∀ {c c1 c2 : Cfg},
    runB m c = some c1 → runB n c1 = some c2 → runB (m + n) c = some c2 := by
  induction m with
  | zero =>
    intro c c1 c2 h1 h2
    simp only [runB, Option.some.injEq] at h1
    subst h1
    simpa using h2
  | succ m ih =>
    intro c c1 c2 h1 h2
    simp only [runB, Option.bind_eq_some_iff] at h1
    obtain ⟨c', hc', hm⟩ := h1
    rw [Nat.succ_add]
    simp only [runB, hc', Option.bind_some]
    exact ih hm h2
def ext (c : Cfg) (Lt Rt : List Bool) : Cfg := ⟨c.st, c.L ++ Lt, c.h, c.R ++ Rt⟩
theorem stepB_frame {c c' : Cfg} (Lt Rt : List Bool) (h : stepB c = some c') :
    step (ext c Lt Rt) = ext c' Lt Rt := by
  obtain ⟨s, L, x, R⟩ := c
  cases s <;> cases x <;> simp only [stepB, mvDir] at h <;>
    first
    | (cases R with
        | nil => simp at h
        | cons r rs => simp at h; subst h; simp [ext, step, mR])
    | (cases L with
        | nil => simp at h
        | cons l ls => simp at h; subst h; simp [ext, step, mL])
    | (simp at h; subst h; simp [ext, step])
theorem runB_frame (n : Nat) (Lt Rt : List Bool) :
    ∀ {c c' : Cfg}, runB n c = some c' → run n (ext c Lt Rt) = ext c' Lt Rt := by
  induction n with
  | zero => intro c c' h; simp [runB] at h; subst h; rfl
  | succ n ih =>
    intro c c' h
    simp only [runB, Option.bind_eq_some_iff] at h
    obtain ⟨c1, h1, h2⟩ := h
    show run n (step (ext c Lt Rt)) = _
    rw [stepB_frame Lt Rt h1]
    exact ih h2
abbrev X : List Bool := [false, false, true]
abbrev Y : List Bool := [true, false, false]
abbrev Z : List Bool := [true, false, true]
theorem rot (x : Bool) (l : List Bool) (k : Nat) (T : List Bool) :
    x :: (pw k (l ++ [x]) ++ T) = pw k (x :: l) ++ x :: T := by
  induction k with
  | zero => simp
  | succ k ih => simp [ih]
theorem rotX (k : Nat) (T : List Bool) : true :: (pw k X ++ T) = pw k Y ++ true :: T :=
  rot true [false, false] k T
theorem rotZ (k : Nat) (T : List Bool) : true :: (pw k Z ++ T) = pw k U ++ true :: T :=
  rot true [true, false] k T
theorem splitZ (k : Nat) (T : List Bool) :
    pw (k + 1) Z ++ T = true :: false :: (pw k U ++ true :: T) := by
  rw [pw_succ, ← rotZ]; simp
theorem rsweep (k : Nat) (L R : List Bool) :
    run (3 * k) ⟨.A, L, false, pw k U ++ R⟩ = ⟨.A, pw k X ++ L, false, R⟩ := by
  induction k generalizing L with
  | zero => rfl
  | succ k ih =>
    rw [show 3 * (k + 1) = 3 + 3 * k by omega, run_add]
    have h3 : run 3 ⟨.A, L, false, pw (k + 1) U ++ R⟩ = ⟨.A, X ++ L, false, pw k U ++ R⟩ := by
      simp [run, step, mR]
    rw [h3, ih, pw_succ', append_assoc]
theorem lsweep (k : Nat) (L R : List Bool) :
    run (3 * k) ⟨.B, pw k Y ++ L, false, R⟩ = ⟨.B, L, false, pw k Z ++ R⟩ := by
  induction k generalizing R with
  | zero => rfl
  | succ k ih =>
    rw [show 3 * (k + 1) = 3 + 3 * k by omega, run_add]
    have h3 : run 3 ⟨.B, pw (k + 1) Y ++ L, false, R⟩ = ⟨.B, pw k Y ++ L, false, Z ++ R⟩ := by
      simp [run, step, mL]
    rw [h3, ih, pw_succ', append_assoc]
theorem start (R : List Bool) :
    run 3 ⟨.C, [], false, U ++ R⟩ = ⟨.A, [false, true, true], false, R⟩ := by
  simp [run, step, mR]
theorem bounce1 (L W' : List Bool) :
    run 4 ⟨.A, X ++ L, false, false :: W'⟩ = ⟨.B, true :: L, false, Z ++ W'⟩ := by
  simp [run, step, mR, mL]
theorem leftEnd1 (R : List Bool) :
    run 5 ⟨.B, [true, false, true, true], false, true :: false :: R⟩
      = ⟨.A, [false, false, true], false, U ++ R⟩ := by
  simp [run, step, mR, mL]
theorem leftEnd2 (R : List Bool) :
    run 4 ⟨.B, [true], false, R⟩ = ⟨.C, [], false, U ++ true :: R⟩ := by
  simp [run, step, mR, mL]
def wordHyp (W' : List Bool) (a J J' : Nat) (V : List Bool) : Prop :=
  runB a ⟨.A, pw J X, false, true :: W'⟩ = some ⟨.B, true :: pw J' X, false, V⟩
def evSteps (k a m : Nat) : Nat := 3 + 3 * (k + 1) + 4 + 3 * k + 5 + 3 * (k + 1) + a + 3 * m + 4
theorem event (k J J' a : Nat) (W' V : List Bool) (hJ : J ≤ k + 2)
    (hw : wordHyp W' a J J' V) :
    run (evSteps k a (J' + (k + 2 - J))) (ckpt (k + 2) (false :: W'))
      = ckpt (J' + (k + 2 - J) + 1) (true :: V) := by
  have e1 : run 3 (ckpt (k + 2) (false :: W'))
      = ⟨.A, [false, true, true], false, pw (k + 1) U ++ false :: W'⟩ := by
    rw [ckpt, pw_succ, append_assoc, start]
  have e2 := rsweep (k + 1) [false, true, true] (false :: W')
  have e3 : run 4 ⟨.A, pw (k + 1) X ++ [false, true, true], false, false :: W'⟩
      = ⟨.B, pw k Y ++ [true, false, true, true], false, Z ++ W'⟩ := by
    rw [pw_succ, append_assoc, bounce1, rotX]
  have e4 := lsweep k [true, false, true, true] (Z ++ W')
  have e5 : run 5 ⟨.B, [true, false, true, true], false, pw k Z ++ (Z ++ W')⟩
      = ⟨.A, [false, false, true], false, pw (k + 1) U ++ true :: W'⟩ := by
    rw [← append_assoc, ← pw_succ', splitZ, leftEnd1, pw_succ, append_assoc]
  have e6 := rsweep (k + 1) [false, false, true] (true :: W')
  have e7 : run a ⟨.A, pw (k + 1) X ++ [false, false, true], false, true :: W'⟩
      = ⟨.B, pw (J' + (k + 2 - J)) Y ++ [true], false, V⟩ := by
    have hsplit : pw (k + 1) X ++ [false, false, true] = pw J X ++ pw (k + 2 - J) X := by
      rw [← pw_succ', ← pw_add]; congr 1; omega
    have hf := runB_frame a (pw (k + 2 - J) X) [] hw
    simp only [ext, append_nil] at hf
    rw [hsplit, hf, ← rotX, pw_add, append_nil, cons_append]
  have e8 := lsweep (J' + (k + 2 - J)) [true] V
  have e9 : run 4 ⟨.B, [true], false, pw (J' + (k + 2 - J)) Z ++ V⟩
      = ckpt (J' + (k + 2 - J) + 1) (true :: V) := by
    rw [leftEnd2, rotZ, ckpt, pw_succ, append_assoc]
  simp only [evSteps, run_add]
  rw [e1, e2, e3, e4, e5, e6, e7, e8, e9]
def isRetFast : List Bool → Option Nat
  | [true] => some 0
  | [true, false, false, true, false, false, true] => some 2
  | _ => none
theorem isRetFast_sound {L : List Bool} {j : Nat} (h : isRetFast L = some j) :
    L = true :: pw j X := by
  unfold isRetFast at h
  split at h
  · simp only [Option.some.injEq] at h; subst h; rfl
  · simp only [Option.some.injEq] at h; subst h; rfl
  · cases h
def stepB1 (c : Cfg) : Option Cfg :=
  match c.st, c.h with
  | .A, false => match c.R with | r :: rs => some ⟨.B, true :: c.L, r, rs⟩ | [] => none
  | .A, true  => match c.R with | r :: rs => some ⟨.C, true :: c.L, r, rs⟩ | [] => none
  | .B, false => match c.L with | l :: ls => some ⟨.C, ls, l, true :: c.R⟩ | [] => none
  | .B, true  => match c.R with | r :: rs => some ⟨.F, false :: c.L, r, rs⟩ | [] => none
  | .C, false => match c.R with | r :: rs => some ⟨.E, true :: c.L, r, rs⟩ | [] => none
  | .C, true  => match c.L with | l :: ls => some ⟨.D, ls, l, false :: c.R⟩ | [] => none
  | .D, false => match c.L with | l :: ls => some ⟨.B, ls, l, true :: c.R⟩ | [] => none
  | .D, true  => match c.L with | l :: ls => some ⟨.D, ls, l, false :: c.R⟩ | [] => none
  | .E, false => some ⟨.H, c.L, false, c.R⟩
  | .E, true  => match c.R with | r :: rs => some ⟨.F, true :: c.L, r, rs⟩ | [] => none
  | .F, false => match c.L with | l :: ls => some ⟨.F, ls, l, false :: c.R⟩ | [] => none
  | .F, true  => match c.R with | r :: rs => some ⟨.A, false :: c.L, r, rs⟩ | [] => none
  | .H, h     => some ⟨.H, c.L, h, c.R⟩
theorem stepB1_eq (c : Cfg) : stepB1 c = stepB c := by
  obtain ⟨st, L, h, R⟩ := c
  cases st <;> cases h <;> first
    | (cases R <;> rfl)
    | (cases L <;> rfl)
    | rfl
def stepFastA (L R : List Bool) : Option Cfg :=
  match R with
  | true :: true :: false :: true :: true :: false :: R' =>
    some ⟨.A, false :: false :: true :: false :: false :: true :: L, false, R'⟩
  | true :: true :: false :: R' =>
    some ⟨.A, false :: false :: true :: L, false, R'⟩
  | true :: true :: true :: false :: R' =>
    some ⟨.C, true :: false :: false :: true :: L, false, R'⟩
  | false :: R' =>
    some ⟨.B, true :: L, false, R'⟩
  | _ => stepB1 ⟨.A, L, false, R⟩
theorem stepFastA_sound (L R : List Bool) {c' : Cfg} (h : stepFastA L R = some c') :
    ∃ k, runB k ⟨.A, L, false, R⟩ = some c' := by
  unfold stepFastA at h
  split at h
  · simp only [Option.some.injEq] at h; subst h; exact ⟨6, rfl⟩
  · simp only [Option.some.injEq] at h; subst h; exact ⟨3, rfl⟩
  · simp only [Option.some.injEq] at h; subst h; exact ⟨4, rfl⟩
  · simp only [Option.some.injEq] at h; subst h; exact ⟨1, rfl⟩
  · rw [stepB1_eq] at h; exact ⟨1, by simp [runB, h]⟩
def stepFastC (L R : List Bool) : Option Cfg :=
  match R with
  | true :: true :: false :: true :: true :: false :: R' =>
    some ⟨.A, false :: false :: true :: false :: true :: true :: L, false, R'⟩
  | true :: true :: false :: R' =>
    some ⟨.A, false :: true :: true :: L, false, R'⟩
  | true :: true :: true :: false :: R' =>
    some ⟨.C, true :: false :: true :: true :: L, false, R'⟩
  | true :: false :: false :: R' =>
    some ⟨.B, true :: false :: true :: L, false, R'⟩
  | _ => stepB1 ⟨.C, L, false, R⟩
theorem stepFastC_sound (L R : List Bool) {c' : Cfg} (h : stepFastC L R = some c') :
