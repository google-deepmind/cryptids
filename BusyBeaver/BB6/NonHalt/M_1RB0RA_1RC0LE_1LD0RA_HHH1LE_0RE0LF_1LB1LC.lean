  · rw [stepB1_eq] at h; exact ⟨1, by simp [runB, h]⟩
def stepFast (c : Cfg) : Option Cfg :=
  match c.st, c.h with
  | .A, false => stepFastA c.L c.R
  | .C, false => stepFastC c.L c.R
  | .B, false => stepFastB c.L c.R
  | _, _ => stepB1 c
theorem stepFast_sound (c : Cfg) {c' : Cfg} (h : stepFast c = some c') :
    ∃ k, runB k c = some c' := by
  obtain ⟨st, L, x, R⟩ := c
  cases st <;> cases x <;> simp only [stepFast] at h
  · exact stepFastA_sound L R h
  · rw [stepB1_eq] at h; exact ⟨1, by simp [runB, h]⟩
  · exact stepFastB_sound L R h
  · rw [stepB1_eq] at h; exact ⟨1, by simp [runB, h]⟩
  · exact stepFastC_sound L R h
  all_goals (rw [stepB1_eq] at h; exact ⟨1, by simp [runB, h]⟩)
def seekFast : Nat → Cfg → Option (Nat × List Bool)
  | 0, _ => none
  | f + 1, c =>
    match c.st, c.h, isRetFast c.L with
    | .B, false, some j => some (j, c.R)
    | _, _, _ =>
      match stepFast c with
      | some c' => seekFast f c'
      | none => none
theorem seekFast_sound (f : Nat) : ∀ {c : Cfg} {j : Nat} {V : List Bool},
    seekFast f c = some (j, V) → ∃ a, runB a c = some ⟨.B, true :: pw j X, false, V⟩ := by
  induction f with
  | zero => intro c j V h; simp [seekFast] at h
  | succ f ih =>
    intro c j V h
    obtain ⟨s, L, x, R⟩ := c
    simp only [seekFast] at h
    split at h
    · rename_i jj hj
      simp only [Option.some.injEq, Prod.mk.injEq] at h
      obtain ⟨rfl, rfl⟩ := h
      rw [isRetFast_sound hj]
      exact ⟨0, rfl⟩
    · split at h
      · rename_i c' hc'
        obtain ⟨k, hk⟩ := stepFast_sound _ hc'
        obtain ⟨a, ha⟩ := ih h
        exact ⟨k + a, runB_add k a hk ha⟩
      · cases h
def win (W' : List Bool) : Cfg := ⟨.A, pw 2 X, false, true :: W'⟩
def wordMapFast (fuel : Nat) (W' : List Bool) : Option (Nat × List Bool) :=
  seekFast fuel (win W')
theorem event_map_fast (k fuel J' : Nat) (W' V : List Bool)
    (h : wordMapFast fuel W' = some (J', V)) :
    ∃ a, run (evSteps k a (J' + k)) (ckpt (k + 2) (false :: W')) = ckpt (J' + k + 1) (true :: V) := by
  obtain ⟨a, ha⟩ := seekFast_sound fuel h
  refine ⟨a, ?_⟩
  have := event k 2 J' a W' V (by omega) ha
  simpa using this
theorem stepB_ext {c c' : Cfg} (Lt Rt : List Bool) (h : stepB c = some c') :
    stepB (ext c Lt Rt) = some (ext c' Lt Rt) := by
  obtain ⟨s, L, x, R⟩ := c
  cases s <;> cases x <;> simp only [stepB, mvDir, ext] at h ⊢ <;>
    first
    | (cases R with
        | nil => simp at h
        | cons r rs => simp at h; subst h; simp [step, mR])
    | (cases L with
        | nil => simp at h
        | cons l ls => simp at h; subst h; simp [step, mL])
    | (simp at h; subst h; simp [step])
theorem runB_ext (n : Nat) (Lt Rt : List Bool) :
    ∀ {c c' : Cfg}, runB n c = some c' → runB n (ext c Lt Rt) = some (ext c' Lt Rt) := by
  induction n with
  | zero => intro c c' h; simp [runB] at h ⊢; subst h; rfl
  | succ n ih =>
    intro c c' h
    simp only [runB, Option.bind_eq_some_iff] at h ⊢
    obtain ⟨c1, h1, h2⟩ := h
    exact ⟨ext c1 Lt Rt, stepB_ext Lt Rt h1, ih h2⟩
def seekToC : Nat → Cfg → Option (List Bool)
  | 0, _ => none
  | f + 1, c =>
    match c.st, c.h, c.R with
    | .C, false, [] => some c.L
    | _, _, _ =>
      match stepFast c with
      | some c' => seekToC f c'
      | none => none
theorem seekToC_sound (f : Nat) : ∀ {c : Cfg} {L_P : List Bool},
    seekToC f c = some L_P → ∃ a, runB a c = some ⟨.C, L_P, false, []⟩ := by
  induction f with
  | zero => intro c L_P h; simp [seekToC] at h
  | succ f ih =>
    intro c L_P h
    obtain ⟨s, L, x, R⟩ := c
    simp only [seekToC] at h
    split at h
    · simp only [Option.some.injEq] at h; subst h; exact ⟨0, rfl⟩
    · split at h
      · rename_i c' hc'
        obtain ⟨k, hk⟩ := stepFast_sound _ hc'
        obtain ⟨a, ha⟩ := ih h
        exact ⟨k + a, runB_add k a hk ha⟩
      · cases h
def seekToB0 : Nat → Cfg → Option (List Bool)
  | 0, _ => none
  | f + 1, c =>
    match c.st, c.h, c.L with
    | .B, false, [true] => some c.R
    | _, _, _ =>
      match stepFast c with
      | some c' => seekToB0 f c'
      | none => none
theorem seekToB0_sound (f : Nat) : ∀ {c : Cfg} {V : List Bool},
    seekToB0 f c = some V → ∃ a, runB a c = some ⟨.B, [true], false, V⟩ := by
  induction f with
  | zero => intro c V h; simp [seekToB0] at h
  | succ f ih =>
    intro c V h
    obtain ⟨s, L, x, R⟩ := c
    simp only [seekToB0] at h
    split at h
    · simp only [Option.some.injEq] at h; subst h; exact ⟨0, rfl⟩
    · split at h
      · rename_i c' hc'
        obtain ⟨k, hk⟩ := stepFast_sound _ hc'
        obtain ⟨a, ha⟩ := ih h
        exact ⟨k + a, runB_add k a hk ha⟩
      · cases h
def ValidCPrefix (P : List Bool) : Prop :=
  ∃ a1 a3 L_P R_back,
    runB a1 ⟨.A, [], false, true :: P⟩ = some ⟨.C, L_P, false, []⟩ ∧
    runB a3 ⟨.B, true :: L_P, false, []⟩ = some ⟨.B, [true], false, R_back⟩ ∧
    R_back ++ [true, false] = [true, false, false] ++ P
theorem validCPrefix_base : ValidCPrefix [true, true, false] :=
  ⟨4, 4, [true, false, false, true], [true, false, false, true], rfl, rfl, rfl⟩
def ValidCSeg (B : List Bool) : Prop :=
  ∃ b1 b3 L_B R_B,
    runB b1 ⟨.C, [], false, B⟩ = some ⟨.C, L_B, false, []⟩ ∧
    runB b3 ⟨.B, true :: L_B, false, []⟩ = some ⟨.B, [true], false, R_B⟩ ∧
    R_B ++ [true, false] = [true, false] ++ B
def checkCSeg (B : List Bool) : Bool :=
  match seekToC 400 ⟨.C, [], false, B⟩ with
  | some L_B =>
    match seekToB0 400 ⟨.B, true :: L_B, false, []⟩ with
    | some R_B => decide (R_B ++ [true, false] = [true, false] ++ B)
    | none => false
  | none => false
theorem checkCSeg_sound {B : List Bool} (h : checkCSeg B = true) : ValidCSeg B := by
  unfold checkCSeg at h
  split at h
  · rename_i L_B h1
    split at h
    · rename_i R_B h2
      simp only [decide_eq_true_eq] at h
      obtain ⟨b1, hb1⟩ := seekToC_sound 400 h1
      obtain ⟨b3, hb3⟩ := seekToB0_sound 400 h2
      exact ⟨b1, b3, L_B, R_B, hb1, hb3, h⟩
    · cases h
  · cases h
theorem validCPrefix_append {P B : List Bool} (hP : ValidCPrefix P) (hB : ValidCSeg B) :
    ValidCPrefix (P ++ B) := by
  obtain ⟨a1, a3, L_P, R_back, ha1, ha3, heqP⟩ := hP
  obtain ⟨b1, b3, L_B, R_B, hb1, hb3, heqB⟩ := hB
  refine ⟨a1 + b1, b3 + a3, L_B ++ L_P, R_back ++ R_B, ?_, ?_, ?_⟩
  · have e1 := runB_ext a1 [] B ha1
    simp only [ext, append_nil] at e1
    have e2 := runB_ext b1 L_P [] hb1
    simp only [ext, append_nil] at e2
    exact runB_add a1 b1 e1 e2
  · have e1 := runB_ext b3 L_P [] hb3
    simp only [ext, append_nil, cons_append] at e1
    have e2 := runB_ext a3 [] R_B ha3
    simp only [ext, append_nil] at e2
    exact runB_add b3 a3 e1 e2
  · rw [append_assoc, heqB, ← append_assoc, heqP, append_assoc]
theorem wordHyp_prefix {P S S_raw : List Bool} {a2 : Nat} (hP : ValidCPrefix P)
    (hS : runB a2 ⟨.C, [], false, S⟩ = some ⟨.B, [true], false, true :: false :: S_raw⟩) :
    ∃ a V, wordHyp (P ++ S) a 2 2 V ∧ true :: V = U ++ (false :: P ++ S_raw) := by
  obtain ⟨a1, a3, L_P, R_back, ha1, ha3, heqP⟩ := hP
  refine ⟨(a1 + a2) + a3, R_back ++ (true :: false :: S_raw), ?_, ?_⟩
  · unfold wordHyp
    have e1 := runB_ext a1 (pw 2 X) S ha1
    simp only [ext, nil_append] at e1
    have e2 := runB_ext a2 (L_P ++ pw 2 X) [] hS
    simp only [ext, nil_append, append_nil, cons_append] at e2
    have e3 := runB_ext a3 (pw 2 X) (true :: false :: S_raw) ha3
    simp only [ext, nil_append, cons_append] at e3
    exact runB_add (a1 + a2) a3 (runB_add a1 a2 e1 e2) e3
  · have h1 : R_back ++ (true :: false :: S_raw) = (R_back ++ [true, false]) ++ S_raw := by simp
    rw [h1, heqP]
    simp [U]
end M23
namespace Cert
abbrev Machine := Nat → Bool → Option (Bool × Bool × Nat)
structure Cfg where
  q : Nat
  L : List Bool
  h : Bool
  R : List Bool
  deriving DecidableEq, Repr
abbrev halted (M : Machine) (c : Cfg) : Prop := M c.q c.h = none
def step (M : Machine) (c : Cfg) : Cfg :=
  match M c.q c.h with
  | none => c
  | some (w, true, s) => ⟨s, w :: c.L, c.R.headD false, c.R.tail⟩
  | some (w, false, s) => ⟨s, c.L.tail, c.L.headD false, w :: c.R⟩
def run (M : Machine) : Nat → Cfg → Cfg
  | 0, c => c
  | n + 1, c => run M n (step M c)
def blank (q : Nat) : Cfg := ⟨q, [], false, []⟩
theorem run_add (M : Machine) (m n : Nat) (c : Cfg) :
    run M (m + n) c = run M n (run M m c) := by
  induction m generalizing c with
  | zero => simp [run]
  | succ m ih => rw [Nat.succ_add]; simp only [run]; exact ih _
theorem step_of_halted {M : Machine} {c : Cfg} (h : halted M c) : step M c = c := by
  unfold halted at h; simp [step, h]
theorem run_of_halted {M : Machine} {c : Cfg} (h : halted M c) : ∀ n, run M n c = c := by
  intro n; induction n with
  | zero => rfl
  | succ n ih => simp only [run, step_of_halted h, ih]
theorem halted_mono {M : Machine} {c : Cfg} {n n' : Nat} (hn : n ≤ n')
    (h : halted M (run M n c)) : halted M (run M n' c) := by
  obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hn
  rw [run_add, run_of_halted h]; exact h
def strip : List Bool → List Bool
  | [] => []
  | true :: xs => true :: strip xs
  | false :: xs =>
    match strip xs with
    | [] => []
    | y :: ys => false :: y :: ys
abbrev eqv (x y : List Bool) : Prop := strip x = strip y
theorem strip_headD (x : List Bool) : (strip x).headD false = x.headD false := by
  cases x with
  | nil => rfl
  | cons b xs =>
    cases b
    · simp only [strip]; split <;> rfl
    · rfl
theorem strip_tail (x : List Bool) : (strip x).tail = strip x.tail := by
  cases x with
  | nil => rfl
  | cons b xs =>
    cases b
    · simp only [strip, List.tail_cons]; split
      · rename_i h; simp [h]
      · rename_i y ys h; simp [h]
    · rfl
theorem eqv_headD {x y : List Bool} (h : eqv x y) : x.headD false = y.headD false := by
  rw [← strip_headD x, h, strip_headD]
theorem eqv_tail {x y : List Bool} (h : eqv x y) : eqv x.tail y.tail := by
  unfold eqv; rw [← strip_tail, ← strip_tail, h]
theorem eqv_cons {x y : List Bool} (w : Bool) (h : eqv x y) : eqv (w :: x) (w :: y) := by
  unfold eqv at *; cases w <;> simp only [strip, h]
theorem strip_strip (x : List Bool) : strip (strip x) = strip x := by
  induction x with
  | nil => rfl
  | cons b ys ih =>
    cases b
    · dsimp only [strip]
      cases h : strip ys with
      | nil => rfl
      | cons y ys' =>
        have ih' : strip (y :: ys') = y :: ys' := by rw [← h, ih]
        simp only [strip, ih']
    · simp only [strip, ih]
theorem strip_append (x y : List Bool) : strip (x ++ y) = strip (x ++ strip y) := by
  induction x with
  | nil => simp [strip_strip]
  | cons b xs ih => cases b <;> simp only [List.cons_append, strip, ih]
theorem strip_replicate (k : Nat) : strip (List.replicate k false) = [] := by
  induction k with
  | zero => rfl
  | succ k ih => simp [List.replicate_succ, strip, ih]
theorem eqv_pad (x : List Bool) (k : Nat) : eqv (x ++ List.replicate k false) x := by
  unfold eqv; rw [strip_append, strip_replicate, List.append_nil]
theorem eqv_append {x y y' : List Bool} (h : eqv y y') : eqv (x ++ y) (x ++ y') := by
  unfold eqv at *; rw [strip_append, h, ← strip_append]
theorem eqv_strip (x : List Bool) : eqv (strip x) x := strip_strip x
abbrev eqvC (c d : Cfg) : Prop := c.q = d.q ∧ c.h = d.h ∧ eqv c.L d.L ∧ eqv c.R d.R
theorem eqvC_refl (c : Cfg) : eqvC c c := ⟨rfl, rfl, rfl, rfl⟩
theorem eqvC_trans {c d e : Cfg} (h1 : eqvC c d) (h2 : eqvC d e) : eqvC c e := by
  obtain ⟨a1, b1, c1, d1⟩ := h1; obtain ⟨a2, b2, c2, d2⟩ := h2
  exact ⟨a1.trans a2, b1.trans b2, Eq.trans c1 c2, Eq.trans d1 d2⟩
theorem step_eqvC (M : Machine) {c d : Cfg} (h : eqvC c d) : eqvC (step M c) (step M d) := by
  obtain ⟨q, L, x, R⟩ := c
  obtain ⟨q', L', x', R'⟩ := d
  obtain ⟨hq, hh, hL, hR⟩ := h
  simp only at hq hh; subst hq; subst hh
  unfold step
  cases M q x with
  | none => exact ⟨rfl, rfl, hL, hR⟩
  | some t =>
    obtain ⟨w, d, s⟩ := t
    cases d
    · exact ⟨rfl, eqv_headD hL, eqv_tail hL, eqv_cons _ hR⟩
    · exact ⟨rfl, eqv_headD hR, eqv_cons _ hL, eqv_tail hR⟩
theorem run_eqvC (M : Machine) (n : Nat) : ∀ {c d : Cfg}, eqvC c d → eqvC (run M n c) (run M n d) := by
  induction n with
  | zero => intro c d h; exact h
  | succ n ih => intro c d h; exact ih (step_eqvC M h)
def M : Machine
  | 0, false => some (true, true, 1)
  | 0, true  => some (true, true, 2)
  | 1, false => some (true, false, 2)
  | 1, true  => some (false, true, 5)
  | 2, false => some (true, true, 4)
  | 2, true  => some (false, false, 3)
  | 3, false => some (true, false, 1)
  | 3, true  => some (false, false, 3)
  | 4, false => none
  | 4, true  => some (true, true, 5)
  | 5, false => some (false, false, 5)
  | 5, true  => some (false, true, 0)
  | _, _ => none
def stIdx : M23.St → Nat
  | .A => 0 | .B => 1 | .C => 2 | .D => 3 | .E => 4 | .F => 5 | .H => 4
def fC (c : M23.Cfg) : Cfg := ⟨stIdx c.st, c.L, c.h, c.R⟩
def goodC (c : M23.Cfg) : Prop := c.st = .H → c.h = false
theorem step_f (c : M23.Cfg) (hg : goodC c) :
    fC (M23.step c) = step M (fC c) ∧ goodC (M23.step c) := by
  obtain ⟨s, L, x, R⟩ := c
  unfold goodC at *
  cases s <;> cases x <;> simp_all [M23.step, M23.mR, M23.mL, step, M, fC, stIdx]
theorem run_f (n : Nat) : ∀ (c : M23.Cfg), goodC c → fC (M23.run n c) = run M n (fC c) := by
  induction n with
  | zero => intro c _; rfl
  | succ n ih =>
    intro c hg
    obtain ⟨h1, h2⟩ := step_f c hg
    simp only [M23.run, run]; rw [ih _ h2, h1]
def ck (n : Nat) (W : List Bool) : Cfg := ⟨2, [], false, M23.pw n M23.U ++ W⟩
theorem ck_f (n : Nat) (W : List Bool) : fC (M23.ckpt n W) = ck n W := rfl
def units : List Bool → Nat × List Bool
  | true :: true :: false :: r =>
    match units r with
    | (u, rest) => (u + 1, rest)
  | l => (0, l)
theorem units_spec (l : List Bool) : M23.pw (units l).1 M23.U ++ (units l).2 = l := by
  induction l using units.induct with
  | case1 r u rest h_eq ih =>
    unfold units
    rw [h_eq]
    simp only [M23.pw_succ, List.append_assoc]
    have h1 : (units r).1 = u := by rw [h_eq]
    have h2 : (units r).2 = rest := by rw [h_eq]
    rw [← h1, ← h2, ih]
    rfl
  | case2 l h =>
    unfold units; split
    · rename_i r; exact absurd rfl (h r)
    · rfl
def PAD : Nat := 12
def evStep (p : Nat × List Bool) : Option (Nat × List Bool) :=
  match p.2 with
  | false :: W' =>
    if 2 ≤ p.1 then
      match M23.wordMapFast 450 (W' ++ List.replicate PAD false) with
      | some (J', V) => some (J' + (p.1 - 2) + 1 + (units (true :: V)).1,
                              strip (units (true :: V)).2)
      | none => none
    else none
  | _ => none
theorem evStep_sound {p p' : Nat × List Bool} (h : evStep p = some p') :
    ∃ m, eqvC (run M m (ck p.1 p.2)) (ck p'.1 p'.2) := by
  obtain ⟨n, W⟩ := p
  rcases W with _ | ⟨b, W'⟩
  · simp [evStep] at h
  cases b
  case true => simp [evStep] at h
  by_cases hn : 2 ≤ n
  case neg => simp [evStep, hn] at h
  cases hw : M23.wordMapFast 450 (W' ++ List.replicate PAD false) with
  | none => simp [evStep, hn, hw] at h
  | some r =>
    obtain ⟨J', V⟩ := r
    simp only [evStep, hn, if_true, hw, Option.some.injEq] at h
    subst h
    obtain ⟨k, rfl⟩ : ∃ k, n = k + 2 := ⟨n - 2, by omega⟩
    obtain ⟨a, ev⟩ := M23.event_map_fast k 450 J' (W' ++ List.replicate PAD false) V hw
    have hr := run_f (M23.evSteps k a (J' + k)) (M23.ckpt (k + 2) (false :: (W' ++ List.replicate PAD false))) (by unfold goodC M23.ckpt; intro h; cases h)
    rw [ev, ck_f, ck_f] at hr
    refine ⟨M23.evSteps k a (J' + k), ?_⟩
    have e1 : eqvC (ck (k + 2) (false :: W'))
        (ck (k + 2) (false :: (W' ++ List.replicate PAD false))) := by
      refine ⟨rfl, rfl, rfl, ?_⟩
      show eqv _ _
      apply eqv_append
      show strip _ = strip _
      rw [← List.cons_append]; exact (eqv_pad _ _).symm
    have e2 := run_eqvC M (M23.evSteps k a (J' + k)) e1
    rw [← hr] at e2
    refine eqvC_trans e2 ⟨rfl, rfl, rfl, ?_⟩
    show eqv _ _
    have hu := units_spec (true :: V)
    simp only [ck]
    rw [show k + 2 - 2 = k by omega]
    have e3 : M23.pw (J' + k + 1) M23.U ++ (true :: V)
        = M23.pw (J' + k + 1 + (units (true :: V)).1) M23.U ++ (units (true :: V)).2 := by
      rw [M23.pw_add (J' + k + 1), List.append_assoc, hu]
    rw [e3]
    exact eqv_append (eqv_strip _).symm
