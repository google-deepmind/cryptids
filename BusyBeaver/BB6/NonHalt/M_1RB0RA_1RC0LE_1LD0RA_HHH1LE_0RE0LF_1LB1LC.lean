theorem nonhalt_D : ∀ n, ¬ halted M (run M n (blank 3)) :=
  nonhalt_of_start startD_inv
theorem nonhalt_N : ∀ n, ¬ halted N (run N n (blank 0)) := by
  intro n; rw [N_run, N_halted]; exact nonhalt_D n
