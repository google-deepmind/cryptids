theorem wfSegs_valid {segs : List Nat} (h : wfSegs segs) : M23.ValidCPrefix (evalSegs segs) := by
  induction segs with
  | nil => exact M23.validCPrefix_base
  | cons seg rest ih =>
    exact M23.validCPrefix_append (ih h.2) (validCSeg_of_lt h.1)
def wfCfg : PdaCfg → Prop
  | .cmode _ segs _ => wfSegs segs
  | .fmode _ _ => True
def toPair : PdaCfg → Nat × List Bool
  | .cmode n segs s => (n, false :: (evalSegs segs ++ stateBits s))
  | .fmode n w => (n, fbBits w)
def applyCAct (n : Nat) (segs : List Nat) : CAct → Option PdaCfg
  | .push seg s_rem => some (.cmode n (seg :: segs) s_rem)
  | .mac k s_end =>
    if 2 ≤ n then sNat (n + 2 * k) fun n' => some (.cmode n' segs s_end)
    else none
  | .popExit pops w_exit =>
    match segs with
    | [] =>
      match w_exit with
      | some w => some (.fmode n w)
      | none => none
    | seg :: rest =>
      match lookupPop pops seg with
      | some s_comb => some (.cmode n rest s_comb)
      | none => none
  | .none => none
def applyFbAct (n : Nat) : FbAct → Option PdaCfg
  | .fb dn true s_out =>
    if 2 ≤ n then sNat (n + dn) fun n' => some (.cmode n' [] s_out)
    else none
  | .fb dn false w_out =>
    if 2 ≤ n then sNat (n + dn) fun n' => some (.fmode n' w_out)
    else none
  | .none => none
def pdaStep : PdaCfg → Option PdaCfg
  | .cmode n segs s =>
    if s < 159 then applyCAct n segs (cActTable.get s .none) else none
  | .fmode n w =>
    if w < 27 then applyFbAct n (fbActTable.get w .none) else none
theorem pdaStep_sound {c c' : PdaCfg} (hwf : wfCfg c) (h : pdaStep c = some c') :
    wfCfg c' ∧ ∃ m, eqvC (run M m (ck (toPair c).1 (toPair c).2)) (ck (toPair c').1 (toPair c').2) := by
  cases c with
  | cmode n segs s =>
    simp only [pdaStep] at h
    split at h
    · rename_i hs
      have hv := validCAct_of_lt hs
      unfold validCAct at hv
      generalize cActTable.get s .none = act at h hv
      cases act with
      | push seg s_rem =>
        simp only [applyCAct, checkCAct, Bool.and_eq_true, decide_eq_true_eq, eqLB_iff, Option.some.injEq] at hv h
        subst h
        refine ⟨⟨hv.1, hwf⟩, 0, ?_⟩
        simp only [toPair, evalSegs, List.append_assoc, ← hv.2, run]
        exact eqvC_refl _
      | mac k s_end =>
        simp only [applyCAct, checkCAct, eqOptLB_iff] at hv h
        split at h
        · rename_i hn
          rw [sNat_eq] at h
          simp only [Option.some.injEq] at h
          subst h
          refine ⟨hwf, ?_⟩
          exact suffixIter_sound k (wfSegs_valid hwf) n hn hv
        · cases h
      | popExit pops w_exit =>
        simp only [applyCAct, checkCAct, Bool.and_eq_true] at hv h
        cases segs with
        | nil =>
          cases w_exit with
          | none => cases h
          | some w =>
            simp only [eqLB_iff, Option.some.injEq] at hv h
            subst h
            refine ⟨trivial, 0, ?_⟩
            simp only [toPair, evalSegs, hv.2, run]
            exact eqvC_refl _
        | cons seg rest =>
          simp only at h
          split at h
          · rename_i s_comb hl
            simp only [Option.some.injEq] at h
            subst h
            have heq := lookupPop_sound hv.1 hl
            refine ⟨hwf.2, 0, ?_⟩
            simp only [toPair, evalSegs, List.append_assoc, heq, run]
            exact eqvC_refl _
          · cases h
      | none => cases h
    · cases h
  | fmode n w =>
    simp only [pdaStep] at h
    split at h
    · rename_i hw
      have hv := validFbAct_of_lt hw
      unfold validFbAct at hv
      generalize fbActTable.get w .none = act at h hv
      cases act with
      | fb dn is_c out_id =>
        cases is_c
        · simp only [applyFbAct, checkFbAct, eqOptPair_iff] at hv h
          split at h
          · rename_i hn
            rw [sNat_eq] at h
            simp only [Option.some.injEq] at h
            subst h
            refine ⟨trivial, ?_⟩
            have hsh := evStep_shift (n - 2) hv
            rw [show 2 + (n - 2) = n by omega, show 2 + dn + (n - 2) = n + dn by omega] at hsh
            exact evStep_sound hsh
          · cases h
        · simp only [applyFbAct, checkFbAct, eqOptPair_iff] at hv h
          split at h
          · rename_i hn
            rw [sNat_eq] at h
            simp only [Option.some.injEq] at h
            subst h
            refine ⟨trivial, ?_⟩
            have hsh := evStep_shift (n - 2) hv
            rw [show 2 + (n - 2) = n by omega, show 2 + dn + (n - 2) = n + dn by omega] at hsh
            exact evStep_sound hsh
          · cases h
      | none => cases h
    · cases h
def pdaIter : Nat → PdaCfg → Option PdaCfg
  | 0, c => some c
  | k + 1, c => (pdaStep c).bind (pdaIter k)
theorem pdaIter_sound (k : Nat) : ∀ {c c' : PdaCfg}, wfCfg c → pdaIter k c = some c' →
    ∃ m, eqvC (run M m (ck (toPair c).1 (toPair c).2)) (ck (toPair c').1 (toPair c').2) := by
  induction k with
  | zero =>
    intro c c' _ h
    simp only [pdaIter, Option.some.injEq] at h
    subst h
    exact ⟨0, eqvC_refl _⟩
  | succ k ih =>
    intro c c' hwf h
    simp only [pdaIter, Option.bind_eq_some_iff] at h
    obtain ⟨c1, h1, h2⟩ := h
    obtain ⟨hwf1, m1, e1⟩ := pdaStep_sound hwf h1
    obtain ⟨m2, e2⟩ := ih hwf1 h2
    exact ⟨m1 + m2, by rw [run_add]; exact eqvC_trans (run_eqvC M m2 e1) e2⟩
