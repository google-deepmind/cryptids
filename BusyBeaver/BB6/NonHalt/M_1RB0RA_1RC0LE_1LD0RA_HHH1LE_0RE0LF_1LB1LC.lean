theorem eqvC_symm {c d : Cfg} (h : eqvC c d) : eqvC d c :=
  ⟨h.1.symm, h.2.1.symm, h.2.2.1.symm, h.2.2.2.symm⟩
theorem startD_inv : ∃ m, Inv (run M m (blank 3)) := by
  obtain ⟨m, hm⟩ := reach_D_all
