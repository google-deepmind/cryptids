def lookupPop : List (Nat × Nat) → Nat → Option Nat
  | [], _ => none
  | (seg, s_comb) :: rest, target =>
    if seg == target then some s_comb else lookupPop rest target
def checkPopList (s : Nat) : List (Nat × Nat) → Bool
  | [] => true
  | (seg, s_comb) :: rest =>
    eqLB (segBits seg ++ stateBits s) (stateBits s_comb) &&
    checkPopList s rest
theorem lookupPop_sound {s seg s_comb : Nat} {pops : List (Nat × Nat)}
    (hc : checkPopList s pops = true) (hl : lookupPop pops seg = some s_comb) :
    segBits seg ++ stateBits s = stateBits s_comb := by
  induction pops with
  | nil => simp [lookupPop] at hl
  | cons hd tl ih =>
    obtain ⟨seg', s_comb'⟩ := hd
    simp only [checkPopList, Bool.and_eq_true, eqLB_iff] at hc
    simp only [lookupPop] at hl
    split at hl
    · rename_i heq
      simp only [beq_iff_eq] at heq
      simp only [Option.some.injEq] at hl
      subst heq; subst hl
      exact hc.1
    · exact ih hc.2 hl
def checkCAct (s : Nat) : CAct → Bool
  | .push seg s_rem =>
    decide (seg < 14) && eqLB (stateBits s) (segBits seg ++ stateBits s_rem)
  | .mac k s_end =>
    eqOptLB (suffixIter k (stateBits s)) (stateBits s_end)
  | .popExit pops w_exit =>
    checkPopList s pops &&
    match w_exit with
    | some w => eqLB (false :: ([true, true, false] ++ stateBits s)) (fbBits w)
    | none => true
  | .none => true
def validCAct (s : Nat) : Bool := checkCAct s (cActTable.get s .none)
def checkFbAct (w : Nat) : FbAct → Bool
  | .fb dn true s_out =>
    eqOptPair (evStep (2, fbBits w)) (2 + dn) (false :: ([true, true, false] ++ stateBits s_out))
  | .fb dn false w_out =>
    eqOptPair (evStep (2, fbBits w)) (2 + dn) (fbBits w_out)
  | .none => true
def validFbAct (w : Nat) : Bool := checkFbAct w (fbActTable.get w .none)
