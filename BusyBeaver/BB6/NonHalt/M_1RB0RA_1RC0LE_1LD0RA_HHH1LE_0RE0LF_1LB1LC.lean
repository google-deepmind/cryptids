def stepFastB (L R : List Bool) : Option Cfg :=
  match L with
  | true :: false :: false :: true :: false :: false :: L' =>
    some ⟨.B, L', false, true :: false :: true :: true :: false :: true :: R⟩
  | true :: false :: false :: L' =>
    some ⟨.B, L', false, true :: false :: true :: R⟩
  | true :: true :: false :: false :: L' =>
    some ⟨.B, L', false, true :: false :: false :: true :: R⟩
  | true :: true :: true :: false :: false :: L' =>
