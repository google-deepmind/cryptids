  | 1, false => some (true, true, 2)
  | 1, true  => some (false, false, 4)
  | 2, false => some (true, false, 3)
  | 2, true  => some (false, true, 0)
  | 3, false => none
  | 3, true  => some (true, false, 4)
  | 4, false => some (false, true, 4)
  | 4, true  => some (false, false, 5)
  | 5, false => some (true, false, 1)
  | 5, true  => some (true, false, 2)
  | _, _ => none
def piMN : Nat → Nat
  | 0 => 5 | 1 => 1 | 2 => 2 | 3 => 0 | 4 => 3 | 5 => 4 | n => n
theorem N_mirror_M : IsMirror piMN M N := by
  intro q h
