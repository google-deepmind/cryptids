theorem stepFastB_sound (L R : List Bool) {c' : Cfg} (h : stepFastB L R = some c') :
    ∃ k, runB k ⟨.B, L, false, R⟩ = some c' := by
  unfold stepFastB at h
  split at h
  · simp only [Option.some.injEq] at h; subst h; exact ⟨6, rfl⟩
  · simp only [Option.some.injEq] at h; subst h; exact ⟨3, rfl⟩
  · simp only [Option.some.injEq] at h; subst h; exact ⟨4, rfl⟩
