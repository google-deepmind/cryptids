def qa4 : Nat:=62
def qE : Nat:=291
def tnode (v : Nat) : TransRow:=qZ transTree v
def qe (k : Nat) : Mask:=qZ masksTree k
def cell (u v : Nat) : List Nat:=qZ (qZ rowCellTree u) v
def qay (u : Nat) (c : Letter) : List Nat :=
  ((node u).edges.filter (fun e => qU e.1 c)).map Prod.snd
def qbl (u : Nat) : Option Letter -> List Nat
  | none => [u]
  | some c => qay u c
lemma qaX (u : Nat) (c : Letter) (v : Nat) :
    v ∈ qay u c ↔ (c,v) ∈ (node u).edges:= by
  unfold qay
  simp only [List.mem_map,List.mem_filter,qam,Prod.exists]
  constructor
  · rintro ⟨a,b,⟨hmem,rfl⟩,rfl⟩; exact hmem
  · intro hmem; exact ⟨c,v,⟨hmem,rfl⟩,rfl⟩
def qas (vs : List Nat) (c : Letter) : List Nat -> List Nat -> Bool
  | [],[] => true
  | q :: qs,p :: ps =>
    vs.any (fun x => x == p) && memEdge (node p).edges c q && qas vs c qs ps
  | _,_ => false
lemma qbi (vs : List Nat) (c : Letter) (qs ps : List Nat)
    (h : qas vs c qs ps=true) {q : Nat} (hq : q ∈ qs) :
    ∃ p,p ∈ vs /\ (c,q) ∈ (node p).edges:= by
  induction qs generalizing ps with
  | nil => contradiction
  | cons q0 qs' ih =>
    cases ps with
    | nil => contradiction
    | cons p0 ps' =>
      unfold qas at h
      simp only [Bool.and_eq_true,List.any_eq_true,beq_iff_eq] at h
      rcases List.mem_cons.mp hq with rfl | hq'
      · rcases h.1.1 with ⟨x,hx,rfl⟩
        exact ⟨x,hx,(qaZ _ _ _).mp h.1.2⟩
      · exact ih ps' h.2 hq'
def qF (m : Mask) (c : Letter) : Bool :=
  qas m.vertices c (mask_img m c) (mask_src m c) &&
  (mask_sub m (some c)).all (fun k' => qaP (qe k').vertices (mask_img m c))
def qT (k : Nat) : Bool :=
  let m:=qe k
  m.sub_none.all (fun k' => qaP (qe k').vertices m.vertices) &&
  qF m .Odd &&
  qF m .Even &&
  qF m .Gap &&
  ((!m.accepting) || m.vertices.any (fun u => qz u))
def qb0 : Bool :=
  (List.range qE).all qT
lemma masks_checked : qb0=true:= by decide
lemma qa8 (k : Nat) (hk : k < qE) : qT k=true:= by
  have h:=masks_checked
  unfold qb0 at h
  rw [List.all_eq_true] at h
  exact h k (List.mem_range.mpr hk)
lemma qal (k k' p : Nat) (hk : k < qE)
    (hk' : k' ∈ (qe k).sub_none) (hp : p ∈ (qe k').vertices) :
    p ∈ (qe k).vertices:= by
  have hm:=qa8 k hk
  unfold qT at hm
  simp only [Bool.and_eq_true] at hm
  have h1:=hm.1.1.1.1
  rw [List.all_eq_true] at h1
  exact qax (h1 k' hk') hp
lemma qak (k : Nat) (c : Letter) (k' q : Nat) (hk : k < qE)
    (hk' : k' ∈ mask_sub (qe k) (some c)) (hq : q ∈ (qe k').vertices) :
    ∃ p,p ∈ (qe k).vertices /\ (c,q) ∈ (node p).edges:= by
  have hm:=qa8 k hk
  unfold qT at hm
  simp only [Bool.and_eq_true] at hm
  have hc : qF (qe k) c=true:= by
    cases c with
    | Odd => exact hm.1.1.1.2
    | Even => exact hm.1.1.2
    | Gap => exact hm.1.2
  unfold qF at hc
  simp only [Bool.and_eq_true] at hc
  have hsub:=hc.2
  rw [List.all_eq_true] at hsub
  exact qbi _ c _ _ hc.1 (qax (hsub k' hk') hq)
lemma qb1 (k : Nat) (hk : k < qE)
    (hf : (qe k).accepting=true) :
    ∃ p,p ∈ (qe k).vertices /\ qz p=true:= by
  have hm:=qa8 k hk
  unfold qT at hm
  simp only [Bool.and_eq_true] at hm
  have hacc:=hm.2
  rw [hf] at hacc
  simp only [Bool.not_true,Bool.false_or,List.any_eq_true] at hacc
  exact hacc
def qb7 (xs ys : List Nat) : Bool :=
  xs.any (fun x => (x < qE) && ys.any (fun y => x == y))
lemma qbg {xs ys : List Nat} (h : qb7 xs ys=true) :
    ∃ k,k < qE /\ k ∈ xs /\ k ∈ ys:= by
  unfold qb7 at h
  simp only [List.any_eq_true,Bool.and_eq_true,decide_eq_true_eq,beq_iff_eq] at h
  rcases h with ⟨k,hk_xs,hk_lt,y,hy_ys,rfl⟩
  exact ⟨k,hk_lt,hk_xs,hy_ys⟩
def covers (u' v' : Nat) (ks : List Nat) : Bool :=
  qb7 (cell u' v') ks
def qbm (u k : Nat) (e : Option Letter × Option Letter × Nat) : Bool :=
  let (i,o,v'):=e
  (v' < qa4) &&
  (qbl u i).all (fun u' => (u' < q7) && covers u' v' (mask_sub (qe k) o))
def qae (u v : Nat) : Bool :=
  (cell u v).all (fun k =>
    (k < qE) &&
    (tnode v).trans_edges.all (qbm u k) &&
    if qz u && (tnode v).trans_final then (qe k).accepting else true)
def qar : Bool :=
  (List.range q7).all (fun u => (List.range qa4).all (qae u))
lemma qb9 : qar=true:= by decide
lemma qaG (u v : Nat) (hu : u < q7) (hv : v < qa4) :
    qae u v=true:= by
  have h:=qb9
  unfold qar at h
  rw [List.all_eq_true] at h
  have hu':=h u (List.mem_range.mpr hu)
  rw [List.all_eq_true] at hu'
  exact hu' v (List.mem_range.mpr hv)
def emit : Option Letter -> List Letter
  | none => []
  | some c => [c]
inductive TransPath : Nat -> List Letter -> List Letter -> Nat -> Prop where
  | nil (v : Nat) : TransPath v [] [] v
  | cons (v : Nat) (i o : Option Letter) (v' : Nat) (xs ys : List Letter) (v'' : Nat) :
      (i,o,v') ∈ (tnode v).trans_edges -> TransPath v' xs ys v'' ->
      TransPath v (emit i ++ xs) (emit o ++ ys) v''
lemma q8 {u : Nat} {xs ys : List Letter} {v : Nat} {xs' ys' : List Letter} {w : Nat}
    (h1 : TransPath u xs ys v) (h2 : TransPath v xs' ys' w) :
    TransPath u (xs ++ xs') (ys ++ ys') w:= by
  induction h1 with
  | nil _ => simpa using! h2
  | cons v0 i o v1 xs1 ys1 v2 he _ ih =>
    simp only [List.append_assoc]
    exact TransPath.cons v0 i o v1 (xs1 ++ xs') (ys1 ++ ys') w he (ih h2)
def qaE (es : List (Option Letter × Option Letter × Nat))
    (e : Option Letter × Option Letter × Nat) : Bool :=
  es.any (fun e' => e' == e)
def qah : Nat -> List (Option Letter × Option Letter × Nat) -> Bool
  | _,[] => true
  | q,(i,o,q') :: es =>
    qaE (tnode q).trans_edges (i,o,q') && qah q' es
def qaO : List (Option Letter × Option Letter × Nat) -> List Letter
  | [] => []
  | (i,_,_) :: es => emit i ++ qaO es
def qaC : List (Option Letter × Option Letter × Nat) -> List Letter
  | [] => []
  | (_,o,_) :: es => emit o ++ qaC es
def trace_end : Nat -> List (Option Letter × Option Letter × Nat) -> Nat
  | q,[] => q
  | _,(_,_,q') :: es => trace_end q' es
lemma q2 (q : Nat) (es : List (Option Letter × Option Letter × Nat))
    (h : qah q es=true) :
    TransPath q (qaO es) (qaC es) (trace_end q es):= by
  induction es generalizing q with
  | nil => exact TransPath.nil q
  | cons e es ih =>
    rcases e with ⟨i,o,q'⟩
    unfold qah at h
    simp only [Bool.and_eq_true] at h
    have hmem : (i,o,q') ∈ (tnode q).trans_edges:= by
      unfold qaE at h
      simp only [List.any_eq_true,beq_iff_eq] at h
      rcases h.1 with ⟨e',he',rfl⟩
      exact he'
    exact TransPath.cons q i o q' _ _ _ hmem (ih q' h.2)
lemma input_path (u : Nat) (i : Option Letter) (xs : List Letter) (q : Nat)
    (hp : Path u (emit i ++ xs) q) :
    ∃ u',u' ∈ qbl u i /\ Path u' xs q:= by
  cases i with
  | none =>
    exact ⟨u,List.Mem.head _,hp⟩
  | some c =>
    simp only [emit,List.singleton_append] at hp
    cases hp with
    | cons _ _ u' _ _ he hr =>
      exact ⟨u',(qaX u c u').mpr he,hr⟩
lemma closure_sound {v : Nat} {xs ys : List Letter} {v' : Nat}
    (ht : TransPath v xs ys v') (hf : (tnode v').trans_final=true) :
    ∀ u q k,u < q7 -> v < qa4 -> k ∈ cell u v ->
    Path u xs q -> qz q=true ->
    ∃ p q',p ∈ (qe k).vertices /\ Path p ys q' /\ qz q'=true:= by
  induction ht with
  | nil v0 =>
    intro u q k hu hv hk hp hq
    cases hp with
    | nil _ =>
      have hc:=qaG u v0 hu hv
      unfold qae at hc
      rw [List.all_eq_true] at hc
      have hk_ok:=hc k hk
      simp only [Bool.and_eq_true,decide_eq_true_eq,hq,hf,↓reduceIte] at hk_ok
      rcases qb1 k hk_ok.1.1 hk_ok.2 with ⟨p,hp_mem,hp_fin⟩
      exact ⟨p,p,hp_mem,Path.nil p,hp_fin⟩
  | cons v0 i o v1 xs1 ys1 v2 he _ ih =>
    intro u q k hu hv hk hp hq
    have hc:=qaG u v0 hu hv
    unfold qae at hc
    rw [List.all_eq_true] at hc
    have hk_ok:=hc k hk
    simp only [Bool.and_eq_true,decide_eq_true_eq] at hk_ok
    have hk_lt:=hk_ok.1.1
    have hedges:=hk_ok.1.2
    rw [List.all_eq_true] at hedges
    have hedge:=hedges (i,o,v1) he
    unfold qbm at hedge
    simp only [Bool.and_eq_true,decide_eq_true_eq] at hedge
    have hv1:=hedge.1
    have hin:=hedge.2
    rw [List.all_eq_true] at hin
    rcases input_path u i xs1 q hp with ⟨u',hu'_in,hp'⟩
    have hu'_ok:=hin u' hu'_in
    simp only [Bool.and_eq_true,decide_eq_true_eq] at hu'_ok
    rcases qbg hu'_ok.2 with ⟨k',_,hk'_cell,hk'_sub⟩
    rcases ih hf u' q k' hu'_ok.1 hv1 hk'_cell hp' hq with ⟨p',q',hp'_mem,hpath_ys,hq'⟩
    cases o with
    | none =>
      exact ⟨p',q',qal k k' p' hk_lt hk'_sub hp'_mem,hpath_ys,hq'⟩
    | some c =>
      rcases qak k c k' p' hk_lt hk'_sub hp'_mem with ⟨p,hp_mem,hedge_p⟩
      exact ⟨p,q',hp_mem,Path.cons p c p' ys1 q' hedge_p hpath_ys,hq'⟩
def starts : List Nat:=[0,440,477,515]
def qv : Nat:=0
def qI (w : List Letter) : Prop :=
  ∃ u q,u ∈ starts /\ Path u w q /\ qz q=true
def qao : Bool :=
  qaP (qe 0).vertices starts &&
  starts.all (fun u => (u < q7) && (qv < qa4) &&
    (cell u qv).any (fun k => k == 0))
lemma qb6 : qao=true:= by decide
lemma qb5 {xs ys : List Letter} {v' : Nat}
    (ht : TransPath qv xs ys v')
    (hf : (tnode v').trans_final=true)
    (hl : qI xs) : qI ys:= by
  rcases hl with ⟨u,q,hu_st,hp,hq⟩
  have hi:=qb6
  unfold qao at hi
  simp only [Bool.and_eq_true] at hi
  have hsub:=hi.1
  have hall:=hi.2
  rw [List.all_eq_true] at hall
  have hu_ok:=hall u hu_st
  simp only [Bool.and_eq_true,decide_eq_true_eq,List.any_eq_true,beq_iff_eq] at hu_ok
  rcases hu_ok.2 with ⟨k0,hk0_cell,rfl⟩
  rcases closure_sound ht hf u q 0 hu_ok.1.1 hu_ok.1.2 hk0_cell hp hq with ⟨p,q',hp_mem,hp_ys,hq'⟩
  exact ⟨p,q',qax hsub hp_mem,hp_ys,hq'⟩
lemma path_core (w : List Letter) (u f : Nat) (hu : u < q7)
    (hp : Path u (w ++ [.Even]) f) (hfin : qz f=true) :
    ∃ v,Path u w v /\ (node v).final=true:= by
  induction w generalizing u with
  | nil =>
    simp only [List.nil_append] at hp
    cases hp with
    | cons _ _ q' _ _ he hr =>
      cases hr with
      | nil _ =>
        refine ⟨u,Path.nil u,?_⟩
        rw [qaL u hu]
        unfold qa7
        rw [List.any_eq_true]
        exact ⟨(.E,f),he,by simp [qU,hfin]⟩
  | cons c w ih =>
    simp only [List.cons_append] at hp
    cases hp with
    | cons _ _ q' _ _ he hr =>
      have hq':=(qG u c q' hu he).1
      rcases ih q' hq' hr with ⟨v,hp_v,hv_fin⟩
      exact ⟨v,Path.cons u c q' w v he hp_v,hv_fin⟩
def qx : Bool :=
  starts.all (fun q => (q < q7) && (0 < qA q 0) && (qA q 0 <= 12))
lemma qap : qx=true:= by decide
def qa6 (flip : Bool) : Nat:=if flip then 1 else 12
def qO (flip : Bool) (d : Letter) : Letter :=
