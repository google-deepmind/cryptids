  q2 45 [(some .G,none,56),(some .G,none,59),(some .G,none,60),(none,some .E,45)] (by decide)
lemma p_suffix (f : Bool) : TransPath 45 [] ([qO f .Odd] ++ []) (qa6 f):= by
