  · exact q2 27 [(none,some .E,15),(none,some .G,1)] (by decide)
lemma tail0_prefix : TransPath 12 [.Even] [.Odd,.Even,.Even,.Even,.Even] 57 :=
  q2 12 [(some .E,none,51),(none,some .O,52),(none,some .E,53),(none,some .E,54),(none,some .E,55),(none,some .E,57)] (by decide)
lemma tail1_prefix : TransPath 12 [.Even] [.Gap,.Even,.Even,.Even,.Even] 57 :=
  q2 12 [(some .E,none,51),(none,some .G,52),(none,some .E,53),(none,some .E,54),(none,some .E,55),(none,some .E,57)] (by decide)
lemma tail2_prefix : TransPath 12 [.Even] [.Gap,.Gap,.Even,.Even,.Even,.Even] 57 :=
  q2 12 [(some .E,none,51),(none,some .G,58),(none,some .G,52),(none,some .E,53),(none,some .E,54),(none,some .E,55),(none,some .E,57)] (by decide)
lemma tail_loop : TransPath 57 [] [.Even] 57 :=
  q2 57 [(none,some .E,57)] (by decide)
lemma pump (k n : Nat) (h : TransPath k [.Gap,.Gap,.Gap] [.Even] k) :
    TransPath k (List.replicate (n * 3) .Gap) (List.replicate n .Even) k:= by
  induction n with
  | zero => exact TransPath.nil k
  | succ n ih =>
    have heq : (n + 1) * 3=3 + n * 3:= by omega
    rw [heq,List.replicate_add,List.replicate_succ]
    exact q8 h ih
lemma qbp (c : Letter) (g : Nat) (pre : List Letter) (k : Nat) (suf : List Letter) (n q : Nat)
    (hpre : TransPath 12 (c :: List.replicate g .Gap) pre k)
    (hloop : TransPath k [.Gap,.Gap,.Gap] [.Even] k)
    (hsuf : TransPath k [] suf q) :
    TransPath 12 (c :: List.replicate (g + n * 3) .Gap) (pre ++ List.replicate n .Even ++ suf) q:= by
  rw [List.replicate_add,<- List.cons_append,List.append_assoc]
  refine q8 hpre ?_
  have h1:=q8 (pump k n hloop) hsuf
  simpa using! h1
inductive Block where
  | BP0 | BP1 | BP2 (n : Nat) | BP3 (n : Nat) | BP4 (n : Nat)
  | BQ0 | BQ1 | BQ2 | BQ3 (n : Nat) | BQ4 (n : Nat) | BQ5 (n : Nat)
  deriving DecidableEq
def q3 : Block -> Bool
  | .BP0 | .BP1 | .BP2 _ | .BP3 _ | .BP4 _ => true
  | _ => false
def symbol (b : Block) : Letter:=if q3 b then .Even else .Odd
def gaps : Block -> Nat
  | .BP0 | .BQ0 => 0
  | .BP1 | .BQ1 => 1
  | .BQ2 => 2
  | .BP2 n => 2 + n * 3
  | .BP3 n | .BQ3 n => 3 + n * 3
  | .BP4 n | .BQ4 n => 4 + n * 3
  | .BQ5 n => 5 + n * 3
def qi (b : Block) : List Letter:=symbol b :: List.replicate (gaps b) .Gap
def qa : Block -> Letter
  | .BP0 | .BQ1 => .Even
  | _ => .Odd
def qaz : Block -> List Letter
  | .BP1 | .BQ2 => [.Gap]
  | .BP2 n | .BQ3 n => [.Gap,.Gap] ++ List.replicate n .Even
  | .BP3 n | .BQ4 n => .Odd :: List.replicate n .Even
  | .BP4 n | .BQ5 n => [.Gap,.Even] ++ List.replicate n .Even
  | _ => []
def back (b : Block) : List Letter:=if q3 b then [] else [.Gap]
def q4 (b : Block) (f : Bool) : List Letter :=
  qaz b ++ [qO f (qa b)] ++ back b
lemma block_path (b : Block) (f : Bool) (h : b ≠ .BQ0) :
    TransPath 12 (qi b) (q4 b f) (qa6 f):= by
  cases b with
  | BP0 => exact p0_path f
  | BP1 => exact p1_path f
  | BP2 n =>
    simpa [q4,qaz,qa,back,q3,List.append_assoc] using!
      qbp .Even 2 [.Gap,.Gap] 45 ([qO f .Odd] ++ []) n (qa6 f) p2_prefix p_loop (p_suffix f)
  | BP3 n =>
    simpa [q4,qaz,qa,back,q3,List.append_assoc] using!
      qbp .Even 3 [.Odd] 45 ([qO f .Odd] ++ []) n (qa6 f) p3_prefix p_loop (p_suffix f)
  | BP4 n =>
    simpa [q4,qaz,qa,back,q3,List.append_assoc] using!
      qbp .Even 4 [.Gap,.Even] 45 ([qO f .Odd] ++ []) n (qa6 f) p4_prefix p_loop (p_suffix f)
  | BQ0 => contradiction
  | BQ1 => exact q1_path f
  | BQ2 => exact q2_path f
  | BQ3 n =>
    simpa [q4,qaz,qa,back,q3,List.append_assoc] using!
      qbp .Odd 3 [.Gap,.Gap] 27 ([qO f .Odd] ++ [.Gap]) n (qa6 f) q3_prefix q_loop (q_suffix f)
  | BQ4 n =>
    simpa [q4,qaz,qa,back,q3,List.append_assoc] using!
      qbp .Odd 4 [.Odd] 27 ([qO f .Odd] ++ [.Gap]) n (qa6 f) q4_prefix q_loop (q_suffix f)
  | BQ5 n =>
    simpa [q4,qaz,qa,back,q3,List.append_assoc] using!
      qbp .Odd 5 [.Gap,.Even] 27 ([qO f .Odd] ++ [.Gap]) n (qa6 f) q5_prefix q_loop (q_suffix f)
def qb : List Block -> List Letter
  | [] => []
  | b :: xs => qi b ++ qb xs
def q6 : List Block -> Bool
  | .BQ0 :: xs => !(q6 xs)
  | _ => false
def qM : List Block -> List Letter
  | [] => []
  | .BQ0 :: xs => [.Gap,.Gap,.Gap] ++ qM xs
  | b :: xs => q4 b (q6 xs) ++ qM xs
lemma blocks_path (xs : List Block) :
    TransPath (qa6 (q6 xs)) (qb xs) (qM xs) 12:= by
  induction xs with
  | nil => exact TransPath.nil 12
  | cons b xs ih =>
    by_cases h : b=.BQ0
    · subst h; exact q8 (bare_path (q6 xs)) ih
    · have hnf : q6 (b :: xs)=false:= by cases b <;> first | contradiction | rfl
      have hout : qM (b :: xs)=q4 b (q6 xs) ++ qM xs:= by
        cases b <;> first | contradiction | rfl
      rw [hnf,qb,hout]
      exact q8 (block_path b (q6 xs) h) ih
def qu (j : Nat) : List Letter :=
  match j with
  | 0 => [.Odd]
  | 1 => [.Gap]
  | _ => [.Gap,.Gap]
def q9 (j q : Nat) : Nat :=
  q + match j with | 0 => 0 | _ => 1
lemma tail_repeats (n : Nat) : TransPath 57 [] (List.replicate n .Even) 57:= by
  induction n with
  | zero => exact TransPath.nil 57
  | succ n ih =>
    simpa using! q8 tail_loop ih
lemma tail_path (j n : Nat) (hj : j < 3) :
    TransPath 12 [.Even] (qu j ++ List.replicate (4 + n) .Even) 57:= by
  rw [List.replicate_add,<- List.append_assoc]
  have hpre : TransPath 12 [.Even] (qu j ++ List.replicate 4 .Even) 57:= by
    rcases j with _ | _ | _ | j
    · exact tail0_prefix
    · exact tail1_prefix
    · exact tail2_prefix
    · omega
  simpa using! q8 hpre (tail_repeats n)
def qL (xs : List Block) : List Letter :=
  qO (q6 xs) .Odd :: qM xs
lemma boundary_path (xs : List Block) (j n : Nat) (hj : j < 3) :
    TransPath qv (qb xs ++ [.Even])
      (qL xs ++ qu j ++ List.replicate (4 + n) .Even) 57:= by
  unfold qL qv
  have h1:=start_path (q6 xs)
  have h2:=blocks_path xs
  have h3:=tail_path j n hj
  have h23:=q8 h2 h3
  have h123:=q8 h1 h23
  simpa [List.append_assoc] using! h123
lemma macro_closed (xs : List Block) (j n : Nat) (hj : j < 3)
    (hl : qI (qb xs ++ [.Even])) :
    qI (qL xs ++ qu j ++ List.replicate (4 + n) .Even) :=
  qb5 (boundary_path xs j n hj) (by decide) hl
inductive BlocksRun : Nat -> List Block -> Nat -> Prop where
  | nil (s : Nat) : BlocksRun s [] s
  | cons (s : Nat) (b : Block) (s' : Nat) (xs : List Block) (s'' : Nat) :
      qau (q3 b) (gaps b) s=some s' ->
      BlocksRun s' xs s'' ->
      BlocksRun s (b :: xs) s''
lemma qbh (xs : List Block) (u q : Nat)
    (hu : u < q7) (hp : Path u (qb xs) q) (hf : (node q).final=true) :
    0 < qA u 0 /\ ∀ s,qA u 0 - 1 <= s ->
      ∃ t,BlocksRun s xs t /\ 28 <= t:= by
  induction xs generalizing u with
  | nil =>
    cases hp with
    | nil _ =>
      have hfin:=checked_final _ hu hf
      exact ⟨by omega,fun s hs => ⟨s,BlocksRun.nil s,by omega⟩⟩
  | cons b xs ih =>
    simp only [qb,qi,List.cons_append] at hp
    cases hp with
    | cons _ _ v _ _ he hr =>
      have hv:=(qG u (symbol b) v hu he).1
      rcases checked_gaps v (gaps b) (qb xs) q hv hr with ⟨z,hz,hp_z,hb_z⟩
      rcases ih z hz hp_z with ⟨hb0,hs_z⟩
      have hb_v:=hb_z hb0
      have he' : ((if q3 b then Letter.Even else Letter.Odd),v) ∈ (node u).edges:=he
      rcases checked_digit u v (q3 b) (gaps b) hu he' (by omega) with ⟨hu0,hstep⟩
      refine ⟨hu0,fun s hs => ?_⟩
      rcases hstep s hs with ⟨s',ha,hs'⟩
      rcases hs_z s' (by omega) with ⟨t,hrun,ht⟩
      exact ⟨t,BlocksRun.cons s b s' xs t ha hrun,ht⟩
lemma qaB (xs : List Block)
    (hl : qI (qb xs ++ [.Even])) :
    ∃ t,BlocksRun 11 xs t /\ 28 <= t:= by
  rcases hl with ⟨u,f,hu_st,hp,hfin⟩
  have hcap:=qap
  unfold qx at hcap
  rw [List.all_eq_true] at hcap
  have hu_ok:=hcap u hu_st
  simp only [Bool.and_eq_true,decide_eq_true_eq] at hu_ok
  rcases path_core (qb xs) u f hu_ok.1.1 hp hfin with ⟨q,hp_q,hq_fin⟩
  rcases qbh xs u q hu_ok.1.1 hp_q hq_fin with ⟨_,hs⟩
  exact hs 11 (by omega)
def qbn (p : Bool) (g : Nat) : Block :=
  if p then
    match g with
    | 0 => .BP0 | 1 => .BP1 | 2 => .BP2 0
    | _ => match g % 3 with | 0 => .BP3 (g / 3 - 1) | 1 => .BP4 (g / 3 - 1) | _ => .BP2 (g / 3)
  else
    match g with
    | 0 => .BQ0 | 1 => .BQ1 | 2 => .BQ2
    | _ => match g % 3 with | 0 => .BQ3 (g / 3 - 1) | 1 => .BQ4 (g / 3 - 1) | _ => .BQ5 (g / 3 - 1)
lemma qQ (p : Bool) (g : Nat) :
    qi (qbn p g)=(if p then .Even else .Odd) :: List.replicate g .Gap:= by
  cases p <;> (
    rcases g with _ | _ | _ | g
    · rfl
    · rfl
    · rfl
    · unfold qbn
      simp only [↓reduceIte,Bool.false_eq_true]
      have hmod : (g + 3) % 3=0 \/ (g + 3) % 3=1 \/ (g + 3) % 3=2:= by omega
