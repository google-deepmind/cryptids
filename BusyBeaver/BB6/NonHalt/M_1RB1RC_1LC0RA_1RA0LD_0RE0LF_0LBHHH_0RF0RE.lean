    ∃ xs,qb xs=d :: w:= by
  rcases words_blocks w with ⟨g,xs,rfl⟩
  cases d with
  | Odd =>
    refine ⟨qbn false g :: xs,?_⟩
    simp only [qb,qQ,↓reduceIte,Bool.false_eq_true,List.cons_append]
  | Even =>
    refine ⟨qbn true g :: xs,?_⟩
    simp only [qb,qQ,↓reduceIte,List.cons_append]
  | Gap => contradiction
