def qf : List Letter -> List Letter
  | [] => []
  | .Odd :: w => .Even :: w
  | .Even :: w => .Odd :: w
  | .Gap :: w => .Gap :: qf w
lemma qP (w : List Letter) : qf (qf w)=w:= by
  induction w with
  | nil => rfl
  | cons c w ih => cases c <;> simp [qf,ih]
lemma toggle_gaps (n : Nat) (w : List Letter) :
    qf (List.replicate n .Gap ++ w)=List.replicate n .Gap ++ qf w:= by
  induction n with
  | zero => rfl
  | succ n ih => simp [List.replicate_succ,qf,ih]
lemma gaps_cons (n : Nat) (w : List Letter) :
    List.replicate n .Gap ++ .Gap :: w=List.replicate (n + 1) .Gap ++ w:= by
  rw [List.replicate_succ',List.append_assoc,List.singleton_append]
inductive Counter : List Letter -> Nat -> ListBlank (Fin 2) -> Prop where
  | c0 : Counter [] 0 default
  | c1 {w s l} : Counter w s l -> Counter (.Odd :: w) (4 * (s / 2) + 3) (l <+ e1)
  | c2 {w s l} : Counter w s l -> Counter (.Even :: w) (4 * (s / 2) + 2) (l <+ e2)
  | c3 {w s l} : Counter w s l -> Counter (.Odd :: w) (4 * (s / 2) + 1) (l <+ e3)
  | c4 {w s l} : Counter w s l -> Counter (.Even :: w) (4 * (s / 2)) (l <+ e4)
  | c_gap {w s l} (n : Nat) : Counter w s l -> Counter (List.replicate n .Gap ++ w) s (l <+ gap n)
lemma qb8 (m : Nat) :
    ∀ w s l,Counter w s l -> s < m -> 0 < s ->
    ∃ l',Counter (qf w) (s - 1) l' /\ J l l':= by
  induction m with
  | zero => intro _ _ _ _ hs _; omega
  | succ m ihm =>
    intro w s l hc
    induction hc with
    | c0 => intro _ hp; omega
    | @c1 w s l hc _ =>
      intro _ _
      refine ⟨l <+ e2,?_,J1 l⟩
      have heq : 4 * (s / 2) + 3 - 1=4 * (s / 2) + 2:= by omega
      rw [heq]; exact Counter.c2 hc
    | @c2 w s l hc _ =>
      intro _ _
      refine ⟨l <+ e3,?_,J2 l⟩
      have heq : 4 * (s / 2) + 2 - 1=4 * (s / 2) + 1:= by omega
      rw [heq]; exact Counter.c3 hc
    | @c3 w s l hc _ =>
      intro _ _
      refine ⟨l <+ e4,?_,J3 l⟩
      have heq : 4 * (s / 2) + 1 - 1=4 * (s / 2):= by omega
      rw [heq]; exact Counter.c4 hc
    | @c4 w s l hc _ =>
      intro hb hp
      have hs2 : 2 <= s:= by omega
      have hsm : s < m:= by omega
      rcases ihm w s l hc hsm (by omega) with ⟨l',hc',hj⟩
      rcases ihm (qf w) (s - 1) l' hc' (by omega) (by omega) with ⟨l'',hc'',hj'⟩
      rw [qP] at hc''
      refine ⟨l'' <+ e1,?_,J4 hj hj'⟩
      have heq : 4 * (s / 2) - 1=4 * ((s - 1 - 1) / 2) + 3:= by omega
      rw [heq]; exact Counter.c1 hc''
    | @c_gap w s l n hc ih =>
      intro hb hp
      rcases ih hb hp with ⟨l',hc',hj⟩
      refine ⟨l' <+ gap n,?_,J_gaps n hj⟩
      rw [toggle_gaps]; exact Counter.c_gap n hc'
lemma qaq {w : List Letter} {s : Nat} {l : ListBlank (Fin 2)}
    (hc : Counter w s l) (hs : 0 < s) :
    ∃ l',Counter (qf w) (s - 1) l' /\ J l l' :=
  qb8 (s + 1) w s l hc (by omega) hs
