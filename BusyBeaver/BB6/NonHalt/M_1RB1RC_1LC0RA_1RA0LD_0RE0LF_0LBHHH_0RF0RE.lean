def node (q : Nat) : CapRow:=qZ coreGraphTree q
def qA (q g : Nat) : Nat:=getBoundRow (node q) g
def qz (q : Nat) : Bool:=q == 378
inductive Path : Nat -> List Letter -> Nat -> Prop where
  | nil (q : Nat) : Path q [] q
  | cons (q : Nat) (c : Letter) (q' : Nat) (w : List Letter) (q'' : Nat) :
      (c,q') ∈ (node q).edges -> Path q' w q'' -> Path q (c :: w) q''
def qy (q : Nat) (c : Letter) (q' g : Nat) : Bool :=
  if qA q' g == 0 then true else
  match c with
  | .Gap => (0 < qA q (min 4 (g + 1))) && (qA q' g <= qA q (min 4 (g + 1)))
  | .Even => (0 < qA q 0) &&
      match qq true g (qA q 0 - 1) with
      | some t => qA q' g <= t + 1
      | none => false
  | .Odd => (0 < qA q 0) &&
      match qq false g (qA q 0 - 1) with
      | some t => qA q' g <= t + 1
      | none => false
def qbo (q : Nat) (e : Letter × Nat) : Bool :=
  (e.2 < q7) &&
  qy q e.1 e.2 0 &&
  qy q e.1 e.2 1 &&
  qy q e.1 e.2 2 &&
  qy q e.1 e.2 3 &&
  qy q e.1 e.2 4
def qa7 (r : CapRow) : Bool :=
  r.edges.any (fun e => qU e.1 .Even && qz e.2)
def qV (q : Nat) : Bool :=
  ((node q).final == qa7 (node q)) &&
  (if (node q).final then 29 <= qA q 0 else true) &&
  (node q).edges.all (qbo q)
def qag : Bool :=
  (List.range q7).all qV
lemma qaM : qag=true:= by decide
lemma qa9 (q : Nat) (hq : q < q7) : qV q=true:= by
  have h:=qaM
  unfold qag at h
  rw [List.all_eq_true] at h
  exact h q (List.mem_range.mpr hq)
lemma qaL (q : Nat) (hq : q < q7) :
    (node q).final=qa7 (node q):= by
  have h:=qa9 q hq
  unfold qV at h
  simp only [Bool.and_eq_true,beq_iff_eq] at h
  exact h.1.1
lemma checked_final (q : Nat) (hq : q < q7) (hf : (node q).final=true) :
    29 <= qA q 0:= by
  have h:=qa9 q hq
  unfold qV at h
  simp only [Bool.and_eq_true,hf,↓reduceIte,decide_eq_true_eq] at h
  exact h.1.2
lemma qG (q : Nat) (c : Letter) (q' : Nat)
    (hq : q < q7) (he : (c,q') ∈ (node q).edges) :
    q' < q7 /\ ∀ g,g < 5 -> qy q c q' g=true:= by
  have h:=qa9 q hq
  unfold qV at h
  simp only [Bool.and_eq_true] at h
  have hall:=h.2
  rw [List.all_eq_true] at hall
  have hedge:=hall (c,q') he
  unfold qbo at hedge
  simp only [Bool.and_eq_true,decide_eq_true_eq] at hedge
  refine ⟨hedge.1.1.1.1.1,?_⟩
  intro g hg
  rcases g with _ | _ | _ | _ | _ | g
  · exact hedge.1.1.1.1.2
  · exact hedge.1.1.1.2
  · exact hedge.1.1.2
  · exact hedge.1.2
  · exact hedge.2
  · omega
lemma checked_gap (q q' g : Nat) (hq : q < q7)
    (he : (.G,q') ∈ (node q).edges) (hg : g < 5) (hb : 0 < qA q' g) :
    qA q' g <= qA q (min 4 (g + 1)):= by
  have h:=(qG q .Gap q' hq he).2 g hg
  unfold qy at h
  have hne : (qA q' g == 0)=false:= by
    rw [beq_eq_false_iff_ne]; omega
  rw [hne] at h
  simp only [Bool.false_eq_true,↓reduceIte,Bool.and_eq_true,decide_eq_true_eq] at h
  exact h.2
lemma checked_gaps (q n : Nat) (w : List Letter) (f : Nat)
    (hq : q < q7) (hp : Path q (List.replicate n .Gap ++ w) f) :
    ∃ q',q' < q7 /\ Path q' w f /\
      (0 < qA q' 0 -> qA q' 0 <= qA q (min 4 n)):= by
  induction n generalizing q with
  | zero =>
    exact ⟨q,hq,hp,fun _ => Nat.le_refl _⟩
  | succ n ih =>
    simp only [List.replicate_succ,List.cons_append] at hp
    cases hp with
    | cons _ _ q1 _ _ he hr =>
      have hq1:=(qG q .Gap q1 hq he).1
      rcases ih q1 hq1 hr with ⟨q',hq',hr',hb⟩
      refine ⟨q',hq',hr',fun hpos => ?_⟩
      have hb1:=hb hpos
      have hg1:=checked_gap q q1 (min 4 n) hq he (by omega) (by omega)
      have hmin : min 4 (min 4 n + 1)=min 4 (n + 1):= by omega
      rw [hmin] at hg1
      omega
lemma checked_digit (q q' : Nat) (b : Bool) (g : Nat)
    (hq : q < q7)
    (he : ((if b then Letter.Even else Letter.Odd),q') ∈ (node q).edges)
    (hb : 0 < qA q' (min 4 g)) :
    0 < qA q 0 /\ ∀ s,qA q 0 - 1 <= s ->
      ∃ t,qau b g s=some t /\ qA q' (min 4 g) - 1 <= t:= by
  have h:=(qG q (if b then .Even else .Odd) q' hq he).2 (min 4 g) (by omega)
  unfold qy at h
  have hne : (qA q' (min 4 g) == 0)=false:= by
    rw [beq_eq_false_iff_ne]; omega
  rw [hne] at h
  cases b <;> (
    simp only [Bool.false_eq_true,↓reduceIte,Bool.and_eq_true,decide_eq_true_eq] at h
    rcases h with ⟨hpos,h⟩
    cases ha : qq _ (min 4 g) (qA q 0 - 1) with
    | none => rw [ha] at h; contradiction
    | some t0 =>
      rw [ha] at h
      simp only [decide_eq_true_eq] at h
      refine ⟨hpos,fun s hs => ?_⟩
      rcases qbj _ g (qA q 0 - 1) t0 s ha hs with ⟨t',ht',hle'⟩
      exact ⟨t',ht',by omega⟩
  )
def qaP : List Nat -> List Nat -> Bool
  | [],_ => true
  | _ :: _,[] => false
  | x :: xs,y :: ys =>
    if x == y then qaP xs ys else qaP (x :: xs) ys
lemma qax {xs ys : List Nat} (h : qaP xs ys=true) {q : Nat} (hq : q ∈ xs) :
    q ∈ ys:= by
  induction ys generalizing xs with
  | nil =>
    cases xs with
    | nil => contradiction
    | cons x xs' => contradiction
  | cons y ys' ih =>
    cases xs with
    | nil => contradiction
    | cons x xs' =>
      unfold qaP at h
      split_ifs at h with heq
      · have hx : x=y:=beq_iff_eq.mp heq
        rcases List.mem_cons.mp hq with rfl | hq'
        · rw [hx]; exact List.Mem.head _
        · exact List.Mem.tail _ (ih h hq')
      · exact List.Mem.tail _ (ih h hq)
structure Mask where
  vertices : List Nat
  sub_none : List Nat
  sub_odd  : List Nat
  sub_even : List Nat
  sub_gap  : List Nat
  odd_img  : List Nat
  odd_src  : List Nat
  even_img : List Nat
  even_src : List Nat
  gap_img  : List Nat
  gap_src  : List Nat
  accepting : Bool
def mask_sub (m : Mask) : Option Letter -> List Nat
  | none => m.sub_none
  | some .O => m.sub_odd
  | some .E => m.sub_even
  | some .G => m.sub_gap
def mask_img (m : Mask) : Letter -> List Nat
  | .Odd => m.odd_img
  | .Even => m.even_img
  | .Gap => m.gap_img
def mask_src (m : Mask) : Letter -> List Nat
  | .Odd => m.odd_src
  | .Even => m.even_src
  | .Gap => m.gap_src
