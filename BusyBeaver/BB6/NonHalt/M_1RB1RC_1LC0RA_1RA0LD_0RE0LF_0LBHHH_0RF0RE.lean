lemma q_loop : TransPath 27 [.Gap,.Gap,.Gap] [.Even] 27 :=
  q2 27 [(some .G,none,28),(some .G,none,29),(some .G,none,30),(none,some .E,27)] (by decide)
lemma q_suffix (f : Bool) : TransPath 27 [] ([qO f .Odd] ++ [.Gap]) (qa6 f):= by
  cases f
