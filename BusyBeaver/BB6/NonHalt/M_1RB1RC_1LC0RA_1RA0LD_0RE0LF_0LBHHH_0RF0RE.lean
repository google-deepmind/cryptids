lemma words_blocks (w : List Letter) :
    ∃ g xs,w=List.replicate g .Gap ++ qb xs:= by
  induction w with
  | nil => exact ⟨0,[],rfl⟩
  | cons c w ih =>
    rcases ih with ⟨g,xs,rfl⟩
    cases c with
    | Odd =>
      refine ⟨0,qbn false g :: xs,?_⟩
      simp only [List.replicate_zero,List.nil_append,qb,qQ,↓reduceIte,Bool.false_eq_true,List.cons_append]
    | Even =>
      refine ⟨0,qbn true g :: xs,?_⟩
      simp only [List.replicate_zero,List.nil_append,qb,qQ,↓reduceIte,List.cons_append]
    | Gap =>
      exact ⟨g + 1,xs,by simp [List.replicate_succ]⟩
