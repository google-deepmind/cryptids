    refine reachesP_step (s' := (.d0 [.b1, .w001 0, .w01 3, .b1, .w001 (v0 + 1)] [.b1 0]))
        (by step_plain_c0 (.c0 [.w001 Nat.zero, .w01 Nat.zero.succ.succ.succ, .b1,
            .w001 v0.succ] [.b1 Nat.zero]) (.d0 [.b1, .w001 0, .w01 3, .b1,
