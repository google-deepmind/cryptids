@[expose] public section

open Mathlib Relation Nat Turing BusyBeaver

namespace BusyBeaver.M_1RB1RF_1LC1LB_1RD1LD_1RE0RA_HHH0LB_0LF0RC

/-- The `(6, 2)` Turing machine in `ConjectureMachines.Machine` form. -/
def machine : ConjectureMachines.Machine 6 2 :=
  load_rle_machine% "1RB1RF_1LC1LB_1RD1LD_1RE0RA_---0LB_0LF0RC"

/-- The `(6, 2)` Turing machine in `BusyBeaver.Machine` form. -/
abbrev target : Machine (Fin 2) (Fin 6) :=
  machine.toBB

private def target_tm : Machine (Fin 2) (Fin 6)
  | 0, 0 => some (some 1, Stmt.write 1 Dir.right)
  | 0, 1 => some (some 5, Stmt.write 1 Dir.right)
  | 1, 0 => some (some 2, Stmt.write 1 Dir.left)
  | 1, 1 => some (some 1, Stmt.write 1 Dir.left)
  | 2, 0 => some (some 3, Stmt.write 1 Dir.right)
  | 2, 1 => some (some 3, Stmt.write 1 Dir.left)
  | 3, 0 => some (some 4, Stmt.write 1 Dir.right)
  | 3, 1 => some (some 0, Stmt.write 0 Dir.right)
  | 4, 0 => none
  | 4, 1 => some (some 1, Stmt.write 0 Dir.left)
  | 5, 0 => some (some 5, Stmt.write 0 Dir.left)
  | 5, 1 => some (some 2, Stmt.write 0 Dir.right)

private theorem target_eq_target_tm : target = target_tm := by
  funext q s
  fin_cases q <;> fin_cases s <;> rfl

section
variable {Γ Λ : Type*} [Inhabited Γ] [Inhabited Λ]


private theorem reachesIn_cast_flip {M : Machine Γ Λ} {m n : ℕ} {c₁ c₂ : Cfg Γ Λ}
    (e : m = n) (h : ReachesIn M m c₁ c₂) : ReachesIn M n c₁ c₂ :=
  e ▸ h

local macro "bb_refl_in" : tactic =>
  `(tactic| (
    try simp only [Cfg.headRight, Cfg.headLeft, init, Tape.mk₁, Tape.mk₂, Tape.mk',
      List.cons_append, List.nil_append, List.append_nil,
      ListBlank.mk_nil, ListBlank.append, ListBlank.head_cons, ListBlank.tail_cons,
      ListBlank.head_default, ListBlank.head_default_fin, ListBlank.tail_default,
      ListBlank.cons_default_default, ListBlank.cons_zero_default]
    exact ReachesIn.zero _ _))

local macro "bb_step_in" : tactic =>
  `(tactic| (
    refine ReachesIn.step_left (by
        try simp only [Cfg.headRight, Cfg.headLeft, init, Tape.mk₁, Tape.mk₂, Tape.mk',
          List.cons_append, List.nil_append, List.append_nil,
          ListBlank.mk_nil, ListBlank.append, ListBlank.head_cons, ListBlank.tail_cons,
          ListBlank.head_default, ListBlank.head_default_fin, ListBlank.tail_default,
          ListBlank.cons_default_default, ListBlank.cons_zero_default]
        rfl) ?_
    try simp only [Tape.write, Tape.move, ListBlank.head_cons, ListBlank.tail_cons,
      ListBlank.head_default, ListBlank.head_default_fin, ListBlank.tail_default,
      ListBlank.cons_default_default, ListBlank.cons_zero_default]))

local macro "bb_steps_in" : tactic =>
  `(tactic| repeat (first | bb_refl_in | bb_step_in))

/-- Compressed head-outward left-tape tokens (`w01 n` = `[0,1]^(n+1)`, `w001 n` =
    `[0,0,1]^(n+1)`). -/
private inductive TokL where
  | b0 : TokL
  | b1 : TokL
  | w01 : ℕ → TokL
  | w001 : ℕ → TokL
  deriving DecidableEq

/-- Compressed head-outward right-tape tokens. -/
private inductive TokR where
  | b0 : TokR
  | b1 : ℕ → TokR
  | w110 : ℕ → TokR
  | w1110 : ℕ → TokR
  | w31 : ℕ → TokR
  deriving DecidableEq

/-- Compressed macro state space (`c0` = `[C:0]`, `d0` = `[D:0]` facing `1`, `b1` = `[B:1]`). -/
private inductive State where
  | c0 : List TokL → List TokR → State
  | d0 : List TokL → List TokR → State
  | b1 : List TokL → List TokR → State
  deriving DecidableEq

private def start : State := .d0 [] [.b1 0]

private def pushW01 (n : ℕ) : List TokL → List TokL
  | .w01 m :: ls => .w01 (n + m + 1) :: ls
  | ls => .w01 n :: ls

private def pushW001 (n : ℕ) : List TokL → List TokL
  | .w001 m :: ls => .w001 (n + m + 1) :: ls
  | ls => .w001 n :: ls

private def pushW001Opt : ℕ → List TokL → List TokL
  | 0, ls => ls
  | k + 1, ls => pushW001 k ls

private def pushB0L : List TokL → List TokL
  | [] => []
  | .b1 :: ls => pushW01 0 ls
  | .b0 :: .b1 :: ls => pushW001 0 ls
  | .w01 0 :: ls => pushW001 0 ls
  | .w01 (n + 1) :: ls => pushW001 0 (.w01 n :: ls)
  | ls => .b0 :: ls

private def pushB1L (ls : List TokL) : List TokL := .b1 :: ls

private def popBitL : List TokL → Fin 2 × List TokL
  | [] => (0, [])
  | .b0 :: ls => (0, ls)
  | .b1 :: ls => (1, ls)
  | .w01 0 :: ls => (0, .b1 :: ls)
  | .w01 (n + 1) :: ls => (0, .b1 :: .w01 n :: ls)
  | .w001 0 :: ls => (0, .w01 0 :: ls)
  | .w001 (n + 1) :: ls => (0, .w01 0 :: .w001 n :: ls)

private def pushW110 (n : ℕ) : List TokR → List TokR
  | .w110 m :: rs => .w110 (n + m + 1) :: rs
  | rs => .w110 n :: rs

private def pushW1110 (n : ℕ) : List TokR → List TokR
  | .w1110 m :: rs => .w1110 (n + m + 1) :: rs
  | rs => .w1110 n :: rs

private def pushW1110Opt : ℕ → List TokR → List TokR
  | 0, rs => rs
  | k + 1, rs => pushW1110 k rs

private def pushW31 (n : ℕ) : List TokR → List TokR
  | .w31 m :: rs => .w31 (n + m + 1) :: rs
  | rs => .w31 n :: rs

private def pushB0R : List TokR → List TokR
  | [] => []
  | rs => .b0 :: rs

private def pushB1R (n : ℕ) (rs : List TokR) : List TokR :=
  let (tot, rest) := match rs with
    | .b1 m :: rs' => (n + m + 1, rs')
    | _ => (n, rs)
  if tot = 1 then
    match rest with
    | [] => [.w110 0]
    | .b0 :: rs' => pushW110 0 rs'
    | _ => .b1 1 :: rest
  else if tot = 2 then
    match rest with
    | [] => [.w1110 0]
    | .b0 :: rs' => pushW1110 0 rs'
    | _ => .b1 2 :: rest
  else
    .b1 tot :: rest

private def popBitR : List TokR → Fin 2 × List TokR
  | [] => (0, [])
  | .b0 :: rs => (0, rs)
  | .b1 0 :: rs => (1, rs)
  | .b1 (n + 1) :: rs => (1, .b1 n :: rs)
  | .w110 0 :: rs => (1, .b1 0 :: .b0 :: rs)
  | .w110 (n + 1) :: rs => (1, .b1 0 :: .b0 :: .w110 n :: rs)
  | .w1110 0 :: rs => (1, .b1 1 :: .b0 :: rs)
  | .w1110 (n + 1) :: rs => (1, .b1 1 :: .b0 :: .w1110 n :: rs)
  | .w31 0 :: rs => (1, .b1 1 :: .b0 :: .b1 0 :: .b0 :: rs)
  | .w31 (n + 1) :: rs => (1, .b1 1 :: .b0 :: .b1 0 :: .b0 :: .w31 n :: rs)

/-- Zero-allocation bit-prefix predicates & total peel helpers on `List TokR`. -/
private def headBit1R : List TokR → Bool
  | [] => false
  | .b0 :: _ => false
  | _ => true

private def is2OnesR : List TokR → Bool
  | .b1 0 :: rs => headBit1R rs
  | .b1 (_ + 1) :: _ => true
  | .w110 _ :: _ => true
  | .w1110 _ :: _ => true
  | .w31 _ :: _ => true
  | _ => false

private def pop2OnesR : List TokR → List TokR
  | .b1 0 :: rs => (popBitR rs).2
  | .b1 1 :: rs => rs
  | .b1 (k + 2) :: rs => .b1 k :: rs
  | .w110 0 :: rs => .b0 :: rs
  | .w110 (n + 1) :: rs => .b0 :: .w110 n :: rs
  | .w1110 0 :: rs => .b1 0 :: .b0 :: rs
  | .w1110 (n + 1) :: rs => .b1 0 :: .b0 :: .w1110 n :: rs
  | .w31 0 :: rs => .b1 0 :: .b0 :: .b1 0 :: .b0 :: rs
  | .w31 (n + 1) :: rs => .b1 0 :: .b0 :: .b1 0 :: .b0 :: .w31 n :: rs
  | rs => rs

private def is4OnesR : List TokR → Bool
  | .b1 (_ + 3) :: _ => true
  | .b1 1 :: .w110 _ :: _ => true
  | .b1 0 :: .w1110 _ :: _ => true
  | _ => false

private def pop4OnesR : List TokR → List TokR
  | .b1 3 :: rs => rs
  | .b1 (k + 4) :: rs => .b1 k :: rs
  | .b1 1 :: .w110 0 :: rs => .b0 :: rs
  | .b1 1 :: .w110 (n + 1) :: rs => .b0 :: .w110 n :: rs
  | .b1 0 :: .w1110 0 :: rs => .b0 :: rs
  | .b1 0 :: .w1110 (n + 1) :: rs => .b0 :: .w1110 n :: rs
  | rs => rs

private def is2OnesAfterPop4R : List TokR → Bool
  | .b1 3 :: rs => is2OnesR rs
  | .b1 4 :: rs => headBit1R rs
  | .b1 (_ + 5) :: _ => true
  | _ => false

/-! ### Reusable Level-5 Transition & Cost Subroutines -/

private def nextLoopIIBridgeIII (n0 : ℕ) (rTail : List TokR) : State :=
  let p := n0 / 2
  let m := p + 1
  let (na0, nb0) := if n0 % 2 = 0 then (4, 3) else (3, 4)
  let q := m / 2
  let na := na0 + 3 * q
  let nb := nb0 + 3 * q
  if m % 2 = 0 then
    .c0 [] (pushW110 na (pushW1110 nb rTail))
  else if is2OnesR rTail then
    .c0 [] (pushW110 (na + 2) (pushW1110 (nb + 2) (pop2OnesR rTail)))
  else
    .c0 [] (pushW110 na (pushW1110 nb (pushW31 0 rTail)))

private def costLoopIIBridgeIIIFlag (n0 : ℕ) (has2Ones : Bool) : ℕ :=
  let p := n0 / 2
  let m := p + 1
  let (na0, nb0, cBr) := if n0 % 2 = 0 then (4, 3, 293) else (3, 4, 294)
  let q := m / 2
  let tot := 62 * m + cBr + q * (90 * q + 287)
  if m % 2 = 0 then
    tot
  else if has2Ones then
    let na := na0 + 3 * q
    let nb := nb0 + 3 * q
    tot + 20 * (na + nb) + 96
  else
    tot

private def popW001Tail : ℕ → List TokL → List TokL
  | 0, ls => ls
  | c + 1, ls => .w001 c :: ls

private def popW110Tail : ℕ → List TokR → List TokR
  | 0, rs => rs
  | k + 1, rs => .w110 k :: rs

private def nextFinishLoopV (na2 nb2 : ℕ) (rTail2 : List TokR) : State :=
  match rTail2 with
  | .w110 n2 :: rs =>
    .c0 [] (pushW110 (na2 + 2) (pushW1110 (nb2 + 1) (pushB0R (popW110Tail n2 rs))))
  | _ =>
    if headBit1R rTail2 then
      .c0 [] (pushW110 (na2 + 1) (pushW1110 nb2 (pushB1R 2 (popBitR rTail2).2)))
    else
      .c0 [] (pushW110 na2 (pushW1110 nb2 (pushB1R 0 (pushB0R rTail2))))

private def costFinishLoopV (na2 nb2 : ℕ) (rTail2 : List TokR) (dtSoFar : ℕ) : ℕ :=
  match rTail2 with
  | .w110 _ :: _ => dtSoFar + 20 * (na2 + nb2) + 76
  | _ =>
    if headBit1R rTail2 then
      dtSoFar + 10 * (na2 + nb2) + 31
    else
      dtSoFar

/-! ### Fallback & Level-2 Sweep Subroutines -/

private def nextC0Fallback (L : List TokL) (R : List TokR) : Option State :=
  let (r0, R1) := popBitR R
  let (r1, R2) := popBitR R1
  if r0 = 0 then
    if r1 = 0 then none else some (.d0 (pushB1L L) R2)
  else
    let (r2, R3) := popBitR R2
    if r1 = 0 then
      if r2 = 0 then
        some (.d0 (pushB1L L) (pushB1R 0 R3))
      else
        let (l0, L1) := popBitL L
        if l0 = 0 then
          some (.d0 L1 (pushB1R 2 R3))
        else
          some (.d0 (pushB1L (pushB0L L1)) (pushB1R 0 R3))
    else
      if r2 = 0 then
        some (.c0 (pushW001 0 L) R3)
      else
        let (r3, R4) := popBitR R3
        if r3 = 0 then
          some (.c0 (pushW01 1 L) R4)
        else
          some (.d0 (pushB1L (pushB0L (pushB1L L))) R4)

private def costC0Fallback (L : List TokL) (R : List TokR) : ℕ :=
  let (r0, R1) := popBitR R
  let (r1, R2) := popBitR R1
  if r0 = 0 then
    if r1 = 0 then 0 else 1
  else
    let (r2, R3) := popBitR R2
    if r1 = 0 then
      if r2 = 0 then 5
      else if (popBitL L).1 = 0 then 7 else 11
    else
      if r2 = 0 then 5
      else if (popBitR R3).1 = 0 then 4 else 5

private def nextC0SweepOrFallback (L : List TokL) : List TokR → Option State
  | .w110 n :: R' => some (.c0 (pushW001 n L) R')
  | .w1110 n :: R' => some (.c0 (pushW01 (2 * n + 1) L) R')
  | R => nextC0Fallback L R

private def costC0SweepOrFallback (L : List TokL) : List TokR → ℕ
  | .w110 n :: _ => 5 * (n + 1)
  | .w1110 n :: _ => 4 * (n + 1)
  | R => costC0Fallback L R

private def nextC0ClimbOrSweep (L : List TokL) (R : List TokR) : Option State :=
  match L, R with
  | .b1 :: L', .w1110 nb :: rAfter =>
    if is4OnesR rAfter then
      let r4 := pop4OnesR rAfter
      match L' with
      | [.w001 (n0 + 3)] => some (nextLoopIIBridgeIII n0 (pushW1110Opt nb r4))
      | _ => some (.d0 (.b1 :: pushB0L L') (pushB1R 0 (pushB0R (pushW1110 nb r4))))
    else
      nextC0SweepOrFallback L R
  | _, _ => nextC0SweepOrFallback L R

private def costC0ClimbOrSweep (L : List TokL) (R : List TokR) : ℕ :=
  match L, R with
  | .b1 :: L', .w1110 nb :: rAfter =>
    if is4OnesR rAfter then
      let dt := 10 * nb + 25
      match L' with
      | [.w001 (n0 + 3)] =>
        let has2 := if nb > 0 then true else is2OnesAfterPop4R rAfter
        dt + 27 + costLoopIIBridgeIIIFlag n0 has2
      | _ => dt
    else
      costC0SweepOrFallback L R
  | _, _ => costC0SweepOrFallback L R

private def nextC0DiveOrClimb (L : List TokL) (R : List TokR) : Option State :=
  match R with
  | .w110 na :: .w1110 nb :: .b0 :: rt =>
    match rt with
    | .w1110 (nc0 + 1) :: .b0 :: rt2 =>
      if headBit1R rt2 then
        let L1 := .b1 :: pushW001Opt na L
        some (.c0 (.b1 :: pushW01 (2 * nb + 3) L1) (pushW1110 (nc0 + 1) (popBitR rt2).2))
      else
        some (.c0 (.b1 :: pushW001Opt na L) (pushW1110 (nb + 1) (popBitR rt).2))
    | _ =>
      if headBit1R rt then
        some (.c0 (.b1 :: pushW001Opt na L) (pushW1110 (nb + 1) (popBitR rt).2))
      else
        nextC0ClimbOrSweep L R
  | .w1110 nb :: .b1 1 :: .b0 :: .w1110 nc :: .b0 :: rt =>
    if headBit1R rt then
      some (.c0 (.b1 :: pushW01 (2 * nb + 1) L) (pushW1110 (nc + 1) (popBitR rt).2))
    else
      nextC0ClimbOrSweep L R
  | [.w1110 nb, .b1 0] =>
    some (.d0 (.b1 :: L) [.w1110 nb, .b1 0])
  | _ => nextC0ClimbOrSweep L R

private def costC0DiveOrClimb (L : List TokL) (R : List TokR) : ℕ :=
  match R with
  | .w110 na :: .w1110 nb :: .b0 :: rt =>
    match rt with
    | .w1110 (nc0 + 1) :: .b0 :: rt2 =>
      if headBit1R rt2 then
        5 * na + 14 * nb + 10 * nc0 + 50
      else
        5 * na + 10 * nb + 21
    | _ =>
      if headBit1R rt then
        5 * na + 10 * nb + 21
      else
        costC0ClimbOrSweep L R
  | .w1110 nb :: .b1 1 :: .b0 :: .w1110 nc :: .b0 :: rt =>
    if headBit1R rt then
      4 * nb + 10 * nc + 25
    else
      costC0ClimbOrSweep L R
  | [.w1110 nb, .b1 0] =>
    10 * nb + 15
  | _ => costC0ClimbOrSweep L R

private def nextC0Blank (na nb : ℕ) (rMid : List TokR) : Option State :=
  match rMid with
  | .b1 (k0 + 3) :: .b0 :: rt =>
    let m := k0 / 4 + 1
    let rem := k0 % 4
    match rem, rt with
    | 1, .w1110 nm :: rt2 =>
      let mv := nm + 1
      some (nextFinishLoopV (na + m + 2 * mv) (nb + m + mv) rt2)
    | _, _ =>
      let rRem := if rem = 0 then pushB0R rt else pushB1R (rem - 1) (pushB0R rt)
      some (.c0 [] (pushW110 (na + m) (pushW1110 (nb + m) rRem)))
  | [.b1 (k0 + 3)] =>
    let m := k0 / 4 + 1
    let rem := k0 % 4
    let rRem := if rem = 0 then [] else pushB1R (rem - 1) []
    some (.c0 [] (pushW110 (na + m) (pushW1110 (nb + m) rRem)))
  | .b1 0 :: .w1110 nc :: rt =>
    let rAfter4 := pushB0R (pushW1110Opt nc rt)
    some (.c0 [] (pushW110 (na + 1) (pushW1110 (nb + 1) rAfter4)))
  | .w31 (n31 + 1) :: rt =>
    let m := n31 / 2 + 1
    let rTail := if n31 % 2 = 0 then rt else .w31 0 :: rt
    some (.c0 [] (pushW110 (na + 3 * m) (pushW1110 (nb + 3 * m) rTail)))
  | .w31 0 :: rt =>
    if headBit1R rt then
      some (.c0 [] (pushW110 (na + 1) (pushW1110 (nb + 1) (pushB1R 2 (popBitR rt).2))))
    else
      nextC0DiveOrClimb [] (.w110 na :: .w1110 nb :: rMid)
  | .b1 0 :: .b0 :: rt =>
    match rt with
    | .w1110 nm :: rt2 =>
      let mv := nm + 1
      some (nextFinishLoopV (na + 2 * mv) (nb + mv) rt2)
    | .b0 :: rt2 =>
      some (.c0 (.b1 :: pushW001Opt na []) (pushW1110 (nb + 1) (pushB1R 0 rt2)))
    | _ =>
      if headBit1R rt then
        some (.c0 [] (pushW110 (na + 1) (pushW1110 nb (pushB1R 2 (popBitR rt).2))))
      else
        nextC0DiveOrClimb [] (.w110 na :: .w1110 nb :: rMid)
  | .w110 na2 :: .w1110 nc :: .b0 :: rt =>
    if headBit1R rt then
      let lBase := pushW01 (2 * nb + 1) (pushW001 na [])
      some (.c0 (.b1 :: pushW001Opt na2 lBase) (pushW1110 (nc + 1) (popBitR rt).2))
    else
      nextC0DiveOrClimb [] (.w110 na :: .w1110 nb :: rMid)
  | _ => nextC0DiveOrClimb [] (.w110 na :: .w1110 nb :: rMid)

private def costC0Blank (na nb : ℕ) (rMid : List TokR) : ℕ :=
  let a := na + 1
  let b := nb + 1
  match rMid with
  | .b1 (k0 + 3) :: .b0 :: rt =>
    let m := k0 / 4 + 1
    let rem := k0 % 4
    let dtIV := m * (10 * (a + b + m) + 5)
    match rem, rt with
    | 1, .w1110 nm :: rt2 =>
      let mv := nm + 1
      let na1 := na + m
      let nb1 := nb + m
      let dtV := mv * (20 * (na1 + nb1 + 2) + 30 * mv + 6)
      costFinishLoopV (na1 + 2 * mv) (nb1 + mv) rt2 (dtIV + dtV)
    | _, _ => dtIV
  | [.b1 (k0 + 3)] =>
    let m := k0 / 4 + 1
    m * (10 * (a + b + m) + 5)
  | .b1 0 :: .w1110 _ :: _ =>
    10 * (a + b) + 15
  | .w31 (n31 + 1) :: _ =>
    let m := n31 / 2 + 1
    m * (30 * (a + b + 3 * m) + 17)
  | .w31 0 :: rt =>
    if headBit1R rt then
      10 * (a + b) + 21
    else
      costC0DiveOrClimb [] (.w110 na :: .w1110 nb :: rMid)
  | .b1 0 :: .b0 :: rt =>
    match rt with
    | .w1110 nm :: rt2 =>
      let mv := nm + 1
      let dtV := mv * (20 * (a + b) + 30 * mv + 6)
      costFinishLoopV (na + 2 * mv) (nb + mv) rt2 dtV
    | .b0 :: _ =>
      5 * a + 10 * b + 10
    | _ =>
      if headBit1R rt then
        10 * (a + b) + 11
      else
        costC0DiveOrClimb [] (.w110 na :: .w1110 nb :: rMid)
  | .w110 na2 :: .w1110 nc :: .b0 :: rt =>
    if headBit1R rt then
      5 * a + 4 * b + 5 * (na2 + 1) + 10 * (nc + 1) + 6
    else
      costC0DiveOrClimb [] (.w110 na :: .w1110 nb :: rMid)
  | _ => costC0DiveOrClimb [] (.w110 na :: .w1110 nb :: rMid)

private def nextC0 (L : List TokL) (R : List TokR) : Option State :=
  match L, R with
  -- 1. BottomDoubleTurn + Climb chains
  | _, [.w1110 nb, .b1 1, .b0, .w1110 nc, .b1 0] =>
    let R1 := pushW1110Opt nb [.b1 1, .w110 0, .w1110 (nc + 1), .b1 0]
    match L with
    | [.b1, .w01 k1, .b1, .w001 (na + 2)] =>
      if k1 % 2 = 1 then
        let p2 := k1 / 2
        let R2 := pushW1110Opt p2 (pushB1R 1 (pushW110 0 R1))
        match R2 with
        | .w1110 nb2 :: rt2 =>
          let ra4 := pushB0R (pushW1110Opt nb2 rt2)
          some (.c0 [] (pushW110 (na + 2) (pushW1110 2 ra4)))
        | _ =>
          some (.c0 [] (pushW110 (na + 1) (pushW1110 1 (pushB1R 0 R2))))
      else
        some (.d0 (.b1 :: L) R1)
    | [.b1, .w01 k1, .w001 (n0 + 4)] =>
      if k1 % 2 = 1 then
        let p2 := k1 / 2
        let rTail := pushW1110Opt p2 (pushB0R R1)
        some (nextLoopIIBridgeIII n0 rTail)
      else
        some (.d0 (.b1 :: L) R1)
    | _ => some (.d0 (.b1 :: L) R1)
  -- 2. MidDiveClimb1111 (+ optional Pre27 + LoopII_Bridge_III)
  | .b1 :: L', .w1110 nb :: .b1 1 :: .b0 :: .w1110 nc :: .b1 1 :: .w110 n2 :: rt =>
    let r4 := pushB0R (popW110Tail n2 rt)
    let rMid := pushW1110Opt nb (pushW110 0 (pushW1110 (nc + 1) r4))
    match L', rMid with
    | [.w001 (n0 + 3)], .w1110 nbTop :: rRest =>
      some (nextLoopIIBridgeIII n0 (pushW1110Opt nbTop rRest))
    | _, _ =>
      some (.d0 (.b1 :: pushB0L L') (pushB1R 0 (pushB0R rMid)))
  -- 3a. Loop I (variant A: explicit b1 run >= 3 ones + 21-step exit)
  | .b1 :: .w01 n :: L', .w1110 0 :: .b1 0 :: .b0 :: .b1 (k0 + 2) :: rt =>
    let m := n + 1
    some (.d0 (.b1 :: pushB0L L') (pushB1R 0 (pushB0R (pushB1R (k0 + 2 * m + 4) rt))))
  -- 3b. Loop I (variant B: w1110 block + 21-step exit, fused with D0_TailBlank + Bounce101 when L'
  -- = [.b1, .w001 na])
  | .b1 :: .w01 n :: L', .w1110 0 :: .b1 0 :: .b0 :: .w1110 n3 :: rt =>
    let m := n + 1
    let tail2 := pushW1110Opt n3 rt
    match L' with
    | [.b1, .w001 na] =>
      some (.c0 [] (pushW110 (na + 2) (pushW1110 0 (pushB1R (6 + 2 * m) (pushB0R tail2)))))
    | _ =>
      some (.d0 (.b1 :: pushB0L L') (pushB1R 0 (pushB0R (pushB1R (4 + 2 * m) (pushB0R tail2)))))
  -- 4a. Loop II (explicit b0, fused with Bridge + LoopIII when L' = [])
  | .b1 :: .w001 (n0 + 1) :: L', .w1110 1 :: .b1 4 :: .b0 :: rt =>
    match L' with
    | [] => some (nextLoopIIBridgeIII n0 rt)
    | _ =>
      let p := n0 / 2
      let lNew := if n0 % 2 = 0 then .b1 :: L' else .b1 :: .w001 0 :: L'
      some (.c0 lNew (.w1110 1 :: .b1 4 :: .b0 :: pushW31 p rt))
  -- 4b. Loop II (blank right end)
  | .b1 :: .w001 (n0 + 1) :: L', [.w1110 1, .b1 4] =>
    match L' with
    | [] => some (nextLoopIIBridgeIII n0 [])
    | _ =>
      let p := n0 / 2
      let lNew := if n0 % 2 = 0 then .b1 :: L' else .b1 :: .w001 0 :: L'
      some (.c0 lNew (.w1110 1 :: .b1 4 :: .b0 :: pushW31 p []))
  -- 5. Blank-left C0 rules
  | [], .w110 na :: .w1110 nb :: rMid =>
    nextC0Blank na nb rMid
  | _, _ =>
    nextC0DiveOrClimb L R

private def costC0 (L : List TokL) (R : List TokR) : ℕ :=
  match L, R with
  | _, [.w1110 nb, .b1 1, .b0, .w1110 nc, .b1 0] =>
    let dt12 := 10 * nb + 20 * nc + 61
    match L with
    | [.b1, .w01 k1, .b1, .w001 (na + 2)] =>
      if k1 % 2 = 1 then
        let p2 := k1 / 2
        let dt3 := 6 * p2 + 7
        if p2 > 0 then dt12 + dt3 + 15 * na + 111 else dt12 + dt3 + 5 * na + 56
      else
        dt12
    | [.b1, .w01 k1, .w001 (n0 + 4)] =>
      if k1 % 2 = 1 then
        let p2 := k1 / 2
        dt12 + (16 * p2 + 37) + 27 + costLoopIIBridgeIIIFlag n0 (decide (p2 > 0))
      else
        dt12
    | _ => dt12
  | .b1 :: L', .w1110 nb :: .b1 1 :: .b0 :: .w1110 nc :: .b1 1 :: .w110 _ :: _ =>
    let dt := 10 * nb + 10 * nc + 45
    match L', nb with
    | [.w001 (n0 + 3)], _ + 1 =>
      dt + 27 + costLoopIIBridgeIIIFlag n0 true
    | _, _ => dt
  | .b1 :: .w01 n :: _, .w1110 0 :: .b1 0 :: .b0 :: .b1 (_ + 2) :: _ =>
    26 * (n + 1) + 21
  | .b1 :: .w01 n :: L', .w1110 0 :: .b1 0 :: .b0 :: .w1110 _ :: _ =>
    let m := n + 1
    match L' with
    | [.b1, .w001 na] => 26 * m + 15 * na + 77
    | _ => 26 * m + 21
  | .b1 :: .w001 (n0 + 1) :: L', .w1110 1 :: .b1 4 :: .b0 :: rt =>
    match L' with
    | [] => costLoopIIBridgeIIIFlag n0 (is2OnesR rt)
    | _ => 62 * (n0 / 2 + 1)
  | .b1 :: .w001 (n0 + 1) :: L', [.w1110 1, .b1 4] =>
    match L' with
    | [] => costLoopIIBridgeIIIFlag n0 false
    | _ => 62 * (n0 / 2 + 1)
  | [], .w110 na :: .w1110 nb :: rMid =>
    costC0Blank na nb rMid
  | _, _ =>
    costC0DiveOrClimb L R

private def nextD0SweepOrFallback (L : List TokL) (R : List TokR) : State :=
  match L with
  | .b1 :: .w01 (n0 + 1) :: L' =>
    let p := n0 / 2
    let lNew := if n0 % 2 = 0 then .b1 :: L' else .b1 :: .w01 0 :: L'
    .d0 lNew (pushW1110 p R)
  | .w01 0 :: .w001 n :: L' =>
    .d0 (.w01 0 :: L') (pushW110 n R)
  | _ =>
    let (l0, L1) := popBitL L
    let (l1, L2) := popBitL L1
    if l0 = 0 then
      if l1 = 0 then
        .c0 L2 (pushW110 0 R)
      else
        let (l2, L3) := popBitL L2
        if l2 = 0 then
          .d0 L3 (pushW110 0 R)
        else
          .d0 (pushB1L (pushB0L L3)) (pushB0R R)
    else
      if l1 = 0 then
        let (l2, L3) := popBitL L2
        if l2 = 0 then
          .c0 L3 (pushW1110 0 R)
        else
          let (l3, L4) := popBitL L3
          if l3 = 0 then
            .d0 L4 (pushW1110 0 R)
          else
            .d0 (pushB1L (pushB0L L4)) (pushB1R 0 (pushB0R R))
      else
        .b1 L1 (pushB1R 0 (pushB0R R))

private def costD0SweepOrFallback (L : List TokL) : ℕ :=
  match L with
  | .b1 :: .w01 (n0 + 1) :: _ => 6 * (n0 / 2 + 1)
  | .w01 0 :: .w001 n :: _ => 5 * (n + 1)
  | _ =>
    let (l0, L1) := popBitL L
    let (l1, L2) := popBitL L1
    if l0 = 0 then
      if l1 = 0 then 4
      else if (popBitL L2).1 = 0 then 5 else 9
    else
      if l1 = 0 then
        let (l2, L3) := popBitL L2
        if l2 = 0 then 5
        else if (popBitL L3).1 = 0 then 6 else 10
      else
        3

private def nextD0 (L : List TokL) (R : List TokR) : State :=
  match L, R with
  | [.b1, .w001 0, .w01 n, .b1, .w001 na], .b1 0 :: .b0 :: .w1110 n3 :: rt =>
    let m := n + 1
    let tail2 := pushW1110Opt n3 rt
    .c0 [] (pushW110 (na + 2) (pushW1110 0 (pushB1R (6 + 2 * m) (pushB0R tail2))))
  | [.b1, .w01 k, .w001 na], _ =>
    if k % 2 = 0 then
      .c0 [] (pushW110 (na + 1) (pushW1110 0 (pushW1110Opt (k / 2) R)))
    else
      nextD0SweepOrFallback L R
  | .b1 :: .b0 :: .w001 (cnt0 + 1) :: L', .b1 0 :: .b0 :: rAfter =>
    match L', cnt0, rAfter with
    | [], n0 + 2, .w1110 nc :: rt =>
      nextLoopIIBridgeIII n0 (pushW1110Opt nc rt)
    | _, _, _ =>
      if headBit1R rAfter then
        let lRem := popW001Tail cnt0 L'
        .c0 (.b1 :: lRem) (pushW1110 1 (pushB1R 2 (popBitR rAfter).2))
      else
        nextD0SweepOrFallback L R
  | [.b1, .b1, .w001 (na + 2)], _ =>
    match R with
    | .w1110 nb :: rt =>
      let ra4 := pushB0R (pushW1110Opt nb rt)
      .c0 [] (pushW110 (na + 2) (pushW1110 2 ra4))
    | _ =>
      .c0 [] (pushW110 (na + 1) (pushW1110 1 (pushB1R 0 R)))
  | .b1 :: .b1 :: .w01 k :: L', _ =>
    if k % 2 = 1 then
      .d0 (.b1 :: L') (pushW1110Opt (k / 2) (pushB1R 1 (pushW110 0 R)))
    else
      nextD0SweepOrFallback L R
  | _, _ => nextD0SweepOrFallback L R

private def costD0 (L : List TokL) (R : List TokR) : ℕ :=
  match L, R with
  | [.b1, .w001 0, .w01 n, .b1, .w001 na], .b1 0 :: .b0 :: .w1110 _ :: _ =>
    26 * (n + 1) + 15 * na + 82
  | [.b1, .w01 k, .w001 na], _ =>
    if k % 2 = 0 then
      6 * (k / 2) + 5 * na + 15
    else
      costD0SweepOrFallback L
  | .b1 :: .b0 :: .w001 (cnt0 + 1) :: L', .b1 0 :: .b0 :: rAfter =>
    match L', cnt0, rAfter with
    | [], n0 + 2, .w1110 nc :: rt =>
      let has2 := if nc > 0 then true else is2OnesR rt
      27 + costLoopIIBridgeIIIFlag n0 has2
    | _, _, _ =>
      if headBit1R rAfter then 27 else costD0SweepOrFallback L
  | [.b1, .b1, .w001 (na + 2)], _ =>
    match R with
    | .w1110 _ :: _ => 15 * na + 111
    | _ => 5 * na + 56
  | .b1 :: .b1 :: .w01 k :: _, _ =>
    if k % 2 = 1 then
      6 * (k / 2) + 7
    else
      costD0SweepOrFallback L
  | _, _ => costD0SweepOrFallback L

private def nextB1 (L : List TokL) (R : List TokR) : State :=
  let (l0, L1) := popBitL L
  if l0 = 1 then
    .b1 L1 (pushB1R 0 R)
  else
    let (l1, L2) := popBitL L1
    if l1 = 0 then
      .c0 L2 (pushB1R 1 R)
    else
      let (l2, L3) := popBitL L2
      if l2 = 0 then
        .d0 L3 (pushB1R 1 R)
      else
        .d0 (pushB1L (pushB0L L3)) R

private def costB1 (L : List TokL) : ℕ :=
  let (l0, L1) := popBitL L
  if l0 = 1 then 1
  else
    let (l1, L2) := popBitL L1
    if l1 = 0 then 2
    else if (popBitL L2).1 = 0 then 3 else 7

private def next : State → Option State
  | .c0 L R => nextC0 L R
  | .d0 L R => some (nextD0 L R)
  | .b1 L R => some (nextB1 L R)

/-! ### Encoding into `Cfg (Fin 2) (Fin 6)` -/

private def encodePrepend : List (Fin 2) → ListBlank (Fin 2) → ListBlank (Fin 2)
  | [], lb => lb
  | b :: bs, lb => ListBlank.cons b (encodePrepend bs lb)

private def encodeRep (w : List (Fin 2)) : ℕ → ListBlank (Fin 2) → ListBlank (Fin 2)
  | 0, lb => lb
  | n + 1, lb => encodePrepend w (encodeRep w n lb)

private def encodeTokL : TokL → ListBlank (Fin 2) → ListBlank (Fin 2)
  | .b0, lb => ListBlank.cons 0 lb
  | .b1, lb => ListBlank.cons 1 lb
  | .w01 n, lb => encodeRep [0, 1] (n + 1) lb
  | .w001 n, lb => encodeRep [0, 0, 1] (n + 1) lb

private def encodeL : List TokL → ListBlank (Fin 2)
  | [] => default
  | t :: ts => encodeTokL t (encodeL ts)

private def encodeTokR : TokR → ListBlank (Fin 2) → ListBlank (Fin 2)
  | .b0, lb => ListBlank.cons 0 lb
  | .b1 n, lb => encodeRep [1] (n + 1) lb
  | .w110 n, lb => encodeRep [1, 1, 0] (n + 1) lb
  | .w1110 n, lb => encodeRep [1, 1, 1, 0] (n + 1) lb
  | .w31 n, lb => encodeRep [1, 1, 1, 0, 1, 0] (n + 1) lb

private def encodeR : List TokR → ListBlank (Fin 2)
  | [] => default
  | t :: ts => encodeTokR t (encodeR ts)

private def encode : State → Cfg (Fin 2) (Fin 6)
  | .c0 L R => ⟨some 2, ⟨0, encodeL L, encodeR R⟩⟩
  | .d0 L R => ⟨some 3, ⟨0, encodeL L, ListBlank.cons 1 (encodeR R)⟩⟩
  | .b1 L R => ⟨some 1, ⟨1, encodeL L, encodeR R⟩⟩

/-! ### Encoding algebra & smart-constructor lemmas -/

private theorem encodeRep_add (w : List (Fin 2)) (a b : ℕ) (lb : ListBlank (Fin 2)) :
    encodeRep w (a + b) lb = encodeRep w a (encodeRep w b lb) := by
  induction a with
  | zero => simp [encodeRep]
  | succ a ih => simp [Nat.succ_add, encodeRep, ih]

private theorem encodeL_pushW01 (n : ℕ) (L : List TokL) :
    encodeL (pushW01 n L) = encodeRep [0, 1] (n + 1) (encodeL L) := by
  cases L with
  | nil => rfl
  | cons t ls =>
    cases t with
    | w01 m =>
      simp only [pushW01, encodeL, encodeTokL]
      have h : n + m + 1 + 1 = (n + 1) + (m + 1) := by omega
      rw [h, encodeRep_add]
    | _ => rfl

private theorem encodeL_pushW001 (n : ℕ) (L : List TokL) :
    encodeL (pushW001 n L) = encodeRep [0, 0, 1] (n + 1) (encodeL L) := by
  cases L with
  | nil => rfl
  | cons t ls =>
    cases t with
    | w001 m =>
      simp only [pushW001, encodeL, encodeTokL]
      have h : n + m + 1 + 1 = (n + 1) + (m + 1) := by omega
      rw [h, encodeRep_add]
    | _ => rfl

private theorem encodeL_pushW001Opt (cnt : ℕ) (L : List TokL) :
    encodeL (pushW001Opt cnt L) = encodeRep [0, 0, 1] cnt (encodeL L) := by
  cases cnt with
  | zero => rfl
  | succ k => exact encodeL_pushW001 k L

private theorem encodeL_pushB0L (L : List TokL) :
    encodeL (pushB0L L) = ListBlank.cons 0 (encodeL L) := by
  match L with
  | [] => simp [pushB0L, encodeL, ListBlank.cons_zero_default]
  | .b1 :: ls => rw [pushB0L, encodeL_pushW01]; rfl
  | .b0 :: [] => rfl
  | .b0 :: .b0 :: ls => rfl
  | .b0 :: .b1 :: ls => rw [pushB0L, encodeL_pushW001]; rfl
  | .b0 :: .w01 m :: ls => rfl
  | .b0 :: .w001 m :: ls => rfl
  | .w01 0 :: ls => rw [pushB0L, encodeL_pushW001]; rfl
  | .w01 (n + 1) :: ls => rw [pushB0L, encodeL_pushW001]; rfl
  | .w001 m :: ls => rfl

private theorem encodeL_pushB1L (L : List TokL) :
    encodeL (pushB1L L) = ListBlank.cons 1 (encodeL L) := rfl

private theorem encodeL_popBitL (L : List TokL) :
    encodeL L = ListBlank.cons (popBitL L).1 (encodeL (popBitL L).2) := by
  match L with
  | [] => simp [popBitL, encodeL, ListBlank.cons_zero_default]
  | .b0 :: ls => rfl
  | .b1 :: ls => rfl
  | .w01 0 :: ls => rfl
  | .w01 (n + 1) :: ls => rfl
  | .w001 0 :: ls => rfl
  | .w001 (n + 1) :: ls => rfl

private theorem encodeR_pushW110 (n : ℕ) (R : List TokR) :
    encodeR (pushW110 n R) = encodeRep [1, 1, 0] (n + 1) (encodeR R) := by
  cases R with
  | nil => rfl
  | cons t rs =>
    cases t with
    | w110 m =>
      simp only [pushW110, encodeR, encodeTokR]
      have h : n + m + 1 + 1 = (n + 1) + (m + 1) := by omega
      rw [h, encodeRep_add]
    | _ => rfl

private theorem encodeR_pushW1110 (n : ℕ) (R : List TokR) :
    encodeR (pushW1110 n R) = encodeRep [1, 1, 1, 0] (n + 1) (encodeR R) := by
  cases R with
  | nil => rfl
  | cons t rs =>
    cases t with
    | w1110 m =>
      simp only [pushW1110, encodeR, encodeTokR]
      have h : n + m + 1 + 1 = (n + 1) + (m + 1) := by omega
      rw [h, encodeRep_add]
    | _ => rfl

private theorem encodeR_pushW1110Opt (cnt : ℕ) (R : List TokR) :
    encodeR (pushW1110Opt cnt R) = encodeRep [1, 1, 1, 0] cnt (encodeR R) := by
  cases cnt with
  | zero => rfl
  | succ k => exact encodeR_pushW1110 k R

private theorem pushW110_pushW1110 (a b : ℕ) (rs : List TokR) :
    pushW110 a (pushW1110 b rs) = .w110 a :: pushW1110 b rs := by
  cases rs with
  | nil => rfl
  | cons t ts => cases t <;> rfl

private theorem encodeR_w1110_eq_opt (n : ℕ) (rs : List TokR) :
    encodeR (.w1110 n :: rs) = encodePrepend [1, 1, 1, 0] (encodeR (pushW1110Opt n rs)) := by
  simp only [encodeR, encodeTokR, encodeRep, encodeR_pushW1110Opt]

private theorem encodeTokR_w1110_eq_opt (n : ℕ) (rs : List TokR) :
    encodeTokR (.w1110 n) (encodeR rs) =
        encodePrepend [1, 1, 1, 0] (encodeR (pushW1110Opt n rs)) := by
  simp only [encodeTokR, encodeRep, encodeR_pushW1110Opt]

private theorem encodeR_pushW31 (n : ℕ) (R : List TokR) :
    encodeR (pushW31 n R) = encodeRep [1, 1, 1, 0, 1, 0] (n + 1) (encodeR R) := by
  cases R with
  | nil => rfl
  | cons t rs =>
    cases t with
    | w31 m =>
      simp only [pushW31, encodeR, encodeTokR]
      have h : n + m + 1 + 1 = (n + 1) + (m + 1) := by omega
      rw [h, encodeRep_add]
    | _ => rfl

private theorem encodeR_pushB0R (R : List TokR) :
    encodeR (pushB0R R) = ListBlank.cons 0 (encodeR R) := by
  cases R <;> simp [pushB0R, encodeR, encodeTokR, ListBlank.cons_zero_default]

private theorem encodeR_pushB1R_aux (tot : ℕ) (rest : List TokR) :
    encodeR (
      if tot = 1 then
        match rest with
        | [] => [.w110 0]
        | .b0 :: rs' => pushW110 0 rs'
        | _ => .b1 1 :: rest
      else if tot = 2 then
        match rest with
        | [] => [.w1110 0]
        | .b0 :: rs' => pushW1110 0 rs'
        | _ => .b1 2 :: rest
      else
        .b1 tot :: rest) = encodeRep [1] (tot + 1) (encodeR rest) := by
  by_cases h1 : tot = 1
  · subst h1
    simp only [↓reduceIte]
    match rest with
    | [] => simp [encodeR, encodeTokR, encodeRep, encodePrepend, ListBlank.cons_zero_default]
    | .b0 :: rs' => rw [encodeR_pushW110]; rfl
    | .b1 _ :: _ | .w110 _ :: _ | .w1110 _ :: _ | .w31 _ :: _ => rfl
  · by_cases h2 : tot = 2
    · subst h2
      simp only [show (2 : ℕ) ≠ 1 by decide, ↓reduceIte]
      match rest with
      | [] => simp [encodeR, encodeTokR, encodeRep, encodePrepend, ListBlank.cons_zero_default]
      | .b0 :: rs' => rw [encodeR_pushW1110]; rfl
      | .b1 _ :: _ | .w110 _ :: _ | .w1110 _ :: _ | .w31 _ :: _ => rfl
    · simp only [h1, h2, ↓reduceIte, encodeR, encodeTokR]

private theorem encodeR_pushB1R (n : ℕ) (R : List TokR) :
    encodeR (pushB1R n R) = encodeRep [1] (n + 1) (encodeR R) := by
  unfold pushB1R
  cases R with
  | nil => exact encodeR_pushB1R_aux n []
  | cons t rs' =>
    cases t with
    | b1 m =>
      dsimp only
      refine (encodeR_pushB1R_aux (n + m + 1) rs').trans ?_
      simp only [encodeR, encodeTokR]
      have h : n + m + 1 + 1 = (n + 1) + (m + 1) := by omega
      rw [h, encodeRep_add]
    | _ => exact encodeR_pushB1R_aux n (_ :: rs')

private theorem encodeR_popBitR (R : List TokR) :
    encodeR R = ListBlank.cons (popBitR R).1 (encodeR (popBitR R).2) := by
  match R with
  | [] => simp [popBitR, encodeR, ListBlank.cons_zero_default]
  | .b0 :: rs => rfl
  | .b1 0 :: rs => rfl
  | .b1 (n + 1) :: rs => rfl
  | .w110 0 :: rs => rfl
  | .w110 (n + 1) :: rs => rfl
  | .w1110 0 :: rs => rfl
  | .w1110 (n + 1) :: rs => rfl
  | .w31 0 :: rs => rfl
  | .w31 (n + 1) :: rs => rfl

private theorem headBit1R_eq_popBitR (R : List TokR) :
    (popBitR R).1 = if headBit1R R then 1 else 0 := by
  match R with
  | [] => rfl
  | .b0 :: _ => rfl
  | .b1 0 :: _ => rfl
  | .b1 (_ + 1) :: _ => rfl
  | .w110 0 :: _ => rfl
  | .w110 (_ + 1) :: _ => rfl
  | .w1110 0 :: _ => rfl
  | .w1110 (_ + 1) :: _ => rfl
  | .w31 0 :: _ => rfl
  | .w31 (_ + 1) :: _ => rfl

private theorem encodeR_of_headBit1R (R : List TokR) (h : headBit1R R = true) :
    encodeR R = ListBlank.cons 1 (encodeR (popBitR R).2) := by
  rw [encodeR_popBitR R, headBit1R_eq_popBitR R, h]
  rfl

private theorem encodeR_of_is2OnesR (R : List TokR) (h : is2OnesR R = true) :
    encodeR R = ListBlank.cons 1 (ListBlank.cons 1 (encodeR (pop2OnesR R))) := by
  match R with
  | [] => simp [is2OnesR] at h
  | .b0 :: _ => simp [is2OnesR] at h
  | .b1 0 :: rs =>
    simp only [is2OnesR] at h
    simp only [pop2OnesR, encodeR, encodeTokR, encodeRep, encodePrepend]
    rw [encodeR_of_headBit1R rs h]
  | .b1 1 :: rs => rfl
  | .b1 (k + 2) :: rs =>
    simp only [pop2OnesR, encodeR, encodeTokR]
    have hk : k + 2 + 1 = 2 + (k + 1) := by omega
    rw [hk, encodeRep_add]
    rfl
  | .w110 0 :: rs => rfl
  | .w110 (n + 1) :: rs => rfl
  | .w1110 0 :: rs => rfl
  | .w1110 (n + 1) :: rs => rfl
  | .w31 0 :: rs => rfl
  | .w31 (n + 1) :: rs => rfl

private theorem encodeR_of_is4OnesR (R : List TokR) (h : is4OnesR R = true) :
    encodeR R = encodePrepend [1, 1, 1, 1] (encodeR (pop4OnesR R)) := by
  match R with
  | .b1 3 :: rs => rfl
  | .b1 (k + 4) :: rs =>
    simp only [pop4OnesR, encodeR, encodeTokR]
    have hk : k + 4 + 1 = 4 + (k + 1) := by omega
    rw [hk, encodeRep_add]
    rfl
  | .b1 1 :: .w110 0 :: rs => rfl
  | .b1 1 :: .w110 (n + 1) :: rs => rfl
  | .b1 0 :: .w1110 0 :: rs => rfl
  | .b1 0 :: .w1110 (n + 1) :: rs => rfl
  | [] => simp [is4OnesR] at h
  | .b0 :: _ => simp [is4OnesR] at h
  | .w110 _ :: _ => simp [is4OnesR] at h
  | .w1110 _ :: _ => simp [is4OnesR] at h
  | .w31 _ :: _ => simp [is4OnesR] at h
  | .b1 2 :: _ => simp [is4OnesR] at h
  | [.b1 1] => simp [is4OnesR] at h
  | .b1 1 :: .b0 :: _ => simp [is4OnesR] at h
  | .b1 1 :: .b1 _ :: _ => simp [is4OnesR] at h
  | .b1 1 :: .w1110 _ :: _ => simp [is4OnesR] at h
  | .b1 1 :: .w31 _ :: _ => simp [is4OnesR] at h
  | [.b1 0] => simp [is4OnesR] at h
  | .b1 0 :: .b0 :: _ => simp [is4OnesR] at h
  | .b1 0 :: .b1 _ :: _ => simp [is4OnesR] at h
  | .b1 0 :: .w110 _ :: _ => simp [is4OnesR] at h
  | .b1 0 :: .w31 _ :: _ => simp [is4OnesR] at h

private theorem is2OnesAfterPop4R_eq (R : List TokR) (h : is4OnesR R = true) :
    is2OnesAfterPop4R R = is2OnesR (pop4OnesR R) := by
  match R with
  | .b1 3 :: rs => rfl
  | .b1 4 :: rs => rfl
  | .b1 (k + 5) :: rs => rfl
  | .b1 1 :: .w110 0 :: rs => rfl
  | .b1 1 :: .w110 (n + 1) :: rs => rfl
  | .b1 0 :: .w1110 0 :: rs => rfl
  | .b1 0 :: .w1110 (n + 1) :: rs => rfl
  | [] | .b0 :: _ | .w110 _ :: _ | .w1110 _ :: _ | .w31 _ :: _ | .b1 2 :: _
  | [.b1 1] | .b1 1 :: .b0 :: _ | .b1 1 :: .b1 _ :: _ | .b1 1 :: .w1110 _ :: _ | .b1 1 :: .w31 _ ::
      _
  | [.b1 0] | .b1 0 :: .b0 :: _ | .b1 0 :: .b1 _ :: _ | .b1 0 :: .w110 _ :: _ | .b1 0 :: .w31 _ ::
      _ =>
    simp [is4OnesR] at h

private theorem fin2_cases (b : Fin 2) : b = 0 ∨ b = 1 := by
  match b with
  | ⟨0, _⟩ => exact Or.inl rfl
  | ⟨1, _⟩ => exact Or.inr rfl

