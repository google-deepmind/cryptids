private def ReachesP (s : State) : Prop :=
  ∃ cfg', ReachesPlus target_tm (encode s) cfg' ∧
    (IsInPatternSet ps cfg' ∨ (step target_tm cfg').isNone)

private theorem reachesP_eq {s₁ s₂ : State} (h : s₁ = s₂) (h2 : ReachesP s₂) : ReachesP s₁ :=
  h ▸ h2

private theorem reachesP_step {s s' : State}
    (hstep : next s = some s') (hrec : ReachesP s') : ReachesP s := by
  obtain ⟨cfg', hplus, hpost⟩ := hrec
  exact ⟨cfg', (next_some_plus hstep).trans hplus, hpost⟩

private theorem reachesP_step_in {s s' : State}
    (hstep : next s = some s') (hin : IsInPatternSet ps (encode s')) : ReachesP s :=
  ⟨encode s', next_some_plus hstep, Or.inl hin⟩

private theorem reachesP_step_halt {s s' : State}
    (hstep : next s = some s') (hhalt : next s' = none) : ReachesP s := by
  obtain ⟨cfg', hstar, hisnone⟩ := next_none_halts hhalt
  exact ⟨cfg', (next_some_plus hstep).trans_star hstar, Or.inr hisnone⟩

private theorem reachesP_iter_in (k : ℕ) {s s' : State} (hk : 0 < k)
    (hiter : nextIter k s = some s') (hin : IsInPatternSet ps (encode s')) : ReachesP s :=
  ⟨encode s', nextIter_plus k s s' hk hiter, Or.inl hin⟩

private theorem reachesP_iter_halt (k : ℕ) {s s' : State} (hk : 0 < k)
    (hiter : nextIter k s = some s') (hhalt : next s' = none) : ReachesP s := by
  obtain ⟨cfg', hstar, hisnone⟩ := next_none_halts hhalt
  exact ⟨cfg', (nextIter_plus k s s' hk hiter).trans_star hstar, Or.inr hisnone⟩

private theorem nat_cases2 (n : ℕ) {P : ℕ → Prop}
    (h0 : ∀ q, P (2 * q)) (h1 : ∀ q, P (2 * q + 1)) : P n := by
  have h : n = 2 * (n / 2) ∨ n = 2 * (n / 2) + 1 := by omega
  rcases h with h | h <;> rw [h]
  · exact h0 (n / 2)
  · exact h1 (n / 2)

private theorem nextLoopIIBridgeIII_eq (n0 p r0 q rm : ℕ) (rTail : List TokR)
    (hp : n0 / 2 = p) (hr0 : n0 % 2 = r0) (hq : (p + 1) / 2 = q) (hrm : (p + 1) % 2 = rm) :
    nextLoopIIBridgeIII n0 rTail =
      let (na0, nb0) := if r0 = 0 then (4, 3) else (3, 4)
      let na := na0 + 3 * q
      let nb := nb0 + 3 * q
      if rm = 0 then
        .c0 [] (pushW110 na (pushW1110 nb rTail))
      else if is2OnesR rTail then
        .c0 [] (pushW110 (na + 2) (pushW1110 (nb + 2) (pop2OnesR rTail)))
      else
        .c0 [] (pushW110 na (pushW1110 nb (pushW31 0 rTail))) := by
  unfold nextLoopIIBridgeIII
  simp only [hp, hr0, hq, hrm]

private theorem nextC0Blank_b1_b0_eq (na nb k q rem : ℕ) (rt : List TokR)
    (hk : 3 ≤ k) (hq : (k - 3) / 4 = q) (hrem : (k - 3) % 4 = rem) :
    nextC0Blank na nb (.b1 k :: .b0 :: rt) =
      if rem = 1 then
        match rt with
        | .w1110 nm :: rt2 =>
          some (nextFinishLoopV (na + (q + 1) + 2 * (nm + 1)) (nb + (q + 1) + (nm + 1)) rt2)
        | _ =>
          some (.c0 [] (pushW110 (na + (q + 1)) (pushW1110 (nb + (q + 1)) (pushB1R 0 (pushB0R
              rt)))))
      else
        let rRem := if rem = 0 then pushB0R rt else pushB1R (rem - 1) (pushB0R rt)
        some (.c0 [] (pushW110 (na + (q + 1)) (pushW1110 (nb + (q + 1)) rRem))) := by
  obtain ⟨k0, rfl⟩ : ∃ k0, k = k0 + 3 := ⟨k - 3, by omega⟩
  have hsub : k0 + 3 - 3 = k0 := by omega
  rw [hsub] at hq hrem
  unfold nextC0Blank
  simp only [hq, hrem]
  rcases rem with _ | (_ | _)
  · rfl
  · cases rt with
    | nil => rfl
    | cons t rs => cases t <;> rfl
  · rfl

