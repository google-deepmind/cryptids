       TokR.b1.injEq, TokR.w110.injEq, TokR.w1110.injEq, TokR.w31.injEq,
       true_and, and_true]
     first
     | done
     | ((repeat' apply And.intro)
        all_goals (first | rfl | omega_nz)
        done))))

