    refine ⟨by positivity, ?_⟩
    have h31 : encodeRep [1, 1, 1, 0, 1, 0] (n31 + 1 + 1) (encodeR rt) =
        encodeRep [1, 1, 1, 0, 1, 0] (2 * m) (encodeR (if n31 % 2 =
            0 then rt else .w31 0 :: rt)) := by
      by_cases hpar : n31 % 2 = 0
      · simp only [hpar, ↓reduceIte]; congr 1; omega
      · simp only [hpar, ↓reduceIte, encodeR, encodeTokR]
        rw [← encodeRep_add]; congr 1; omega
    simp only [encode, encodeL, encodeR_pushW110, encodeR_pushW1110, encodeR, encodeTokR]
    rw [h31]
    exact loopIII_run m na nb (encodeR (if n31 % 2 = 0 then rt else .w31 0 :: rt))
  -- 5. BounceW31_0
  · next rt =>
    by_cases h1 : headBit1R rt = true
    · simp only [h1, ↓reduceIte, Option.some.injEq] at h ⊢
      subst h
      refine ⟨by omega, ?_⟩
      simp only [encode, encodeL, encodeR, encodeTokR, encodeR_pushW110, encodeR_pushW1110,
          encodeR_pushB1R]
      rw [encodeR_of_headBit1R rt h1]
      have h_re : encodeRep [1, 1, 1, 0] (nb + 1)
            (encodeRep [1, 1, 1, 0, 1, 0] 1 (ListBlank.cons 1 (encodeR (popBitR rt).2))) =
          encodeRep [1, 1, 1, 0] (nb + 2)
            (ListBlank.cons 1 (ListBlank.cons 0 (ListBlank.cons 1 (encodeR (popBitR rt).2)))) := by
        have t := encodeRep_add [1, 1, 1, 0] (nb + 1) 1
          (ListBlank.cons 1 (ListBlank.cons 0 (ListBlank.cons 1 (encodeR (popBitR rt).2))))
        simpa [encodeRep, encodePrepend] using t.symm
      rw [h_re]
      exact (step_bounce_101 na (nb + 1) (encodeR (popBitR rt).2)) |> reachesIn_cast_flip (by omega)
    · have h1f : headBit1R rt = false := Bool.eq_false_iff.mpr h1
      simp only [h1f, Bool.false_eq_true, ↓reduceIte] at h ⊢
      exact sound_c0_dive_some [] _ s' h
  -- 6. .b1 0 :: .b0 :: rt (LoopV_Chain, Bounce100_Dive, Bounce101)
  · next rt =>
    split at h
    · next nm rt2 =>
      simp only [Option.some.injEq] at h
      subst h
      set mv := nm + 1
      have h_v : ReachesIn target_tm (mv * (20 * (na + 1 + (nb + 1)) + 30 * mv + 6))
          (encode (.c0 [] (.w110 na :: .w1110 nb :: .b1 0 :: .b0 :: .w1110 nm :: rt2)))
          ⟨some 2, ⟨0, default, encodeRep [1, 1, 0] (na + 2 * mv + 1) (encodeRep [1, 1, 1,
              0] (nb + mv + 1)
            (ListBlank.cons 1 (ListBlank.cons 0 (encodeR rt2))))⟩⟩ := by
        have h_in : encode (.c0 [] (.w110 na :: .w1110 nb :: .b1 0 :: .b0 :: .w1110 nm :: rt2)) =
            ⟨some 2, ⟨0, default, encodeRep [1, 1, 0] (na + 1) (encodeRep [1, 1, 1, 0] (nb + 1)
              (ListBlank.cons 1 (ListBlank.cons 0 (encodeRep [1, 1, 1,
                  0] mv (encodeR rt2)))))⟩⟩ := rfl
        rw [h_in]
        exact loopV_run mv na nb (encodeR rt2)
      exact sound_finish_loopV (na + 2 * mv) (nb + mv) rt2 _ _ (by positivity) h_v
    · next rt2 =>
      simp only [Option.some.injEq] at h
      subst h
      refine ⟨by omega, ?_⟩
      simp only [encode, encodeL, encodeTokL, encodeL_pushW001Opt, encodeR, encodeTokR,
        encodeR_pushW1110, encodeR_pushB1R]
      have h1 := sweep_c0_w110 (na + 1) default
        (encodeRep [1, 1, 1,
            0] (nb + 1) (ListBlank.cons 1 (ListBlank.cons 0 (ListBlank.cons 0 (encodeR rt2)))))
      have h2 := step_turnaround_100 nb (encodeRep [0, 0, 1] (na + 1) default) (encodeR rt2)
      have h_split : ListBlank.cons 1 (encodeRep [0, 0, 1] (na + 1) default) =
          ListBlank.cons 1 (ListBlank.cons 0 (ListBlank.cons 0 (ListBlank.cons 1 (encodeRep [0, 0,
              1] na default)))) := rfl
      rw [h_split] at h2
      have h3 := step_d0_100 (ListBlank.cons 1 (encodeRep [0, 0, 1] na default))
        (encodeRep [1, 1, 1, 0] (nb + 1) (ListBlank.cons 1 (encodeR rt2)))
      have h_end : encodePrepend [1, 1, 1, 0] (encodeRep [1, 1, 1,
          0] (nb + 1) (ListBlank.cons 1 (encodeR rt2))) =
          encodeRep [1, 1, 1, 0] (nb + 2) (encodeRep [1] 1 (encodeR rt2)) := rfl
      rw [h_end] at h3
      have h1' : ReachesIn target_tm (5 * (na + 1))
          ⟨some 2, ⟨0, default, encodeRep [1, 1, 0] (na + 1) (encodeRep [1, 1, 1, 0] (nb + 1)
            (encodeRep [1] 1 (ListBlank.cons 0 (ListBlank.cons 0 (encodeR rt2)))))⟩⟩
          ⟨some 2, ⟨0, encodeRep [0, 0, 1] (na + 1) default, encodeRep [1, 1, 1, 0] (nb + 1)
            (ListBlank.cons 1 (ListBlank.cons 0 (ListBlank.cons 0 (encodeR rt2))))⟩⟩ := h1
      exact (h1'.trans (h2.trans h3)) |> reachesIn_cast_flip (by omega)
    · by_cases h1 : headBit1R rt = true
      · simp only [h1, ↓reduceIte, Option.some.injEq] at h ⊢
        subst h
        refine ⟨by omega, ?_⟩
        simp only [encode, encodeL, encodeR, encodeTokR, encodeR_pushW110, encodeR_pushW1110,
            encodeR_pushB1R]
        rw [encodeR_of_headBit1R rt h1]
        exact (step_bounce_101 na nb (encodeR (popBitR rt).2)) |> reachesIn_cast_flip (by omega)
      · have h1f : headBit1R rt = false := Bool.eq_false_iff.mpr h1
        simp only [h1f, Bool.false_eq_true, ↓reduceIte] at h ⊢
        exact sound_c0_dive_some [] _ s' h
  -- 7. Sweep2_DiveW110B0
  · next na2 nc rt =>
    by_cases h1 : headBit1R rt = true
    · simp only [h1, ↓reduceIte, Option.some.injEq] at h ⊢
      subst h
      refine ⟨by omega, ?_⟩
      have h_sw1 : ReachesIn target_tm (5 * (na + 1))
          (encode (.c0 [] (.w110 na :: .w1110 nb :: .w110 na2 :: .w1110 nc :: .b0 :: rt)))
          (encode (.c0 (pushW001 na []) (.w1110 nb :: .w110 na2 :: .w1110 nc :: .b0 :: rt))) := by
        simp only [encode, encodeL, encodeL_pushW001, encodeR, encodeTokR]
