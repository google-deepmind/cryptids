private theorem sound_loopI_full_w3 (n na n3 : ℕ) (rt : List TokR) :
    ReachesIn target_tm (26 * (n + 1) + 15 * na + 77)
      (encode (.c0 [.b1, .w01 n, .b1, .w001 na] (.w1110 0 :: .b1 0 :: .b0 :: .w1110 n3 :: rt)))
      (encode (.c0 [] (pushW110 (na + 2) (pushW1110 0 (pushB1R (6 + 2 * (n + 1)) (pushB0R
          (pushW1110Opt n3 rt))))))) := by
  set m := n + 1
  set tail2 := pushW1110Opt n3 rt
  have hR_in : encodeR (.w1110 0 :: .b1 0 :: .b0 :: .w1110 n3 :: rt) =
      encodePrepend [1, 1, 1, 0, 1, 0] (ListBlank.cons 1 (ListBlank.cons 1
        (ListBlank.cons 1 (ListBlank.cons 0 (encodeR tail2))))) := by
    simp only [encodeR]
    rw [encodeTokR_w1110_eq_opt n3 rt]
    rfl
  simp only [encode]
  rw [hR_in]
  have h1 := loopI_exit_run m (encodeL [.b1,
      .w001 na]) (ListBlank.cons 1 (ListBlank.cons 0 (encodeR tail2)))
  have hL_in : encodeL [.b1, .w01 n, .b1, .w001 na] =
      ListBlank.cons 1 (encodeRep [0, 1] m (encodeL [.b1, .w001 na])) := rfl
  rw [hL_in]
  have h_1s : encodeRep [1] (2 * m + 4) (ListBlank.cons 1 (ListBlank.cons 0 (encodeR tail2))) =
      ListBlank.cons 1 (encodeRep [1] (2 * m + 4) (ListBlank.cons 0 (encodeR tail2))) := by
    have t1 := encodeRep_add [1] (2 * m + 4) 1 (ListBlank.cons 0 (encodeR tail2))
    have t2 := encodeRep_add [1] 1 (2 * m + 4) (ListBlank.cons 0 (encodeR tail2))
    have hm : 2 * m + 4 + 1 = 1 + (2 * m + 4) := by omega
    change encodeRep [1] (2 * m + 4) (encodeRep [1] 1 (ListBlank.cons 0 (encodeR tail2))) = _
    rw [← t1, hm, t2]
    rfl
  rw [h_1s] at h1
  have h1' : ReachesIn target_tm (26 * m + 21)
      ⟨some 2, ⟨0, ListBlank.cons 1 (encodeRep [0, 1] m (encodeL [.b1, .w001 na])),
        encodePrepend [1, 1, 1, 0, 1, 0] (ListBlank.cons 1 (ListBlank.cons 1
          (ListBlank.cons 1 (ListBlank.cons 0 (encodeR tail2)))))⟩⟩
      ⟨some 3, ⟨0, ListBlank.cons 1 (ListBlank.cons 0 (ListBlank.cons 1 (encodeRep [0, 0,
          1] (na + 1) default))),
        ListBlank.cons 1 (ListBlank.cons 1 (ListBlank.cons 0
          (ListBlank.cons 1 (encodeRep [1] (2 * m + 4) (ListBlank.cons 0 (encodeR tail2))))))⟩⟩ :=
              h1
  have h2 := d0_tail_to_blank_c0 na
    (ListBlank.cons 1 (ListBlank.cons 0 (ListBlank.cons 1 (encodeRep [1] (2 * m + 4)
        (ListBlank.cons 0 (encodeR tail2))))))
  have h2' : ReachesIn target_tm (5 * na + 15)
      ⟨some 3, ⟨0, ListBlank.cons 1 (ListBlank.cons 0 (ListBlank.cons 1 (encodeRep [0, 0,
          1] (na + 1) default))),
        ListBlank.cons 1 (ListBlank.cons 1 (ListBlank.cons 0
          (ListBlank.cons 1 (encodeRep [1] (2 * m + 4) (ListBlank.cons 0 (encodeR tail2))))))⟩⟩
      ⟨some 2, ⟨0, default, encodeRep [1, 1, 0] (na + 2) (encodeRep [1, 1, 1, 0] 1
        (ListBlank.cons 1 (ListBlank.cons 0 (ListBlank.cons 1
          (encodeRep [1] (2 * m + 4) (ListBlank.cons 0 (encodeR tail2)))))))⟩⟩ := h2
  have h3 := step_bounce_101 (na + 1) 0 (encodeRep [1] (2 * m + 4) (ListBlank.cons 0 (encodeR
      tail2)))
  have h_end : encodeRep [1] 3 (encodeRep [1] (2 * m + 4) (ListBlank.cons 0 (encodeR tail2))) =
      encodeRep [1] (6 + 2 * m + 1) (ListBlank.cons 0 (encodeR tail2)) := by
    rw [← encodeRep_add]
    congr 1; omega
  rw [h_end] at h3
  simp only [encodeL, encodeR_pushW110, encodeR_pushW1110, encodeR_pushB1R, encodeR_pushB0R]
  exact (h1'.trans (h2'.trans h3)) |> reachesIn_cast_flip (by omega)

/-! ### Soundness of Subroutines `C0Fallback`, `C0Sweep`, `C0Climb`, `C0Dive`, `C0Blank`, `C0`,
    `D0`, `B1` -/

private theorem sound_c0_fallback_some (L : List TokL) (R : List TokR) (s' : State)
    (h : nextC0Fallback L R = some s') :
    0 < costC0Fallback L R ∧
        ReachesIn target_tm (costC0Fallback L R) (encode (.c0 L R)) (encode s') := by
  unfold nextC0Fallback at h
  unfold costC0Fallback
  have hR0 := encodeR_popBitR R
  rcases hp0 : popBitR R with ⟨r0, R1⟩
  simp only [hp0] at h hR0 ⊢
  have hR1 := encodeR_popBitR R1
  rcases hp1 : popBitR R1 with ⟨r1, R2⟩
  simp only [hp1] at h hR1 ⊢
  rcases fin2_cases r0 with hr0 | hr0
  · simp only [hr0, ↓reduceIte] at h ⊢
    rcases fin2_cases r1 with hr1 | hr1
    · simp [hr1] at h
    · simp only [hr1, show (1 : Fin 2) ≠ 0 by decide, ↓reduceIte, Option.some.injEq] at h ⊢
      subst h
      refine ⟨by omega, ?_⟩
      simp only [encode, encodeL_pushB1L]
      rw [hR0, hr0, hR1, hr1]
      exact step_c0_01 (encodeL L) (encodeR R2)
  · simp only [hr0, show (1 : Fin 2) ≠ 0 by decide, ↓reduceIte] at h ⊢
    have hR2 := encodeR_popBitR R2
    rcases hp2 : popBitR R2 with ⟨r2, R3⟩
    simp only [hp2] at h hR2 ⊢
    rcases fin2_cases r1 with hr1 | hr1
    · simp only [hr1, ↓reduceIte] at h ⊢
      rcases fin2_cases r2 with hr2 | hr2
      · simp only [hr2, ↓reduceIte, Option.some.injEq] at h ⊢
        subst h
        refine ⟨by omega, ?_⟩
        simp only [encode, encodeL_pushB1L, encodeR_pushB1R, encodeRep, encodePrepend]
        rw [hR0, hr0, hR1, hr1, hR2, hr2]
        exact step_c0_100 (encodeL L) (encodeR R3)
      · simp only [hr2, show (1 : Fin 2) ≠ 0 by decide, ↓reduceIte] at h ⊢
        have hL0 := encodeL_popBitL L
        rcases hq0 : popBitL L with ⟨l0, L1⟩
        simp only [hq0] at h hL0 ⊢
        rcases fin2_cases l0 with hl0 | hl0
        · simp only [hl0, ↓reduceIte, Option.some.injEq] at h ⊢
          subst h
          refine ⟨by omega, ?_⟩
          simp only [encode, encodeR_pushB1R]
          rw [hL0, hl0, hR0, hr0, hR1, hr1, hR2, hr2]
          exact step_c0_101_0 (encodeL L1) (encodeR R3)
        · simp only [hl0, show (1 : Fin 2) ≠ 0 by decide, ↓reduceIte, Option.some.injEq] at h ⊢
          subst h
          refine ⟨by omega, ?_⟩
          simp only [encode, encodeL_pushB1L, encodeL_pushB0L, encodeR_pushB1R, encodeRep,
              encodePrepend]
          rw [hL0, hl0, hR0, hr0, hR1, hr1, hR2, hr2]
          exact step_c0_101_1 (encodeL L1) (encodeR R3)
    · simp only [hr1, show (1 : Fin 2) ≠ 0 by decide, ↓reduceIte] at h ⊢
      rcases fin2_cases r2 with hr2 | hr2
      · simp only [hr2, ↓reduceIte, Option.some.injEq] at h ⊢
        subst h
        refine ⟨by omega, ?_⟩
        simp only [encode, encodeL_pushW001, encodeRep]
        rw [hR0, hr0, hR1, hr1, hR2, hr2]
        exact step_c0_110 (encodeL L) (encodeR R3)
      · simp only [hr2, show (1 : Fin 2) ≠ 0 by decide, ↓reduceIte] at h ⊢
        have hR3 := encodeR_popBitR R3
        rcases hp3 : popBitR R3 with ⟨r3, R4⟩
        simp only [hp3] at h hR3 ⊢
        rcases fin2_cases r3 with hr3 | hr3
        · simp only [hr3, ↓reduceIte, Option.some.injEq] at h ⊢
          subst h
          refine ⟨by omega, ?_⟩
          simp only [encode, encodeL_pushW01]
          rw [hR0, hr0, hR1, hr1, hR2, hr2, hR3, hr3]
          exact step_c0_1110 (encodeL L) (encodeR R4)
        · simp only [hr3, show (1 : Fin 2) ≠ 0 by decide, ↓reduceIte, Option.some.injEq] at h ⊢
          subst h
          refine ⟨by omega, ?_⟩
          simp only [encode, encodeL_pushB1L, encodeL_pushB0L]
          rw [hR0, hr0, hR1, hr1, hR2, hr2, hR3, hr3]
          exact step_c0_1111 (encodeL L) (encodeR R4)

private theorem sound_c0_fallback_none (L : List TokL) (R : List TokR)
    (h : nextC0Fallback L R = none) :
    ∃ cfg', ReachesStar target_tm (encode (.c0 L R)) cfg' ∧ (step target_tm cfg').isNone := by
  unfold nextC0Fallback at h
  have hR0 := encodeR_popBitR R
  rcases hp0 : popBitR R with ⟨r0, R1⟩
  simp only [hp0] at h hR0
  have hR1 := encodeR_popBitR R1
  rcases hp1 : popBitR R1 with ⟨r1, R2⟩
  simp only [hp1] at h hR1
  rcases fin2_cases r0 with hr0 | hr0
  · rcases fin2_cases r1 with hr1 | hr1
    · refine ⟨⟨some 4, ⟨0, ListBlank.cons 1 (ListBlank.cons 1 (encodeL L)), encodeR R2⟩⟩, ?_, rfl⟩
      simp only [encode]
      rw [hR0, hr0, hR1, hr1]
      exact step_c0_halt (encodeL L) (encodeR R2)
    · simp [hr0, hr1] at h
  · simp only [hr0, show (1 : Fin 2) ≠ 0 by decide, ↓reduceIte] at h
    rcases hp2 : popBitR R2 with ⟨r2, R3⟩
    simp only [hp2] at h
    rcases fin2_cases r1 with hr1 | hr1
    · rcases fin2_cases r2 with hr2 | hr2
      · simp [hr1, hr2] at h
      · rcases hq0 : popBitL L with ⟨l0, L1⟩
        simp only [hq0] at h
        rcases fin2_cases l0 with hl0 | hl0 <;> simp [hr1, hr2, hl0] at h
    · rcases fin2_cases r2 with hr2 | hr2
      · simp [hr1, hr2] at h
      · rcases hp3 : popBitR R3 with ⟨r3, R4⟩
        simp only [hp3] at h
        rcases fin2_cases r3 with hr3 | hr3 <;> simp [hr1, hr2, hr3] at h

private theorem sound_c0_sweep_some (L : List TokL) (R : List TokR) (s' : State)
    (h : nextC0SweepOrFallback L R = some s') :
    0 < costC0SweepOrFallback L R ∧
    ReachesIn target_tm (costC0SweepOrFallback L R) (encode (.c0 L R)) (encode s') := by
  unfold nextC0SweepOrFallback at h
  unfold costC0SweepOrFallback
  split at h
  · next n R' =>
    simp only [Option.some.injEq] at h
    subst h
    refine ⟨by omega, ?_⟩
    simp only [encode, encodeR, encodeTokR, encodeL_pushW001]
    exact sweep_c0_w110 (n + 1) (encodeL L) (encodeR R')
  · next n R' =>
    simp only [Option.some.injEq] at h
    subst h
    refine ⟨by omega, ?_⟩
    simp only [encode, encodeR, encodeTokR, encodeL_pushW01]
    have h2n : 2 * n + 1 + 1 = 2 * (n + 1) := by omega
    rw [h2n]
    exact sweep_c0_w1110 (n + 1) (encodeL L) (encodeR R')
  · exact sound_c0_fallback_some L R s' h

private theorem sound_c0_sweep_none (L : List TokL) (R : List TokR)
    (h : nextC0SweepOrFallback L R = none) :
    ∃ cfg', ReachesStar target_tm (encode (.c0 L R)) cfg' ∧ (step target_tm cfg').isNone := by
  unfold nextC0SweepOrFallback at h
  split at h <;> try simp at h
  exact sound_c0_fallback_none L R h

private theorem sound_c0_climb_some (L : List TokL) (R : List TokR) (s' : State)
    (h : nextC0ClimbOrSweep L R = some s') :
    0 < costC0ClimbOrSweep L R ∧
    ReachesIn target_tm (costC0ClimbOrSweep L R) (encode (.c0 L R)) (encode s') := by
  unfold nextC0ClimbOrSweep at h
  unfold costC0ClimbOrSweep
  dsimp only at h ⊢
  split at h
  · next L' nb rAfter =>
    by_cases h4 : is4OnesR rAfter = true
    · simp only [h4, ↓reduceIte] at h ⊢
      have h_cl : ReachesIn target_tm (10 * nb + 25)
          (encode (.c0 (.b1 :: L') (.w1110 nb :: rAfter)))
          ⟨some 3, ⟨0, ListBlank.cons 1 (ListBlank.cons 0 (encodeL L')),
            ListBlank.cons 1 (ListBlank.cons 1 (ListBlank.cons 0
              (encodeRep [1, 1, 1, 0] (nb + 1) (encodeR (pop4OnesR rAfter)))))⟩⟩ := by
        simp only [encode, encodeL, encodeTokL, encodeR, encodeTokR]
        rw [encodeR_of_is4OnesR rAfter h4]
        exact (step_climb_1111 nb (encodeL L') (encodeR (pop4OnesR rAfter))) |> reachesIn_cast_flip
            (by omega)
      split at h
      · next n0 =>
        simp only [Option.some.injEq] at h
        subst h
        set rRest := pushW1110Opt nb (pop4OnesR rAfter)
        have h_flag : (if nb > 0 then true else is2OnesAfterPop4R rAfter) = is2OnesR rRest := by
          cases nb with
          | zero =>
            simp only [Nat.not_lt_zero, ↓reduceIte, rRest, pushW1110Opt]
            exact is2OnesAfterPop4R_eq rAfter h4
          | succ k =>
            simp only [Nat.succ_pos, ↓reduceIte, rRest, pushW1110Opt]
            cases pop4OnesR rAfter with
            | nil => rfl
            | cons t ts => cases t <;> rfl
        rw [h_flag]
        have h_rep : encodeRep [1, 1, 1, 0] (nb + 1) (encodeR (pop4OnesR rAfter)) =
            encodePrepend [1, 1, 1, 0] (encodeR rRest) := by
          simp only [rRest, encodeR_pushW1110Opt, encodeRep]
        rw [h_rep] at h_cl
        have ⟨hp2, h2⟩ := sound_d0_pre27_loopII n0 rRest
        exact ⟨by omega, (h_cl.trans h2) |> reachesIn_cast_flip (by omega)⟩
      · simp only [Option.some.injEq] at h
        subst h
        refine ⟨by omega, ?_⟩
        simpa only [encode, encodeL, encodeTokL, encodeL_pushB0L,
          encodeR_pushB1R, encodeR_pushB0R, encodeR_pushW1110, encodeRep, encodePrepend] using h_cl
    · have h4f : is4OnesR rAfter = false := Bool.eq_false_iff.mpr h4
      simp only [h4f, Bool.false_eq_true, ↓reduceIte] at h ⊢
      exact sound_c0_sweep_some _ _ s' h
  · exact sound_c0_sweep_some L R s' h

private theorem sound_c0_climb_none (L : List TokL) (R : List TokR)
    (h : nextC0ClimbOrSweep L R = none) :
    ∃ cfg', ReachesStar target_tm (encode (.c0 L R)) cfg' ∧ (step target_tm cfg').isNone := by
  unfold nextC0ClimbOrSweep at h
  dsimp only at h
  split at h
  · next L' nb rAfter =>
    by_cases h4 : is4OnesR rAfter = true
    · simp only [h4, ↓reduceIte] at h
      split at h <;> simp at h
    · have h4f : is4OnesR rAfter = false := Bool.eq_false_iff.mpr h4
      simp only [h4f, Bool.false_eq_true, ↓reduceIte] at h
      exact sound_c0_sweep_none _ _ h
  · exact sound_c0_sweep_none L R h

private theorem sound_c0_dive_some (L : List TokL) (R : List TokR) (s' : State)
    (h : nextC0DiveOrClimb L R = some s') :
    0 < costC0DiveOrClimb L R ∧
    ReachesIn target_tm (costC0DiveOrClimb L R) (encode (.c0 L R)) (encode s') := by
  unfold nextC0DiveOrClimb at h
  unfold costC0DiveOrClimb
  dsimp only at h ⊢
  split at h
  · next na nb rt =>
    split at h
    · next nc0 rt2 =>
      by_cases h1 : headBit1R rt2 = true
      · simp only [h1, ↓reduceIte, Option.some.injEq] at h ⊢
        subst h
        refine ⟨by omega, ?_⟩
        have hd1 := sound_dive_w110_b0 L na nb (.w1110 (nc0 + 1) :: .b0 :: rt2) rfl
        have h_pop : (popBitR (.w1110 (nc0 + 1) :: .b0 :: rt2)).2 =
            .b1 1 :: .b0 :: .w1110 nc0 :: .b0 :: rt2 := rfl
        have h_psh : pushW1110 (nb + 1) (.b1 1 :: .b0 :: .w1110 nc0 :: .b0 :: rt2) =
            .w1110 (nb + 1) :: .b1 1 :: .b0 :: .w1110 nc0 :: .b0 :: rt2 := rfl
        rw [h_pop, h_psh] at hd1
        have hd2 := sound_mid_dive_110_b0 (.b1 :: pushW001Opt na L) (nb + 1) nc0 rt2 h1
        have h2nb : 2 * (nb + 1) + 1 = 2 * nb + 3 := by omega
        rw [h2nb] at hd2
        exact (hd1.trans hd2) |> reachesIn_cast_flip (by omega)
      · have h1f : headBit1R rt2 = false := Bool.eq_false_iff.mpr h1
        simp only [h1f, Bool.false_eq_true, ↓reduceIte, Option.some.injEq] at h ⊢
        subst h
        exact ⟨by omega, sound_dive_w110_b0 L na nb (.w1110 (nc0 + 1) :: .b0 :: rt2) rfl⟩
    · by_cases h1 : headBit1R rt = true
      · simp only [h1, ↓reduceIte, Option.some.injEq] at h ⊢
        subst h
        exact ⟨by omega, sound_dive_w110_b0 L na nb rt h1⟩
      · have h1f : headBit1R rt = false := Bool.eq_false_iff.mpr h1
        simp only [h1f, Bool.false_eq_true, ↓reduceIte] at h ⊢
        exact sound_c0_climb_some L _ s' h
  · next nb nc rt =>
    by_cases h1 : headBit1R rt = true
    · simp only [h1, ↓reduceIte, Option.some.injEq] at h ⊢
      subst h
      exact ⟨by omega, sound_mid_dive_110_b0 L nb nc rt h1⟩
    · have h1f : headBit1R rt = false := Bool.eq_false_iff.mpr h1
      simp only [h1f, Bool.false_eq_true, ↓reduceIte] at h ⊢
      exact sound_c0_climb_some L _ s' h
  · next nb =>
    simp only [Option.some.injEq] at h
    subst h
    refine ⟨by omega, ?_⟩
    have h_turn := (step_turnaround_100 nb (encodeL L) default) |> reachesIn_cast_flip (show 10 *
        (nb + 1) + 5 = 10 * nb + 15 by omega)
    simpa [encode, encodeL, encodeTokL, encodeR, encodeTokR, encodeRep, encodePrepend,
      ListBlank.cons_zero_default] using h_turn
  · exact sound_c0_climb_some L R s' h

private theorem sound_c0_dive_none (L : List TokL) (R : List TokR)
    (h : nextC0DiveOrClimb L R = none) :
    ∃ cfg', ReachesStar target_tm (encode (.c0 L R)) cfg' ∧ (step target_tm cfg').isNone := by
  unfold nextC0DiveOrClimb at h
  dsimp only at h
  split at h
  · next na nb rt =>
    split at h
    · next nc0 rt2 =>
      by_cases h1 : headBit1R rt2 = true <;> simp [h1] at h
    · by_cases h1 : headBit1R rt = true
      · simp [h1] at h
      · have h1f : headBit1R rt = false := Bool.eq_false_iff.mpr h1
        simp only [h1f, Bool.false_eq_true, ↓reduceIte] at h
        exact sound_c0_climb_none L _ h
  · next nb nc rt =>
    by_cases h1 : headBit1R rt = true
    · simp [h1] at h
    · have h1f : headBit1R rt = false := Bool.eq_false_iff.mpr h1
      simp only [h1f, Bool.false_eq_true, ↓reduceIte] at h
      exact sound_c0_climb_none L _ h
  · simp at h
  · exact sound_c0_climb_none L R h

private theorem sound_c0_blank_some (na nb : ℕ) (rMid : List TokR) (s' : State)
    (h : nextC0Blank na nb rMid = some s') :
    0 < costC0Blank na nb rMid ∧
    ReachesIn target_tm (costC0Blank na nb rMid) (encode (.c0 [] (.w110 na :: .w1110 nb :: rMid)))
        (encode s') := by
  unfold nextC0Blank at h
  unfold costC0Blank
  dsimp only at h ⊢
  split at h
  -- 1. LoopIV with explicit .b0
  · next k0 rt =>
    let m := k0 / 4 + 1
    let rem := k0 % 4
    have h_iv : ReachesIn target_tm (m * (10 * (na + 1 + (nb + 1) + m) + 5))
        (encode (.c0 [] (.w110 na :: .w1110 nb :: .b1 (k0 + 3) :: .b0 :: rt)))
        ⟨some 2, ⟨0, default, encodeRep [1, 1, 0] (na + m + 1) (encodeRep [1, 1, 1, 0] (nb + m + 1)
          (encodeRep [1] rem (ListBlank.cons 0 (encodeR rt))))⟩⟩ := by
      simp only [encode, encodeL, encodeR, encodeTokR]
      have hk : k0 + 3 + 1 = 4 * m + rem := by omega
      rw [hk, encodeRep_one_four_rem]
      exact loopIV_run m na nb (encodeRep [1] rem (ListBlank.cons 0 (encodeR rt)))
    have h_rem_enc : ∀ rs : List TokR,
        encodeR (if rem = 0 then pushB0R rs else pushB1R (rem - 1) (pushB0R rs)) =
          encodeRep [1] rem (ListBlank.cons 0 (encodeR rs)) := by
      intro rs
      by_cases hr0 : rem = 0
      · simp [hr0, encodeR_pushB0R, encodeRep]
      · simp only [hr0, ↓reduceIte, encodeR_pushB1R, encodeR_pushB0R]
        congr 1; omega
    split at h
    · next nm rt2 hrem =>
      try dsimp only at h ⊢
      simp only [Option.some.injEq] at h
      subst h
      have hrem1 : rem = 1 := hrem
      rw [hrem1] at h_iv
      have h_v := loopV_run (nm + 1) (na + m) (nb + m) (encodeR rt2)
      have h_iv' : ReachesIn target_tm (m * (10 * (na + 1 + (nb + 1) + m) + 5))
          (encode (.c0 [] (.w110 na :: .w1110 nb :: .b1 (k0 + 3) :: .b0 :: .w1110 nm :: rt2)))
          ⟨some 2, ⟨0, default, encodeRep [1, 1, 0] (na + m + 1) (encodeRep [1, 1, 1,
              0] (nb + m + 1)
            (ListBlank.cons 1 (ListBlank.cons 0 (encodeRep [1, 1, 1,
                0] (nm + 1) (encodeR rt2)))))⟩⟩ := by
        simpa [encodeR, encodeTokR, encodeRep, encodePrepend] using h_iv
      have h_iv_v := (h_iv'.trans h_v) |> reachesIn_cast_flip (show
        m * (10 * (na + 1 + (nb + 1) + m) + 5) + (nm + 1) * (20 * (na + m + 1 + (nb + m + 1)) + 30
            * (nm + 1) + 6) =
        m * (10 * (na + 1 + (nb + 1) + m) + 5) + (nm + 1) * (20 * (na + m + (nb + m) + 2) + 30 *
            (nm + 1) + 6) by ring)
      exact sound_finish_loopV (na + m + 2 * (nm + 1)) (nb + m + (nm + 1)) rt2 _ _
          (by positivity) h_iv_v
    · try dsimp only at h ⊢
      simp only [Option.some.injEq] at h
      subst h
      refine ⟨by positivity, ?_⟩
      simpa only [m, rem, encode, encodeL, encodeR_pushW110, encodeR_pushW1110,
          h_rem_enc] using h_iv
  -- 2. LoopIV at blank right end
  · next k0 =>
    simp only [Option.some.injEq] at h
    subst h
    set m := k0 / 4 + 1
    set rem := k0 % 4
    refine ⟨by positivity, ?_⟩
    have hk : k0 + 3 + 1 = 4 * m + rem := by omega
    have h_iv := loopIV_run m na nb (encodeRep [1] rem default)
    have h_rem_enc : encodeR (if rem = 0 then [] else pushB1R (rem - 1) []) =
        encodeRep [1] rem default := by
      by_cases hr0 : rem = 0
      · simp [hr0, encodeR, encodeRep]
      · simp only [hr0, ↓reduceIte, encodeR_pushB1R, encodeR]
        congr 1; omega
    simp only [encode, encodeL, encodeR, encodeTokR, encodeR_pushW110, encodeR_pushW1110, h_rem_enc]
    rw [hk, encodeRep_one_four_rem]
    exact h_iv
  -- 3. BounceGe4 on .b1 0 :: .w1110 nc :: rt
  · next nc rt =>
    simp only [Option.some.injEq] at h
    subst h
    refine ⟨by omega, ?_⟩
    have h_in : encodeR (.b1 0 :: .w1110 nc :: rt) =
        encodePrepend [1, 1, 1, 1] (ListBlank.cons 0 (encodeR (pushW1110Opt nc rt))) := by
      simp only [encodeR]
      rw [encodeTokR_w1110_eq_opt nc rt]
      rfl
    simp only [encode, encodeL, encodeR_pushW110, encodeR_pushW1110, encodeR_pushB0R]
    change ReachesIn target_tm _ ⟨some 2, ⟨0, default,
      encodeRep [1, 1, 0] (na + 1) (encodeRep [1, 1, 1,
          0] (nb + 1) (encodeR (.b1 0 :: .w1110 nc :: rt)))⟩⟩ _
    rw [h_in]
    exact (step_bounce_ge4 na (nb + 1) (ListBlank.cons 0 (encodeR (pushW1110Opt nc rt)))) |>
        reachesIn_cast_flip (by omega)
  -- 4. LoopIII
  · next n31 rt =>
    simp only [Option.some.injEq] at h
    subst h
