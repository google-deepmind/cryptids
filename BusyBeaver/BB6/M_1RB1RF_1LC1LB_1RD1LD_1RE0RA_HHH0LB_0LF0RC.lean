private theorem pushB1R_of_ge3 {n : ℕ} {rs : List TokR} (hn : n ≥ 3) :
    pushB1R n rs = match rs with | .b1 m :: rs' => .b1 (n + m + 1) :: rs' | _ => .b1 n :: rs := by
  unfold pushB1R
  cases rs with
  | nil => simp only; split_ifs <;> first | rfl | omega
  | cons t rs' => cases t <;> (simp only; split_ifs <;> first | rfl | omega)

