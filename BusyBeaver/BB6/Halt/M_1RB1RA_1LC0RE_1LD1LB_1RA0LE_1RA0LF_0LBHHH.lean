theorem chain_tree {t : CertTree} {fc fc' : FastConfig}
    (hwf : fc.WF) (h : run_tree t fc = .inl fc')
    (hrest : fc'.WF → HaltsFrom target_tm (flush_fc fc').denote) :
    HaltsFrom target_tm (flush_fc fc).denote := by
  have hs := run_tree_spec t fc hwf
  rw [h] at hs
  exact HaltsFrom.of_reachesStar hs.1 (hrest hs.2)

theorem done_tree {t : CertTree} {fc : FastConfig}
    (hwf : fc.WF) (h : run_tree t fc = .inr true) :
    HaltsFrom target_tm (flush_fc fc).denote := by
  have hs := run_tree_spec t fc hwf
  rw [h] at hs
  exact hs rfl

