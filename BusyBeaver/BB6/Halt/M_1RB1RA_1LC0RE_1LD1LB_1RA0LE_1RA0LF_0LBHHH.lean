  exact chain_tree hwf0 step_0 fun hwf1 =>
    chain_tree hwf1 step_1 fun hwf2 =>
    chain_tree hwf2 step_2 fun hwf3 =>
    chain_tree hwf3 step_3 fun hwf4 =>
