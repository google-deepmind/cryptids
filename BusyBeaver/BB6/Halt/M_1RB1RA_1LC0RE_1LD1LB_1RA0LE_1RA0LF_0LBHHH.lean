def withNat {α : Type} (x : Nat) (k : Nat → α) : α :=
  match x + 1 with
  | 0 => k 0
  | v + 1 => k v

@[simp] theorem withNat_apply {α : Type} (x : Nat) (k : Nat → α) : withNat x k = k x := by
  cases x <;> rfl

