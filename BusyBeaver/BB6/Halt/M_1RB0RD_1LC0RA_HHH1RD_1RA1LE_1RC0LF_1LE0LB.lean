      some ⟨q', Dir.left, ls, r'⟩

theorem bstep_sound (c c' : DCfg) (h : bstep c = some c') :
    (evalDCfg default default c) [tm_coq]⊢ (evalDCfg default default c') := by
  rcases c with ⟨q, dir, l, r⟩
  cases dir with
  | right =>
    cases r with
    | nil =>
      try dsimp [bstep] at h
      cases h_tm : tm_coq q 0 with
      | none => rw [h_tm] at h; nomatch h
      | some val =>
        rcases val with ⟨_ | q', ⟨w, d'⟩⟩
        · rw [h_tm] at h; nomatch h
        · cases d' with
          | right =>
            rw [h_tm] at h; injection h with h'; subst h'
            cases l with
            | nil =>
              by_cases hw : w = 0
              · subst hw; simp [step, evalDCfg, h_tm, Turing.Tape.write, Turing.Tape.move]
              · simp [step, evalDCfg, h_tm, hw, Turing.Tape.write, Turing.Tape.move]
            | cons b' ls' =>
              simp [step, evalDCfg, h_tm, Turing.Tape.write, Turing.Tape.move]
          | left =>
            rw [h_tm] at h; injection h with h'; subst h'
            by_cases hw : w = 0
            · subst hw; simp [step, evalDCfg, h_tm, Turing.Tape.write, Turing.Tape.move]
            · simp [step, evalDCfg, h_tm, hw, Turing.Tape.write, Turing.Tape.move]
    | cons b rs =>
      try dsimp [bstep] at h
      cases h_tm : tm_coq q b with
      | none => rw [h_tm] at h; nomatch h
      | some val =>
        rcases val with ⟨_ | q', ⟨w, d'⟩⟩
        · rw [h_tm] at h; nomatch h
        · cases d' with
          | right =>
            rw [h_tm] at h; injection h with h'; subst h'
            cases l with
            | nil =>
              by_cases hw : w = 0
              · subst hw; simp [step, evalDCfg, h_tm, Turing.Tape.write, Turing.Tape.move]
              · simp [step, evalDCfg, h_tm, hw, Turing.Tape.write, Turing.Tape.move]
            | cons b' ls' =>
              simp [step, evalDCfg, h_tm, Turing.Tape.write, Turing.Tape.move]
          | left =>
            rw [h_tm] at h; injection h with h'; subst h'
            cases rs with
            | nil =>
              by_cases hw : w = 0
              · subst hw; simp [step, evalDCfg, h_tm, Turing.Tape.write, Turing.Tape.move]
              · simp [step, evalDCfg, h_tm, hw, Turing.Tape.write, Turing.Tape.move]
            | cons b' rs' =>
              simp [step, evalDCfg, h_tm, Turing.Tape.write, Turing.Tape.move]
  | left =>
    cases l with
    | nil =>
      try dsimp [bstep] at h
      cases h_tm : tm_coq q 0 with
      | none => rw [h_tm] at h; nomatch h
      | some val =>
        rcases val with ⟨_ | q', ⟨w, d'⟩⟩
        · rw [h_tm] at h; nomatch h
        · cases d' with
          | right =>
            rw [h_tm] at h; injection h with h'; subst h'
            by_cases hw : w = 0
            · subst hw; simp [step, evalDCfg, h_tm, Turing.Tape.write, Turing.Tape.move]
            · simp [step, evalDCfg, h_tm, hw, Turing.Tape.write, Turing.Tape.move]
          | left =>
            rw [h_tm] at h; injection h with h'; subst h'
            cases r with
            | nil =>
              by_cases hw : w = 0
              · subst hw; simp [step, evalDCfg, h_tm, Turing.Tape.write, Turing.Tape.move]
              · simp [step, evalDCfg, h_tm, hw, Turing.Tape.write, Turing.Tape.move]
            | cons b' rs' =>
              simp [step, evalDCfg, h_tm, Turing.Tape.write, Turing.Tape.move]
    | cons b ls =>
      try dsimp [bstep] at h
      cases h_tm : tm_coq q b with
      | none => rw [h_tm] at h; nomatch h
      | some val =>
        rcases val with ⟨_ | q', ⟨w, d'⟩⟩
        · rw [h_tm] at h; nomatch h
        · cases d' with
          | right =>
            rw [h_tm] at h; injection h with h'; subst h'
            cases ls with
            | nil =>
              by_cases hw : w = 0
              · subst hw; simp [step, evalDCfg, h_tm, Turing.Tape.write, Turing.Tape.move]
              · simp [step, evalDCfg, h_tm, hw, Turing.Tape.write, Turing.Tape.move]
            | cons b' ls' =>
              simp [step, evalDCfg, h_tm, Turing.Tape.write, Turing.Tape.move]
          | left =>
            rw [h_tm] at h; injection h with h'; subst h'
            cases r with
            | nil =>
              by_cases hw : w = 0
              · subst hw; simp [step, evalDCfg, h_tm, Turing.Tape.write, Turing.Tape.move]
              · simp [step, evalDCfg, h_tm, hw, Turing.Tape.write, Turing.Tape.move]
            | cons b' rs' =>
              simp [step, evalDCfg, h_tm, Turing.Tape.write, Turing.Tape.move]

def bmultiStep : ℕ → DCfg → Option DCfg
  | 0, c => some c
  | n + 1, c => (bstep c).bind (bmultiStep n)

theorem bmultiStep_sound : ∀ (n : ℕ) (c c' : DCfg),
    bmultiStep n c = some c' →
    (evalDCfg default default c) [tm_coq]⊢^{n} (evalDCfg default default c')
  | 0, c, c', h => by injection h with h'; subst h'; rfl
  | n + 1, c, c', h => by
    simp only [bmultiStep, Option.bind_eq_some_iff] at h
    rcases h with ⟨c₁, h₁, h₂⟩
    exact multiStep_step (bstep_sound c c₁ h₁) (bmultiStep_sound n c₁ c' h₂)

-- ============================================================================
-- Segment Relations (`segRR`, `segLL`, `segRL`, `sideRL`, `sideRLs`, `segRLs`)
-- ============================================================================

def segRR (q₁ q₂ : Fin 6) (w m : List (Fin 2)) : Prop :=
  ∀ l r, (l {{q₁}}> (w +> r)) [tm_coq]⊢* ((m +> l) {{q₂}}> r)

def segLL (q₁ q₂ : Fin 6) (w o : List (Fin 2)) : Prop :=
  ∀ l r, ((w +> l) <{{q₁}} r) [tm_coq]⊢* (l <{{q₂}} (o +> r))

def segRL (q₁ q₂ : Fin 6) (w w' : List (Fin 2)) : Prop :=
  ∀ l r, (l {{q₁}}> (w +> r)) [tm_coq]⊢* (l <{{q₂}} (w' +> r))

def sideRL (q₁ q₂ : Fin 6) (R R' : ListBlank (Fin 2)) : Prop :=
  ∀ l, (l {{q₁}}> R) [tm_coq]⊢* (l <{{q₂}} R')

def haltsFrom (c : Cfg (Fin 2) (Fin 6)) : Prop :=
  ∃ cfg, (c [tm_coq]⊢* cfg) ∧ (step tm_coq cfg).isNone

lemma haltsFrom_stepStar {c₁ c₂ : Cfg (Fin 2) (Fin 6)} (h₁ : c₁ [tm_coq]⊢* c₂) (h₂ : haltsFrom c₂) :
    haltsFrom c₁ := by
  rcases h₂ with ⟨cfg, h₂, hnone⟩
  exact ⟨cfg, stepStar_trans h₁ h₂, hnone⟩

def sideRL_halt (R : ListBlank (Fin 2)) : Prop :=
  ∀ l, haltsFrom (l {{B}}> R)

lemma segRR_app {q₁ q₂ q₃ : Fin 6} {w₁ w₂ m₁ m₂ : List (Fin 2)}
    (h₁ : segRR q₁ q₂ w₁ m₁) (h₂ : segRR q₂ q₃ w₂ m₂) :
    segRR q₁ q₃ (w₁ ++ w₂) (m₂ ++ m₁) := by
  intro l r
  rw [listblank_append_assoc, listblank_append_assoc]
  exact stepStar_trans (h₁ l (w₂ +> r)) (h₂ (m₁ +> l) r)

lemma segLL_app {q₁ q₂ q₃ : Fin 6} {w₁ w₂ o₁ o₂ : List (Fin 2)}
    (h₁ : segLL q₁ q₂ w₁ o₁) (h₂ : segLL q₂ q₃ w₂ o₂) :
    segLL q₁ q₃ (w₁ ++ w₂) (o₂ ++ o₁) := by
  intro l r
  rw [listblank_append_assoc, listblank_append_assoc]
  exact stepStar_trans (h₁ (w₂ +> l) r) (h₂ l (o₁ +> r))

lemma segRR_RL_LL {q₁ q₂ q₃ q₄ : Fin 6} {w₁ w₂ m w₁' w₂' : List (Fin 2)}
    (h₁ : segRR q₁ q₂ w₁ m) (h₂ : segRL q₂ q₃ w₂ w₂') (h₃ : segLL q₃ q₄ m w₁') :
    segRL q₁ q₄ (w₁ ++ w₂) (w₁' ++ w₂') := by
  intro l r
  rw [listblank_append_assoc, listblank_append_assoc]
  exact stepStar_trans (h₁ l (w₂ +> r)) (stepStar_trans (h₂ (m +> l) r) (h₃ l (w₂' +> r)))

lemma segRR_sideRL_LL {q₁ q₂ q₃ q₄ : Fin 6} {w m w' : List (Fin 2)} {r r' : ListBlank (Fin 2)}
    (h₁ : segRR q₁ q₂ w m) (h₂ : sideRL q₂ q₃ r r') (h₃ : segLL q₃ q₄ m w') :
    sideRL q₁ q₄ (w +> r) (w' +> r') := by
  intro l
  exact stepStar_trans (h₁ l r) (stepStar_trans (h₂ (m +> l)) (h₃ l r'))

lemma segRL_frame {q₁ q₂ : Fin 6} {w w' : List (Fin 2)} (u : List (Fin 2))
    (h : segRL q₁ q₂ w w') : segRL q₁ q₂ (w ++ u) (w' ++ u) := by
  intro l r
  rw [listblank_append_assoc, listblank_append_assoc]
  exact h l (u +> r)

lemma segRL_side {q₁ q₂ : Fin 6} {w w' : List (Fin 2)} (R : ListBlank (Fin 2))
    (h : segRL q₁ q₂ w w') : sideRL q₁ q₂ (w +> R) (w' +> R) := by
  intro l; exact h l R

inductive sideRLs : Nat → ListBlank (Fin 2) → ListBlank (Fin 2) → Prop
  | zero (R : ListBlank (Fin 2)) : sideRLs 0 R R
  | succ {n : Nat} {R R₁ R' : ListBlank (Fin 2)} :
      sideRL B D R R₁ → sideRLs n R₁ R' → sideRLs (n + 1) R R'

lemma sideRLs_append : ∀ {n₁ n₂ : Nat} {R₁ R₂ R₃ : ListBlank (Fin 2)},
    sideRLs n₁ R₁ R₂ → sideRLs n₂ R₂ R₃ → sideRLs (n₁ + n₂) R₁ R₃
  | 0, _, _, _, _, .zero _, h₂ => by simpa using h₂
  | n₁ + 1, n₂, _, _, _, .succ h step₁, h₂ => by
    rw [Nat.succ_add]
    exact .succ h (sideRLs_append step₁ h₂)

lemma sideRLs_split : ∀ {n₁ n₂ : Nat} {R R' : ListBlank (Fin 2)},
    sideRLs (n₁ + n₂) R R' → ∃ R₁, sideRLs n₁ R R₁ ∧ sideRLs n₂ R₁ R'
  | 0, n₂, R, R', h => by
    rw [Nat.zero_add] at h
    exact ⟨R, .zero R, h⟩
  | n₁ + 1, n₂, R, R', h => by
    rw [Nat.succ_add] at h
    cases h with
    | succ h₁ hrest =>
      rcases sideRLs_split hrest with ⟨R₁, hs₁, hs₂⟩
      exact ⟨R₁, .succ h₁ hs₁, hs₂⟩

def segRLs (n p : Nat) (w w' : List (Fin 2)) : Prop :=
  ∀ R R', sideRLs p R R' → sideRLs n (w +> R) (w' +> R')

lemma segRLs_O (w : List (Fin 2)) : segRLs 0 0 w w := by
  intro R R' h; cases h; exact .zero (w +> R)

lemma segRLs_trans {n₁ n₂ p₁ p₂ : Nat} {w₁ w₂ w₃ : List (Fin 2)}
    (h₁ : segRLs n₁ p₁ w₁ w₂) (h₂ : segRLs n₂ p₂ w₂ w₃) :
    segRLs (n₁ + n₂) (p₁ + p₂) w₁ w₃ := by
  intro R R' h
  rcases sideRLs_split h with ⟨R₁, hp₁, hp₂⟩
  exact sideRLs_append (h₁ R R₁ hp₁) (h₂ R₁ R' hp₂)

lemma lrcons1 {w₁ w₂ m : List (Fin 2)} (hR : segRR B B w₁ m) (hL : segLL D D m w₂) :
    segRLs 1 1 w₁ w₂ := by
  intro R R' h
  cases h with
  | succ h₁ h₀ =>
    cases h₀
    exact .succ (segRR_sideRL_LL hR h₁ hL) (.zero (w₂ +> R'))

lemma side1 {w w' : List (Fin 2)} {r r' : ListBlank (Fin 2)}
    (h₁ : segRLs 1 1 w w') (h₂ : sideRL B D r r') :
    sideRL B D (w +> r) (w' +> r') := by
  have h := h₁ r r' (.succ h₂ (.zero r'))
  cases h with
  | succ hs h₀ =>
    cases h₀
    exact hs

def passRL (w w' : List (Fin 2)) : Prop :=
  segRLs 1 1 w w' ∧ ∀ R, sideRL_halt R → sideRL_halt (w +> R)

lemma lrcons1_pass {w₁ w₂ m : List (Fin 2)} (hR : segRR B B w₁ m) (hL : segLL D D m w₂) :
    passRL w₁ w₂ :=
  ⟨lrcons1 hR hL, fun R hHalt l => haltsFrom_stepStar (hR l R) (hHalt (m +> l))⟩

lemma stop1s {w w' : List (Fin 2)} (h : segRL B D w w') : segRLs 1 0 w w' := by
  intro R R' h0
  cases h0
  exact .succ (segRL_side R h) (.zero (w' +> R))

lemma segRR_pow {q : Fin 6} {u v : List (Fin 2)} (h : segRR q q u v) :
    ∀ k : ℕ, segRR q q (u ^ k) (v ^ k)
  | 0 => fun _ _ => ⟨0, rfl⟩
  | k + 1 => by
    rw [pow_succ_list, pow_succ_right]
    exact segRR_app h (segRR_pow h k)

lemma segLL_pow {q : Fin 6} {u v : List (Fin 2)} (h : segLL q q u v) :
    ∀ k : ℕ, segLL q q (u ^ k) (v ^ k)
  | 0 => fun _ _ => ⟨0, rfl⟩
  | k + 1 => by
    rw [pow_succ_list, pow_succ_right]
    exact segLL_app h (segLL_pow h k)

-- ============================================================================
-- Word Algebra & Definitions
-- ============================================================================

lemma pow_01_zero (n : ℕ) : ([0, 1] : List (Fin 2)) ^ n ++ [0] = [0] ++ ([1, 0] : List (Fin 2)) ^ n := by
  induction n with
  | zero => rfl
  | succ n ih =>
    calc ([0, 1] : List (Fin 2)) ^ (n + 1) ++ [0]
      _ = [0, 1] ++ ([0, 1] ^ n ++ [0]) := by rw [pow_succ_list, List.append_assoc]
      _ = [0, 1] ++ ([0] ++ [1, 0] ^ n) := by rw [ih]
      _ = [0] ++ ([1, 0] ++ [1, 0] ^ n) := rfl
      _ = [0] ++ [1, 0] ^ (n + 1) := by rw [← pow_succ_list]

lemma one_pow_01 (n : ℕ) : ([1] : List (Fin 2)) ++ ([0, 1] : List (Fin 2)) ^ n = ([1, 0] : List (Fin 2)) ^ n ++ [1] := by
  induction n with
  | zero => rfl
  | succ n ih =>
    calc ([1] : List (Fin 2)) ++ [0, 1] ^ (n + 1)
      _ = [1, 0] ++ ([1] ++ [0, 1] ^ n) := by rw [pow_succ_list]; rfl
      _ = [1, 0] ++ ([1, 0] ^ n ++ [1]) := by rw [ih]
      _ = ([1, 0] ++ [1, 0] ^ n) ++ [1] := by rw [← List.append_assoc]
      _ = [1, 0] ^ (n + 1) ++ [1] := by rw [← pow_succ_list]

lemma zero_pow10_one (n : ℕ) : ([0] : List (Fin 2)) ++ ([1, 0] : List (Fin 2)) ^ n ++ [1] = ([0, 1] : List (Fin 2)) ^ (n + 1) := by
  rw [← pow_01_zero, List.append_assoc]
  exact (pow_succ_right [0, 1] n).symm

lemma one_pow111 (n : ℕ) : ([1] : List (Fin 2)) ++ ([1, 1, 1] : List (Fin 2)) ^ n = ([1, 1, 1] : List (Fin 2)) ^ n ++ [1] := by
  induction n with
  | zero => rfl
  | succ n ih =>
    calc ([1] : List (Fin 2)) ++ [1, 1, 1] ^ (n + 1)
      _ = [1, 1, 1] ++ ([1] ++ [1, 1, 1] ^ n) := by rw [pow_succ_list]; rfl
      _ = [1, 1, 1] ++ ([1, 1, 1] ^ n ++ [1]) := by rw [ih]
      _ = ([1, 1, 1] ++ [1, 1, 1] ^ n) ++ [1] := by rw [← List.append_assoc]
      _ = [1, 1, 1] ^ (n + 1) ++ [1] := by rw [← pow_succ_list]

lemma two_ones_pow111 (n : ℕ) : ([1, 1] : List (Fin 2)) ++ ([1, 1, 1] : List (Fin 2)) ^ n = ([1, 1, 1] : List (Fin 2)) ^ n ++ [1, 1] := by
  induction n with
  | zero => rfl
  | succ n ih =>
    calc ([1, 1] : List (Fin 2)) ++ [1, 1, 1] ^ (n + 1)
      _ = [1, 1, 1] ++ ([1, 1] ++ [1, 1, 1] ^ n) := by rw [pow_succ_list]; rfl
      _ = [1, 1, 1] ++ ([1, 1, 1] ^ n ++ [1, 1]) := by rw [ih]
      _ = ([1, 1, 1] ++ [1, 1, 1] ^ n) ++ [1, 1] := by rw [← List.append_assoc]
      _ = [1, 1, 1] ^ (n + 1) ++ [1, 1] := by rw [← pow_succ_list]

def stack (j : ℕ) : List (Fin 2) := [1] ++ [1, 1, 1] ^ j
def blk (m j : ℕ) : List (Fin 2) := [0, 1] ^ (m + 1) ++ [1, 1, 1] ^ j
def bmid (m j : ℕ) : List (Fin 2) := [0, 1] ++ [0, 1, 1] ^ j ++ [0, 1] ^ m
def lbw (m j : ℕ) : List (Fin 2) := [0, 1, 1] ^ j ++ [0, 1] ^ (m + 1)
def xbmid (x : ℕ) : List (Fin 2) := [0, 0, 1] ++ [0, 1] ^ x

lemma blk_eq_10 (m j : ℕ) : blk m j = [0] ++ [1, 0] ^ m ++ stack j := by
  unfold blk stack
  rw [← zero_pow10_one, List.append_assoc]

def blkp (p : ℕ × ℕ) : List (Fin 2) := blk p.1 p.2
def bmidp (p : ℕ × ℕ) : List (Fin 2) := bmid p.1 p.2
def lbwp (p : ℕ × ℕ) : List (Fin 2) := lbw p.1 p.2

def cw : List (ℕ × ℕ) → List (Fin 2)
  | [] => []
  | p :: ch => blkp p ++ cw ch

def cmid : List (ℕ × ℕ) → List (Fin 2)
  | [] => []
  | p :: ch => cmid ch ++ bmidp p

def clbw : List (ℕ × ℕ) → List (Fin 2)
  | [] => []
  | p :: ch => clbw ch ++ lbwp p

lemma cw_app (l₁ l₂ : List (ℕ × ℕ)) : cw (l₁ ++ l₂) = cw l₁ ++ cw l₂ := by
  induction l₁ with
  | nil => rfl
  | cons p l₁ ih => simp [cw, ih, List.append_assoc]

def pw (c j : ℕ) (ch : List (ℕ × ℕ)) : List (Fin 2) := blk c j ++ cw ch
def lead1 (a x : ℕ) : List (Fin 2) := blk a 1 ++ [0] ++ [1, 0] ^ x
def lead0 (a x : ℕ) : List (Fin 2) := [0, 1] ^ a ++ [0, 0] ++ [1, 0] ^ x
def tailw (g : ℕ) : List (Fin 2) := [1, 1] ++ [1, 1, 1] ^ g
def edgew (x f : ℕ) : List (Fin 2) := [0] ++ [1, 0] ^ x ++ [1, 1, 1] ^ f
def edge1w (f : ℕ) : List (Fin 2) := [1] ++ [1, 1, 1] ^ f
def leadw (b : Bool) (a x : ℕ) : List (Fin 2) := if b then lead1 a x else lead0 a x
def uw (bs : List (ℕ × ℕ)) (b : Bool) (a x : ℕ) (far : List (Fin 2)) : List (Fin 2) :=
  cw bs ++ leadw b a x ++ far

def consume (bs : List (ℕ × ℕ)) (a : ℕ) : Option (ℕ × List (ℕ × ℕ) × ℕ) :=
  match bs with
  | (c + 1, j) :: r => some (0, (c, j) :: r, a)
  | (0, j) :: r => some (j, r, a)
  | [] => match a with | a' + 1 => some (0, [], a') | 0 => none

-- ============================================================================
-- Shift Rules & Block / Chain Lemmas
-- ============================================================================

lemma shift_F_01 : segRR F F [0, 1] [0, 1] :=
  fun l r => dmultiStep_star 2 ⟨F, .right, [], [0, 1]⟩ ⟨F, .right, [0, 1], []⟩ l r rfl

lemma B_to_F_01 : segRR B F [0, 1] [0, 1] :=
  fun l r => dmultiStep_star 4 ⟨B, .right, [], [0, 1]⟩ ⟨F, .right, [0, 1], []⟩ l r rfl

lemma shift_F_111 (l r : ListBlank (Fin 2)) :
    (([0, 1] +> l) {{F}}> ([1, 1, 1] +> r)) [tm_coq]⊢* (([0, 1, 0, 1, 1] +> l) {{F}}> r) :=
  dmultiStep_star 9 ⟨F, .right, [0, 1], [1, 1, 1]⟩ ⟨F, .right, [0, 1, 0, 1, 1], []⟩ l r rfl

lemma shift_F_111_pow : ∀ (j : ℕ) (l r : ListBlank (Fin 2)),
    (([0, 1] +> l) {{F}}> ([1, 1, 1] ^ j +> r)) [tm_coq]⊢* ((([0, 1] ++ [0, 1, 1] ^ j) +> l) {{F}}> r)
  | 0, l, r => ⟨0, rfl⟩
  | j + 1, l, r => by
    rw [pow_succ_list ([1, 1, 1]), pow_succ_right ([0, 1, 1]), ← List.append_assoc,
      listblank_append_assoc, listblank_append_assoc]
    have h1 : (([0, 1] +> l) {{F}}> ([1, 1, 1] +> ([1, 1, 1] ^ j +> r))) [tm_coq]⊢*
        (([0, 1] +> ([0, 1, 1] +> l)) {{F}}> ([1, 1, 1] ^ j +> r)) :=
      shift_F_111 l ([1, 1, 1] ^ j +> r)
    exact stepStar_trans h1 (shift_F_111_pow j ([0, 1, 1] +> l) r)

lemma shift_D_01 : segLL D D [0, 1] [0, 1] :=
  fun l r => dmultiStep_star 2 ⟨D, .left, [0, 1], []⟩ ⟨D, .left, [], [0, 1]⟩ l r rfl

lemma shift_D_011 : segLL D D [0, 1, 1] [1, 1, 1] :=
  fun l r => dmultiStep_star 5 ⟨D, .left, [0, 1, 1], []⟩ ⟨D, .left, [], [1, 1, 1]⟩ l r rfl

lemma shift_A_01 : segLL A A [0, 1] [0, 1] :=
  fun l r => dmultiStep_star 2 ⟨A, .left, [0, 1], []⟩ ⟨A, .left, [], [0, 1]⟩ l r rfl

lemma A_default_to_F (R : ListBlank (Fin 2)) :
    (default <{{A}} R) [tm_coq]⊢* (([0, 1] +> default) {{F}}> R) :=
  ldmultiStep_star 5 ⟨A, .left, [], []⟩ ⟨F, .right, [0, 1], []⟩ R rfl

lemma blkRR_F (m j : ℕ) : segRR F F (blk m j) (bmid m j) := by
  intro l r
  unfold blk bmid
  rw [listblank_append_assoc]
  have h1 : (l {{F}}> ([0, 1] ^ (m + 1) +> ([1, 1, 1] ^ j +> r))) [tm_coq]⊢*
      (([0, 1] +> ([0, 1] ^ m +> l)) {{F}}> ([1, 1, 1] ^ j +> r)) := by
    simpa [pow_succ_list] using segRR_pow shift_F_01 (m + 1) l ([1, 1, 1] ^ j +> r)
  have h2 := shift_F_111_pow j ([0, 1] ^ m +> l) r
  simpa [List.append_assoc] using stepStar_trans h1 h2

lemma blkRR_B (m j : ℕ) : segRR B F (blk m j) (bmid m j) := by
  intro l r
  unfold blk bmid
  rw [listblank_append_assoc]
  have h1 : (l {{B}}> ([0, 1] ^ (m + 1) +> ([1, 1, 1] ^ j +> r))) [tm_coq]⊢*
      (([0, 1] +> ([0, 1] ^ m +> l)) {{F}}> ([1, 1, 1] ^ j +> r)) := by
    have hR := segRR_app B_to_F_01 (segRR_pow shift_F_01 m) l ([1, 1, 1] ^ j +> r)
    rw [← pow_succ_right] at hR
    simpa [pow_succ_list] using hR
  have h2 := shift_F_111_pow j ([0, 1] ^ m +> l) r
  simpa [List.append_assoc] using stepStar_trans h1 h2

lemma blkLL (m j : ℕ) : segLL D D (lbw m j) (blk m j) :=
  segLL_app (segLL_pow shift_D_011 j) (segLL_pow shift_D_01 (m + 1))

lemma sweepLL : segLL D D [0, 1] [0, 1] := shift_D_01
lemma yLL_glue (j : ℕ) : segLL D D ([0, 1, 1] ^ j) ([1, 1, 1] ^ j) := segLL_pow shift_D_011 j

lemma chainRR : ∀ ch : List (ℕ × ℕ), segRR F F (cw ch) (cmid ch)
  | [] => fun _ _ => ⟨0, rfl⟩
  | p :: ch => segRR_app (blkRR_F p.1 p.2) (chainRR ch)

lemma chainLL : ∀ ch : List (ℕ × ℕ), segLL D D (clbw ch) (cw ch)
  | [] => fun _ _ => ⟨0, rfl⟩
  | p :: ch => segLL_app (chainLL ch) (blkLL p.1 p.2)

lemma bmid_shift (m j : ℕ) : bmid m j ++ [0, 1] = [0, 1] ++ lbw m j := by
  unfold bmid lbw
  rw [List.append_assoc, List.append_assoc, ← pow_succ_right]

lemma cmid_shift : ∀ ch : List (ℕ × ℕ), cmid ch ++ [0, 1] = [0, 1] ++ clbw ch
  | [] => rfl
  | p :: ch => by
    simp only [cmid, clbw, bmidp, lbwp]
    rw [List.append_assoc, bmid_shift, ← List.append_assoc, cmid_shift ch, List.append_assoc]

lemma bmid_S (m j : ℕ) : bmid (m + 1) j = [0, 1] ++ lbw m j := by
  rw [← bmid_shift]
  unfold bmid
  rw [pow_succ_right]
  simp [List.append_assoc]

lemma prefRR (c j : ℕ) (ch : List (ℕ × ℕ)) : segRR B F (pw c j ch) (cmid ch ++ bmid c j) :=
  segRR_app (blkRR_B c j) (chainRR ch)

lemma prefLL (c j : ℕ) (ch : List (ℕ × ℕ)) : segLL D D (cmid ch ++ bmid (c + 1) j) (pw c j ch ++ [0, 1]) := by
  rw [bmid_S, ← List.append_assoc, cmid_shift, List.append_assoc]
  have h := segLL_app sweepLL (segLL_app (chainLL ch) (blkLL c j))
  simpa [pw, List.append_assoc] using h

lemma prefLL_glue (j : ℕ) (ch : List (ℕ × ℕ)) : segLL D D (cmid ch ++ bmid 0 j) ([1, 1, 1] ^ j ++ cw ch ++ [0, 1]) := by
  have hb0 : bmid 0 j = [0, 1] ++ [0, 1, 1] ^ j := by unfold bmid; simp
  rw [hb0, ← List.append_assoc, cmid_shift, List.append_assoc]
  have h := segLL_app sweepLL (segLL_app (chainLL ch) (yLL_glue j))
  simpa [List.append_assoc] using h

-- ============================================================================
-- Digits, Edge, Root, Resets & Uniform Touch Lemmas
-- ============================================================================

lemma leadLL_start : segLL A D [0, 1, 0, 1, 1] [0, 0, 1, 0, 1] :=
  fun l r => dmultiStep_star 5 ⟨A, .left, [0, 1, 0, 1, 1], []⟩ ⟨D, .left, [], [0, 0, 1, 0, 1]⟩ l r rfl

lemma leadLL (a : ℕ) : segLL A D (bmid a 1) ([0, 1] ^ a ++ [0, 0] ++ [1, 0, 1]) := by
  have h := segLL_app leadLL_start (segLL_pow shift_D_01 a)
  simpa [bmid, List.append_assoc] using h

lemma xbRR_end : segRR F B [1] [0] :=
  fun l r => dmultiStep_star 1 ⟨F, .right, [], [1]⟩ ⟨B, .right, [0], []⟩ l r rfl

lemma xbRR (x : ℕ) : segRR F B ([0] ++ [1, 0] ^ x ++ [1, 1]) (xbmid x) := by
  have h := segRR_app (segRR_pow shift_F_01 (x + 1)) xbRR_end
  have heq1 : ([0] : List (Fin 2)) ++ [1, 0] ^ x ++ [1, 1] = [0, 1] ^ (x + 1) ++ [1] := by
    rw [← zero_pow10_one]; simp [List.append_assoc]
  have heq2 : ([0] : List (Fin 2)) ++ [0, 1] ^ (x + 1) = xbmid x := rfl
  rw [heq1, ← heq2]
  exact h

lemma xbLL_start : segLL D A [0, 0, 1] [0, 1, 1] :=
  fun l r => dmultiStep_star 3 ⟨D, .left, [0, 0, 1], []⟩ ⟨A, .left, [], [0, 1, 1]⟩ l r rfl

lemma xbLL (x : ℕ) : segLL D A (xbmid x) ([0] ++ [1, 0] ^ x ++ [1, 1]) := by
  have h := segLL_app xbLL_start (segLL_pow shift_A_01 x)
  have heq : ([0, 1] : List (Fin 2)) ^ x ++ [0, 1, 1] = [0] ++ [1, 0] ^ x ++ [1, 1] := by
    calc ([0, 1] : List (Fin 2)) ^ x ++ [0, 1, 1]
      _ = ([0, 1] ^ x ++ [0, 1]) ++ [1] := by simp [List.append_assoc]
      _ = [0, 1] ^ (x + 1) ++ [1] := by rw [← pow_succ_right]
      _ = ([0] ++ [1, 0] ^ x ++ [1]) ++ [1] := by rw [zero_pow10_one]
      _ = [0] ++ [1, 0] ^ x ++ [1, 1] := by simp [List.append_assoc]
  unfold xbmid
  rw [← heq]
  exact h

lemma leadstop_turn : segRL F D [0, 0] [1, 1] :=
  fun l r => dmultiStep_star 3 ⟨F, .right, [], [0, 0]⟩ ⟨D, .left, [], [1, 1]⟩ l r rfl

lemma leadstop0 (x : ℕ) : segRL F D ([0, 0] ++ [1, 0] ^ (x + 1)) ([1, 1, 1] ++ [0] ++ [1, 0] ^ x) := by
  have h := segRL_frame ([1, 0] ^ (x + 1)) leadstop_turn
  simpa [pow_succ_list, List.append_assoc] using h

lemma leadstopS (a x : ℕ) :
    segRL F D ([0, 1] ^ (a + 1) ++ [0, 0] ++ [1, 0] ^ (x + 1)) (lead1 a x) := by
  have h := segRR_RL_LL (segRR_pow shift_F_01 (a + 1)) (leadstop0 x) (segLL_pow shift_D_01 (a + 1))
  simpa [lead1, blk, List.append_assoc] using h

lemma stopK1 (c a : ℕ) : segRL B D (lead0 (c + 1) (a + 1)) (lead1 c a) := by
  have hR : segRR B F ([0, 1] ^ (c + 1)) ([0, 1] ^ (c + 1)) := by
    have h0 := segRR_app B_to_F_01 (segRR_pow shift_F_01 c)
    rwa [← pow_succ_right, ← pow_succ_list] at h0
  have h := segRR_RL_LL hR (leadstop0 a) (segLL_pow shift_D_01 (c + 1))
  simpa [lead0, lead1, blk, List.append_assoc] using h

lemma stop1 (c a : ℕ) : segRL B D (lead0 (c + 1) (a + 1)) (lead1 c a) := stopK1 c a

lemma halt0 (x : ℕ) (l r : ListBlank (Fin 2)) : haltsFrom (l {{B}}> (lead0 0 x +> r)) := by
  refine ⟨([1] +> l) {{C}}> ([0] +> ([1, 0] ^ x +> r)), ?_, ?_⟩
  · simpa [lead0, evalDCfg] using dmultiStep_star 1 ⟨B, .right, [], [0, 0]⟩ ⟨C, .right, [1], [0]⟩ l ([1, 0] ^ x +> r) rfl
  · simp [step, C, tm_coq]

lemma shift_E_111 (l r : ListBlank (Fin 2)) :
    (([1] +> l) {{E}}> ([1, 1, 1] +> r)) [tm_coq]⊢* (([1, 0, 1, 1] +> l) {{E}}> r) :=
  dmultiStep_star 9 ⟨E, .right, [1], [1, 1, 1]⟩ ⟨E, .right, [1, 0, 1, 1], []⟩ l r rfl

lemma shift_E_111_pow : ∀ (k : ℕ) (l r : ListBlank (Fin 2)),
    (([1] +> l) {{E}}> ([1, 1, 1] ^ k +> r)) [tm_coq]⊢* ((([1] ++ [0, 1, 1] ^ k) +> l) {{E}}> r)
  | 0, l, r => ⟨0, rfl⟩
  | k + 1, l, r => by
    rw [pow_succ_list ([1, 1, 1]), pow_succ_right ([0, 1, 1]), ← List.append_assoc,
      listblank_append_assoc, listblank_append_assoc]
    have h1 : (([1] +> l) {{E}}> ([1, 1, 1] +> ([1, 1, 1] ^ k +> r))) [tm_coq]⊢*
        (([1] +> ([0, 1, 1] +> l)) {{E}}> ([1, 1, 1] ^ k +> r)) :=
      shift_E_111 l ([1, 1, 1] ^ k +> r)
    exact stepStar_trans h1 (shift_E_111_pow k ([0, 1, 1] +> l) r)

lemma bounce_E_default (l : ListBlank (Fin 2)) :
    (([1] +> l) {{E}}> default) [tm_coq]⊢* (l <{{D}} ([1, 1] +> default)) :=
  rdmultiStep_star 2 ⟨E, .right, [1], []⟩ ⟨D, .left, [], [1, 1]⟩ l rfl

lemma edgeE_bounce (k : ℕ) (l : ListBlank (Fin 2)) :
    (([1] +> l) {{E}}> ([1, 1, 1] ^ k +> default)) [tm_coq]⊢* (l <{{D}} (([1, 1] ++ [1, 1, 1] ^ k) +> default)) := by
  have h1 := shift_E_111_pow k l default
  rw [listblank_append_assoc] at h1
  have h2 := bounce_E_default ([0, 1, 1] ^ k +> l)
  have h3 := segLL_pow shift_D_011 k l ([1, 1] +> default)
  rw [← listblank_append_assoc, ← two_ones_pow111] at h3
  exact stepStar_trans h1 (stepStar_trans h2 h3)

lemma edge0L0 (f : ℕ) : sideRL F D (([0] ++ [1, 1, 1] ^ f) +> default) (([1, 1] ++ [1, 1, 1] ^ f) +> default) := by
  intro l
  rw [listblank_append_assoc]
  have h1 : (l {{F}}> ([0] +> ([1, 1, 1] ^ f +> default))) [tm_coq]⊢* (([1] +> l) {{E}}> ([1, 1, 1] ^ f +> default)) :=
    dmultiStep_star 1 ⟨F, .right, [], [0]⟩ ⟨E, .right, [1], []⟩ l ([1, 1, 1] ^ f +> default) rfl
  exact stepStar_trans h1 (edgeE_bounce f l)

lemma z_absorb (f : ℕ) : sideRL B D (edgew 0 (f + 1) +> default) (([1, 1] ++ [1, 1, 1] ^ (f + 1)) +> default) := by
  intro l
  have h1 := dmultiStep_star 3 ⟨B, .right, [], [0, 1]⟩ ⟨E, .right, [1], [1]⟩ l ([1, 1] +> ([1, 1, 1] ^ f +> default)) rfl
  have h1' : (l {{B}}> (edgew 0 (f + 1) +> default)) [tm_coq]⊢*
      (([1] +> l) {{E}}> ([1, 1, 1] ^ (f + 1) +> default)) := by
    simpa [edgew, evalDCfg, pow_succ_list, List.append_assoc] using h1
  exact stepStar_trans h1' (edgeE_bounce (f + 1) l)

lemma edge0L (x f : ℕ) : sideRL F D (([0] ++ [1, 0] ^ (x + 1) ++ [1, 1, 1] ^ f) +> default) (([0] ++ [1, 0] ^ x ++ [1, 1, 1] ^ (f + 1)) +> default) := by
  have heq1 : ([0] : List (Fin 2)) ++ [1, 0] ^ (x + 1) ++ [1, 1, 1] ^ f = [0, 1] ^ (x + 1) ++ ([0] ++ [1, 1, 1] ^ f) := by
    calc ([0] : List (Fin 2)) ++ [1, 0] ^ (x + 1) ++ [1, 1, 1] ^ f
      _ = ([0] ++ [1, 0] ^ x ++ [1]) ++ ([0] ++ [1, 1, 1] ^ f) := by
        rw [pow_succ_right ([1, 0])]; simp [List.append_assoc]
      _ = [0, 1] ^ (x + 1) ++ ([0] ++ [1, 1, 1] ^ f) := by rw [zero_pow10_one]
  have heq2 : ([0, 1] : List (Fin 2)) ^ (x + 1) ++ ([1, 1] ++ [1, 1, 1] ^ f) = [0] ++ [1, 0] ^ x ++ [1, 1, 1] ^ (f + 1) := by
    rw [← zero_pow10_one]
    simp [pow_succ_list, List.append_assoc]
  have h := segRR_sideRL_LL (segRR_pow shift_F_01 (x + 1)) (edge0L0 f) (segLL_pow shift_D_01 (x + 1))
  rwa [← listblank_append_assoc, ← listblank_append_assoc, ← heq1, heq2] at h

lemma edge0E (y f : ℕ) : sideRL B D (([0] ++ [1, 0] ^ (y + 1) ++ [1, 1, 1] ^ f) +> default) (([0] ++ [1, 0] ^ y ++ [1, 1, 1] ^ (f + 1)) +> default) := by
  have hR : segRR B F ([0, 1] ^ (y + 1)) ([0, 1] ^ (y + 1)) := by
    have h0 := segRR_app B_to_F_01 (segRR_pow shift_F_01 y)
    rwa [← pow_succ_right, ← pow_succ_list] at h0
  have heq1 : ([0] : List (Fin 2)) ++ [1, 0] ^ (y + 1) ++ [1, 1, 1] ^ f = [0, 1] ^ (y + 1) ++ ([0] ++ [1, 1, 1] ^ f) := by
    calc ([0] : List (Fin 2)) ++ [1, 0] ^ (y + 1) ++ [1, 1, 1] ^ f
      _ = ([0] ++ [1, 0] ^ y ++ [1]) ++ ([0] ++ [1, 1, 1] ^ f) := by
        rw [pow_succ_right ([1, 0])]; simp [List.append_assoc]
      _ = [0, 1] ^ (y + 1) ++ ([0] ++ [1, 1, 1] ^ f) := by rw [zero_pow10_one]
  have heq2 : ([0, 1] : List (Fin 2)) ^ (y + 1) ++ ([1, 1] ++ [1, 1, 1] ^ f) = [0] ++ [1, 0] ^ y ++ [1, 1, 1] ^ (f + 1) := by
    rw [← zero_pow10_one]
    simp [pow_succ_list, List.append_assoc]
  have h := segRR_sideRL_LL hR (edge0L0 f) (segLL_pow shift_D_01 (y + 1))
  rwa [← listblank_append_assoc, ← listblank_append_assoc, ← heq1, heq2] at h

lemma u0E (y f : ℕ) : sideRL B D (edgew (y + 1) f +> default) (edgew y (f + 1) +> default) :=
  edge0E y f

def root (t : ℕ) (X : ListBlank (Fin 2)) : Cfg (Fin 2) (Fin 6) :=
  default <{{A}} (([0, 1] ^ t ++ [0, 1, 1]) +> X)

def wmid (t : ℕ) : List (Fin 2) := [0, 0, 1] ++ [0, 1] ^ (t + 1)

lemma pow_01_append_default (k : ℕ) :
    ([0, 1] : List (Fin 2)) ^ k +> ([0, 1] +> (default : ListBlank (Fin 2))) = [0, 1] ^ (k + 1) +> default := by
  rw [← listblank_append_assoc, ← pow_succ_right]

lemma root_in (t : ℕ) (X : ListBlank (Fin 2)) :
    (root t X) [tm_coq]⊢* ((wmid t +> default) {{B}}> X) := by
  unfold root wmid
  have heq : ([0, 1] : List (Fin 2)) ^ t ++ [0, 1, 1] = [0, 1] ^ (t + 1) ++ [1] := by
    rw [pow_succ_right]; simp [List.append_assoc]
  rw [heq, listblank_append_assoc]
  have h1 := A_default_to_F ([0, 1] ^ (t + 1) +> ([1] +> X))
  have h2 := segRR_pow shift_F_01 (t + 1) ([0, 1] +> default) ([1] +> X)
  rw [pow_01_append_default (t + 1)] at h2
  have h3 := xbRR_end ([0, 1] ^ (t + 2) +> default) X
  have h := stepStar_trans h1 (stepStar_trans h2 h3)
  simpa [pow_succ_list, List.append_assoc] using h

lemma root_out (t : ℕ) (X : ListBlank (Fin 2)) :
    ((wmid t +> default) <{{D}} X) [tm_coq]⊢* (root (t + 1) X) := by
  unfold wmid root
  have h := segLL_app xbLL_start (segLL_pow shift_A_01 (t + 1)) default X
  simpa [List.append_assoc] using h

lemma root_step (t : ℕ) (X X' : ListBlank (Fin 2)) (h : sideRL B D X X') :
    (root t X) [tm_coq]⊢* (root (t + 1) X') :=
  stepStar_trans (root_in t X) (stepStar_trans (h (wmid t +> default)) (root_out t X'))

lemma root_steps : ∀ (n t : ℕ) (X X' : ListBlank (Fin 2)),
    sideRLs n X X' → (root t X) [tm_coq]⊢* (root (n + t) X')
  | 0, t, X, _, .zero _ => by simp [stepStar_refl]
  | n + 1, t, X, X', .succ h₁ hs => by
    have hstep := root_step t X _ h₁
    have hrest := root_steps n (t + 1) _ X' hs
    have hn : n + (t + 1) = n + 1 + t := by omega
    rw [hn] at hrest
    exact stepStar_trans hstep hrest

lemma root_halt (t : ℕ) (X : ListBlank (Fin 2)) (h : sideRL_halt X) :
    haltsFrom (root t X) :=
  haltsFrom_stepStar (root_in t X) (h (wmid t +> default))

lemma gen_RL {ci co : List (Fin 2)} (hF : segRL F D ci co) (c j : ℕ) (ch : List (ℕ × ℕ)) :
    segRL B D (pw (c + 1) j ch ++ ci) (pw c j ch ++ [0, 1] ++ co) := by
  have h := segRR_RL_LL (prefRR (c + 1) j ch) hF (prefLL c j ch)
  simpa [List.append_assoc] using h

lemma gen_RLg {ci co : List (Fin 2)} (hF : segRL F D ci co) (j : ℕ) (ch : List (ℕ × ℕ)) :
    segRL B D (pw 0 j ch ++ ci) ([1, 1, 1] ^ j ++ cw ch ++ [0, 1] ++ co) := by
  have h := segRR_RL_LL (prefRR 0 j ch) hF (prefLL_glue j ch)
  simpa [List.append_assoc] using h

lemma gen_fwd {ci m co : List (Fin 2)} (hR : segRR F B ci m) (hL : segLL D D m co) (c j : ℕ) (ch : List (ℕ × ℕ)) :
    passRL (pw (c + 1) j ch ++ ci) (pw c j ch ++ [0, 1] ++ co) := by
  have h := lrcons1_pass (segRR_app (prefRR (c + 1) j ch) hR) (segLL_app hL (prefLL c j ch))
  simpa [List.append_assoc] using h

lemma gen_fwdg {ci m co : List (Fin 2)} (hR : segRR F B ci m) (hL : segLL D D m co) (j : ℕ) (ch : List (ℕ × ℕ)) :
    passRL (pw 0 j ch ++ ci) ([1, 1, 1] ^ j ++ cw ch ++ [0, 1] ++ co) := by
  have h := lrcons1_pass (segRR_app (prefRR 0 j ch) hR) (segLL_app hL (prefLL_glue j ch))
  simpa [List.append_assoc] using h

lemma gen_side {ci co : List (Fin 2)} {R R' : ListBlank (Fin 2)}
    (hF : sideRL F D (ci +> R) (co +> R')) (c j : ℕ) (ch : List (ℕ × ℕ)) :
    sideRL B D ((pw (c + 1) j ch ++ ci) +> R) ((pw c j ch ++ [0, 1] ++ co) +> R') := by
  have h := segRR_sideRL_LL (prefRR (c + 1) j ch) hF (prefLL c j ch)
  simpa [List.append_assoc] using h

lemma gen_sideg {ci co : List (Fin 2)} {R R' : ListBlank (Fin 2)}
    (hF : sideRL F D (ci +> R) (co +> R')) (j : ℕ) (ch : List (ℕ × ℕ)) :
    sideRL B D ((pw 0 j ch ++ ci) +> R) (([1, 1, 1] ^ j ++ cw ch ++ [0, 1] ++ co) +> R') := by
  have h := segRR_sideRL_LL (prefRR 0 j ch) hF (prefLL_glue j ch)
  simpa [List.append_assoc] using h

lemma cstopF (a x : ℕ) (far : List (Fin 2)) :
    ∃ co, segRL F D (lead0 a (x + 1) ++ far) co ∧ [0, 1] ++ co = lead1 a x ++ far := by
  cases a with
  | zero =>
    refine ⟨([1, 1, 1] ++ [0] ++ [1, 0] ^ x) ++ far, ?_, ?_⟩
    · simpa [lead0, List.append_assoc] using segRL_frame far (leadstop0 x)
    · simp [lead1, blk, List.append_assoc]
  | succ a =>
    refine ⟨lead1 a x ++ far, ?_, ?_⟩
    · simpa [lead0, List.append_assoc] using segRL_frame far (leadstopS a x)
    · simp [lead1, blk, pow_succ_list, List.append_assoc]

lemma t_stop (bs : List (ℕ × ℕ)) (a x : ℕ) (far : List (Fin 2)) (ov : ℕ) (bs' : List (ℕ × ℕ)) (a' : ℕ)
    (h : consume bs a = some (ov, bs', a')) :
    segRL B D (uw bs false a (x + 1) far) ([1, 1, 1] ^ ov ++ uw bs' true a' x far) := by
  rcases cstopF a x far with ⟨co, hF, hE⟩
  cases bs with
  | nil =>
    cases a with
    | zero => nomatch h
    | succ a =>
      simp only [consume, Option.some.injEq, Prod.mk.injEq] at h
      rcases h with ⟨rfl, rfl, rfl⟩
      simpa [uw, leadw, cw, List.append_assoc] using segRL_frame far (stopK1 a x)
  | cons p r =>
    rcases p with ⟨_ | c, j⟩
    · simp only [consume, Option.some.injEq, Prod.mk.injEq] at h
      rcases h with ⟨rfl, rfl, rfl⟩
      have hg := gen_RLg hF j r
      rw [List.append_assoc ([1, 1, 1] ^ j ++ cw r), hE] at hg
      simpa [uw, leadw, pw, cw, blkp, List.append_assoc] using hg
    · simp only [consume, Option.some.injEq, Prod.mk.injEq] at h
      rcases h with ⟨rfl, rfl, rfl⟩
      have hg := gen_RL hF c j r
      rw [List.append_assoc (pw c j r), hE] at hg
      simpa [uw, leadw, pw, cw, blkp, List.append_assoc] using hg

def cpass_mid (a x : ℕ) : List (Fin 2) := xbmid x ++ bmid a 1
def cpass_co (a x : ℕ) : List (Fin 2) := ([0, 1] ^ a ++ [0, 0] ++ [1, 0, 1]) ++ ([0] ++ [1, 0] ^ x ++ [1, 1])

lemma cpassRR (a x : ℕ) : segRR F B (lead1 a x ++ [1, 1]) (cpass_mid a x) := by
  have h := segRR_app (blkRR_F a 1) (xbRR x)
  simpa [lead1, cpass_mid, List.append_assoc] using h

lemma cpassLL (a x : ℕ) : segLL D D (cpass_mid a x) (cpass_co a x) :=
  segLL_app (xbLL x) (leadLL a)

lemma cpass_co_eq (a x : ℕ) : cpass_co a x = lead0 a (x + 2) ++ tailw 0 := by
  simp [cpass_co, lead0, tailw, pow_succ_list, List.append_assoc]

lemma passK1 (a x : ℕ) : passRL (lead1 a x ++ [1, 1]) (lead0 a (x + 2) ++ [1, 1]) := by
  have hR : segRR B B (lead1 a x ++ [1, 1]) (cpass_mid a x) := by
    simpa [lead1, cpass_mid, List.append_assoc] using segRR_app (blkRR_B a 1) (xbRR x)
  have hL : segLL D D (cpass_mid a x) (lead0 a (x + 2) ++ [1, 1]) := by
    have h := cpassLL a x
    rwa [cpass_co_eq] at h
  exact lrcons1_pass hR hL

lemma t_pass (bs : List (ℕ × ℕ)) (a x ov : ℕ) (bs' : List (ℕ × ℕ)) (a' : ℕ)
    (h : consume bs (a + 1) = some (ov, bs', a')) :
    passRL (uw bs true a x (tailw 0)) ([1, 1, 1] ^ ov ++ uw bs' false a' (x + 2) (tailw 0)) := by
  cases bs with
  | nil =>
    simp only [consume, Option.some.injEq, Prod.mk.injEq] at h
    rcases h with ⟨rfl, rfl, rfl⟩
    simpa [uw, leadw, cw, tailw, List.append_assoc] using passK1 a x
  | cons p r =>
    rcases p with ⟨_ | c, j⟩
    · simp only [consume, Option.some.injEq, Prod.mk.injEq] at h
      rcases h with ⟨rfl, rfl, rfl⟩
      have hg := gen_fwdg (cpassRR a x) (cpassLL a x) j r
      rw [cpass_co_eq] at hg
      simpa [uw, leadw, lead0, pw, cw, blkp, tailw, pow_succ_list, List.append_assoc] using hg
    · simp only [consume, Option.some.injEq, Prod.mk.injEq] at h
      rcases h with ⟨rfl, rfl, rfl⟩
      have hg := gen_fwd (cpassRR a x) (cpassLL a x) c j r
      rw [cpass_co_eq] at hg
      simpa [uw, leadw, lead0, pw, cw, blkp, tailw, pow_succ_list, List.append_assoc] using hg

lemma lead1_tailw_eq (a x g : ℕ) :
    lead1 a x ++ tailw (g + 1) = blk a 1 ++ blk x (g + 1) ++ [1] := by
  calc lead1 a x ++ tailw (g + 1)
    _ = blk a 1 ++ ([0] ++ [1, 0] ^ x ++ [1]) ++ ([1] ++ [1, 1, 1] ^ (g + 1)) := by
      simp [lead1, tailw, List.append_assoc]
    _ = blk a 1 ++ [0, 1] ^ (x + 1) ++ ([1, 1, 1] ^ (g + 1) ++ [1]) := by
      rw [zero_pow10_one, one_pow111]
    _ = blk a 1 ++ blk x (g + 1) ++ [1] := by
      simp [blk, List.append_assoc]

lemma lead1_edge1w_eq (a x f : ℕ) :
    lead1 a x ++ edge1w f = blk a 1 ++ blk x f := by
  calc lead1 a x ++ edge1w f
    _ = blk a 1 ++ ([0] ++ [1, 0] ^ x ++ [1]) ++ [1, 1, 1] ^ f := by
      simp [lead1, edge1w, List.append_assoc]
    _ = blk a 1 ++ [0, 1] ^ (x + 1) ++ [1, 1, 1] ^ f := by
      rw [zero_pow10_one]
    _ = blk a 1 ++ blk x f := by
      simp [blk, List.append_assoc]

def um (a x g : ℕ) : List (Fin 2) := ([0] ++ bmid x (g + 1)) ++ bmid a 1
def uco (a x g : ℕ) : List (Fin 2) := [0, 1] ^ a ++ [1, 1, 1] ++ blk x g ++ [0, 0, 1, 0, 1, 1]

lemma u_RF (a x g : ℕ) : segRR F B (lead1 a x ++ tailw (g + 1)) (um a x g) := by
  rw [lead1_tailw_eq]
  have h := segRR_app (segRR_app (blkRR_F a 1) (blkRR_F x (g + 1))) xbRR_end
  simpa [um, List.append_assoc] using h

lemma u_RB (a x g : ℕ) : segRR B B (lead1 a x ++ tailw (g + 1)) (um a x g) := by
  rw [lead1_tailw_eq]
  have h := segRR_app (segRR_app (blkRR_B a 1) (blkRR_F x (g + 1))) xbRR_end
  simpa [um, List.append_assoc] using h

lemma u_L_start : segLL D D [0, 0, 1, 0, 1, 1] [0, 0, 1, 0, 1, 1] :=
  fun l r => dmultiStep_star 6 ⟨D, .left, [0, 0, 1, 0, 1, 1], []⟩ ⟨D, .left, [], [0, 0, 1, 0, 1, 1]⟩ l r rfl

lemma um_eq (a x g : ℕ) : um a x g = [0, 0, 1, 0, 1, 1] ++ (lbw x g ++ ([0, 1, 1] ++ [0, 1] ^ a)) := by
  unfold um bmid lbw
  rw [pow_succ_list ([0, 1, 1] : List (Fin 2)) g, pow_succ_right ([0, 1] : List (Fin 2)) x]
  simp [List.append_assoc]

lemma u_L (a x g : ℕ) : segLL D D (um a x g) (uco a x g) := by
  rw [um_eq]
  have h := segLL_app u_L_start (segLL_app (blkLL x g) (segLL_app shift_D_011 (segLL_pow shift_D_01 a)))
  simpa [uco, List.append_assoc] using h

lemma t_ungl1 (bs : List (ℕ × ℕ)) (a x ov : ℕ) (bs' : List (ℕ × ℕ)) (a' : ℕ)
    (h : consume (bs ++ [(a, 1)]) (x + 1) = some (ov, bs', a')) :
    passRL (uw bs true a x (tailw 1)) ([1, 1, 1] ^ ov ++ uw bs' false a' 1 (tailw 0)) := by
  cases bs with
  | nil =>
    cases a with
    | zero =>
      simp only [List.nil_append, consume, Option.some.injEq, Prod.mk.injEq] at h
      rcases h with ⟨rfl, rfl, rfl⟩
      simpa [uw, leadw, cw, uco, blk, lead0, tailw, List.append_assoc] using lrcons1_pass (u_RB 0 x 0) (u_L 0 x 0)
    | succ a =>
      simp only [List.nil_append, consume, Option.some.injEq, Prod.mk.injEq] at h
      rcases h with ⟨rfl, rfl, rfl⟩
      simpa [uw, leadw, cw, blkp, uco, blk, lead0, tailw, pow_succ_list, List.append_assoc] using lrcons1_pass (u_RB (a + 1) x 0) (u_L (a + 1) x 0)
  | cons p r =>
    rcases p with ⟨_ | c, j⟩
    · simp only [List.cons_append, consume, Option.some.injEq, Prod.mk.injEq] at h
      rcases h with ⟨rfl, rfl, rfl⟩
      have hg := gen_fwdg (u_RF a x 0) (u_L a x 0) j r
      simpa [uw, leadw, pw, cw, cw_app, blkp, uco, blk, lead0, tailw, pow_succ_list, List.append_assoc] using hg
    · simp only [List.cons_append, consume, Option.some.injEq, Prod.mk.injEq] at h
      rcases h with ⟨rfl, rfl, rfl⟩
      have hg := gen_fwd (u_RF a x 0) (u_L a x 0) c j r
      simpa [uw, leadw, pw, cw, cw_app, blkp, uco, blk, lead0, tailw, pow_succ_list, List.append_assoc] using hg

lemma t_ungl2 (bs : List (ℕ × ℕ)) (a x g ov : ℕ) (bs' : List (ℕ × ℕ)) (a' : ℕ)
    (h : consume (bs ++ [(a, 1), (x, g + 1)]) 0 = some (ov, bs', a')) :
    passRL (uw bs true a x (tailw (g + 2))) ([1, 1, 1] ^ ov ++ uw bs' false a' 1 (tailw 0)) := by
  cases bs with
  | nil =>
    cases a with
    | zero =>
      simp only [List.nil_append, consume, Option.some.injEq, Prod.mk.injEq] at h
      rcases h with ⟨rfl, rfl, rfl⟩
      simpa [uw, leadw, cw, blkp, uco, blk, lead0, tailw, List.append_assoc] using lrcons1_pass (u_RB 0 x (g + 1)) (u_L 0 x (g + 1))
    | succ a =>
      simp only [List.nil_append, consume, Option.some.injEq, Prod.mk.injEq] at h
      rcases h with ⟨rfl, rfl, rfl⟩
      simpa [uw, leadw, cw, blkp, uco, blk, lead0, tailw, pow_succ_list, List.append_assoc] using lrcons1_pass (u_RB (a + 1) x (g + 1)) (u_L (a + 1) x (g + 1))
  | cons p r =>
    rcases p with ⟨_ | c, j⟩
    · simp only [List.cons_append, consume, Option.some.injEq, Prod.mk.injEq] at h
      rcases h with ⟨rfl, rfl, rfl⟩
      have hg := gen_fwdg (u_RF a x (g + 1)) (u_L a x (g + 1)) j r
      simpa [uw, leadw, pw, cw, cw_app, blkp, uco, blk, lead0, tailw, pow_succ_list, List.append_assoc] using hg
    · simp only [List.cons_append, consume, Option.some.injEq, Prod.mk.injEq] at h
      rcases h with ⟨rfl, rfl, rfl⟩
      have hg := gen_fwd (u_RF a x (g + 1)) (u_L a x (g + 1)) c j r
      simpa [uw, leadw, pw, cw, cw_app, blkp, uco, blk, lead0, tailw, pow_succ_list, List.append_assoc] using hg

lemma t_halt (x : ℕ) (far : List (Fin 2)) (l r : ListBlank (Fin 2)) :
    haltsFrom (l {{B}}> (uw [] false 0 x far +> r)) := by
  simpa [uw, leadw, cw] using halt0 x l (far +> r)

lemma z_lead (bs : List (ℕ × ℕ)) (x f ov : ℕ) (bs' : List (ℕ × ℕ)) (a' : ℕ)
    (hne : bs ≠ []) (h : consume bs 0 = some (ov, bs', a')) :
    sideRL B D ((cw bs ++ edgew x f) +> default) (([1, 1, 1] ^ ov ++ cw bs' ++ edgew x (f + 1)) +> default) := by
  cases bs with
  | nil => contradiction
  | cons p r =>
    rcases p with ⟨_ | c, j⟩
    · simp only [consume, Option.some.injEq, Prod.mk.injEq] at h
      rcases h with ⟨rfl, rfl, rfl⟩
      cases x with
      | zero =>
        have hg := gen_sideg (edge0L0 f) j r
        simpa [pw, cw, blkp, edgew, List.append_assoc] using hg
      | succ x =>
        have hg := gen_sideg (edge0L x f) j r
        simpa [pw, cw, blkp, edgew, List.append_assoc] using hg
    · simp only [consume, Option.some.injEq, Prod.mk.injEq] at h
      rcases h with ⟨rfl, rfl, rfl⟩
      cases x with
      | zero =>
        have hg := gen_side (edge0L0 f) c j r
        simpa [pw, cw, blkp, edgew, List.append_assoc] using hg
      | succ x =>
        have hg := gen_side (edge0L x f) c j r
        simpa [pw, cw, blkp, edgew, List.append_assoc] using hg

lemma z_empty (y f : ℕ) : sideRL B D (edgew (y + 1) f +> default) (edgew y (f + 1) +> default) :=
  u0E y f

lemma z_stop (bs : List (ℕ × ℕ)) (a x f ov : ℕ) (bs' : List (ℕ × ℕ)) (a' : ℕ)
    (h : consume bs a = some (ov, bs', a')) :
    sideRL B D (uw bs false a (x + 1) (edge1w f) +> default) (([1, 1, 1] ^ ov ++ uw bs' true a' x (edge1w f)) +> default) :=
  segRL_side default (t_stop bs a x (edge1w f) ov bs' a' h)

def zco (a x f : ℕ) : List (Fin 2) := [0, 1] ^ a ++ [1, 1, 1] ++ blk x f ++ edgew 0 1

lemma bounce_F_default (l : ListBlank (Fin 2)) :
    (([0, 1] +> l) {{F}}> default) [tm_coq]⊢* (l <{{D}} (edgew 0 1 +> default)) :=
  rdmultiStep_star 5 ⟨F, .right, [0, 1], []⟩ ⟨D, .left, [], [0, 1, 1, 1]⟩ l rfl

lemma bmid_pair_eq (a x f : ℕ) :
    bmid x f ++ bmid a 1 = [0, 1] ++ (lbw x f ++ ([0, 1, 1] ++ [0, 1] ^ a)) := by
  unfold bmid lbw
  rw [pow_succ_right ([0, 1] : List (Fin 2)) x]
  simp [List.append_assoc]

lemma z1_bounce_LL (a x f : ℕ) (l : ListBlank (Fin 2)) :
    (((bmid x f ++ bmid a 1) +> l) {{F}}> default) [tm_coq]⊢* (l <{{D}} (zco a x f +> default)) := by
  rw [bmid_pair_eq, listblank_append_assoc]
  have h1 := bounce_F_default ((lbw x f ++ ([0, 1, 1] ++ [0, 1] ^ a)) +> l)
  have h2 := segLL_app (blkLL x f) (segLL_app shift_D_011 (segLL_pow shift_D_01 a)) l (edgew 0 1 +> default)
  have h := stepStar_trans h1 h2
  simpa [zco, List.append_assoc] using h

lemma z1F (a x f : ℕ) : sideRL F D ((lead1 a x ++ edge1w f) +> default) (zco a x f +> default) := by
  intro l
  rw [lead1_edge1w_eq]
  have hR := segRR_app (blkRR_F a 1) (blkRR_F x f) l default
  exact stepStar_trans hR (z1_bounce_LL a x f l)

lemma z1B (a x f : ℕ) : sideRL B D ((lead1 a x ++ edge1w f) +> default) (zco a x f +> default) := by
  intro l
  rw [lead1_edge1w_eq]
  have hR := segRR_app (blkRR_B a 1) (blkRR_F x f) l default
  exact stepStar_trans hR (z1_bounce_LL a x f l)

lemma z_1111 (bs : List (ℕ × ℕ)) (a x f ov : ℕ) (bs' : List (ℕ × ℕ)) (a' : ℕ)
    (h : consume (bs ++ [(a, 1), (x, f)]) 0 = some (ov, bs', a')) :
    sideRL B D (uw bs true a x (edge1w f) +> default) (([1, 1, 1] ^ ov ++ cw bs' ++ edgew 0 1) +> default) := by
  cases bs with
  | nil =>
    cases a with
    | zero =>
      simp only [List.nil_append, consume, Option.some.injEq, Prod.mk.injEq] at h
      rcases h with ⟨rfl, rfl, rfl⟩
      simpa [uw, leadw, cw, blkp, zco, blk, List.append_assoc] using z1B 0 x f
    | succ a =>
      simp only [List.nil_append, consume, Option.some.injEq, Prod.mk.injEq] at h
      rcases h with ⟨rfl, rfl, rfl⟩
      simpa [uw, leadw, cw, blkp, zco, blk, pow_succ_list, List.append_assoc] using z1B (a + 1) x f
  | cons p r =>
    rcases p with ⟨_ | c, j⟩
    · simp only [List.cons_append, consume, Option.some.injEq, Prod.mk.injEq] at h
      rcases h with ⟨rfl, rfl, rfl⟩
      have hg := gen_sideg (z1F a x f) j r
      simpa [uw, leadw, pw, cw, cw_app, blkp, zco, blk, pow_succ_list, List.append_assoc] using hg
    · simp only [List.cons_append, consume, Option.some.injEq, Prod.mk.injEq] at h
      rcases h with ⟨rfl, rfl, rfl⟩
      have hg := gen_side (z1F a x f) c j r
      simpa [uw, leadw, pw, cw, cw_app, blkp, zco, blk, pow_succ_list, List.append_assoc] using hg

def NT (s g : ℕ) (X : ListBlank (Fin 2)) : Cfg (Fin 2) (Fin 6) :=
  default <{{A}} (([1, 0] ^ s ++ [1] ++ [0, 0] ++ [1, 0] ++ tailw g) +> X)

def rmid (t : ℕ) : List (Fin 2) := [0, 0, 1, 0, 1, 1] ++ [0, 1] ^ (t + 1)

lemma reset1_in (t : ℕ) (X : ListBlank (Fin 2)) :
    (root t ([1, 1, 1] +> X)) [tm_coq]⊢* ((rmid t +> default) {{B}}> X) := by
  unfold root rmid
  have heq : ([0, 1] : List (Fin 2)) ^ t ++ [0, 1, 1] ++ [1, 1, 1] = [0, 1] ^ (t + 1) ++ ([1, 1, 1] ++ [1]) := by
    rw [pow_succ_right]; simp [List.append_assoc]
  rw [← listblank_append_assoc, heq, listblank_append_assoc, listblank_append_assoc]
  have h1 := A_default_to_F ([0, 1] ^ (t + 1) +> ([1, 1, 1] +> ([1] +> X)))
  have h2 := segRR_pow shift_F_01 (t + 1) ([0, 1] +> default) ([1, 1, 1] +> ([1] +> X))
  rw [pow_01_append_default (t + 1)] at h2
  have h3 : (([0, 1] ^ (t + 2) +> default) {{F}}> ([1, 1, 1] +> ([1] +> X))) [tm_coq]⊢*
      (([0, 1, 0, 1, 1] +> ([0, 1] ^ (t + 1) +> default)) {{F}}> ([1] +> X)) := by
    simpa [pow_succ_list] using shift_F_111 ([0, 1] ^ (t + 1) +> default) ([1] +> X)
  have h4 := xbRR_end ([0, 1, 0, 1, 1] +> ([0, 1] ^ (t + 1) +> default)) X
  have h := stepStar_trans h1 (stepStar_trans h2 (stepStar_trans h3 h4))
  simpa [List.append_assoc] using h

lemma D_default_to_A (R : ListBlank (Fin 2)) :
    (default <{{D}} R) [tm_coq]⊢* (default <{{A}} ([1] +> R)) :=
  ldmultiStep_star 1 ⟨D, .left, [], []⟩ ⟨A, .left, [], [1]⟩ R rfl

lemma reset1_out (t : ℕ) (X : ListBlank (Fin 2)) :
    ((rmid t +> default) <{{D}} X) [tm_coq]⊢* (NT (t + 1) 0 X) := by
  unfold rmid NT
  have h1 := segLL_app u_L_start (segLL_pow shift_D_01 (t + 1)) default X
  have h2 := D_default_to_A (([0, 1] ^ (t + 1) ++ [0, 0, 1, 0, 1, 1]) +> X)
  have h := stepStar_trans h1 h2
  have heq : ([1] : List (Fin 2)) ++ ([0, 1] ^ (t + 1) ++ [0, 0, 1, 0, 1, 1]) =
      [1, 0] ^ (t + 1) ++ [1] ++ [0, 0] ++ [1, 0] ++ tailw 0 := by
    rw [← List.append_assoc ([1]), one_pow_01]
    simp [tailw, List.append_assoc]
  rwa [← listblank_append_assoc, heq] at h

lemma reset1 (t : ℕ) (X X' : ListBlank (Fin 2)) (h : sideRL B D X X') :
    (root t ([1, 1, 1] +> X)) [tm_coq]⊢* (NT (t + 1) 0 X') :=
  stepStar_trans (reset1_in t X) (stepStar_trans (h (rmid t +> default)) (reset1_out t X'))

lemma reset1_halt (t : ℕ) (X : ListBlank (Fin 2)) (h : sideRL_halt X) :
    haltsFrom (root t ([1, 1, 1] +> X)) :=
  haltsFrom_stepStar (reset1_in t X) (h (rmid t +> default))

lemma reset2 (s g : ℕ) (X : ListBlank (Fin 2)) :
    (NT (s + 1) g X) [tm_coq]⊢* (root 0 ((lead1 s 0 ++ tailw g) +> X)) := by
  unfold NT root
  have heq : ([1, 0] : List (Fin 2)) ^ (s + 1) ++ [1] ++ [0, 0] ++ [1, 0] ++ tailw g =
      [1] ++ (lead0 (s + 1) 1 ++ tailw g) := by
    rw [← one_pow_01]
    simp [lead0, List.append_assoc]
  rw [heq, listblank_append_assoc, listblank_append_assoc]
  have h1 := A_default_to_F ([1] +> (lead0 (s + 1) 1 +> (tailw g +> X)))
  have h2 := xbRR_end ([0, 1] +> default) (lead0 (s + 1) 1 +> (tailw g +> X))
  have h3 := stop1 s 0 ([0, 0, 1] +> default) (tailw g +> X)
  have h4 := xbLL_start default (lead1 s 0 +> (tailw g +> X))
  have h := stepStar_trans h1 (stepStar_trans h2 (stepStar_trans h3 h4))
  simpa [List.append_assoc] using h

-- ============================================================================
-- Closed-Form Batch Lemmas (`pairK`, `pair1`, `clK0`, `clK1`, `cl10`, `cl11`, `zLs`, `zEs`)
-- ============================================================================

lemma pairK : ∀ (q c j : ℕ) (r : List (ℕ × ℕ)) (a x : ℕ),
    segRLs (q * 2) q
      (uw ((q * 2 + c, j) :: r) false a (x + 1) (tailw 0))
      (uw ((c, j) :: r) false (q + a) (q + x + 1) (tailw 0))
  | 0, c, j, r, a, x => by simpa using segRLs_O _
  | q + 1, c, j, r, a, x => by
    have h1 := stop1s (t_stop ((q * 2 + c + 2, j) :: r) a x (tailw 0) 0 ((q * 2 + c + 1, j) :: r) a rfl)
    have h2 := (t_pass ((q * 2 + c + 1, j) :: r) a x 0 ((q * 2 + c, j) :: r) (a + 1) rfl).1
    have h3 := pairK q c j r (a + 1) (x + 1)
    have h := segRLs_trans h1 (segRLs_trans h2 h3)
    have ha : q + (a + 1) = q + 1 + a := by omega
    have hx : q + (x + 1) + 1 = q + 1 + x + 1 := by omega
    have hc : (q + 1) * 2 + c = q * 2 + c + 2 := by omega
    have hq1 : 1 + (1 + q * 2) = (q + 1) * 2 := by omega
    have hq2 : 0 + (1 + q) = q + 1 := by omega
    rw [ha, hx, hq1, hq2] at h
    rw [hc]
    exact h

lemma pair1 : ∀ (q a x : ℕ),
    segRLs (q * 2) q
      (uw [] false (q + a) (x + 1) (tailw 0))
      (uw [] false a (q + x + 1) (tailw 0))
  | 0, a, x => by simpa using segRLs_O _
  | q + 1, a, x => by
    have h1 := stop1s (t_stop [] (q + a + 1) x (tailw 0) 0 [] (q + a) rfl)
    have h2 := (t_pass [] (q + a) x 0 [] (q + a) rfl).1
    have h3 := pair1 q a (x + 1)
    have h := segRLs_trans h1 (segRLs_trans h2 h3)
    have ha : q + 1 + a = q + a + 1 := by omega
    have hx : q + (x + 1) + 1 = q + 1 + x + 1 := by omega
    have hq1 : 1 + (1 + q * 2) = (q + 1) * 2 := by omega
    have hq2 : 0 + (1 + q) = q + 1 := by omega
    rw [hx, hq1, hq2, ← ha] at h
    exact h

def b2n (b : Bool) : ℕ := if b then 1 else 0

lemma clK0 (q : ℕ) (rb : Bool) (c j : ℕ) (r : List (ℕ × ℕ)) (a x : ℕ) :
    segRLs (q * 2 + b2n rb) q
      (uw ((q * 2 + b2n rb + c, j) :: r) false a (x + 1) (tailw 0))
      (uw ((c, j) :: r) rb (q + a) (q + (x + 1) - b2n rb) (tailw 0)) := by
  cases rb with
  | false =>
    simpa [b2n, Nat.add_assoc] using pairK q c j r a x
  | true =>
    have h1 := pairK q (c + 1) j r a x
    have h2 := stop1s (t_stop ((c + 1, j) :: r) (q + a) (q + x) (tailw 0) 0 ((c, j) :: r) (q + a) rfl)
    have h := segRLs_trans h1 h2
    have hc : q * 2 + 1 + c = q * 2 + (c + 1) := by omega
    have hx : q + (x + 1) - 1 = q + x := by omega
    simpa [b2n, hc, hx] using h

lemma clK1 (q : ℕ) (rb : Bool) (c j : ℕ) (r : List (ℕ × ℕ)) (a x : ℕ) :
    segRLs (q * 2 + b2n rb + 1) (q + 1)
      (uw ((q * 2 + b2n rb + c + 1, j) :: r) true a x (tailw 0))
      (uw ((c, j) :: r) rb (q + (a + 1)) (q + (x + 2) - b2n rb) (tailw 0)) := by
  have h1 := (t_pass ((q * 2 + b2n rb + c + 1, j) :: r) a x 0 ((q * 2 + b2n rb + c, j) :: r) (a + 1) rfl).1
  have h2 := clK0 q rb c j r (a + 1) (x + 1)
  have h := segRLs_trans h1 h2
  have hn1 : 1 + (q * 2 + b2n rb) = q * 2 + b2n rb + 1 := by omega
  have hn2 : 1 + q = q + 1 := by omega
  rw [hn1, hn2] at h
  exact h

lemma cl10 (q : ℕ) (rb : Bool) (a x : ℕ) :
    segRLs (q * 2 + b2n rb) q
      (uw [] false (q + b2n rb + a) (x + 1) (tailw 0))
      (uw [] rb a (q + (x + 1) - b2n rb) (tailw 0)) := by
  cases rb with
  | false =>
    simpa [b2n, Nat.add_assoc] using pair1 q a x
  | true =>
    have h1 := pair1 q (a + 1) x
    have h2 := stop1s (t_stop [] (a + 1) (q + x) (tailw 0) 0 [] a rfl)
    have h := segRLs_trans h1 h2
    have ha : q + 1 + a = q + (a + 1) := by omega
    have hx : q + (x + 1) - 1 = q + x := by omega
    simpa [b2n, ha, hx] using h

lemma cl11 (q : ℕ) (rb : Bool) (a x : ℕ) :
    segRLs (q * 2 + b2n rb + 1) (q + 1)
      (uw [] true (q + b2n rb + a) x (tailw 0))
      (uw [] rb a (q + (x + 2) - b2n rb) (tailw 0)) := by
  have h1 := (t_pass [] (q + b2n rb + a) x 0 [] (q + b2n rb + a) rfl).1
  have h2 := cl10 q rb a (x + 1)
  have h := segRLs_trans h1 h2
  have hn1 : 1 + (q * 2 + b2n rb) = q * 2 + b2n rb + 1 := by omega
  have hn2 : 1 + q = q + 1 := by omega
  rw [hn1, hn2] at h
  exact h

lemma zLs : ∀ (m c j : ℕ) (r : List (ℕ × ℕ)) (x f : ℕ),
    sideRLs m ((cw ((m + c, j) :: r) ++ edgew x f) +> default)
      ((cw ((c, j) :: r) ++ edgew x (m + f)) +> default)
  | 0, c, j, r, x, f => by simpa using .zero _
  | m + 1, c, j, r, x, f => by
    have h1 := z_lead ((m + c + 1, j) :: r) x f 0 ((m + c, j) :: r) 0 (by simp) rfl
    have h2 := zLs m c j r x (f + 1)
    have hm1 : m + 1 + c = m + c + 1 := by omega
    have hm2 : m + (f + 1) = m + 1 + f := by omega
    rw [hm1]
    rw [hm2] at h2
    exact .succ h1 h2

lemma zEs : ∀ (m y f : ℕ),
    sideRLs m (edgew (m + y) f +> default) (edgew y (m + f) +> default)
  | 0, y, f => by simpa using .zero _
  | m + 1, y, f => by
    have h1 := z_empty (m + y) f
    have h2 := zEs m y (f + 1)
    have hm1 : m + 1 + y = m + y + 1 := by omega
    have hm2 : m + (f + 1) = m + 1 + f := by omega
    rw [hm1]
    rw [hm2] at h2
    exact .succ h1 h2

-- ============================================================================
-- Part 3: Symbolic Simulator & Soundness Proofs
-- ============================================================================

def strictNat {α : Type} (x : ℕ) (k : ℕ → α) : α :=
  Nat.casesOn (motive := fun _ => α) (Nat.add x 1) (k 0) k

@[simp] lemma strictNat_eq {α : Type} (x : ℕ) (k : ℕ → α) : strictNat x k = k x := rfl

def strictBool {α : Type} (b : Bool) (k : Bool → α) : α :=
  Bool.casesOn (motive := fun _ => α) b (k false) (k true)

@[simp] lemma strictBool_eq {α : Type} (b : Bool) (k : Bool → α) : strictBool b k = k b := by
  cases b <;> rfl

inductive PairN where
  | mk (c j : ℕ)
  | dummy

inductive BSQ where
  | mk (front back : List PairN)
  | dummy

def revAux : List PairN → List PairN → List PairN
  | [], acc => acc
  | x :: xs, acc => revAux xs (x :: acc)

def qNorm (front back : List PairN) : BSQ :=
  match front with
  | [] =>
    match back with
    | [] => .mk [] []
    | _ => .mk (revAux back []) []
  | _ => .mk front back

def qPush1 (q : BSQ) (c j : ℕ) : BSQ :=
  match q with
  | .mk [] _ => .mk [.mk c j] []
  | .mk front back => .mk front (.mk c j :: back)
  | .dummy => .mk [.mk c j] []

def qPush2 (q : BSQ) (c1 j1 c2 j2 : ℕ) : BSQ :=
  qPush1 (qPush1 q c1 j1) c2 j2

def pairToProd : PairN → ℕ × ℕ
  | .mk c j => (c, j)
  | .dummy => (0, 0)

def bsqToList : BSQ → List (ℕ × ℕ)
  | .mk [] _ => []
  | .mk (p :: r) back => pairToProd p :: (r.map pairToProd ++ (revAux back []).map pairToProd)
  | .dummy => []

lemma revAux_eq (xs acc : List PairN) : revAux xs acc = xs.reverse ++ acc := by
  induction xs generalizing acc with
  | nil => rfl
  | cons x xs ih =>
    simp only [revAux, ih, List.reverse_cons, List.append_assoc, List.singleton_append]

lemma bsqToList_qNorm (r back : List PairN) :
    bsqToList (qNorm r back) = r.map pairToProd ++ (revAux back []).map pairToProd := by
  cases r with
  | cons p r' => rfl
  | nil =>
    cases back with
    | nil => rfl
    | cons b bs =>
      try dsimp [qNorm]
      have hne : revAux (b :: bs) [] ≠ [] := by
        rw [revAux_eq]
        simp
      cases h : revAux (b :: bs) [] with
      | nil => contradiction
      | cons p' r' => simp [bsqToList, revAux]

lemma bsqToList_qPush1 (q : BSQ) (c j : ℕ) :
    bsqToList (qPush1 q c j) = bsqToList q ++ [(c, j)] := by
  rcases q with ⟨_ | ⟨p, r⟩, back⟩ | _
  · rfl
  · simp [qPush1, bsqToList, revAux_eq, pairToProd, List.append_assoc]
  · rfl

lemma bsqToList_qPush2 (q : BSQ) (c1 j1 c2 j2 : ℕ) :
    bsqToList (qPush2 q c1 j1 c2 j2) = bsqToList q ++ [(c1, j1), (c2, j2)] := by
  simp [qPush2, bsqToList_qPush1, List.append_assoc]

inductive UnitN where
  | mk (uq : BSQ) (ubit : Bool) (ua ux ug : ℕ)
  | dummy

def unitG : UnitN → ℕ
  | .mk _ _ _ _ g => g
  | .dummy => 1

def uwN : UnitN → List (Fin 2)
  | .mk q b a x g => uw (bsqToList q) b a x (tailw g)
  | .dummy => uw [] false 0 0 (tailw 0)

inductive ZN where
  | z0 (q : BSQ) (x f : ℕ)
  | zd (q : BSQ) (b : Bool) (a x f : ℕ)

def zside : ZN → ListBlank (Fin 2)
  | .z0 q x f => (cw (bsqToList q) ++ edgew x f) +> default
  | .zd q b a x f => uw (bsqToList q) b a x (edge1w f) +> default

inductive TailN where
  | tt (t g : ℕ)
  | ntl (s g : ℕ)

inductive SimCfg where
  | mk (ctl : TailN) (cus : List UnitN) (cz : ZN)
  | halt

inductive ConRes where
  | some (ov : ℕ) (q : BSQ) (a : ℕ)
  | none

def consumeN (q : BSQ) (a : ℕ) : ConRes :=
  match q with
  | .mk (.mk c j :: r) back =>
    if Nat.beq c 0 then .some j (qNorm r back) a
    else
      strictNat (Nat.sub c 1) fun c1 =>
      .some 0 (.mk (.mk c1 j :: r) back) a
  | .mk [] _ =>
    if Nat.beq a 0 then .none
    else
      strictNat (Nat.sub a 1) fun a1 =>
      .some 0 (.mk [] []) a1
  | _ => .none

lemma consumeN_spec (q : BSQ) (a ov : ℕ) (q' : BSQ) (a' : ℕ)
    (h : consumeN q a = .some ov q' a') :
    consume (bsqToList q) a = some (ov, bsqToList q', a') := by
  rcases q with ⟨_ | ⟨⟨_ | c, j⟩ | _, r⟩, back⟩ | _
  · try dsimp [consumeN] at h
    cases a with
    | zero => nomatch h
    | succ a1 =>
      injection h with hov hq ha
      subst hov hq ha
      rfl
  · try dsimp [consumeN] at h
    injection h with hov hq ha
    subst hov hq ha
    rw [bsqToList_qNorm]
    rfl
  · try dsimp [consumeN] at h
    injection h with hov hq ha
    subst hov hq ha
    rfl
  · nomatch h
  · nomatch h

inductive TRes where
  | tstop (ov : ℕ) (u : UnitN)
  | tpass (ov : ℕ) (u : UnitN)
  | thalt
  | tfail

def touchN (u : UnitN) : TRes :=
  match u with
  | .mk q ubit ua ux ug =>
    if ubit then
      if Nat.beq ug 0 then
        strictNat (Nat.add ua 1) fun ua1 =>
        match consumeN q ua1 with
        | .some ov q' a' =>
          strictNat (Nat.add ux 2) fun ux2 =>
          .tpass ov (.mk q' false a' ux2 0)
        | .none => .tfail
      else if Nat.beq ug 1 then
        strictNat (Nat.add ux 1) fun ux1 =>
        match consumeN (qPush1 q ua 1) ux1 with
        | .some ov q' a' =>
          .tpass ov (.mk q' false a' 1 0)
        | .none => .tfail
      else
        strictNat (Nat.sub ug 1) fun ug1 =>
        match consumeN (qPush2 q ua 1 ux ug1) 0 with
        | .some ov q' a' =>
          .tpass ov (.mk q' false a' 1 0)
        | .none => .tfail
    else
      match q with
      | .mk [] _ =>
        if Nat.beq ua 0 then .thalt
        else if Nat.beq ux 0 then .tfail else
        match consumeN q ua with
        | .some ov q' a' =>
          strictNat (Nat.sub ux 1) fun ux1 =>
          .tstop ov (.mk q' true a' ux1 ug)
        | .none => .tfail
      | .mk (_ :: _) _ =>
        if Nat.beq ux 0 then .tfail else
        match consumeN q ua with
        | .some ov q' a' =>
          strictNat (Nat.sub ux 1) fun ux1 =>
          .tstop ov (.mk q' true a' ux1 ug)
        | .none => .tfail
      | .dummy => .tfail
  | .dummy => .tfail

lemma touchN_stop (u : UnitN) (ov : ℕ) (u' : UnitN) (h : touchN u = .tstop ov u') :
    segRL B D (uwN u) ([1, 1, 1] ^ ov ++ uwN u') := by
  rcases u with ⟨⟨front, back⟩ | _, _ | _, ua, _ | ux, ug⟩ | _
  · cases front with
    | nil => cases ua <;> nomatch h
    | cons p r => nomatch h
  · cases front with
    | nil =>
      cases ua with
      | zero => nomatch h
      | succ ua1 =>
        try dsimp [touchN] at h
        cases hc : consumeN (.mk [] back) (ua1 + 1) with
        | none => rw [hc] at h; nomatch h
        | some o q' a' =>
          rw [hc] at h
          injection h with hov hu'
          subst hov hu'
          exact t_stop (bsqToList (.mk [] back)) (ua1 + 1) ux (tailw ug) o (bsqToList q') a' (consumeN_spec _ _ _ _ _ hc)
    | cons p r =>
      try dsimp [touchN] at h
      cases hc : consumeN (.mk (p :: r) back) ua with
      | none => rw [hc] at h; nomatch h
      | some o q' a' =>
        rw [hc] at h
        injection h with hov hu'
        subst hov hu'
        exact t_stop (bsqToList (.mk (p :: r) back)) ua ux (tailw ug) o (bsqToList q') a' (consumeN_spec _ _ _ _ _ hc)
  · cases ug with
    | zero =>
      try dsimp [touchN] at h
      cases hc : consumeN (.mk front back) (ua + 1) <;> rw [hc] at h <;> nomatch h
    | succ ug1 =>
      cases ug1 with
      | zero =>
        try dsimp [touchN] at h
        cases hc : consumeN (qPush1 (.mk front back) ua 1) 1 <;> rw [hc] at h <;> nomatch h
      | succ ug2 =>
        try dsimp [touchN] at h
        cases hc : consumeN (qPush2 (.mk front back) ua 1 0 (ug2 + 1)) 0 <;> rw [hc] at h <;> nomatch h
  · cases ug with
    | zero =>
      try dsimp [touchN] at h
      cases hc : consumeN (.mk front back) (ua + 1) <;> rw [hc] at h <;> nomatch h
    | succ ug1 =>
      cases ug1 with
      | zero =>
        try dsimp [touchN] at h
        cases hc : consumeN (qPush1 (.mk front back) ua 1) (ux + 2) <;> rw [hc] at h <;> nomatch h
      | succ ug2 =>
        try dsimp [touchN] at h
        cases hc : consumeN (qPush2 (.mk front back) ua 1 (ux + 1) (ug2 + 1)) 0 <;> rw [hc] at h <;> nomatch h
  · nomatch h
  · nomatch h
  · cases ug with
    | zero =>
      try dsimp [touchN] at h
      cases hc : consumeN .dummy (ua + 1) <;> rw [hc] at h <;> nomatch h
    | succ ug1 =>
      cases ug1 with
      | zero =>
        try dsimp [touchN] at h
        cases hc : consumeN (qPush1 .dummy ua 1) 1 <;> rw [hc] at h <;> nomatch h
      | succ ug2 =>
        try dsimp [touchN] at h
        cases hc : consumeN (qPush2 .dummy ua 1 0 (ug2 + 1)) 0 <;> rw [hc] at h <;> nomatch h
  · cases ug with
    | zero =>
      try dsimp [touchN] at h
      cases hc : consumeN .dummy (ua + 1) <;> rw [hc] at h <;> nomatch h
    | succ ug1 =>
      cases ug1 with
      | zero =>
        try dsimp [touchN] at h
        cases hc : consumeN (qPush1 .dummy ua 1) (ux + 2) <;> rw [hc] at h <;> nomatch h
      | succ ug2 =>
        try dsimp [touchN] at h
        cases hc : consumeN (qPush2 .dummy ua 1 (ux + 1) (ug2 + 1)) 0 <;> rw [hc] at h <;> nomatch h
  · nomatch h

lemma touchN_pass (u : UnitN) (ov : ℕ) (u' : UnitN) (h : touchN u = .tpass ov u') :
    passRL (uwN u) ([1, 1, 1] ^ ov ++ uwN u') ∧ unitG u' = 0 := by
  rcases u with ⟨q, _ | _, ua, ux, ug⟩ | _
  · rcases q with ⟨_ | ⟨p, r⟩, back⟩ | _
    · cases ua with
      | zero => nomatch h
      | succ ua1 =>
        cases ux with
        | zero => nomatch h
        | succ ux1 =>
          try dsimp [touchN] at h
          cases hc : consumeN (.mk [] back) (ua1 + 1) <;> rw [hc] at h <;> nomatch h
    · cases ux with
      | zero => nomatch h
      | succ ux1 =>
        try dsimp [touchN] at h
        cases hc : consumeN (.mk (p :: r) back) ua <;> rw [hc] at h <;> nomatch h
    · nomatch h
  · rcases ug with _ | _ | ug
    · try dsimp [touchN] at h
      cases hc : consumeN q (ua + 1) with
      | none => rw [hc] at h; nomatch h
      | some o q' a' =>
        rw [hc] at h
        injection h with hov hu'
        subst hov hu'
        exact ⟨t_pass (bsqToList q) ua ux o (bsqToList q') a' (consumeN_spec _ _ _ _ _ hc), rfl⟩
    · try dsimp [touchN] at h
      cases hc : consumeN (qPush1 q ua 1) (ux + 1) with
      | none => rw [hc] at h; nomatch h
      | some o q' a' =>
        rw [hc] at h
        injection h with hov hu'
        subst hov hu'
        have hspec := consumeN_spec _ _ _ _ _ hc
        rw [bsqToList_qPush1] at hspec
        exact ⟨t_ungl1 (bsqToList q) ua ux o (bsqToList q') a' hspec, rfl⟩
    · try dsimp [touchN] at h
      cases hc : consumeN (qPush2 q ua 1 ux (ug + 1)) 0 with
      | none => rw [hc] at h; nomatch h
      | some o q' a' =>
        rw [hc] at h
        injection h with hov hu'
        subst hov hu'
        have hspec := consumeN_spec _ _ _ _ _ hc
        rw [bsqToList_qPush2] at hspec
        exact ⟨t_ungl2 (bsqToList q) ua ux ug o (bsqToList q') a' hspec, rfl⟩
  · nomatch h

lemma touchN_halt (u : UnitN) (h : touchN u = .thalt) (l r : ListBlank (Fin 2)) :
    haltsFrom (l {{B}}> (uwN u +> r)) := by
  rcases u with ⟨q, _ | _, ua, ux, ug⟩ | _
  · rcases q with ⟨_ | ⟨p, r'⟩, back⟩ | _
    · cases ua with
      | zero => exact t_halt ux (tailw ug) l r
      | succ ua1 =>
        cases ux with
        | zero => nomatch h
        | succ ux1 =>
          try dsimp [touchN] at h
          cases hc : consumeN (.mk [] back) (ua1 + 1) <;> rw [hc] at h <;> nomatch h
    · cases ux with
      | zero => nomatch h
      | succ ux1 =>
        try dsimp [touchN] at h
        cases hc : consumeN (.mk (p :: r') back) ua <;> rw [hc] at h <;> nomatch h
    · nomatch h
  · cases ug with
    | zero =>
      try dsimp [touchN] at h
      cases hc : consumeN q (ua + 1) <;> rw [hc] at h <;> nomatch h
    | succ ug1 =>
      cases ug1 with
      | zero =>
        try dsimp [touchN] at h
        cases hc : consumeN (qPush1 q ua 1) (ux + 1) <;> rw [hc] at h <;> nomatch h
      | succ ug2 =>
        try dsimp [touchN] at h
        cases hc : consumeN (qPush2 q ua 1 ux (ug2 + 1)) 0 <;> rw [hc] at h <;> nomatch h
  · nomatch h

inductive ZRes where
  | zret (ov : ℕ) (z : ZN)
  | zabs (f : ℕ)
  | zfail

def ztouch (z : ZN) : ZRes :=
  match z with
  | .z0 (.mk [] _) y f =>
    if Nat.beq y 0 then (if Nat.beq f 0 then .zfail else .zabs f)
    else
      strictNat (Nat.sub y 1) fun y1 =>
      strictNat (Nat.add f 1) fun f1 =>
      .zret 0 (.z0 (.mk [] []) y1 f1)
  | .z0 (.mk (p :: r) back) x f =>
    match consumeN (.mk (p :: r) back) 0 with
    | .some ov q' _ =>
      strictNat (Nat.add f 1) fun f1 =>
      .zret ov (.z0 q' x f1)
    | .none => .zfail
  | .zd q false a x f =>
    if Nat.beq x 0 then .zfail else
    match consumeN q a with
    | .some ov q' a' =>
      strictNat (Nat.sub x 1) fun x1 =>
      .zret ov (.zd q' true a' x1 f)
    | .none => .zfail
  | .zd q true a x f =>
    match consumeN (qPush2 q a 1 x f) 0 with
    | .some ov q' _ => .zret ov (.z0 q' 0 1)
    | .none => .zfail
  | _ => .zfail

lemma ztouch_ret (z : ZN) (ov : ℕ) (z' : ZN) (h : ztouch z = .zret ov z') :
    sideRL B D (zside z) ([1, 1, 1] ^ ov +> zside z') := by
  rcases z with ⟨⟨_ | ⟨p, r⟩, back⟩ | _, x, f⟩ | ⟨q, _ | _, a, x, f⟩
  · cases x with
    | zero =>
      cases f <;> nomatch h
    | succ y1 =>
      try dsimp [ztouch] at h
      injection h with hov hz'
      subst hov hz'
      simpa [zside, bsqToList, cw] using z_empty y1 f
  · try dsimp [ztouch] at h
    cases hc : consumeN (.mk (p :: r) back) 0 with
    | none => rw [hc] at h; nomatch h
    | some o q' a' =>
      rw [hc] at h
      injection h with hov hz'
      subst hov hz'
      have hne : bsqToList (.mk (p :: r) back) ≠ [] := by simp [bsqToList]
      have hz := z_lead (bsqToList (.mk (p :: r) back)) x f o (bsqToList q') a' hne (consumeN_spec _ _ _ _ _ hc)
      simpa [zside] using hz
  · nomatch h
  · cases x with
    | zero => nomatch h
    | succ x1 =>
      try dsimp [ztouch] at h
      cases hc : consumeN q a with
      | none => rw [hc] at h; nomatch h
      | some o q' a' =>
        rw [hc] at h
        injection h with hov hz'
        subst hov hz'
        have hz := z_stop (bsqToList q) a x1 f o (bsqToList q') a' (consumeN_spec _ _ _ _ _ hc)
        simpa [zside] using hz
  · try dsimp [ztouch] at h
    cases hc : consumeN (qPush2 q a 1 x f) 0 with
    | none => rw [hc] at h; nomatch h
    | some o q' a' =>
      rw [hc] at h
      injection h with hov hz'
      subst hov hz'
      have hspec := consumeN_spec _ _ _ _ _ hc
      rw [bsqToList_qPush2] at hspec
      have hz := z_1111 (bsqToList q) a x f o (bsqToList q') a' hspec
      simpa [zside] using hz

lemma ztouch_abs (z : ZN) (f : ℕ) (h : ztouch z = .zabs f) :
    sideRL B D (zside z) (([1, 1] ++ [1, 1, 1] ^ f) +> default) := by
  rcases z with ⟨⟨_ | ⟨p, r⟩, back⟩ | _, x, f'⟩ | ⟨q, _ | _, a, x, f'⟩
  · cases x with
    | zero =>
      cases f' with
      | zero => nomatch h
      | succ f1 =>
        try dsimp [ztouch] at h
        injection h with hf
        subst hf
        simpa [zside, bsqToList, cw] using z_absorb f1
    | succ y1 => nomatch h
  · try dsimp [ztouch] at h
    cases hc : consumeN (.mk (p :: r) back) 0 <;> rw [hc] at h <;> nomatch h
  · nomatch h
  · cases x with
    | zero => nomatch h
    | succ x1 =>
      try dsimp [ztouch] at h
      cases hc : consumeN q a <;> rw [hc] at h <;> nomatch h
  · try dsimp [ztouch] at h
    cases hc : consumeN (qPush2 q a 1 x f') 0 <;> rw [hc] at h <;> nomatch h

inductive CRes where
  | cret (ov : ℕ) (us : List UnitN) (z : ZN)
  | chalt
  | cfail

def setg : UnitN → ℕ → UnitN
  | .mk q bit a x _, g => .mk q bit a x g
  | .dummy, _ => .dummy

def callN (us : List UnitN) (z : ZN) : CRes :=
  match us with
  | [] =>
    match ztouch z with
    | .zret ov z' => .cret ov [] z'
    | _ => .cfail
  | u :: us1 =>
    match touchN u with
    | .tstop ov u' => .cret ov (u' :: us1) z
    | .thalt => .chalt
    | .tfail => .cfail
    | .tpass ov u' =>
      match us1 with
      | [] =>
        match ztouch z with
        | .zret ov2 z' => .cret ov [setg u' ov2] z'
        | .zabs f =>
          match u' with
          | .mk q bit a x g =>
            strictNat (Nat.add (Nat.add g f) 1) fun gf1 =>
            .cret ov [] (.zd q bit a x gf1)
          | .dummy => .cfail
        | .zfail => .cfail
      | _ :: _ =>
        match callN us1 z with
        | .cret ov2 us' z' => .cret ov (setg u' ov2 :: us') z'
        | .chalt => .chalt
        | .cfail => .cfail

def dwords : List UnitN → List (Fin 2)
  | [] => []
  | u :: us => uwN u ++ dwords us

lemma setg_word (u : UnitN) (g : ℕ) (hg : unitG u = 0) :
    uwN u ++ [1, 1, 1] ^ g = uwN (setg u g) := by
  rcases u with ⟨q, bit, a, x, _ | g0⟩ | _
  · simp [uwN, setg, uw, tailw, List.append_assoc]
  · nomatch hg
  · nomatch hg

lemma abs_word (q : BSQ) (bit : Bool) (a x g f : ℕ) (hg : g = 0) :
    uwN (.mk q bit a x g) ++ ([1, 1] ++ [1, 1, 1] ^ f) =
      uw (bsqToList q) bit a x (edge1w (g + f + 1)) := by
  subst hg
  simp [uwN, uw, tailw, edge1w, pow_succ_list, List.append_assoc]

lemma callN_ret : ∀ (us : List UnitN) (z : ZN) (ov : ℕ) (us' : List UnitN) (z' : ZN),
    callN us z = .cret ov us' z' →
    sideRL B D (dwords us +> zside z) (([1, 1, 1] ^ ov ++ dwords us') +> zside z')
  | [], z, ov, us', z', h => by
    try dsimp [callN] at h
    cases hz : ztouch z with
    | zret o z1 =>
      rw [hz] at h
      injection h with hov hus hz'
      subst hov hus hz'
      simpa [dwords] using ztouch_ret z o z1 hz
    | zabs _ => rw [hz] at h; nomatch h
    | zfail => rw [hz] at h; nomatch h
  | u :: us1, z, ov, us', z', h => by
    try dsimp [callN] at h
    cases ht : touchN u with
    | tstop o u1 =>
      rw [ht] at h
      injection h with hov hus hz'
      subst hov hus hz'
      have hs := segRL_side (dwords us1 +> zside z) (touchN_stop u o u1 ht)
      simpa [dwords, List.append_assoc] using hs
    | thalt => rw [ht] at h; nomatch h
    | tfail => rw [ht] at h; nomatch h
    | tpass o u1 =>
      rw [ht] at h
      rcases touchN_pass u o u1 ht with ⟨hp, hg⟩
      cases us1 with
      | nil =>
        cases hz : ztouch z with
        | zret o2 z1 =>
          rw [hz] at h
          injection h with hov hus hz'
          subst hov hus hz'
          have hs := side1 hp.1 (ztouch_ret z o2 z1 hz)
          rw [← listblank_append_assoc, List.append_assoc, setg_word u1 o2 hg] at hs
          simpa [dwords, List.append_assoc] using hs
        | zabs f =>
          rw [hz] at h
          rcases u1 with ⟨q, bit, a, x, g⟩ | _
          · try dsimp at h
            injection h with hov hus hz'
            subst hov hus hz'
            have hs := side1 hp.1 (ztouch_abs z f hz)
            rw [← listblank_append_assoc, List.append_assoc, abs_word q bit a x g f hg] at hs
            simpa [dwords, zside, List.append_assoc] using hs
          · nomatch h
        | zfail => rw [hz] at h; nomatch h
      | cons v us2 =>
        cases hc : callN (v :: us2) z with
        | cret o2 us3 z1 =>
          rw [hc] at h
          injection h with hov hus hz'
          subst hov hus hz'
          have ih := callN_ret (v :: us2) z o2 us3 z1 hc
          have hs := side1 hp.1 ih
          simpa [dwords, ← setg_word u1 o2 hg] using hs
        | chalt => rw [hc] at h; nomatch h
        | cfail => rw [hc] at h; nomatch h

lemma callN_halt : ∀ (us : List UnitN) (z : ZN),
    callN us z = .chalt → sideRL_halt (dwords us +> zside z)
  | [], z, h => by
    try dsimp [callN] at h
    cases hz : ztouch z <;> rw [hz] at h <;> nomatch h
  | u :: us1, z, h => by
    try dsimp [callN] at h
    cases ht : touchN u with
    | tstop _ _ => rw [ht] at h; nomatch h
    | tfail => rw [ht] at h; nomatch h
    | thalt =>
      intro l
      simpa [dwords] using touchN_halt u ht l (dwords us1 +> zside z)
    | tpass o u1 =>
      rw [ht] at h
      rcases touchN_pass u o u1 ht with ⟨hp, _⟩
      cases us1 with
      | nil =>
        cases hz : ztouch z <;> cases u1 <;> rw [hz] at h <;> nomatch h
      | cons v us2 =>
        cases hc : callN (v :: us2) z with
        | cret _ _ _ => rw [hc] at h; nomatch h
        | cfail => rw [hc] at h; nomatch h
        | chalt =>
          have ih := callN_halt (v :: us2) z hc
          simpa [dwords] using hp.2 (dwords (v :: us2) +> zside z) ih

def inc1 (c : SimCfg) : SimCfg :=
  match c with
  | .mk (.tt t g) us z =>
    if Nat.beq g 0 then
      match callN us z with
      | .cret ov us' z' =>
        strictNat (Nat.add t 1) fun t' =>
        .mk (.tt t' ov) us' z'
      | .chalt => .halt
      | .cfail => c
    else if Nat.beq g 1 then
      match callN us z with
      | .cret ov us' z' =>
        strictNat (Nat.add t 1) fun t' =>
        .mk (.ntl t' ov) us' z'
      | .chalt => .halt
      | .cfail => c
    else c
  | .mk (.ntl s g) us z =>
    if Nat.beq s 0 then c
    else
      strictNat (Nat.sub s 1) fun s1 =>
      .mk (.tt 0 0) (.mk (.mk [] []) true s1 0 g :: us) z
  | .halt => .halt

def denoteCfg : TailN → List UnitN → ZN → Cfg (Fin 2) (Fin 6)
  | .tt t g, us, z => root t (([1, 1, 1] ^ g ++ dwords us) +> zside z)
  | .ntl s g, us, z => NT s g (dwords us +> zside z)

def simCfgHalt : SimCfg → Prop
  | .halt => True
  | .mk tl us z => haltsFrom (denoteCfg tl us z)

lemma inc1_sound (c : SimCfg) (h : simCfgHalt (inc1 c)) : simCfgHalt c := by
  rcases c with ⟨⟨t, _ | _ | g⟩ | ⟨_ | s1, g⟩, us, z⟩ | _
  · try dsimp [inc1] at h
    cases hc : callN us z with
    | cret ov us' z' =>
      rw [hc] at h
      have hstep := root_step t (dwords us +> zside z) (([1, 1, 1] ^ ov ++ dwords us') +> zside z') (callN_ret us z ov us' z' hc)
      exact haltsFrom_stepStar hstep h
    | chalt =>
      exact root_halt t (dwords us +> zside z) (callN_halt us z hc)
    | cfail =>
      rw [hc] at h
      exact h
  · try dsimp [inc1] at h
    cases hc : callN us z with
    | cret ov us' z' =>
      rw [hc] at h
      have hstep := reset1 t (dwords us +> zside z) (([1, 1, 1] ^ ov ++ dwords us') +> zside z') (callN_ret us z ov us' z' hc)
      have hstep' : (denoteCfg (.tt t 1) us z) [tm_coq]⊢* (denoteCfg (.ntl (t + 1) ov) us' z') := by
        simpa [denoteCfg, NT, tailw, List.append_assoc] using hstep
      exact haltsFrom_stepStar hstep' h
    | chalt =>
      have hhalt := reset1_halt t (dwords us +> zside z) (callN_halt us z hc)
      simpa [simCfgHalt, denoteCfg] using hhalt
    | cfail =>
      rw [hc] at h
      exact h
  · exact h
  · exact h
  · try dsimp [inc1] at h
    have hstep := reset2 s1 g (dwords us +> zside z)
    have hstep' : (denoteCfg (.ntl (s1 + 1) g) us z) [tm_coq]⊢*
        (denoteCfg (.tt 0 0) (.mk (.mk [] []) true s1 0 g :: us) z) := by
      simpa [denoteCfg, dwords, uwN, uw, bsqToList, cw, leadw, List.append_assoc] using hstep
    exact haltsFrom_stepStar hstep' h
  · exact True.intro

def nodd (n : ℕ) : Bool := Nat.beq (Nat.mod n 2) 1
def ndiv2 (n : ℕ) : ℕ := Nat.div n 2
def nlt (a b : ℕ) : Bool := Nat.ble (Nat.add a 1) b

lemma ndiv2_nodd (n : ℕ) : ndiv2 n * 2 + b2n (nodd n) = n := by
  change (n / 2) * 2 + b2n (Nat.beq (n % 2) 1) = n
  rcases Nat.mod_two_eq_zero_or_one n with h | h <;> simp [h, b2n] <;> omega

lemma nlt_false_iff (a b : ℕ) : nlt a b = false ↔ b ≤ a := by
  change Nat.ble (a + 1) b = false ↔ b ≤ a
  rw [← Bool.not_eq_true, Nat.ble_eq]
  omega

inductive CResU where
  | some (u : UnitN) (p : ℕ)
  | none

def closedU (n : ℕ) (u : UnitN) : CResU :=
  if Nat.beq n 0 then .some u 0 else
  match u with
  | .mk (.mk (.mk c j :: r) back) ubit ua ux ug =>
    if !ubit then
      if Nat.beq n 1 then
        if Nat.beq ux 0 || Nat.beq c 0 then .none
        else
          strictNat (Nat.sub c 1) fun c1 =>
          strictNat (Nat.sub ux 1) fun ux1 =>
          .some (.mk (.mk (.mk c1 j :: r) back) true ua ux1 ug) 0
      else
        if !(Nat.beq ug 0) || Nat.beq ux 0 || nlt c n then .none
        else
          strictBool (nodd n) fun rb =>
          strictNat (ndiv2 n) fun q =>
          strictNat (Nat.sub c n) fun cn =>
          strictNat (Nat.add q ua) fun a' =>
          strictNat (Nat.sub (Nat.add q ux) (b2n rb)) fun x' =>
          .some (.mk (.mk (.mk cn j :: r) back) rb a' x' 0) q
    else
      if !(Nat.beq ug 0) || nlt c n then .none
      else
        strictNat (Nat.sub n 1) fun n1 =>
        strictBool (nodd n1) fun rb =>
        strictNat (ndiv2 n1) fun q =>
        strictNat (Nat.add q 1) fun q1 =>
        strictNat (Nat.sub c n) fun cn =>
        strictNat (Nat.add q (Nat.add ua 1)) fun a' =>
        strictNat (Nat.sub (Nat.add q (Nat.add ux 2)) (b2n rb)) fun x' =>
        .some (.mk (.mk (.mk cn j :: r) back) rb a' x' 0) q1
  | .mk (.mk [] _) ubit ua ux ug =>
    if !ubit then
      if Nat.beq n 1 then
        if Nat.beq ux 0 || Nat.beq ua 0 then .none
        else
          strictNat (Nat.sub ua 1) fun ua1 =>
          strictNat (Nat.sub ux 1) fun ux1 =>
          .some (.mk (.mk [] []) true ua1 ux1 ug) 0
      else
        strictBool (nodd n) fun rb =>
        strictNat (ndiv2 n) fun q =>
        if !(Nat.beq ug 0) || Nat.beq ux 0 || nlt ua (Nat.add q (b2n rb)) then .none
        else
          strictNat (Nat.sub (Nat.sub ua q) (b2n rb)) fun a' =>
          strictNat (Nat.sub (Nat.add q ux) (b2n rb)) fun x' =>
          .some (.mk (.mk [] []) rb a' x' 0) q
    else
      strictNat (Nat.sub n 1) fun n1 =>
      strictBool (nodd n1) fun rb =>
      strictNat (ndiv2 n1) fun q =>
      strictNat (Nat.add q 1) fun q1 =>
      if !(Nat.beq ug 0) || nlt ua (Nat.add q (b2n rb)) then .none
      else
        strictNat (Nat.sub (Nat.sub ua q) (b2n rb)) fun a' =>
        strictNat (Nat.sub (Nat.add q (Nat.add ux 2)) (b2n rb)) fun x' =>
        .some (.mk (.mk [] []) rb a' x' 0) q1
  | _ => .none

lemma closedU_spec (n : ℕ) (u u' : UnitN) (p : ℕ) (h : closedU n u = .some u' p) :
    segRLs n p (uwN u) (uwN u') := by
  unfold closedU at h
  cases hn0 : Nat.beq n 0 with
  | true =>
    rw [hn0] at h
    injection h with hu hp
    subst hu hp
    have hn : n = 0 := Nat.beq_eq.mp hn0
    subst hn
    exact segRLs_O (uwN u)
  | false =>
    rw [hn0] at h
    dsimp at h
    have hn : n ≠ 0 := by intro h0; subst h0; nomatch hn0
    rcases u with ⟨⟨_ | ⟨⟨c, j⟩ | _, r⟩, back⟩ | _, _ | _, ua, ux, ug⟩ | _
    · -- front = [], ubit = false
      simp only [strictBool_eq, strictNat_eq] at h
      try dsimp at h
      cases hn1 : Nat.beq n 1 with
      | true =>
        rw [hn1] at h
        have hn_eq : n = 1 := Nat.beq_eq.mp hn1
        subst hn_eq
        cases ux with
        | zero => nomatch h
        | succ ux1 =>
          cases ua with
          | zero => nomatch h
          | succ ua1 =>
            try dsimp at h
            injection h with hu hp
            subst hu hp
            simpa [uwN, bsqToList] using stop1s (t_stop [] (ua1 + 1) ux1 (tailw ug) 0 [] ua1 rfl)
      | false =>
        rw [hn1] at h
        try dsimp at h
        cases hug : Nat.beq ug 0 with
        | false => rw [hug] at h; nomatch h
        | true =>
          have hug_eq : ug = 0 := Nat.beq_eq.mp hug
          subst hug_eq
          cases ux with
          | zero => nomatch h
          | succ ux1 =>
            cases hlt : nlt ua (ndiv2 n + b2n (nodd n)) with
            | true => simp only [hlt] at h; nomatch h
            | false =>
              simp only [hlt] at h
              try dsimp at h
              injection h with hu hp
              subst hu hp
              have hle : ndiv2 n + b2n (nodd n) ≤ ua := (nlt_false_iff _ _).mp hlt
              have hcl := cl10 (ndiv2 n) (nodd n) (ua - ndiv2 n - b2n (nodd n)) ux1
              have hn_eq := ndiv2_nodd n
              have hua : ndiv2 n + b2n (nodd n) + (ua - ndiv2 n - b2n (nodd n)) = ua := by omega
              rw [hn_eq, hua] at hcl
              simpa [uwN, bsqToList] using hcl
    · -- front = [], ubit = true
      simp only [strictBool_eq, strictNat_eq] at h
      try dsimp at h
      cases hug : Nat.beq ug 0 with
      | false => rw [hug] at h; nomatch h
      | true =>
        have hug_eq : ug = 0 := Nat.beq_eq.mp hug
        subst hug_eq
        cases hlt : nlt ua (ndiv2 (n - 1) + b2n (nodd (n - 1))) with
        | true => simp only [hlt] at h; nomatch h
        | false =>
          simp only [hlt] at h
          try dsimp at h
          injection h with hu hp
          subst hu hp
          have hle : ndiv2 (n - 1) + b2n (nodd (n - 1)) ≤ ua := (nlt_false_iff _ _).mp hlt
          have hcl := cl11 (ndiv2 (n - 1)) (nodd (n - 1)) (ua - ndiv2 (n - 1) - b2n (nodd (n - 1))) ux
          have hn1_eq := ndiv2_nodd (n - 1)
          have hn_eq : ndiv2 (n - 1) * 2 + b2n (nodd (n - 1)) + 1 = n := by omega
          have hua : ndiv2 (n - 1) + b2n (nodd (n - 1)) + (ua - ndiv2 (n - 1) - b2n (nodd (n - 1))) = ua := by omega
          rw [hn_eq, hua] at hcl
          simpa [uwN, bsqToList] using hcl
    · -- front = (c, j) :: r, ubit = false
      simp only [strictBool_eq, strictNat_eq] at h
      try dsimp at h
      cases hn1 : Nat.beq n 1 with
      | true =>
        rw [hn1] at h
        have hn_eq : n = 1 := Nat.beq_eq.mp hn1
        subst hn_eq
        cases ux with
        | zero => nomatch h
        | succ ux1 =>
          cases c with
          | zero => nomatch h
          | succ c1 =>
            try dsimp at h
            injection h with hu hp
            subst hu hp
            let r' := r.map pairToProd ++ (revAux back []).map pairToProd
            simpa [uwN, bsqToList, pairToProd] using stop1s (t_stop ((c1 + 1, j) :: r') ua ux1 (tailw ug) 0 ((c1, j) :: r') ua rfl)
      | false =>
        rw [hn1] at h
        try dsimp at h
        cases hug : Nat.beq ug 0 with
        | false => rw [hug] at h; nomatch h
        | true =>
          have hug_eq : ug = 0 := Nat.beq_eq.mp hug
          subst hug_eq
          cases ux with
          | zero => nomatch h
          | succ ux1 =>
            cases hlt : nlt c n with
            | true => rw [hlt] at h; nomatch h
            | false =>
              rw [hlt] at h
              try dsimp at h
              injection h with hu hp
              subst hu hp
              have hle : n ≤ c := (nlt_false_iff _ _).mp hlt
              let r' := r.map pairToProd ++ (revAux back []).map pairToProd
              have hcl := clK0 (ndiv2 n) (nodd n) (c - n) j r' ua ux1
              have hn_eq := ndiv2_nodd n
              have hc_eq : ndiv2 n * 2 + b2n (nodd n) + (c - n) = c := by omega
              rw [hc_eq, hn_eq] at hcl
              simpa [uwN, bsqToList, pairToProd] using hcl
    · -- front = (c, j) :: r, ubit = true
      simp only [strictBool_eq, strictNat_eq] at h
      try dsimp at h
      cases hug : Nat.beq ug 0 with
      | false => rw [hug] at h; nomatch h
      | true =>
        have hug_eq : ug = 0 := Nat.beq_eq.mp hug
        subst hug_eq
        cases hlt : nlt c n with
        | true => rw [hlt] at h; nomatch h
        | false =>
          rw [hlt] at h
          try dsimp at h
          injection h with hu hp
          subst hu hp
          have hle : n ≤ c := (nlt_false_iff _ _).mp hlt
          let r' := r.map pairToProd ++ (revAux back []).map pairToProd
          have hcl := clK1 (ndiv2 (n - 1)) (nodd (n - 1)) (c - n) j r' ua ux
          have hn1_eq := ndiv2_nodd (n - 1)
          have hn_eq : ndiv2 (n - 1) * 2 + b2n (nodd (n - 1)) + 1 = n := by omega
          have hc_eq : ndiv2 (n - 1) * 2 + b2n (nodd (n - 1)) + (c - n) + 1 = c := by omega
          rw [hc_eq, hn_eq] at hcl
          simpa [uwN, bsqToList, pairToProd] using hcl
    · nomatch h
    · nomatch h
    · nomatch h
    · nomatch h
    · nomatch h

def closedZ (m : ℕ) (z : ZN) : Option ZN :=
  if Nat.beq m 0 then some z else
  match z with
  | .z0 (.mk [] _) y f =>
    if nlt y m then none
    else
      strictNat (Nat.sub y m) fun ym =>
      strictNat (Nat.add f m) fun fm =>
      some (.z0 (.mk [] []) ym fm)
  | .z0 (.mk (.mk c j :: r) back) x f =>
    if nlt c m then none
    else
      strictNat (Nat.sub c m) fun cm =>
      strictNat (Nat.add f m) fun fm =>
      some (.z0 (.mk (.mk cm j :: r) back) x fm)
  | _ => none

lemma closedZ_spec (m : ℕ) (z z' : ZN) (h : closedZ m z = some z') :
    sideRLs m (zside z) (zside z') := by
  unfold closedZ at h
  cases hm0 : Nat.beq m 0 with
  | true =>
    rw [hm0] at h
    injection h with hz
    subst hz
    have hm : m = 0 := Nat.beq_eq.mp hm0
    subst hm
    exact .zero (zside z)
  | false =>
    rw [hm0] at h
    rcases z with ⟨⟨_ | ⟨⟨c, j⟩ | _, r⟩, back⟩ | _, x, f⟩ | ⟨_, _, _, _, _⟩
    · dsimp [strictNat] at h
      cases hlt : nlt x m with
      | true => rw [hlt] at h; nomatch h
      | false =>
        rw [hlt] at h
        dsimp [strictNat] at h
        injection h with hz
        subst hz
        have hle : m ≤ x := (nlt_false_iff _ _).mp hlt
        have hz := zEs m (x - m) f
        have hx : m + (x - m) = x := by omega
        have hf : m + f = f + m := by omega
        rw [hx, hf] at hz
        simpa [zside, bsqToList, cw] using hz
    · dsimp [strictNat] at h
      cases hlt : nlt c m with
      | true => rw [hlt] at h; nomatch h
      | false =>
        rw [hlt] at h
        dsimp [strictNat] at h
        injection h with hz
        subst hz
        have hle : m ≤ c := (nlt_false_iff _ _).mp hlt
        let r' := r.map pairToProd ++ (revAux back []).map pairToProd
        have hz := zLs m (c - m) j r' x f
        have hc : m + (c - m) = c := by omega
        have hf : m + f = f + m := by omega
        rw [hc, hf] at hz
        simpa [zside, bsqToList, pairToProd] using hz
    · nomatch h
    · nomatch h
    · nomatch h

inductive BRes where
  | some (us : List UnitN) (z : ZN)
  | none

def batchL (n : ℕ) (us : List UnitN) (z : ZN) : BRes :=
  if Nat.beq n 0 then .some us z else
  match us with
  | [] =>
    match closedZ n z with
    | some z' => .some [] z'
    | none => .none
  | u :: us =>
    match closedU n u with
    | .some u' p =>
      if Nat.beq p 0 then .some (u' :: us) z
      else
        match batchL p us z with
        | .some us' z' => .some (u' :: us') z'
        | .none => .none
    | .none => .none

lemma batchL_spec : ∀ (us : List UnitN) (n : ℕ) (z : ZN) (us' : List UnitN) (z' : ZN),
    batchL n us z = .some us' z' →
    sideRLs n (dwords us +> zside z) (dwords us' +> zside z')
  | [], n, z, us', z', h => by
    unfold batchL at h
    cases hn0 : Nat.beq n 0 with
    | true =>
      rw [hn0] at h
      injection h with hus hz
      subst hus hz
      have hn : n = 0 := Nat.beq_eq.mp hn0
      subst hn
      exact .zero _
    | false =>
      rw [hn0] at h
      try dsimp at h
      cases hz : closedZ n z with
      | none => rw [hz] at h; nomatch h
      | some z1 =>
        rw [hz] at h
        injection h with hus hz'
        subst hus hz'
        simpa [dwords] using closedZ_spec n z z1 hz
  | u :: us, n, z, us', z', h => by
    unfold batchL at h
    cases hn0 : Nat.beq n 0 with
    | true =>
      rw [hn0] at h
      injection h with hus hz
      subst hus hz
      have hn : n = 0 := Nat.beq_eq.mp hn0
      subst hn
      exact .zero _
    | false =>
      rw [hn0] at h
      try dsimp at h
      cases hu : closedU n u with
      | none => rw [hu] at h; nomatch h
      | some u1 p =>
        rw [hu] at h
        try dsimp at h
        have hseg := closedU_spec n u u1 p hu
        cases hp0 : Nat.beq p 0 with
        | true =>
          rw [hp0] at h
          injection h with hus hz
          subst hus hz
          have hp : p = 0 := Nat.beq_eq.mp hp0
          subst hp
          simpa [dwords] using hseg (dwords us +> zside z) (dwords us +> zside z) (.zero _)
        | false =>
          rw [hp0] at h
          cases hb : batchL p us z with
          | none => rw [hb] at h; nomatch h
          | some us1 z1 =>
            rw [hb] at h
            injection h with hus hz
            subst hus hz
            have ih := batchL_spec us p z us1 z1 hb
            simpa [dwords] using hseg (dwords us +> zside z) (dwords us1 +> zside z1) ih

inductive Cmd where
  | nil
  | b (d : ℕ) (next : Cmd)
  | c (next : Cmd)
  | bc (d : ℕ) (next : Cmd)
  | l (n : ℕ) (sub : Cmd) (next : Cmd)

inductive HRes where
  | some (n : ℕ) (us : List UnitN) (z : ZN)
  | none

def evalCmds : Cmd → List UnitN → ZN → ℕ → HRes
  | .nil, us, z, acc => .some acc us z
  | .b d next, us, z, acc =>
    match batchL d us z with
    | .some us' z' =>
      strictNat (Nat.add acc d) fun acc' =>
      evalCmds next us' z' acc'
    | .none => .none
  | .c next, us, z, acc =>
    match callN us z with
    | .cret ov us' z' =>
      if Nat.beq ov 0 then
        strictNat (Nat.add acc 1) fun acc' =>
        evalCmds next us' z' acc'
      else .none
    | _ => .none
  | .bc d next, us, z, acc =>
    match batchL d us z with
    | .some us1 z1 =>
      match callN us1 z1 with
      | .cret ov us' z' =>
        if Nat.beq ov 0 then
          strictNat (Nat.add acc (Nat.add d 1)) fun acc' =>
          evalCmds next us' z' acc'
        else .none
      | _ => .none
    | .none => .none
  | .l n sub next, us, z, acc =>
    match us with
    | [] => .none
    | u :: us1 =>
      match closedU n u with
      | .some u' p =>
        match evalCmds sub us1 z 0 with
        | .some p' us1' z' =>
          if Nat.beq p p' then
            strictNat (Nat.add acc n) fun acc' =>
            evalCmds next (u' :: us1') z' acc'
          else .none
        | .none => .none
      | .none => .none

lemma evalCmds_spec : ∀ (cmd : Cmd) (us : List UnitN) (z : ZN) (acc tot : ℕ) (us' : List UnitN) (z' : ZN) (R₀ : ListBlank (Fin 2)),
    sideRLs acc R₀ (dwords us +> zside z) →
    evalCmds cmd us z acc = .some tot us' z' →
    sideRLs tot R₀ (dwords us' +> zside z')
  | .nil, us, z, acc, tot, us', z', R₀, h₀, h => by
    try dsimp [evalCmds] at h
    injection h with htot hus hz
    subst htot hus hz
    exact h₀
  | .b d next, us, z, acc, tot, us', z', R₀, h₀, h => by
    try dsimp [evalCmds] at h
    cases hb : batchL d us z with
    | none => rw [hb] at h; nomatch h
    | some us1 z1 =>
      rw [hb] at h
      have h1 := batchL_spec us d z us1 z1 hb
      exact evalCmds_spec next us1 z1 (acc + d) tot us' z' R₀ (sideRLs_append h₀ h1) h
  | .c next, us, z, acc, tot, us', z', R₀, h₀, h => by
    try dsimp [evalCmds] at h
    cases hc : callN us z with
    | chalt => rw [hc] at h; nomatch h
    | cfail => rw [hc] at h; nomatch h
    | cret ov us1 z1 =>
      rw [hc] at h
      try dsimp at h
      cases hov : Nat.beq ov 0 with
      | false => rw [hov] at h; nomatch h
      | true =>
        rw [hov] at h
        have hov_eq : ov = 0 := Nat.beq_eq.mp hov
        subst hov_eq
        have hstep : sideRL B D (dwords us +> zside z) (dwords us1 +> zside z1) := by
          simpa using callN_ret us z 0 us1 z1 hc
        have h1 : sideRLs 1 (dwords us +> zside z) (dwords us1 +> zside z1) := .succ hstep (.zero _)
        exact evalCmds_spec next us1 z1 (acc + 1) tot us' z' R₀ (sideRLs_append h₀ h1) h
  | .bc d next, us, z, acc, tot, us', z', R₀, h₀, h => by
    try dsimp [evalCmds] at h
    cases hb : batchL d us z with
    | none => rw [hb] at h; nomatch h
    | some us1 z1 =>
      rw [hb] at h
      try dsimp at h
      cases hc : callN us1 z1 with
      | chalt => rw [hc] at h; nomatch h
      | cfail => rw [hc] at h; nomatch h
      | cret ov us2 z2 =>
        rw [hc] at h
        try dsimp at h
        cases hov : Nat.beq ov 0 with
        | false => rw [hov] at h; nomatch h
        | true =>
          rw [hov] at h
          have hov_eq : ov = 0 := Nat.beq_eq.mp hov
          subst hov_eq
          have h1 := batchL_spec us d z us1 z1 hb
          have hstep : sideRL B D (dwords us1 +> zside z1) (dwords us2 +> zside z2) := by
            simpa using callN_ret us1 z1 0 us2 z2 hc
          have h2 : sideRLs 1 (dwords us1 +> zside z1) (dwords us2 +> zside z2) := .succ hstep (.zero _)
          exact evalCmds_spec next us2 z2 (acc + (d + 1)) tot us' z' R₀ (sideRLs_append h₀ (sideRLs_append h1 h2)) h
  | .l n sub next, [], z, acc, tot, us', z', R₀, _, h => nomatch h
  | .l n sub next, u :: us1, z, acc, tot, us', z', R₀, h₀, h => by
    try dsimp [evalCmds] at h
    cases hu : closedU n u with
    | none => rw [hu] at h; nomatch h
    | some u1 p =>
      rw [hu] at h
      try dsimp at h
      cases hsub : evalCmds sub us1 z 0 with
      | none => rw [hsub] at h; nomatch h
      | some p' us1' z1 =>
        rw [hsub] at h
        try dsimp at h
        cases hp : Nat.beq p p' with
        | false => rw [hp] at h; nomatch h
        | true =>
          rw [hp] at h
          have hp_eq : p = p' := Nat.beq_eq.mp hp
          subst hp_eq
          have hs_sub := evalCmds_spec sub us1 z 0 p us1' z1 (dwords us1 +> zside z) (.zero _) hsub
          have hseg := closedU_spec n u u1 p hu
          have hl : sideRLs n (dwords (u :: us1) +> zside z) (dwords (u1 :: us1') +> zside z1) := by
            simpa [dwords] using hseg (dwords us1 +> zside z) (dwords us1' +> zside z1) hs_sub
          exact evalCmds_spec next (u1 :: us1') z1 (acc + n) tot us' z' R₀ (sideRLs_append h₀ hl) h

def runHier (cmd : Cmd) (c : SimCfg) : SimCfg :=
  match c with
  | .mk (.tt t g) us z =>
    if Nat.beq g 0 then
      match evalCmds cmd us z 0 with
      | .some n us' z' =>
        strictNat (Nat.add t n) fun tn =>
        .mk (.tt tn 0) us' z'
      | .none => c
    else c
  | _ => c

lemma runHier_sound (cmd : Cmd) (c : SimCfg) (h : simCfgHalt (runHier cmd c)) : simCfgHalt c := by
  rcases c with ⟨⟨t, _ | g⟩ | ⟨s, g⟩, us, z⟩ | _
  · try dsimp [runHier] at h
    cases he : evalCmds cmd us z 0 with
    | none => rw [he] at h; exact h
    | some n us' z' =>
      rw [he] at h
      have hs := evalCmds_spec cmd us z 0 n us' z' (dwords us +> zside z) (.zero _) he
      have hstep := root_steps n t (dwords us +> zside z) (dwords us' +> zside z') hs
      have htn : n + t = t + n := by omega
      rw [htn] at hstep
      exact haltsFrom_stepStar hstep h
  · exact h
  · exact h
  · exact True.intro

inductive Prog where
  | nil
  | inc (next : Prog)
  | hier (cmd : Cmd) (next : Prog)

def evalProg : Prog → SimCfg → SimCfg
  | .nil, c => c
  | .inc next, c =>
    match inc1 c with
    | .mk ctl cus cz => evalProg next (.mk ctl cus cz)
    | .halt => .halt
  | .hier cmd next, c =>
    match runHier cmd c with
    | .mk ctl cus cz => evalProg next (.mk ctl cus cz)
    | .halt => .halt

lemma evalProg_sound : ∀ (p : Prog) (c : SimCfg), simCfgHalt (evalProg p c) → simCfgHalt c
  | .nil, c, h => h
  | .inc next, c, h => by
    try dsimp [evalProg] at h
    cases hi : inc1 c with
    | halt =>
      apply inc1_sound c
      rw [hi]
      exact True.intro
    | mk ctl cus cz =>
      rw [hi] at h
      have ih := evalProg_sound next (.mk ctl cus cz) h
      apply inc1_sound c
      rw [hi]
      exact ih
  | .hier cmd next, c, h => by
    try dsimp [evalProg] at h
    cases hr : runHier cmd c with
    | halt =>
      apply runHier_sound cmd c
      rw [hr]
      exact True.intro
    | mk ctl cus cz =>
      rw [hr] at h
      have ih := evalProg_sound next (.mk ctl cus cz) h
      apply runHier_sound cmd c
      rw [hr]
      exact ih

def isHaltCfg : SimCfg → Bool
  | .halt => true
  | .mk _ _ _ => false

lemma simCfgHalt_of_isHaltCfg (c : SimCfg) (h : isHaltCfg c = true) : simCfgHalt c := by
  cases c with
  | halt => exact True.intro
  | mk _ _ _ => nomatch h

lemma evalProg_halt_sound (p : Prog) (c : SimCfg) (h : isHaltCfg (evalProg p c) = true) :
    simCfgHalt c :=
  evalProg_sound p c (simCfgHalt_of_isHaltCfg (evalProg p c) h)

