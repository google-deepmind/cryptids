structure DCfg where
  q : Fin 6
  dir : Dir
  l : List (Fin 2)
  r : List (Fin 2)
  deriving DecidableEq

def evalDCfg (l_tail r_tail : ListBlank (Fin 2)) (c : DCfg) : Cfg (Fin 2) (Fin 6) :=
  match c.dir with
  | Dir.right => (c.l +> l_tail) {{c.q}}> (c.r +> r_tail)
  | Dir.left  => (c.l +> l_tail) <{{c.q}} (c.r +> r_tail)

def dstep (c : DCfg) : Option DCfg :=
  match c.dir with
  | Dir.right =>
    match c.r with
    | [] => none
    | b :: rs =>
      match tm_coq c.q b with
      | none => none
      | some (none, _) => none
      | some (some q', Stmt.write w Dir.right) => some ⟨q', Dir.right, w :: c.l, rs⟩
      | some (some q', Stmt.write w Dir.left)  => some ⟨q', Dir.left, c.l, w :: rs⟩
  | Dir.left =>
    match c.l with
    | [] => none
    | b :: ls =>
      match tm_coq c.q b with
      | none => none
      | some (none, _) => none
      | some (some q', Stmt.write w Dir.right) => some ⟨q', Dir.right, w :: ls, c.r⟩
      | some (some q', Stmt.write w Dir.left)  => some ⟨q', Dir.left, ls, w :: c.r⟩

theorem dstep_sound (c c' : DCfg) (l_tail r_tail : ListBlank (Fin 2)) (h : dstep c = some c') :
    (evalDCfg l_tail r_tail c) [tm_coq]⊢ (evalDCfg l_tail r_tail c') := by
  rcases c with ⟨q, dir, l, r⟩
  cases dir with
  | right =>
    cases r with
    | nil => nomatch h
    | cons b rs =>
      try dsimp [dstep] at h
      cases h_tm : tm_coq q b with
      | none => rw [h_tm] at h; nomatch h
      | some val =>
        rcases val with ⟨_ | q', ⟨w, d'⟩⟩
        · rw [h_tm] at h; nomatch h
        · cases d' <;> {
            rw [h_tm] at h; injection h with h'; subst h'
            simp [step, evalDCfg, h_tm, Turing.Tape.write, Turing.Tape.move]
          }
  | left =>
    cases l with
    | nil => nomatch h
    | cons b ls =>
      try dsimp [dstep] at h
      cases h_tm : tm_coq q b with
      | none => rw [h_tm] at h; nomatch h
      | some val =>
        rcases val with ⟨_ | q', ⟨w, d'⟩⟩
        · rw [h_tm] at h; nomatch h
        · cases d' <;> {
            rw [h_tm] at h; injection h with h'; subst h'
            simp [step, evalDCfg, h_tm, Turing.Tape.write, Turing.Tape.move]
          }

def dmultiStep : ℕ → DCfg → Option DCfg
  | 0, c => some c
  | n + 1, c => (dstep c).bind (dmultiStep n)

theorem dmultiStep_sound : ∀ (n : ℕ) (c c' : DCfg) (l_tail r_tail : ListBlank (Fin 2)),
    dmultiStep n c = some c' →
    (evalDCfg l_tail r_tail c) [tm_coq]⊢^{n} (evalDCfg l_tail r_tail c')
  | 0, c, c', _, _, h => by injection h with h'; subst h'; rfl
  | n + 1, c, c', l_tail, r_tail, h => by
    simp only [dmultiStep, Option.bind_eq_some_iff] at h
    rcases h with ⟨c₁, h₁, h₂⟩
    exact multiStep_step (dstep_sound c c₁ l_tail r_tail h₁) (dmultiStep_sound n c₁ c' l_tail r_tail h₂)

theorem dmultiStep_star (n : ℕ) (c c' : DCfg) (l_tail r_tail : ListBlank (Fin 2))
    (h : dmultiStep n c = some c') :
    (evalDCfg l_tail r_tail c) [tm_coq]⊢* (evalDCfg l_tail r_tail c') :=
  ⟨n, dmultiStep_sound n c c' l_tail r_tail h⟩

