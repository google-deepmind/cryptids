def tRsF (x : Nat) : Nat := Nat.pow 2 (Nat.mod (Nat.div x 4503599627370496) 64)

def tRdF (x : Nat) : Nat := Nat.mul 8 (Nat.mod (Nat.div x 4294967296) 1048576)

