def setRootRule (rb rs rd _ _ _ : Nat) (c0 c1 c2 c3 : RuleTrie) (_ _ _ _ : RuleTrie) : RuleTrie :=
  RuleTrie.rule rb rs rd c0 c1 c2 c3

def trieSetRoot (rb rs rd : Nat) (t : RuleTrie) : RuleTrie :=
  RuleTrie.rec (setRootEmpty rb rs rd) (setRootPass rb rs rd) (setRootRule rb rs rd) t

def singleStep (rb rs rd : Nat) (_ : Nat) (ih : Nat → Nat → RuleTrie) (rem_b rem_s : Nat) : RuleTrie :=
  Bool.rec
    (Bool.rec
      (Bool.rec
        (Bool.rec
          (RuleTrie.pass RuleTrie.empty RuleTrie.empty RuleTrie.empty (ih (Nat.div rem_b 4) (Nat.div rem_s 4)))
          (RuleTrie.pass RuleTrie.empty (ih (Nat.div rem_b 4) (Nat.div rem_s 4)) RuleTrie.empty RuleTrie.empty)
