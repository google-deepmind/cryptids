        (RuleTrie.rule ob os od c0 (trieSetRoot rb rs rd c1) c2 (trieSetRoot rb rs rd c3))
        (RuleTrie.rule ob os od (trieSetRoot rb rs rd c0) c1 (trieSetRoot rb rs rd c2) c3)
        (Nat.beq (Nat.mod rem_b 2) 0))
