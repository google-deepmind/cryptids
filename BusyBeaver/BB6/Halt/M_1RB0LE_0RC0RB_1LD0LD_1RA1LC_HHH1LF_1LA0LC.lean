def lookupRule (rb rs rd : Nat) (_ _ _ _ : RuleTrie) (ih0 ih1 ih2 ih3 : Nat → OptRule → OptRule)
    (rem : Nat) (_ : OptRule) : OptRule :=
  Bool.rec
    (Bool.rec (ih3 (Nat.div rem 4) (OptRule.some rb rs rd)) (ih1 (Nat.div rem 4) (OptRule.some rb rs rd)) (Nat.beq (Nat.mod rem 4) 1))
    (Bool.rec (ih2 (Nat.div rem 4) (OptRule.some rb rs rd)) (ih0 (Nat.div rem 4) (OptRule.some rb rs rd)) (Nat.beq (Nat.mod rem 4) 0))
