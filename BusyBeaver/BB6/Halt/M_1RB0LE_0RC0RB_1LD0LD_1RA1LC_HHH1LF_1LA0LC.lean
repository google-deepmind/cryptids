      · cases Nat.beq (Nat.mod rem_b 2) 0 <;> dsimp only [Bool.rec, RuleTrie.Valid]
        · exact ⟨ht.1, trieSetRoot_spec rb rs rd c1 hr ht.2.1, ht.2.2.1, trieSetRoot_spec rb rs rd c3 hr ht.2.2.2⟩
