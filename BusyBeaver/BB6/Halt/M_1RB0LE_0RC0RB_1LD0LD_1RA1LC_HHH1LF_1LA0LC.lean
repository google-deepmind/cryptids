    (Bool.rec
      (Bool.rec
        (Bool.rec
          (RuleTrie.rule ob os od c0 c1 c2 (ih3 (Nat.div rem_b 4) (Nat.div rem_s 4)))
          (RuleTrie.rule ob os od c0 (ih1 (Nat.div rem_b 4) (Nat.div rem_s 4)) c2 c3)
          (Nat.beq (Nat.mod rem_b 4) 1))
        (Bool.rec
          (RuleTrie.rule ob os od c0 c1 (ih2 (Nat.div rem_b 4) (Nat.div rem_s 4)) c3)
          (RuleTrie.rule ob os od (ih0 (Nat.div rem_b 4) (Nat.div rem_s 4)) c1 c2 c3)
          (Nat.beq (Nat.mod rem_b 4) 0))
