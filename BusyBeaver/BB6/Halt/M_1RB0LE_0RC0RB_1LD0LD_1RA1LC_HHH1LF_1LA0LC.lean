    have e1 : n1 = m := Nat.eq_of_beq_eq_true h1
    have e2 : pos1 = pos' := Nat.eq_of_beq_eq_true h2
    subst e1
    subst e2
    exact runCF_spec steps n pos x n1 pos1 x1 hT hr

