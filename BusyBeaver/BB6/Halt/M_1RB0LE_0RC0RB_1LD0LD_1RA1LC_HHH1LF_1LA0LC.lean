def entF (g : Nat) : Nat :=
  Nat.land (Nat.shiftRight (blkF (Nat.div g 256)) (Nat.mul 58 (Nat.mod g 256))) 288230376151711743

inductive JRes where
  | fail : JRes
  | ok : Nat → Nat → JRes

def jWithF (ih : Nat → Nat → JRes) (lim p x' g e : Nat) : JRes :=
  Bool.rec JRes.fail (ih (Nat.add p (tRdF e)) x')
    (Bool.and (Nat.ble (Nat.add g 1) lim) (applies (tRbF e) (tRsF e) p))

def jStepF (lim : Nat) (_ : Nat) (ih : Nat → Nat → JRes) (p x : Nat) : JRes :=
  jWithF ih lim p (Nat.div x 32768) (Nat.mod x 32768) (entF (Nat.mod x 32768))

def jumpsF (lim cnt p x : Nat) : JRes :=
  Nat.rec JRes.ok (jStepF lim) cnt p x

inductive P1Res where
  | fail : P1Res
  | ok : Nat → Nat → LList → P1Res

def p1WithF (ih : Nat → Nat → LList → P1Res) (lim p x' : Nat) (acc : LList) (g e : Nat) : P1Res :=
  Bool.rec P1Res.fail (ih (Nat.add p (tRdF e)) x' (LList.cons p e acc))
    (Bool.and (Nat.ble (Nat.add g 1) lim) (applies (tRbF e) (tRsF e) p))

def p1StepF (lim : Nat) (_ : Nat) (ih : Nat → Nat → LList → P1Res) (p x : Nat) (acc : LList) : P1Res :=
  p1WithF ih lim p (Nat.div x 32768) acc (Nat.mod x 32768) (entF (Nat.mod x 32768))

def pass1F (lim cnt p x : Nat) (acc : LList) : P1Res :=
  Nat.rec P1Res.ok (p1StepF lim) cnt p x acc

inductive P2Res where
  | fail : P2Res
  | ok : Nat → Nat → Nat → P2Res

def emitF (k : Nat → Nat → Nat → P2Res) (q s' d' pos e : Nat) : P2Res :=
  Bool.rec P2Res.fail (k s' d' (Nat.add pos 1))
    (Bool.and (Nat.beq (tRbF e) q) (Bool.and (Nat.beq (tRsF e) s') (Nat.beq (tRdF e) d')))

def joinEmitF (k : Nat → Nat → Nat → P2Res) (q si di s d pos : Nat) : P2Res :=
  Bool.rec
    (Bool.rec P2Res.fail (emitF k q s (Nat.add di d) pos (entF pos)) (Nat.beq (Nat.mod s si) 0))
    (Bool.rec P2Res.fail (emitF k q si (Nat.add di d) pos (entF pos)) (Nat.beq (Nat.mod si s) 0))
    (Nat.ble s si)

def p2EndF (bn bs bd s d pos : Nat) : P2Res :=
  joinEmitF P2Res.ok bn bs bd s d pos

def p2StepF (q e : Nat) (_ : LList) (ih : Nat → Nat → Nat → P2Res) (s d pos : Nat) : P2Res :=
  joinEmitF ih q (tRsF e) (tRdF e) s d pos

def p2FoldF (bn bs bd : Nat) (rest : LList) (s d pos : Nat) : P2Res :=
  LList.rec (p2EndF bn bs bd) p2StepF rest s d pos

def p2NilF (bn bs bd pos : Nat) : P2Res :=
  emitF P2Res.ok bn bs bd pos (entF pos)

def p2ConsF (bn bs bd pos : Nat) (_ e : Nat) (rest : LList) (_ : P2Res) : P2Res :=
  p2FoldF bn bs bd rest (tRsF e) (tRdF e) pos

def pass2F (bn bs bd pos : Nat) (acc : LList) : P2Res :=
  LList.rec (p2NilF bn bs bd pos) (p2ConsF bn bs bd pos) acc

inductive CRes where
  | fail : CRes
  | ok : Nat → Nat → Nat → CRes

def jOkF (pos p x : Nat) : CRes := CRes.ok p pos x

def stEF (pos n cnt x : Nat) : CRes :=
  Bool.rec CRes.fail (JRes.rec CRes.fail (jOkF pos) (jumpsF pos cnt (fastEvalF n) x))
    (Nat.ble (Nat.add n 1) (fastEvalF n))

def stBSomeF (pos cnt x n _ rd : Nat) : CRes :=
  JRes.rec CRes.fail (jOkF pos) (jumpsF pos cnt (Nat.add n rd) x)

def stBF (pos n cnt x : Nat) : CRes :=
  CmpRule.rec CRes.fail (stBSomeF pos cnt x n) (fastCompileF n)

def p2OkF (n x' : Nat) (_ d pos : Nat) : CRes := CRes.ok (Nat.add n d) pos x'

def stCAfterF (n pos rs rd : Nat) (_ x' : Nat) (acc : LList) : CRes :=
  P2Res.rec CRes.fail (p2OkF n x') (pass2F n rs rd pos acc)

def stCSomeF (pos cnt x n rs rd : Nat) : CRes :=
  P1Res.rec CRes.fail (stCAfterF n pos rs rd) (pass1F pos cnt (Nat.add n rd) x LList.nil)

def stCF (pos n cnt x : Nat) : CRes :=
  CmpRule.rec CRes.fail (stCSomeF pos cnt x n) (fastCompileF n)

def stKindF (n pos kind cnt x : Nat) : CRes :=
  Bool.rec
    (Bool.rec
      (Bool.rec CRes.fail (stCF pos n cnt x) (Nat.beq kind 2))
      (stBF pos n cnt x)
      (Nat.beq kind 1))
    (stEF pos n cnt x)
    (Nat.beq kind 0)

def stepF (n pos x : Nat) : CRes :=
  stKindF n pos (Nat.mod (Nat.mod x 128) 4) (Nat.div (Nat.mod x 128) 4) (Nat.div x 128)

def cStepF (_ : Nat) (ih : Nat → Nat → Nat → CRes) (n pos x : Nat) : CRes :=
  CRes.rec CRes.fail ih (stepF n pos x)

def runCF (steps n pos x : Nat) : CRes :=
  Nat.rec CRes.ok cStepF steps n pos x

def finCF (m pos' : Nat) (n pos _ : Nat) : Bool :=
  Bool.and (Nat.beq n m) (Nat.beq pos pos')

def chunk5F (steps n m pos pos' x : Nat) : Bool :=
  CRes.rec false (finCF m pos') (runCF steps n pos x)

-- Soundness of the v5 certificate machinery.

def EntV (x : Nat) : Prop := valid (tRbF x) (tRsF x) (tRdF x)

/-- The first `p` table entries are valid rules. -/
def TabV (p : Nat) : Prop := ∀ g, g < p → EntV (entF g)

theorem TabV_zero : TabV 0 := fun g hg => absurd hg (Nat.not_lt_zero g)

theorem TabV_succ (p : Nat) (hp : TabV p) (h : EntV (entF p)) : TabV (p + 1) := by
  intro g hg
  rcases Nat.lt_or_ge g p with h1 | h1
  · exact hp g h1
  · have hgp : g = p := by omega
    subst hgp
    exact h

theorem ref_spec (lim p g : Nat) (hT : TabV lim)
    (h : Bool.and (Nat.ble (Nat.add g 1) lim) (applies (tRbF (entF g)) (tRsF (entF g)) p) = true) :
    valid p (tRsF (entF g)) (tRdF (entF g)) := by
  rcases Bool.and_eq_true_iff.mp h with ⟨h1, h2⟩
  have hg : g + 1 ≤ lim := Nat.le_of_ble_eq_true h1
  exact valid_of_applies _ _ _ p (hT g (by omega)) h2

theorem jumpsF_spec (lim : Nat) (hT : TabV lim) (cnt : Nat) :
    ∀ p x p' x', jumpsF lim cnt p x = JRes.ok p' x' → ReachesStar target_tm (Cn p) (Cn p') := by
  induction cnt with
  | zero =>
    intro p x p' x' h
    change JRes.ok p x = JRes.ok p' x' at h
    injection h with h1 h2
    subst h1
    exact ReachesStar.refl _ _
  | succ cnt ih =>
    intro p x p' x' h
    change jStepF lim cnt (Nat.rec (motive := fun _ => Nat → Nat → JRes) JRes.ok (jStepF lim) cnt) p x =
      JRes.ok p' x' at h
    unfold jStepF jWithF at h
    revert h
    cases hc : Bool.and (Nat.ble (Nat.add (Nat.mod x 32768) 1) lim)
        (applies (tRbF (entF (Nat.mod x 32768))) (tRsF (entF (Nat.mod x 32768))) p) <;>
      dsimp only [Bool.rec] <;> intro h
    · cases h
    · exact (valid_zero p _ _ (ref_spec lim p _ hT hc)).trans (ih _ _ p' x' h)

/-- `acc` lists the looked-up rules of a chain (last first) with the positions they were applied at;
the chain starts at `p0` and ends at `p`. -/
def ChainOK (p0 : Nat) : LList → Nat → Prop
  | .nil, p => p = p0
  | .cons q e rest, p => p = q + tRdF e ∧ valid q (tRsF e) (tRdF e) ∧ ChainOK p0 rest q

theorem pass1F_spec (lim p0 : Nat) (hT : TabV lim) (cnt : Nat) :
    ∀ p x acc p' x' acc', ChainOK p0 acc p → pass1F lim cnt p x acc = P1Res.ok p' x' acc' →
      ChainOK p0 acc' p' := by
  induction cnt with
  | zero =>
    intro p x acc p' x' acc' hacc h
    change P1Res.ok p x acc = P1Res.ok p' x' acc' at h
    injection h with h1 h2 h3
    subst h1
    subst h3
    exact hacc
  | succ cnt ih =>
    intro p x acc p' x' acc' hacc h
    change p1StepF lim cnt (Nat.rec (motive := fun _ => Nat → Nat → LList → P1Res) P1Res.ok (p1StepF lim) cnt)
      p x acc = P1Res.ok p' x' acc' at h
    unfold p1StepF p1WithF at h
    revert h
    cases hc : Bool.and (Nat.ble (Nat.add (Nat.mod x 32768) 1) lim)
        (applies (tRbF (entF (Nat.mod x 32768))) (tRsF (entF (Nat.mod x 32768))) p) <;>
      dsimp only [Bool.rec] <;> intro h
    · cases h
    · refine ih _ _ _ p' x' acc' ?_ h
      exact ⟨rfl, ref_spec lim p _ hT hc, hacc⟩

theorem emitF_spec (k : Nat → Nat → Nat → P2Res) (q s' d' pos : Nat) (hv : valid q s' d') (hT : TabV pos)
    (s d pos' : Nat) (h : emitF k q s' d' pos (entF pos) = P2Res.ok s d pos') :
    TabV (pos + 1) ∧ k s' d' (pos + 1) = P2Res.ok s d pos' := by
  revert h
  unfold emitF
  cases hc : Bool.and (Nat.beq (tRbF (entF pos)) q)
      (Bool.and (Nat.beq (tRsF (entF pos)) s') (Nat.beq (tRdF (entF pos)) d')) <;>
    dsimp only [Bool.rec] <;> intro h
  · cases h
  · rcases Bool.and_eq_true_iff.mp hc with ⟨h1, h23⟩
    rcases Bool.and_eq_true_iff.mp h23 with ⟨h2, h3⟩
    refine ⟨TabV_succ pos hT ?_, h⟩
    show valid (tRbF (entF pos)) (tRsF (entF pos)) (tRdF (entF pos))
    rw [Nat.eq_of_beq_eq_true h1, Nat.eq_of_beq_eq_true h2, Nat.eq_of_beq_eq_true h3]
    exact hv

theorem joinEmitF_spec (k : Nat → Nat → Nat → P2Res) (q si di s d pos : Nat)
    (h1 : valid q si di) (h2 : valid (q + di) s d) (hT : TabV pos) (s0 d0 pos0 : Nat)
    (h : joinEmitF k q si di s d pos = P2Res.ok s0 d0 pos0) :
    ∃ s' d', valid q s' d' ∧ TabV (pos + 1) ∧ k s' d' (pos + 1) = P2Res.ok s0 d0 pos0 := by
  revert h
  unfold joinEmitF
  cases Nat.ble s si <;> dsimp only [Bool.rec]
  · cases hm : Nat.beq (Nat.mod s si) 0 <;> dsimp only [Bool.rec] <;> intro h
    · cases h
    · have hv : valid q s (di + d) := join_rules_2 q si di s d h1 h2 (Nat.eq_of_beq_eq_true hm)
      obtain ⟨hT', hk⟩ := emitF_spec k q s (Nat.add di d) pos hv hT s0 d0 pos0 h
      exact ⟨s, Nat.add di d, hv, hT', hk⟩
  · cases hm : Nat.beq (Nat.mod si s) 0 <;> dsimp only [Bool.rec] <;> intro h
    · cases h
    · have hv : valid q si (di + d) := join_rules_1 q si di s d h1 h2 (Nat.eq_of_beq_eq_true hm)
      obtain ⟨hT', hk⟩ := emitF_spec k q si (Nat.add di d) pos hv hT s0 d0 pos0 h
      exact ⟨si, Nat.add di d, hv, hT', hk⟩

theorem p2FoldF_spec (bn bs bd : Nat) (hb : valid bn bs bd) (rest : LList) :
    ∀ q s d pos s0 d0 pos0, ChainOK (bn + bd) rest q → valid q s d → TabV pos →
      p2FoldF bn bs bd rest s d pos = P2Res.ok s0 d0 pos0 → valid bn s0 d0 ∧ TabV pos0 := by
  induction rest with
  | nil =>
    intro q s d pos s0 d0 pos0 hrest hv hT h
    have hq : q = bn + bd := hrest
    subst hq
    change joinEmitF P2Res.ok bn bs bd s d pos = P2Res.ok s0 d0 pos0 at h
    obtain ⟨s', d', hv', hT', hk⟩ := joinEmitF_spec P2Res.ok bn bs bd s d pos hb hv hT s0 d0 pos0 h
    injection hk with e1 e2 e3
    subst e1
    subst e2
    subst e3
    exact ⟨hv', hT'⟩
  | cons q' e rest ih =>
    intro q s d pos s0 d0 pos0 hrest hv hT h
    rcases hrest with ⟨hq, hv', hrest'⟩
    subst hq
    change joinEmitF (p2FoldF bn bs bd rest) q' (tRsF e) (tRdF e) s d pos = P2Res.ok s0 d0 pos0 at h
    obtain ⟨s', d', hv2, hT', hk⟩ := joinEmitF_spec _ q' (tRsF e) (tRdF e) s d pos hv' hv hT s0 d0 pos0 h
    exact ih q' s' d' (pos + 1) s0 d0 pos0 hrest' hv2 hT' hk

theorem pass2F_spec (bn bs bd pos : Nat) (hb : valid bn bs bd) (hT : TabV pos) (acc : LList) (p' : Nat)
    (hacc : ChainOK (bn + bd) acc p') (s0 d0 pos0 : Nat) (h : pass2F bn bs bd pos acc = P2Res.ok s0 d0 pos0) :
    valid bn s0 d0 ∧ TabV pos0 := by
  cases acc with
  | nil =>
    change emitF P2Res.ok bn bs bd pos (entF pos) = P2Res.ok s0 d0 pos0 at h
    obtain ⟨hT', hk⟩ := emitF_spec P2Res.ok bn bs bd pos hb hT s0 d0 pos0 h
    injection hk with e1 e2 e3
    subst e1
    subst e2
    subst e3
    exact ⟨hb, hT'⟩
  | cons q e rest =>
    rcases hacc with ⟨_, hv, hrest⟩
    change p2FoldF bn bs bd rest (tRsF e) (tRdF e) pos = P2Res.ok s0 d0 pos0 at h
    exact p2FoldF_spec bn bs bd hb rest q (tRsF e) (tRdF e) pos s0 d0 pos0 hrest hv hT h

theorem stEF_spec (pos n cnt x : Nat) (hT : TabV pos) (n' pos' x' : Nat)
    (h : stEF pos n cnt x = CRes.ok n' pos' x') :
    TabV pos' ∧ ReachesStar target_tm (Cn n) (Cn n') := by
  revert h
  unfold stEF
  cases hle : Nat.ble (Nat.add n 1) (fastEvalF n) <;> dsimp only [Bool.rec] <;> intro h
  · cases h
  · have hgt : n + 1 ≤ fastEval n := by
      rw [← fastEvalF_eq]
      exact Nat.le_of_ble_eq_true hle
    have hreach : ReachesStar target_tm (Cn n) (Cn (fastEvalF n)) := by
      rw [fastEvalF_eq]
      rcases fastEval_spec n with h0 | hs
      · omega
      · exact hs
    revert h
    cases hj : jumpsF pos cnt (fastEvalF n) x with
    | fail => intro h; cases h
    | ok p x1 =>
      intro h
      change CRes.ok p pos x1 = CRes.ok n' pos' x' at h
      injection h with e1 e2 e3
      subst e1
      subst e2
      exact ⟨hT, hreach.trans (jumpsF_spec pos hT cnt _ _ p x1 hj)⟩

theorem stBF_spec (pos n cnt x : Nat) (hT : TabV pos) (n' pos' x' : Nat)
    (h : stBF pos n cnt x = CRes.ok n' pos' x') :
    TabV pos' ∧ ReachesStar target_tm (Cn n) (Cn n') := by
  have hcomp := fastCompile_spec n
  rw [← fastCompileF_eq] at hcomp
  unfold stBF at h
  revert h hcomp
  cases fastCompileF n with
  | none => intro h _; cases h
  | some rs rd =>
    intro h hcomp
    have hb : valid n rs rd := hcomp
    change JRes.rec CRes.fail (jOkF pos) (jumpsF pos cnt (Nat.add n rd) x) = CRes.ok n' pos' x' at h
    revert h
    cases hj : jumpsF pos cnt (Nat.add n rd) x with
    | fail => intro h; cases h
    | ok p x1 =>
      intro h
      change CRes.ok p pos x1 = CRes.ok n' pos' x' at h
      injection h with e1 e2 e3
      subst e1
      subst e2
      exact ⟨hT, (valid_zero n rs rd hb).trans (jumpsF_spec pos hT cnt _ _ p x1 hj)⟩

theorem stCF_spec (pos n cnt x : Nat) (hT : TabV pos) (n' pos' x' : Nat)
    (h : stCF pos n cnt x = CRes.ok n' pos' x') :
    TabV pos' ∧ ReachesStar target_tm (Cn n) (Cn n') := by
  have hcomp := fastCompile_spec n
  rw [← fastCompileF_eq] at hcomp
  unfold stCF at h
  revert h hcomp
  cases fastCompileF n with
  | none => intro h _; cases h
  | some rs rd =>
    intro h hcomp
    have hb : valid n rs rd := hcomp
    change P1Res.rec CRes.fail (stCAfterF n pos rs rd) (pass1F pos cnt (Nat.add n rd) x LList.nil) =
      CRes.ok n' pos' x' at h
    revert h
    cases h1 : pass1F pos cnt (Nat.add n rd) x LList.nil with
    | fail => intro h; cases h
    | ok p x1 acc =>
      intro h
      have hacc : ChainOK (n + rd) acc p :=
        pass1F_spec pos (n + rd) hT cnt (Nat.add n rd) x LList.nil p x1 acc rfl h1
      change P2Res.rec CRes.fail (p2OkF n x1) (pass2F n rs rd pos acc) = CRes.ok n' pos' x' at h
      revert h
      cases h2 : pass2F n rs rd pos acc with
      | fail => intro h; cases h
      | ok s0 d0 pos0 =>
        intro h
        change CRes.ok (Nat.add n d0) pos0 x1 = CRes.ok n' pos' x' at h
        injection h with e1 e2 e3
        subst e1
        subst e2
        obtain ⟨hv, hT'⟩ := pass2F_spec n rs rd pos hb hT acc p hacc s0 d0 pos0 h2
        exact ⟨hT', valid_zero n s0 d0 hv⟩

theorem stepF_spec (n pos x : Nat) (hT : TabV pos) (n' pos' x' : Nat)
    (h : stepF n pos x = CRes.ok n' pos' x') :
    TabV pos' ∧ ReachesStar target_tm (Cn n) (Cn n') := by
  unfold stepF stKindF at h
  revert h
  cases Nat.beq (Nat.mod (Nat.mod x 128) 4) 0 <;> cases Nat.beq (Nat.mod (Nat.mod x 128) 4) 1 <;>
    cases Nat.beq (Nat.mod (Nat.mod x 128) 4) 2 <;> dsimp only [Bool.rec] <;> intro h
  all_goals first
    | cases h
