def LC : List Nat → ListBlank (Fin 2)
  | [] => default
  | a :: l => (0 : Fin 2) >> ((([1] : List (Fin 2)) ^ a) +> LC l)

def RC : List Nat → ListBlank (Fin 2)
  | [] => default
  | a :: r => (([1] : List (Fin 2)) ^ a) +> ((0 : Fin 2) >> RC r)

def CfgS (l : List Nat) (b : Nat) (r : List Nat) : Cfg (Fin 2) (Fin 6) :=
  Cfg.headLeft C ((([1] : List (Fin 2)) ^ b) +> LC l) (RC r)

def CfgT (l : List Nat) (b : Nat) (r : List Nat) : Cfg (Fin 2) (Fin 6) :=
  Cfg.headRight B ((([1] : List (Fin 2)) ^ b) +> LC l) (RC r)

def CfgU (l : List Nat) (b : Nat) (r : List Nat) : Cfg (Fin 2) (Fin 6) :=
  Cfg.headLeft F ((([1] : List (Fin 2)) ^ b) +> LC l) (RC r)

def CfgV (l : List Nat) (b : Nat) (r : List Nat) : Cfg (Fin 2) (Fin 6) :=
  Cfg.headLeft A ((([1] : List (Fin 2)) ^ b) +> LC l) (RC r)

theorem Lblank : LC [] = LC [0] := by
  simp only [LC]; normalize

theorem Rblank (r : List Nat) : RC r = RC (r ++ [0]) := by
  induction r with
  | nil => simp only [RC, List.nil_append]; normalize
  | cons a r ih => simp only [List.cons_append, RC, ← ih]

theorem Szero (l : List Nat) (a : Nat) (r : List Nat) :
    ReachesStar target_tm (CfgS (0 :: a :: l) 0 r) (CfgU l a (1 :: r)) := by
  simp only [CfgS, CfgU, LC, RC]; normalize; bb_steps

theorem Sleft (l : List Nat) (a c : Nat) (r : List Nat) :
    ReachesStar target_tm (CfgS ((1 + a) :: l) 0 (c :: r)) (CfgS l a ((2 + c) :: r)) := by
  rw [Nat.add_comm 1 a, Nat.add_comm 2 c]
  simp only [CfgS, LC, RC]; normalize; bb_steps

theorem Sone (l : List Nat) (a : Nat) (r : List Nat) :
    ReachesStar target_tm (CfgS (a :: l) 1 r) (CfgT l (2 + a) r) := by
