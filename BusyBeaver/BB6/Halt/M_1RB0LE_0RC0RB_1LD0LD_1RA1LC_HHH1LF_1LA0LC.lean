def trieStore (rb rs rd : Nat) (t : RuleTrie) (rem_b rem_s : Nat) : RuleTrie :=
  RuleTrie.rec (trieSingleton rb rs rd) (storePass rb rs rd) (storeRule rb rs rd) t rem_b rem_s

def storeIf (rb rs rd : Nat) (t : RuleTrie) : RuleTrie :=
  Bool.rec
    t
    (trieStore rb rs rd t (Nat.div rb 8) (Nat.div rs 8))
    (Nat.ble (Nat.add rb rs) 34357641212)

inductive ChainRes where
  | mk : Nat → Nat → RuleTrie → ChainRes

def chainJoinStore (n m d_new : Nat) (t' : RuleTrie) : ChainRes :=
  ChainRes.mk m d_new (storeIf n m d_new t')

def chainJoinBody (n rs rd cs cd : Nat) (t' : RuleTrie) : ChainRes :=
  Bool.rec
    (Bool.rec
      (ChainRes.mk rs rd t')
      (chainJoinStore n cs (Nat.add rd cd) t')
      (Nat.beq (Nat.mod cs rs) 0))
    (Bool.rec
      (ChainRes.mk rs rd t')
      (chainJoinStore n rs (Nat.add rd cd) t')
      (Nat.beq (Nat.mod rs cs) 0))
    (Nat.ble cs rs)

def chainJoin (n rs rd : Nat) (res : ChainRes) : ChainRes :=
  ChainRes.rec (chainJoinBody n rs rd) res

def chainStepSome (ih : RuleTrie → Nat → Nat → Nat → ChainRes)
    (t : RuleTrie) (n rs rd n_next sb ss sd : Nat) : ChainRes :=
  Bool.rec
    (ChainRes.mk rs rd t)
    (chainJoin n rs rd (ih t n_next ss sd))
    (applies sb ss n_next)

def chainStepAux (ih : RuleTrie → Nat → Nat → Nat → ChainRes)
    (t : RuleTrie) (n rs rd n_next : Nat) : ChainRes :=
  OptRule.rec
    (ChainRes.mk rs rd t)
    (chainStepSome ih t n rs rd n_next)
    (trieLookup t (Nat.div n_next 8) OptRule.none)

def chainStep (_ : Nat) (ih : RuleTrie → Nat → Nat → Nat → ChainRes)
    (t : RuleTrie) (n rs rd : Nat) : ChainRes :=
  chainStepAux ih t n rs rd (Nat.add n rd)

def chainBase (t : RuleTrie) (_ rs rd : Nat) : ChainRes :=
  ChainRes.mk rs rd t

def chainRight (fuel : Nat) (t : RuleTrie) (n rs rd : Nat) : ChainRes :=
  Nat.rec chainBase chainStep fuel t n rs rd

def jumpStepSome (ih : Nat → Nat) (n sb ss sd : Nat) : Nat :=
  Bool.rec n (ih (Nat.add n sd)) (applies sb ss n)

def jumpStep (t : RuleTrie) (_ : Nat) (ih : Nat → Nat) (n : Nat) : Nat :=
  OptRule.rec n (jumpStepSome ih n) (trieLookup t (Nat.div n 8) OptRule.none)

def jumpRight (fuel : Nat) (t : RuleTrie) (n : Nat) : Nat :=
  Nat.rec (fun n => n) (jumpStep t) fuel n

def runEvalJumpStepAux (t : RuleTrie) (ih : Nat → Nat) (n next : Nat) : Nat :=
  Bool.rec n (ih (jumpRight 20 t next)) (Nat.ble (Nat.add n 1) next)

def runEvalJumpStep (t : RuleTrie) (_ : Nat) (ih : Nat → Nat) (n : Nat) : Nat :=
  runEvalJumpStepAux t ih n (fastEval n)

def runEvalJump (t : RuleTrie) (steps n : Nat) : Nat :=
  Nat.rec (fun n => n) (runEvalJumpStep t) steps n

def runAdvAfterChainBody (ih : Nat → RuleTrie → Nat) (n rd ss sd : Nat) (t' : RuleTrie) : Nat :=
  Bool.rec
    (ih (Nat.add n sd) t')
    (ih (Nat.add n sd) (storeIf n ss sd t'))
    (Nat.beq sd rd)

def runAdvAfterChain (ih : Nat → RuleTrie → Nat) (n rd : Nat) (res : ChainRes) : Nat :=
  ChainRes.rec (runAdvAfterChainBody ih n rd) res

def runAdvStepSome (ih : Nat → RuleTrie → Nat) (n : Nat) (t : RuleTrie) (rs rd : Nat) : Nat :=
  Bool.rec
    (ih (jumpRight 20 t (Nat.add n rd)) t)
    (runAdvAfterChain ih n rd (chainRight 20 t n rs rd))
    (Nat.ble (Nat.add n rs) 34357641212)

def runAdvStep (_ : Nat) (ih : Nat → RuleTrie → Nat) (n : Nat) (t : RuleTrie) : Nat :=
  CmpRule.rec
    (runEvalJumpStepAux t (fun n' => ih n' t) n (fastEval n))
    (runAdvStepSome ih n t)
    (fastCompile n)

def runAdvBase (steps2 : Nat) (n : Nat) (t : RuleTrie) : Nat :=
  runEvalJump t steps2 n

def runTwoStage (steps1 steps2 n : Nat) (t : RuleTrie) : Nat :=
  Nat.rec (runAdvBase steps2) runAdvStep steps1 n t

-- Soundness of RuleTrie, chainRight, jumpRight, runEvalJump, and runTwoStage

def OptRule.Valid : OptRule → Prop
  | .none => True
  | .some rb rs rd => valid rb rs rd

def RuleTrie.Valid : RuleTrie → Prop
  | .empty => True
  | .pass c0 c1 c2 c3 =>
    RuleTrie.Valid c0 ∧ RuleTrie.Valid c1 ∧ RuleTrie.Valid c2 ∧ RuleTrie.Valid c3
  | .rule rb rs rd c0 c1 c2 c3 =>
    valid rb rs rd ∧ RuleTrie.Valid c0 ∧ RuleTrie.Valid c1 ∧ RuleTrie.Valid c2 ∧ RuleTrie.Valid c3

theorem applies_spec (rb rs n : Nat) (h : applies rb rs n = true) :
    rb ≤ n ∧ rs ≠ 0 ∧ (n - rb) % rs = 0 := by
  unfold applies at h
  cases h1 : Nat.ble rb n <;> rw [h1] at h <;> dsimp only [Bool.rec] at h
  · contradiction
  · cases h2 : Nat.beq rs 0 <;> rw [h2] at h <;> dsimp only [Bool.rec] at h
    · have h1' := Nat.le_of_ble_eq_true h1
      have h2' : rs ≠ 0 := by
        intro h0; subst h0; revert h2; decide
      have h3' := Nat.eq_of_beq_eq_true h
      exact ⟨h1', h2', h3'⟩
    · contradiction

theorem valid_zero (n rs rd : Nat) (hv : valid n rs rd) :
    ReachesStar target_tm (Cn n) (Cn (n + rd)) := by
  have h := hv 0
  rw [Nat.mul_zero, Nat.add_zero, Nat.add_zero] at h
  exact h

theorem valid_of_applies (sb ss sd n : Nat) (hv : valid sb ss sd) (ha : applies sb ss n = true) :
    valid n ss sd := by
  rcases applies_spec sb ss n ha with ⟨h1, _, h3⟩
  rcases Nat.dvd_of_mod_eq_zero h3 with ⟨k, hk⟩
  intro t
  have h := hv (k + t)
  have he1 : sb + ss * (k + t) = n + ss * t := by
    have : ss * (k + t) = ss * k + ss * t := by ring
    omega
  have he2 : sb + sd + ss * (k + t) = n + sd + ss * t := by
    have : ss * (k + t) = ss * k + ss * t := by ring
    omega
  rw [← he1, ← he2]
  exact h

theorem apply_rule (rb rs rd n : Nat) (hv : valid rb rs rd) (ha : applies rb rs n = true) :
    ReachesStar target_tm (Cn n) (Cn (n + rd)) :=
  valid_zero n rs rd (valid_of_applies rb rs rd n hv ha)

theorem join_rules_1 (n rs rd cs cd : Nat) (h1 : valid n rs rd) (h2 : valid (n + rd) cs cd)
    (hm : rs % cs = 0) : valid n rs (rd + cd) := by
  rcases Nat.dvd_of_mod_eq_zero hm with ⟨k, hk⟩
  intro t
  have hr1 := h1 t
  have hr2 := h2 (k * t)
  have hmul : cs * (k * t) = rs * t := by rw [hk]; ring
  rw [hmul] at hr2
  have heq : n + rd + cd + rs * t = n + (rd + cd) + rs * t := by omega
  rw [heq] at hr2
  exact hr1.trans hr2

theorem join_rules_2 (n rs rd cs cd : Nat) (h1 : valid n rs rd) (h2 : valid (n + rd) cs cd)
    (hm : cs % rs = 0) : valid n cs (rd + cd) := by
  rcases Nat.dvd_of_mod_eq_zero hm with ⟨k, hk⟩
  intro t
  have hr1 := h1 (k * t)
  have hr2 := h2 t
  have hmul : rs * (k * t) = cs * t := by rw [hk]; ring
  rw [hmul] at hr1
  have heq : n + rd + cd + cs * t = n + (rd + cd) + cs * t := by omega
  rw [heq] at hr2
  exact hr1.trans hr2

theorem trieLookup_spec (t : RuleTrie) (rem : Nat) (best : OptRule)
    (ht : RuleTrie.Valid t) (hb : OptRule.Valid best) :
    OptRule.Valid (trieLookup t rem best) := by
  induction t generalizing rem best with
  | empty => exact hb
  | pass c0 c1 c2 c3 ih0 ih1 ih2 ih3 =>
    dsimp only [trieLookup, RuleTrie.rec, lookupPass]
    cases Nat.beq (Nat.mod rem 2) 0 <;> cases Nat.beq (Nat.mod rem 4) 0 <;> cases Nat.beq (Nat.mod rem 4) 1 <;>
      dsimp only [Bool.rec]
    · exact ih3 (Nat.div rem 4) best ht.2.2.2 hb
    · exact ih1 (Nat.div rem 4) best ht.2.1 hb
    · exact ih3 (Nat.div rem 4) best ht.2.2.2 hb
    · exact ih1 (Nat.div rem 4) best ht.2.1 hb
    · exact ih2 (Nat.div rem 4) best ht.2.2.1 hb
    · exact ih2 (Nat.div rem 4) best ht.2.2.1 hb
    · exact ih0 (Nat.div rem 4) best ht.1 hb
    · exact ih0 (Nat.div rem 4) best ht.1 hb
  | rule rb rs rd c0 c1 c2 c3 ih0 ih1 ih2 ih3 =>
    dsimp only [trieLookup, RuleTrie.rec, lookupRule]
    cases Nat.beq (Nat.mod rem 2) 0 <;> cases Nat.beq (Nat.mod rem 4) 0 <;> cases Nat.beq (Nat.mod rem 4) 1 <;>
      dsimp only [Bool.rec]
    · exact ih3 (Nat.div rem 4) (OptRule.some rb rs rd) ht.2.2.2.2 ht.1
    · exact ih1 (Nat.div rem 4) (OptRule.some rb rs rd) ht.2.2.1 ht.1
    · exact ih3 (Nat.div rem 4) (OptRule.some rb rs rd) ht.2.2.2.2 ht.1
    · exact ih1 (Nat.div rem 4) (OptRule.some rb rs rd) ht.2.2.1 ht.1
    · exact ih2 (Nat.div rem 4) (OptRule.some rb rs rd) ht.2.2.2.1 ht.1
    · exact ih2 (Nat.div rem 4) (OptRule.some rb rs rd) ht.2.2.2.1 ht.1
    · exact ih0 (Nat.div rem 4) (OptRule.some rb rs rd) ht.2.1 ht.1
    · exact ih0 (Nat.div rem 4) (OptRule.some rb rs rd) ht.2.1 ht.1

theorem trieSetRoot_spec (rb rs rd : Nat) (t : RuleTrie)
    (hr : valid rb rs rd) (ht : RuleTrie.Valid t) :
    RuleTrie.Valid (trieSetRoot rb rs rd t) := by
  cases t with
  | empty => exact ⟨hr, trivial, trivial, trivial, trivial⟩
