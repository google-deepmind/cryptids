theorem S_odd3_lemma (n : Nat) (l : List Nat) (x : Nat) (r : List Nat) :
    ReachesStar target_tm (CfgS (x :: l) (n * 4 + 7) (0 :: r))
      (CfgS l (x + n * 2 + 1) (0 :: 1 :: 2 :: (List.replicate (n + 1) 1 ++ r))) := by
  have h1 : n * 4 + 7 = (n + 1) * 4 + 1 + 1 * 2 := by omega
  rw [h1]
  refine (Incs (n + 1) 1 l x r).trans ?_
  refine (Spos (((n + 1) * 2 + x) :: l) 1 (0 :: (List.replicate (n + 1) 1 ++ r))).trans ?_
  refine (Sone l ((n + 1) * 2 + x) (1 :: 0 :: (List.replicate (n + 1) 1 ++ r))).trans ?_
  refine (Tpos l (2 + ((n + 1) * 2 + x)) 0 (0 :: (List.replicate (n + 1) 1 ++ r))).trans ?_
  refine (Tzero ((2 + ((n + 1) * 2 + x)) :: l) 0 (List.replicate (n + 1) 1 ++ r)).trans ?_
  refine (Uzero l (2 + ((n + 1) * 2 + x)) 1 (List.replicate (n + 1) 1 ++ r)).trans ?_
  refine (Vpos l ((n + 1) * 2 + x) (2 :: (List.replicate (n + 1) 1 ++ r))).trans ?_
  have h4 : (n + 1) * 2 + x = 1 + (x + n * 2 + 1) := by omega
  rw [h4]
  exact Upos l (x + n * 2 + 1) (1 :: 2 :: (List.replicate (n + 1) 1 ++ r))

theorem S_odd1_lemma (n m : Nat) (l : List Nat) (x : Nat) (r : List Nat) :
    ReachesStar target_tm (CfgS (x :: l) (n * 4 + 5) (0 :: (List.replicate m 1 ++ r)))
      (CfgT l ((n + 1 + m) * 2 + (2 + ((n + 1) * 2 + x))) (0 :: r)) := by
  have h1 : n * 4 + 5 = (n + 1) * 4 + 1 + 0 * 2 := by omega
  rw [h1]
  refine (Incs (n + 1) 0 l x (List.replicate m 1 ++ r)).trans ?_
  refine (Sone l ((n + 1) * 2 + x) (0 :: (List.replicate (n + 1) 1 ++ (List.replicate m 1 ++ r)))).trans ?_
  have h3 : List.replicate (n + 1) 1 ++ (List.replicate m 1 ++ r) = List.replicate (n + 1 + m) 1 ++ r := by
    rw [← List.append_assoc, ← List.replicate_add]
  rw [h3]
  exact Tmixs (n + 1 + m) l (2 + ((n + 1) * 2 + x)) r

theorem T_21_lemma (k : Nat) (l : List Nat) (a : Nat) (r : List Nat) :
    ReachesStar target_tm (CfgT l a (0 :: 2 :: (List.replicate k 1 ++ r)))
      (CfgT ((2 + a) :: l) (k * 2) (0 :: r)) := by
  refine (Tmix l a 1 (List.replicate k 1 ++ r)).trans ?_
  refine (Tpos l (2 + a) 0 (List.replicate k 1 ++ r)).trans ?_
  simpa using Tmixs k ((2 + a) :: l) 0 r

theorem T_end_lemma (l : List Nat) (a : Nat) :
    ReachesStar target_tm (CfgT l (1 + a) [0]) (CfgS l a [0, 1]) := by
  have h1 : CfgT l (1 + a) [0] = CfgT l (1 + a) [0, 0] := by
    simp only [CfgT]; rw [Rblank [0]]; rfl
  rw [h1]
  refine (Tzero l (1 + a) []).trans ?_
  exact Upos l a [1]

theorem S_even_empty_lemma (q m : Nat) (r : List Nat) :
    ReachesStar target_tm (CfgS [] ((q + 1) * 2) (0 :: (List.replicate m 1 ++ r)))
      (CfgS [0, 1] (q * 2 + 1) (0 :: (List.replicate (m + 1) 1 ++ r))) := by
  have h1 : (q + 1) * 2 = (q + 1) * 2 + 0 := by omega
  rw [h1]
  refine (Slefts (q + 1) [] 0 (0 :: (List.replicate m 1 ++ r))).trans ?_
  have h2 : CfgS [] 0 (List.replicate (q + 1) 1 ++ 0 :: (List.replicate m 1 ++ r)) =
      CfgS [0, 0] 0 (1 :: (List.replicate q 1 ++ 0 :: (List.replicate m 1 ++ r))) := by
    simp only [CfgS]
    rw [Lblank, LC, Lblank, ← LC]
    rw [List.replicate_succ, List.cons_append]
  rw [h2]
  refine (Szero [] 0 (1 :: (List.replicate q 1 ++ 0 :: (List.replicate m 1 ++ r)))).trans ?_
  have h3 : CfgU [] 0 (1 :: 1 :: (List.replicate q 1 ++ 0 :: (List.replicate m 1 ++ r))) =
      CfgU [0] 0 (1 :: 1 :: (List.replicate q 1 ++ 0 :: (List.replicate m 1 ++ r))) := by
    simp only [CfgU, Lblank]
  rw [h3]
  refine (Uzero [] 0 1 (1 :: (List.replicate q 1 ++ 0 :: (List.replicate m 1 ++ r)))).trans ?_
  have h4 : CfgV [] 0 ((1 + 1) :: 1 :: (List.replicate q 1 ++ 0 :: (List.replicate m 1 ++ r))) =
      CfgV [0] 0 ((1 + 1) :: 1 :: (List.replicate q 1 ++ 0 :: (List.replicate m 1 ++ r))) := by
    simp only [CfgV, Lblank]
  rw [h4]
  refine (Vzero [] 0 ((1 + 1) :: 1 :: (List.replicate q 1 ++ 0 :: (List.replicate m 1 ++ r)))).trans ?_
  refine (Trights 1 [] 1 (1 :: (List.replicate q 1 ++ 0 :: (List.replicate m 1 ++ r)))).trans ?_
  have h5 : (0 :: 1 :: (List.replicate q 1 ++ 0 :: (List.replicate m 1 ++ r))) =
      (0 :: (List.replicate (q + 1) 1 ++ 0 :: (List.replicate m 1 ++ r))) := by
    rw [List.replicate_succ, List.cons_append]
  rw [h5]
  refine (Tmixs (q + 1) [0, 1] 0 (0 :: (List.replicate m 1 ++ r))).trans ?_
  refine (Tzero [0, 1] ((q + 1) * 2 + 0) (List.replicate m 1 ++ r)).trans ?_
  have h6 : (q + 1) * 2 + 0 = 1 + (q * 2 + 1) := by omega
  have h7 : (1 :: (List.replicate m 1 ++ r)) = (List.replicate (m + 1) 1 ++ r) := by
    rw [List.replicate_succ, List.cons_append]
  rw [h6, h7]
  exact Upos [0, 1] (q * 2 + 1) (List.replicate (m + 1) 1 ++ r)


def Cn (n : Nat) : Cfg (Fin 2) (Fin 6) := CfgS [] n [0, 1]

theorem step_odd1_r (l : List Nat) (x fa m : Nat) (r : List Nat) (h : fa % 4 = 1) :
    ReachesStar target_tm
      (CfgS (x :: l) fa (0 :: (List.replicate (m + 1) 1 ++ r)))
      (CfgT l (x + fa + 2 * m + 3) (0 :: r)) := by
  by_cases h1 : fa = 1
  · subst h1
    refine (Sone l x (0 :: (List.replicate (m + 1) 1 ++ r))).trans ?_
    refine (Tmixs (m + 1) l (2 + x) r).trans ?_
    have heq : (m + 1) * 2 + (2 + x) = x + 1 + 2 * m + 3 := by omega
    rw [heq]; exact ReachesStar.refl _ _
  · have hfa : (fa / 4 - 1) * 4 + 5 = fa := by omega
    rw [← hfa]
    refine (S_odd1_lemma (fa / 4 - 1) (m + 1) l x r).trans ?_
    have heq : (fa / 4 - 1 + 1 + (m + 1)) * 2 + (2 + ((fa / 4 - 1 + 1) * 2 + x)) =
        x + ((fa / 4 - 1) * 4 + 5) + 2 * m + 3 := by omega
    rw [heq]; exact ReachesStar.refl _ _

theorem step_odd1_end (l : List Nat) (x fa : Nat) (h : fa % 4 = 1) :
    ReachesStar target_tm (CfgS (x :: l) fa [0, 1]) (CfgS l (x + fa + 2) [0, 1]) := by
  have hr : ([0, 1] : List Nat) = 0 :: (List.replicate (0 + 1) 1 ++ []) := rfl
  rw [hr]
  refine (step_odd1_r l x fa 0 [] h).trans ?_
  have heq : x + fa + 2 * 0 + 3 = 1 + (x + fa + 2) := by omega
  rw [heq]
  exact T_end_lemma l (x + fa + 2)

theorem step_odd3_r (l : List Nat) (x fa : Nat) (r : List Nat) (h1 : fa % 4 = 3) (h2 : 2 ≤ x + fa / 2) :
    ReachesStar target_tm
      (CfgS (x :: l) fa (0 :: r))
      (CfgS l (x + fa / 2 - 2) (0 :: 1 :: 2 :: (List.replicate (fa / 4) 1 ++ r))) := by
  by_cases hfa3 : fa = 3
  · subst hfa3
    have hx : x = 1 + (x - 1) := by omega
    have h3 : (3 : Nat) = 2 + 1 := rfl
    rw [h3]
    refine (Spos (x :: l) 1 (0 :: r)).trans ?_
    refine (Sone l x (1 :: 0 :: r)).trans ?_
    refine (Tpos l (2 + x) 0 (0 :: r)).trans ?_
    refine (Tzero ((2 + x) :: l) 0 r).trans ?_
    refine (Uzero l (2 + x) 1 r).trans ?_
    refine (Vpos l x (2 :: r)).trans ?_
    have hx2 : x + (2 + 1) / 2 - 2 = x - 1 := by omega
    have hr2 : List.replicate ((2 + 1) / 4) 1 ++ r = r := rfl
    rw [hx2, hr2]
    conv_lhs => rw [hx]
    exact Upos l (x - 1) (1 :: 2 :: r)
  · have h := S_odd3_lemma (fa / 4 - 1) l x r
    have hfa : (fa / 4 - 1) * 4 + 7 = fa := by omega
    have hdiv2 : x + (fa / 4 - 1) * 2 + 1 = x + fa / 2 - 2 := by omega
    have hdiv4 : fa / 4 - 1 + 1 = fa / 4 := by omega
    rw [hfa, hdiv2, hdiv4] at h
    exact h

theorem step_even_1 (fa : Nat) (r : List Nat) (h1 : fa % 2 = 0) (h2 : 2 ≤ fa) :
    ReachesStar target_tm
      (CfgS [] fa (0 :: 1 :: r))
      (CfgS [0, 1] (fa - 1) (0 :: 1 :: 1 :: r)) := by
  have h := S_even_empty_lemma (fa / 2 - 1) 1 r
  have hr1 : (0 :: (List.replicate 1 1 ++ r) : List Nat) = 0 :: 1 :: r := rfl
  have hr2 : (0 :: (List.replicate (1 + 1) 1 ++ r) : List Nat) = 0 :: 1 :: 1 :: r := rfl
  have hfa : (fa / 2 - 1 + 1) * 2 = fa := by omega
  have hfa2 : (fa / 2 - 1) * 2 + 1 = fa - 1 := by omega
  rw [hr1, hr2, hfa, hfa2] at h
  exact h

theorem step_down_nil4 (fa : Nat) (r : List Nat) (h1 : fa % 8 = 4) (h2 : 12 ≤ fa) :
    let arec_0 := fa / 4 - 3
    ReachesStar target_tm
      (CfgS [] fa (0 :: 1 :: r))
      (CfgS [] arec_0 (0 :: 1 :: 2 :: (List.replicate (arec_0 / 2 + 1) 1 ++ 2 :: (List.replicate (arec_0 + 4) 1 ++ r)))) := by
  intro arec_0
  have hev : fa % 2 = 0 := by omega
  have hge2 : 2 ≤ fa := by omega
  refine (step_even_1 fa r hev hge2).trans ?_
  have hodd1 : (fa - 1) % 4 = 3 := by omega
  have hge7_1 : 2 ≤ 0 + (fa - 1) / 2 := by omega
  refine (step_odd3_r [1] 0 (fa - 1) (1 :: 1 :: r) hodd1 hge7_1).trans ?_
  have hrep1 : List.replicate ((fa - 1) / 4) 1 ++ 1 :: 1 :: r = List.replicate (arec_0 + 4) 1 ++ r := by
    have hlen : (fa - 1) / 4 = arec_0 + 2 := by omega
    rw [hlen, rep_snoc, rep_snoc]
    have hadd : 1 + (1 + (arec_0 + 2)) = arec_0 + 4 := by omega
    rw [hadd]
  have ha1 : 0 + (fa - 1) / 2 - 2 = 2 * arec_0 + 3 := by omega
  rw [hrep1, ha1]
  have hodd2 : (2 * arec_0 + 3) % 4 = 3 := by omega
  have hge7_2 : 2 ≤ 1 + (2 * arec_0 + 3) / 2 := by omega
  refine (step_odd3_r [] 1 (2 * arec_0 + 3) (1 :: 2 :: (List.replicate (arec_0 + 4) 1 ++ r)) hodd2 hge7_2).trans ?_
  have hrep2 : List.replicate ((2 * arec_0 + 3) / 4) 1 ++ 1 :: 2 :: (List.replicate (arec_0 + 4) 1 ++ r) =
      List.replicate (arec_0 / 2 + 1) 1 ++ 2 :: (List.replicate (arec_0 + 4) 1 ++ r) := by
    have hlen : (2 * arec_0 + 3) / 4 = arec_0 / 2 := by omega
    rw [hlen, rep_snoc, Nat.add_comm 1 (arec_0 / 2)]
  have ha2 : 1 + (2 * arec_0 + 3) / 2 - 2 = arec_0 := by omega
  rw [hrep2, ha2]; exact ReachesStar.refl _ _

theorem step_leaf_mod4_2 (arec_0 : Nat) (r : List Nat) (h1 : arec_0 % 4 = 2) :
    ReachesStar target_tm
      (CfgS [] arec_0 (0 :: 1 :: r))
      (CfgT [1] (arec_0 + 4) (0 :: r)) := by
  have hev : arec_0 % 2 = 0 := by omega
  have hge2 : 2 ≤ arec_0 := by omega
  refine (step_even_1 arec_0 r hev hge2).trans ?_
  have hodd1 : (arec_0 - 1) % 4 = 1 := by omega
  have hr : (0 :: 1 :: 1 :: r : List Nat) = 0 :: (List.replicate (1 + 1) 1 ++ r) := rfl
  rw [hr]
  refine (step_odd1_r [1] 0 (arec_0 - 1) 1 r hodd1).trans ?_
  have ha : 0 + (arec_0 - 1) + 2 * 1 + 3 = arec_0 + 4 := by omega
  rw [ha]; exact ReachesStar.refl _ _

theorem step_leaf_mod8_0 (arec_0 : Nat) (r : List Nat) (h1 : arec_0 % 8 = 0) (h2 : 8 ≤ arec_0) :
    let ah := arec_0 / 2
    ReachesStar target_tm
      (CfgS [] arec_0 (0 :: 1 :: r))
      (CfgT [ah + 3] (ah + 2) (0 :: r)) := by
  intro ah
  have hev : arec_0 % 2 = 0 := by omega
  have hge2 : 2 ≤ arec_0 := by omega
  refine (step_even_1 arec_0 r hev hge2).trans ?_
  have hodd3 : (arec_0 - 1) % 4 = 3 := by omega
  have hge7 : 2 ≤ 0 + (arec_0 - 1) / 2 := by omega
  refine (step_odd3_r [1] 0 (arec_0 - 1) (1 :: 1 :: r) hodd3 hge7).trans ?_
  have hrep : List.replicate ((arec_0 - 1) / 4) 1 ++ 1 :: 1 :: r = List.replicate (ah / 2 + 1) 1 ++ r := by
    have hlen : (arec_0 - 1) / 4 = ah / 2 - 1 := by omega
    rw [hlen, rep_snoc, rep_snoc]
    have hadd : 1 + (1 + (ah / 2 - 1)) = ah / 2 + 1 := by omega
    rw [hadd]
  have ha1 : 0 + (arec_0 - 1) / 2 - 2 = ah - 3 := by omega
  rw [hrep, ha1]
  have hodd1 : (ah - 3) % 4 = 1 := by omega
  have hr : (0 :: 1 :: 2 :: (List.replicate (ah / 2 + 1) 1 ++ r) : List Nat) =
      0 :: (List.replicate (0 + 1) 1 ++ (2 :: (List.replicate (ah / 2 + 1) 1 ++ r))) := rfl
  rw [hr]
  refine (step_odd1_r [] 1 (ah - 3) 0 (2 :: (List.replicate (ah / 2 + 1) 1 ++ r)) hodd1).trans ?_
  have ha2 : 1 + (ah - 3) + 2 * 0 + 3 = ah + 1 := by omega
  rw [ha2]
  refine (T_21_lemma (ah / 2 + 1) [] (ah + 1) r).trans ?_
  have ha3 : 2 + (ah + 1) = ah + 3 := by omega
  have ha4 : (ah / 2 + 1) * 2 = ah + 2 := by omega
  rw [ha3, ha4]; exact ReachesStar.refl _ _

theorem step_up_nil4 (arec_0 q_top : Nat) (l r : List Nat) (h1 : arec_0 % 2 = 0) (h2 : 2 ≤ q_top) :
    ReachesStar target_tm
      (CfgT l (q_top - 2) (0 :: 2 :: (List.replicate (arec_0 / 2 + 1) 1 ++ 2 :: (List.replicate (arec_0 + 4) 1 ++ r))))
      (CfgT ((arec_0 + 4) :: q_top :: l) (2 * arec_0 + 8) (0 :: r)) := by
  refine (T_21_lemma (arec_0 / 2 + 1) l (q_top - 2) (2 :: (List.replicate (arec_0 + 4) 1 ++ r))).trans ?_
  have hq : 2 + (q_top - 2) = q_top := by omega
  have ha1 : (arec_0 / 2 + 1) * 2 = arec_0 + 2 := by omega
  rw [hq, ha1]
  refine (T_21_lemma (arec_0 + 4) (q_top :: l) (arec_0 + 2) r).trans ?_
  have hp : 2 + (arec_0 + 2) = arec_0 + 4 := by omega
  have ha2 : (arec_0 + 4) * 2 = 2 * arec_0 + 8 := by omega
  rw [hp, ha2]; exact ReachesStar.refl _ _

theorem step_start_loop (arec_0 q_top : Nat) (l : List Nat) (h1 : arec_0 % 2 = 0) (h2 : 2 ≤ q_top) :
    ReachesStar target_tm
      (CfgT l (q_top - 2) (0 :: 2 :: (List.replicate (arec_0 / 2 + 1) 1 ++ 2 :: (List.replicate (arec_0 + 4) 1 ++ []))))
      (CfgS ((q_top + (2 * arec_0 + 10)) :: l) (arec_0 + 3) [0, 1]) := by
  refine (step_up_nil4 arec_0 q_top l [] h1 h2).trans ?_
  have ha1 : 2 * arec_0 + 8 = 1 + (2 * arec_0 + 7) := by omega
  rw [ha1]
  refine (T_end_lemma ((arec_0 + 4) :: q_top :: l) (2 * arec_0 + 7)).trans ?_
  have hodd3 : (2 * arec_0 + 7) % 4 = 3 := by omega
  have hge2 : 2 ≤ (arec_0 + 4) + (2 * arec_0 + 7) / 2 := by omega
  refine (step_odd3_r (q_top :: l) (arec_0 + 4) (2 * arec_0 + 7) [1] hodd3 hge2).trans ?_
  have hrep : List.replicate ((2 * arec_0 + 7) / 4) 1 ++ [1] = List.replicate (arec_0 / 2 + 2) 1 ++ [] := by
    have hlen : (2 * arec_0 + 7) / 4 = arec_0 / 2 + 1 := by omega
    have h1' : ([1] : List Nat) = 1 :: [] := rfl
    rw [hlen, h1', rep_snoc]
    have hadd : 1 + (arec_0 / 2 + 1) = arec_0 / 2 + 2 := by omega
    rw [hadd]
  have ha2 : (arec_0 + 4) + (2 * arec_0 + 7) / 2 - 2 = 2 * arec_0 + 5 := by omega
  rw [hrep, ha2]
  have hodd1 : (2 * arec_0 + 5) % 4 = 1 := by omega
  have hr : (0 :: 1 :: 2 :: (List.replicate (arec_0 / 2 + 2) 1 ++ []) : List Nat) =
      0 :: (List.replicate (0 + 1) 1 ++ (2 :: (List.replicate (arec_0 / 2 + 2) 1 ++ []))) := rfl
  rw [hr]
  refine (step_odd1_r l q_top (2 * arec_0 + 5) 0 (2 :: (List.replicate (arec_0 / 2 + 2) 1 ++ [])) hodd1).trans ?_
  have ha3 : q_top + (2 * arec_0 + 5) + 2 * 0 + 3 = q_top + 2 * arec_0 + 8 := by omega
  rw [ha3]
  refine (T_21_lemma (arec_0 / 2 + 2) l (q_top + 2 * arec_0 + 8) []).trans ?_
  have hq2 : 2 + (q_top + 2 * arec_0 + 8) = q_top + (2 * arec_0 + 10) := by omega
  have ha4 : (arec_0 / 2 + 2) * 2 = 1 + (arec_0 + 3) := by omega
  rw [hq2, ha4]
  exact T_end_lemma ((q_top + (2 * arec_0 + 10)) :: l) (arec_0 + 3)

theorem step_down_cons_r (l : List Nat) (x0 fa : Nat) (r : List Nat) (h1 : fa % 4 = 3) (h2 : 2 ≤ x0 + fa / 2) :
    ReachesStar target_tm
      (CfgS (x0 :: l) fa (0 :: 1 :: r))
      (CfgS l (x0 + fa / 2 - 2) (0 :: 1 :: 2 :: (List.replicate (fa / 4 + 1) 1 ++ r))) := by
  refine (step_odd3_r l x0 fa (1 :: r) h1 h2).trans ?_
  rw [rep_snoc, Nat.add_comm 1 (fa / 4)]
  exact ReachesStar.refl _ _

theorem step_up_cons_r (fa q_top : Nat) (l_in r : List Nat) (h1 : fa % 4 = 3) (h2 : 2 ≤ q_top) :
    ReachesStar target_tm
      (CfgT l_in (q_top - 2) (0 :: 2 :: (List.replicate (fa / 4 + 1) 1 ++ r)))
      (CfgT (q_top :: l_in) (fa / 2 + 1) (0 :: r)) := by
  refine (T_21_lemma (fa / 4 + 1) l_in (q_top - 2) r).trans ?_
  have hq : 2 + (q_top - 2) = q_top := by omega
  have ha : (fa / 4 + 1) * 2 = fa / 2 + 1 := by omega
  rw [hq, ha]; exact ReachesStar.refl _ _

theorem step_up_walk_odd3 (fa q_top : Nat) (l_in : List Nat) (h1 : fa % 4 = 3) (h2 : 2 ≤ q_top) :
    ReachesStar target_tm
      (CfgT l_in (q_top - 2) (0 :: 2 :: (List.replicate (fa / 4 + 1) 1 ++ [])))
      (CfgS (q_top :: l_in) (fa / 2) [0, 1]) := by
  refine (step_up_cons_r fa q_top l_in [] h1 h2).trans ?_
  have ha : fa / 2 + 1 = 1 + fa / 2 := by omega
  rw [ha]
