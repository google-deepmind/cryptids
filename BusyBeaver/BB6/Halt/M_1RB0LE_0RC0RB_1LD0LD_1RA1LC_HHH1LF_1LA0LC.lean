def singleBase (_ _ : Nat) : RuleTrie := RuleTrie.empty

def trieSingleton (rb rs rd rem_b rem_s : Nat) : RuleTrie :=
  Nat.rec singleBase (singleStep rb rs rd) 16 rem_b rem_s

def storePass (rb rs rd : Nat) (c0 c1 c2 c3 : RuleTrie)
    (ih0 ih1 ih2 ih3 : Nat → Nat → RuleTrie) (rem_b rem_s : Nat) : RuleTrie :=
  Bool.rec
    (Bool.rec
      (Bool.rec
        (Bool.rec
          (RuleTrie.pass c0 c1 c2 (ih3 (Nat.div rem_b 4) (Nat.div rem_s 4)))
