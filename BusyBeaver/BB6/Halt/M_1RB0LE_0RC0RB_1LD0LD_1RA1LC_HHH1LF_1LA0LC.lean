theorem val_step_cons_mod3_r (g_f t x0 w_x x1 w_x1 fa w : Nat) (l r : List Nat)
    (hg0 : 0 < g_f) (hg8 : g_f % 8 = 0) (hwx : g_f ∣ w_x) (hwx1 : g_f ∣ w_x1) (hw : g_f ∣ w) (hwh : g_f ∣ (w / 2))
