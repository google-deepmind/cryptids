      (Nat.beq (Nat.mod arec_0 8) 0))
    (fastCompileSome n arec_0 wQtrInit (Nat.add arec_0 6) wQtrInit (LList.cons 1 0 LList.nil))
    (Nat.beq (Nat.mod arec_0 4) 2)

def fastCompile (n : Nat) : CmpRule :=
  Bool.rec
    CmpRule.none
    (fastCompileAux n (Nat.sub (Nat.div n 4) 3))
    (Bool.and (Nat.ble 12 n) (Nat.beq (Nat.mod n 8) 4))

-- Specifications and Proofs

def evalLList (g_f t : Nat) : LList → List Nat
  | .nil => []
  | .cons x w l => val g_f t x w :: evalLList g_f t l

def LList.weightSum : LList → Nat
  | .nil => 0
  | .cons _ w l => w + l.weightSum

def LList.AllDvd (g : Nat) : LList → Prop
  | .nil => True
  | .cons _ w l => g ∣ w ∧ l.AllDvd g

def LList.LastOdd : LList → Nat → Prop
  | .nil, x0 => x0 % 2 = 1
  | .cons x1 _ l, x0 => x0 % 2 = 0 ∧ l.LastOdd x1

theorem LList.AllDvd_mono {g1 g2 : Nat} {l : LList} (h : g1 ∣ g2) (hl : l.AllDvd g2) : l.AllDvd g1 := by
  induction l with
  | nil => trivial
  | cons x w l ih => exact ⟨Nat.dvd_trans h hl.1, ih hl.2⟩

theorem LList.LastOdd_add_even (l : LList) (x d : Nat) (h1 : l.LastOdd x) (h2 : d % 2 = 0) :
    l.LastOdd (x + d) := by
  cases l with
  | nil => dsimp [LList.LastOdd] at h1 ⊢; omega
  | cons x1 w1 l2 =>
    rcases h1 with ⟨h1a, h1b⟩
    exact ⟨by omega, h1b⟩

@[simp] theorem nat_add_eq (a b : Nat) : Nat.add a b = a + b := rfl
@[simp] theorem nat_sub_eq (a b : Nat) : Nat.sub a b = a - b := rfl
@[simp] theorem nat_mul_eq (a b : Nat) : Nat.mul a b = a * b := rfl
@[simp] theorem nat_div_eq (a b : Nat) : Nat.div a b = a / b := rfl
@[simp] theorem nat_mod_eq (a b : Nat) : Nat.mod a b = a % b := rfl

theorem excNil4_zero (fa w g : Nat) : excNil4 0 fa w g = .none := rfl
theorem excNil4_succ (fuel fa w g : Nat) :
    excNil4 (fuel + 1) fa w g = excNil4Step fuel (excNil4 fuel) fa w g := rfl
theorem excCons_nil (x0_0 w_x fa w g : Nat) :
    excCons .nil x0_0 w_x fa w g = excConsNil x0_0 w_x fa w g := rfl
theorem excCons_cons (x1_0 w_x1 : Nat) (l_rest2 : LList) (x0_0 w_x fa w g : Nat) :
    excCons (.cons x1_0 w_x1 l_rest2) x0_0 w_x fa w g =
      excConsStep x1_0 w_x1 l_rest2 (excCons l_rest2) x0_0 w_x fa w g := rfl

def InnRes.NilValid (g_f t fa w g : Nat) : InnRes → Prop
  | .none => True
  | .some g_out q_top w_qtop l_in =>
      g_out ∣ g ∧
      fa % 2 = 0 ∧
      2 ≤ q_top ∧
      l_in.LastOdd q_top ∧
      (0 < g_f → g_f % 8 = 0 → g_f ∣ w → g_f ∣ g_out →
        g_f ∣ w_qtop ∧
        l_in.AllDvd g_f ∧
        w_qtop + l_in.weightSum = w ∧
        ∀ r, ReachesStar target_tm
          (CfgS [] (val g_f t fa w) (0 :: 1 :: r))
          (CfgT (evalLList g_f t l_in) (val g_f t q_top w_qtop - 2) (0 :: r)))

theorem dvd_of_eq_mul (g a b k : Nat) (h : a = k * b) (hb : g ∣ b) : g ∣ a := by
  rcases hb with ⟨m, rfl⟩
  refine ⟨k * m, ?_⟩
  rw [h]; ring

theorem excNil4_spec (g_f t fuel fa w g : Nat) :
    InnRes.NilValid g_f t fa w g (excNil4 fuel fa w g) := by
  induction fuel generalizing fa w g with
  | zero => trivial
  | succ fuel ih =>
    rw [excNil4_succ]
    dsimp only [excNil4Step, nat_add_eq, nat_sub_eq, nat_mul_eq, nat_div_eq, nat_mod_eq]
    cases hcond : Bool.and (Nat.ble 12 fa) (Nat.beq (fa % 8) 4) <;> dsimp only [Bool.rec]
    · trivial
    · rcases Bool.and_eq_true_iff.mp hcond with ⟨hc1, hc2⟩
      have hfa12 : 12 ≤ fa := Nat.le_of_ble_eq_true hc1
      have hfa8 : fa % 8 = 4 := Nat.eq_of_beq_eq_true hc2
      dsimp only [excNil4StepAux1, excNil4StepAux2, nat_add_eq, nat_sub_eq, nat_mul_eq, nat_div_eq, nat_mod_eq]
      cases hm4 : Nat.beq ((fa / 4 - 3) % 4) 2 <;> dsimp only [Bool.rec]
      · cases hm8 : Nat.beq ((fa / 4 - 3) % 8) 0 <;> dsimp only [Bool.rec]
        · have hih := ih (fa / 4 - 3) (w / 2 / 2) (Nat.gcd g (w / 2 / 2))
          cases hres : excNil4 fuel (fa / 4 - 3) (w / 2 / 2) (Nat.gcd g (w / 2 / 2)) with
          | none =>
            dsimp only [excNilRecWrap, InnRes.rec, InnRes.NilValid]
          | some g_out q_top w_qtop l_inner =>
            rw [hres] at hih
            dsimp only [excNilRecWrap, InnRes.rec, excNilRecWrapSome, InnRes.NilValid]
            rcases hih with ⟨hg_dvd, harec2, hq2, hlo, hih_imp⟩
            rcases Nat.dvd_gcd_iff.mp hg_dvd with ⟨hgo_g, hgo_wq⟩
            refine ⟨hgo_g, by omega, by omega, ⟨by omega, by omega, hlo⟩, ?_⟩
            intro hg0 hg8 hw hgout
            have hwq : g_f ∣ (w / 2 / 2) := Nat.dvd_trans hgout hgo_wq
            have hwh : g_f ∣ (w / 2) := dvd_half_of_dvd_qtr g_f w hg8 hw (by rw [← div_2_2_eq_div_4]; exact hwq)
            rcases hih_imp hg0 hg8 hwq hgout with ⟨hwqt, hall, hsum, hreach⟩
            have hw8 := dvd_eight_of_dvd g_f w hg8 hw
            refine ⟨hwh, ⟨hwq, hwqt, hall⟩, ?_, ?_⟩
            · dsimp [LList.weightSum]; omega
            · intro r
              refine (val_step_down_nil4 g_f t fa w r hg0 hg8 hw hwq hfa8 hfa12).trans ?_
              refine (hreach _).trans ?_
              exact val_step_up_nil4 g_f t (fa / 4 - 3) (w / 2) q_top w_qtop (evalLList g_f t l_inner) r
                hg0 hg8 hwh hwq harec2 hq2
        · have harec8 : (fa / 4 - 3) % 8 = 0 := Nat.eq_of_beq_eq_true hm8
          dsimp only [excNil4Leaf8, nat_add_eq, nat_sub_eq, nat_mul_eq, nat_div_eq, nat_mod_eq]
          cases hge8 : Nat.ble 8 (fa / 4 - 3) <;> dsimp only [Bool.rec]
          · trivial
          · have harec_ge8 : 8 ≤ fa / 4 - 3 := Nat.le_of_ble_eq_true hge8
            dsimp only [excNil4Leaf8Aux, InnRes.NilValid, nat_add_eq, nat_sub_eq, nat_mul_eq, nat_div_eq, nat_mod_eq]
            refine ⟨Nat.gcd_dvd_left _ _, by omega, by omega, ?_, ?_⟩
            · dsimp [LList.LastOdd]; omega
            · intro hg0 hg8 hw hgout
              have hwqh : g_f ∣ (w / 2 / 2 / 2) := (Nat.dvd_gcd_iff.mp hgout).2
              have hw8 := dvd_eight_of_dvd g_f w hg8 hw
              have hwq : g_f ∣ (w / 2 / 2) := dvd_of_eq_mul g_f (w / 2 / 2) (w / 2 / 2 / 2) 2 (by omega) hwqh
              have hwh : g_f ∣ (w / 2) := dvd_of_eq_mul g_f (w / 2) (w / 2 / 2 / 2) 4 (by omega) hwqh
              refine ⟨hwh, ⟨hwq, hwqh, hwqh, trivial⟩, ?_, ?_⟩
              · dsimp [LList.weightSum]; omega
              · intro r
                refine (val_step_down_nil4 g_f t fa w r hg0 hg8 hw hwq hfa8 hfa12).trans ?_
                refine (val_step_leaf_mod8_0 g_f t (fa / 4 - 3) (w / 2 / 2) _ hg0 hg8 hwq hwqh harec8 harec_ge8).trans ?_
                exact val_step_up_nil4 g_f t (fa / 4 - 3) (w / 2) ((fa / 4 - 3) / 2 + 4) (w / 2 / 2 / 2)
                  [val g_f t ((fa / 4 - 3) / 2 + 3) (w / 2 / 2 / 2)] r
                  hg0 hg8 hwh hwq (by omega) (by omega)
      · have harec4 : (fa / 4 - 3) % 4 = 2 := Nat.eq_of_beq_eq_true hm4
        dsimp only [InnRes.NilValid, nat_add_eq, nat_sub_eq, nat_mul_eq, nat_div_eq, nat_mod_eq]
        refine ⟨Nat.gcd_dvd_left _ _, by omega, by omega, ?_, ?_⟩
        · dsimp [LList.LastOdd]; omega
        · intro hg0 hg8 hw hgout
          have hwq : g_f ∣ (w / 2 / 2) := (Nat.dvd_gcd_iff.mp hgout).2
          have hwh : g_f ∣ (w / 2) := dvd_half_of_dvd_qtr g_f w hg8 hw (by rw [← div_2_2_eq_div_4]; exact hwq)
          have hw8 := dvd_eight_of_dvd g_f w hg8 hw
          refine ⟨hwh, ⟨hwq, hwq, Nat.dvd_zero g_f, trivial⟩, ?_, ?_⟩
          · dsimp [LList.weightSum]; omega
          · intro r
            refine (val_step_down_nil4 g_f t fa w r hg0 hg8 hw hwq hfa8 hfa12).trans ?_
            refine (val_step_leaf_mod4_2 g_f t (fa / 4 - 3) (w / 2 / 2) _ harec4).trans ?_
            exact val_step_up_nil4 g_f t (fa / 4 - 3) (w / 2) (fa / 4 - 3 + 6) (w / 2 / 2)
              [val g_f t 1 0] r hg0 hg8 hwh hwq (by omega) (by omega)

def InnRes.ConsValid (g_f t : Nat) (l_rest : LList) (x0_0 w_x fa w g : Nat) : InnRes → Prop
  | .none => True
  | .some g_out q_top w_qtop l_in =>
      g_out ∣ g ∧
      2 ≤ q_top ∧
      l_in.LastOdd q_top ∧
      (0 < g_f → g_f % 8 = 0 → g_f ∣ w_x → l_rest.AllDvd g_f → g_f ∣ w → g_f ∣ g_out →
        g_f ∣ w_qtop ∧
        l_in.AllDvd g_f ∧
        w_qtop + l_in.weightSum = w_x + l_rest.weightSum + w ∧
        ∀ r, ReachesStar target_tm
          (CfgS (evalLList g_f t (LList.cons x0_0 w_x l_rest)) (val g_f t fa w) (0 :: 1 :: r))
          (CfgT (evalLList g_f t l_in) (val g_f t q_top w_qtop - 2) (0 :: r)))

theorem excCons_spec (g_f t : Nat) (l_rest : LList) (x0_0 w_x fa w g : Nat)
    (hfa : fa % 4 = 3) (hlo : l_rest.LastOdd x0_0) :
    InnRes.ConsValid g_f t l_rest x0_0 w_x fa w g (excCons l_rest x0_0 w_x fa w g) := by
  induction l_rest generalizing x0_0 w_x fa w g with
  | nil =>
    have hx0 : x0_0 % 2 = 1 := hlo
    rw [excCons_nil]
    dsimp only [excConsNil, excConsNilAux, excConsNilBody1, nat_add_eq, nat_sub_eq, nat_mul_eq, nat_div_eq, nat_mod_eq]
    cases hge2 : Nat.ble 2 (x0_0 + fa / 2) <;> dsimp only [Bool.rec]
    · trivial
    · have hx2n1_ge2 : 2 ≤ x0_0 + fa / 2 := Nat.le_of_ble_eq_true hge2
      dsimp only [excConsNilBody2, nat_add_eq, nat_sub_eq, nat_mul_eq, nat_div_eq, nat_mod_eq]
      cases hm4 : Nat.beq ((x0_0 + fa / 2 - 2) % 4) 2 <;> dsimp only [Bool.rec]
      · cases hm8 : Nat.beq ((x0_0 + fa / 2 - 2) % 8) 0 <;> dsimp only [Bool.rec]
        · have hnil := excNil4_spec g_f t 20 (x0_0 + fa / 2 - 2) (w_x + w / 2) (Nat.gcd g (w / 2))
          cases hres : excNil4 20 (x0_0 + fa / 2 - 2) (w_x + w / 2) (Nat.gcd g (w / 2)) with
          | none =>
            dsimp only [excConsWrap, InnRes.rec, InnRes.ConsValid]
          | some g_out q_top w_qtop l_inner =>
            rw [hres] at hnil
            dsimp only [excConsWrap, InnRes.rec, excConsWrapSome, InnRes.ConsValid]
            rcases hnil with ⟨hg_dvd, _, hq2, hlo_in, hnil_imp⟩
            rcases Nat.dvd_gcd_iff.mp hg_dvd with ⟨hgo_g, hgo_wh⟩
            refine ⟨hgo_g, by omega, ⟨by omega, hlo_in⟩, ?_⟩
            intro hg0 hg8 hwx _ hw hgout
            have hwh : g_f ∣ (w / 2) := Nat.dvd_trans hgout hgo_wh
            have hwrec : g_f ∣ (w_x + w / 2) := Nat.dvd_add hwx hwh
            rcases hnil_imp hg0 hg8 hwrec hgout with ⟨hwqt, hall, hsum, hreach⟩
            have hw8 := dvd_eight_of_dvd g_f w hg8 hw
            refine ⟨hwh, ⟨hwqt, hall⟩, ?_, ?_⟩
            · dsimp [LList.weightSum]; omega
            · intro r
              refine (val_step_down_cons_r g_f t x0_0 w_x fa w [] r hg0 hg8 hwx hw hwh hfa hx2n1_ge2).trans ?_
              refine (hreach _).trans ?_
              exact val_step_up_cons_r g_f t fa w q_top w_qtop (evalLList g_f t l_inner) r hg0 hg8 hw hwh hfa hq2
        · have harec8 : (x0_0 + fa / 2 - 2) % 8 = 0 := Nat.eq_of_beq_eq_true hm8
          dsimp only [excConsNilLeaf8, nat_add_eq, nat_sub_eq, nat_mul_eq, nat_div_eq, nat_mod_eq]
          cases hge8 : Nat.ble 8 (x0_0 + fa / 2 - 2) <;> dsimp only [Bool.rec]
          · trivial
          · have harec_ge8 : 8 ≤ x0_0 + fa / 2 - 2 := Nat.le_of_ble_eq_true hge8
            dsimp only [excConsNilLeaf8Aux, InnRes.ConsValid, nat_add_eq, nat_sub_eq, nat_mul_eq, nat_div_eq, nat_mod_eq]
            have hg_dvd : Nat.gcd (Nat.gcd g (w / 2)) ((w_x + w / 2) / 2) ∣ g :=
              Nat.dvd_trans (Nat.gcd_dvd_left _ _) (Nat.gcd_dvd_left _ _)
            refine ⟨hg_dvd, by omega, ?_, ?_⟩
            · dsimp [LList.LastOdd]; omega
            · intro hg0 hg8 hwx _ hw hgout
              rcases Nat.dvd_gcd_iff.mp hgout with ⟨hg1, hwrh⟩
              have hwh : g_f ∣ (w / 2) := (Nat.dvd_gcd_iff.mp hg1).2
              have hwrec : g_f ∣ (w_x + w / 2) := Nat.dvd_add hwx hwh
              have hw8 := dvd_eight_of_dvd g_f w hg8 hw
              have hwrec8 := dvd_eight_of_dvd g_f (w_x + w / 2) hg8 hwrec
              refine ⟨hwh, ⟨hwrh, hwrh, trivial⟩, ?_, ?_⟩
              · dsimp [LList.weightSum]; omega
              · intro r
                refine (val_step_down_cons_r g_f t x0_0 w_x fa w [] r hg0 hg8 hwx hw hwh hfa hx2n1_ge2).trans ?_
                refine (val_step_leaf_mod8_0 g_f t (x0_0 + fa / 2 - 2) (w_x + w / 2) _ hg0 hg8 hwrec hwrh harec8 harec_ge8).trans ?_
                exact val_step_up_cons_r g_f t fa w ((x0_0 + fa / 2 - 2) / 2 + 4) ((w_x + w / 2) / 2)
                  [val g_f t ((x0_0 + fa / 2 - 2) / 2 + 3) ((w_x + w / 2) / 2)] r
                  hg0 hg8 hw hwh hfa (by omega)
      · have harec4 : (x0_0 + fa / 2 - 2) % 4 = 2 := Nat.eq_of_beq_eq_true hm4
        dsimp only [InnRes.ConsValid, nat_add_eq, nat_sub_eq, nat_mul_eq, nat_div_eq, nat_mod_eq]
        refine ⟨Nat.gcd_dvd_left _ _, by omega, ?_, ?_⟩
        · dsimp [LList.LastOdd]; omega
        · intro hg0 hg8 hwx _ hw hgout
          have hwh : g_f ∣ (w / 2) := (Nat.dvd_gcd_iff.mp hgout).2
          have hwrec : g_f ∣ (w_x + w / 2) := Nat.dvd_add hwx hwh
          have hw8 := dvd_eight_of_dvd g_f w hg8 hw
          refine ⟨hwh, ⟨hwrec, Nat.dvd_zero g_f, trivial⟩, ?_, ?_⟩
          · dsimp [LList.weightSum]; omega
          · intro r
            refine (val_step_down_cons_r g_f t x0_0 w_x fa w [] r hg0 hg8 hwx hw hwh hfa hx2n1_ge2).trans ?_
            refine (val_step_leaf_mod4_2 g_f t (x0_0 + fa / 2 - 2) (w_x + w / 2) _ harec4).trans ?_
            exact val_step_up_cons_r g_f t fa w (x0_0 + fa / 2 - 2 + 6) (w_x + w / 2)
              [val g_f t 1 0] r hg0 hg8 hw hwh hfa (by omega)
  | cons x1_0 w_x1 l_rest2 ih =>
    rcases hlo with ⟨hx0, hlo2⟩
    rw [excCons_cons]
    dsimp only [excConsStep, excConsStepAux1, excConsStepAux2, nat_add_eq, nat_sub_eq, nat_mul_eq, nat_div_eq, nat_mod_eq]
    cases hm3 : Nat.beq ((x0_0 + fa / 2) % 4) 3 <;> dsimp only [Bool.rec]
    · cases hge5 : Nat.ble 5 (x0_0 + fa / 2) <;> dsimp only [Bool.rec]
      · trivial
      · have hx2n1_ge5 : 5 ≤ x0_0 + fa / 2 := Nat.le_of_ble_eq_true hge5
        have hx2n1_ne3 : (x0_0 + fa / 2) % 4 ≠ 3 := Nat.ne_of_beq_eq_false hm3
        have hfa_sub : (x0_0 + fa / 2 - 2) % 4 = 3 := by omega
        have hih := ih x1_0 w_x1 (x0_0 + fa / 2 - 2) (w_x + w / 2) (Nat.gcd g (w / 2)) hfa_sub hlo2
        cases hres : excCons l_rest2 x1_0 w_x1 (x0_0 + fa / 2 - 2) (w_x + w / 2) (Nat.gcd g (w / 2)) with
        | none =>
          dsimp only [excConsWrap, InnRes.rec, InnRes.ConsValid]
        | some g_out q_top w_qtop l_inner =>
          rw [hres] at hih
          dsimp only [excConsWrap, InnRes.rec, excConsWrapSome, InnRes.ConsValid]
          rcases hih with ⟨hg_dvd, hq2, hlo_in, hih_imp⟩
          rcases Nat.dvd_gcd_iff.mp hg_dvd with ⟨hgo_g, hgo_wh⟩
          refine ⟨hgo_g, by omega, ⟨by omega, hlo_in⟩, ?_⟩
          intro hg0 hg8 hwx hl_dvd hw hgout
          have hwh : g_f ∣ (w / 2) := Nat.dvd_trans hgout hgo_wh
          have hwrec : g_f ∣ (w_x + w / 2) := Nat.dvd_add hwx hwh
          rcases hih_imp hg0 hg8 hl_dvd.1 hl_dvd.2 hwrec hgout with ⟨hwqt, hall, hsum, hreach⟩
          have hw8 := dvd_eight_of_dvd g_f w hg8 hw
          refine ⟨hwh, ⟨hwqt, hall⟩, ?_, ?_⟩
          · dsimp [LList.weightSum] at hsum ⊢; omega
          · intro r
            refine (val_step_down_cons_r g_f t x0_0 w_x fa w (evalLList g_f t (LList.cons x1_0 w_x1 l_rest2)) r
              hg0 hg8 hwx hw hwh hfa (by omega)).trans ?_
            refine (hreach _).trans ?_
            exact val_step_up_cons_r g_f t fa w q_top w_qtop (evalLList g_f t l_inner) r hg0 hg8 hw hwh hfa hq2
    · have hx2n1_3 : (x0_0 + fa / 2) % 4 = 3 := Nat.eq_of_beq_eq_true hm3
      dsimp only [InnRes.ConsValid, nat_add_eq, nat_sub_eq, nat_mul_eq, nat_div_eq, nat_mod_eq]
      refine ⟨Nat.gcd_dvd_left _ _, by omega, ⟨by omega, LList.LastOdd_add_even l_rest2 x1_0 (x0_0 + fa / 2 + 3) hlo2 (by omega)⟩, ?_⟩
      intro hg0 hg8 hwx hl_dvd hw hgout
      have hwh : g_f ∣ (w / 2) := (Nat.dvd_gcd_iff.mp hgout).2
      have hw8 := dvd_eight_of_dvd g_f w hg8 hw
      refine ⟨hwh, ⟨Nat.dvd_add hl_dvd.1 (Nat.dvd_add hwx hwh), hl_dvd.2⟩, ?_, ?_⟩
      · dsimp [LList.weightSum]; omega
      · intro r
        exact val_step_cons_mod3_r g_f t x0_0 w_x x1_0 w_x1 fa w (evalLList g_f t l_rest2) r
          hg0 hg8 hwx hl_dvd.1 hw hwh hfa hx2n1_3

def walk (n_orig : Nat) (ih : Nat → Nat → LList → Nat → Nat → Nat → CmpRule)
    (l_rest : LList) (x0_0 w_x fa w g : Nat) : CmpRule :=
  LList.rec (walkNil n_orig) (walkCons ih) l_rest x0_0 w_x fa w g

theorem compileLoop_zero (n_orig x0_0 w_x : Nat) (l_rest : LList) (fa w g : Nat) :
    compileLoop 0 n_orig x0_0 w_x l_rest fa w g = .none := rfl

theorem compileLoop_succ (fuel n_orig x0_0 w_x : Nat) (l_rest : LList) (fa w g : Nat) :
    compileLoop (fuel + 1) n_orig x0_0 w_x l_rest fa w g =
      walk n_orig (compileLoop fuel n_orig) l_rest x0_0 w_x fa w g := rfl

theorem walk_nil (n_orig : Nat) (ih : Nat → Nat → LList → Nat → Nat → Nat → CmpRule)
    (x0_0 w_x fa w g : Nat) :
    walk n_orig ih .nil x0_0 w_x fa w g = walkNil n_orig x0_0 w_x fa w g := rfl

theorem walk_cons (n_orig : Nat) (ih : Nat → Nat → LList → Nat → Nat → Nat → CmpRule)
    (x1_0 w_x1 : Nat) (l_rest2 : LList) (x0_0 w_x fa w g : Nat) :
    walk n_orig ih (.cons x1_0 w_x1 l_rest2) x0_0 w_x fa w g =
      walkCons ih x1_0 w_x1 l_rest2 (walk n_orig ih l_rest2) x0_0 w_x fa w g := rfl

def CmpRule.LoopValid (n_orig x0_0 w_x : Nat) (l_rest : LList) (fa w g : Nat) : CmpRule → Prop
  | .none => True
  | .some rs rd =>
      ∃ g_f,
        8 ≤ g_f ∧
        g_f % 8 = 0 ∧
        g_f ∣ g ∧
        rs = sInit4 / g_f ∧
        (∀ t, g_f ∣ wHalfInit → g_f ∣ w_x → l_rest.AllDvd g_f → g_f ∣ w →
          w_x + l_rest.weightSum + w = sInit →
          ReachesStar target_tm
            (CfgS (evalLList g_f t (LList.cons x0_0 w_x l_rest)) (val g_f t fa w) [0, 1])
            (Cn (n_orig + rd + rs * t)))

theorem val_finish_even (g t n_orig fa_f : Nat)
    (hg8_le : 8 ≤ g) (hg8 : g % 8 = 0) (hwh_init : g ∣ wHalfInit)
    (hge_n : n_orig + 1 ≤ fa_f) (hn12 : 12 ≤ n_orig) (hfaf2 : fa_f % 2 = 0) :
    ReachesStar target_tm
      (CfgS [] (val g t fa_f sInit) [0, 1])
      (Cn (n_orig + (fa_f + 6 * (((fa_f - 4) / 2) % 4) - n_orig) + (sInit4 / g) * t)) := by
  have hg0 : 0 < g := by omega
  have hsinit : g ∣ sInit := dvd_of_eq_mul g sInit wHalfInit 2 rfl hwh_init
  have hsinit2 : g ∣ (sInit / 2) := hwh_init
  have hmod8 : (val g t fa_f sInit) % 8 = fa_f % 8 := val_mod8 g t fa_f sInit hg0 hg8 hsinit hsinit2
  have hge_val : fa_f ≤ val g t fa_f sInit := val_ge g t fa_f sInit
  have hval_even : (val g t fa_f sInit) % 2 = 0 := by omega
  have hval_ge6 : 6 ≤ val g t fa_f sInit := by omega
  have h := finish_even_spec (val g t fa_f sInit) hval_even hval_ge6
  have hrem : (((val g t fa_f sInit) - 4) / 2) % 4 = ((fa_f - 4) / 2) % 4 := by omega
  rcases hsinit with ⟨k, hk⟩
  have hs4 : sInit4 = g * (4 * k) := by
    have : sInit4 = 4 * sInit := rfl
    rw [this, hk]; ring
  have hdiv1 : sInit / g = k := by rw [hk, Nat.mul_div_right _ hg0]
  have hdiv4 : sInit4 / g = 4 * k := by rw [hs4, Nat.mul_div_right _ hg0]
  have h4kt : 4 * ((sInit / g) * t) = (sInit4 / g) * t := by
    rw [hdiv1, hdiv4]; ring
  have htarget : val g t fa_f sInit + 6 * ((((val g t fa_f sInit) - 4) / 2) % 4) =
      n_orig + (fa_f + 6 * (((fa_f - 4) / 2) % 4) - n_orig) + (sInit4 / g) * t := by
    rw [hrem]
    dsimp [val]
    omega
  rw [htarget] at h
  exact h

theorem walk_spec (n_orig : Nat) (ih : Nat → Nat → LList → Nat → Nat → Nat → CmpRule)
    (hih_compile : ∀ x0_0 w_x l_rest fa w g, l_rest.LastOdd x0_0 →
      CmpRule.LoopValid n_orig x0_0 w_x l_rest fa w g (ih x0_0 w_x l_rest fa w g))
    (hn12 : 12 ≤ n_orig)
    (l_rest : LList) (x0_0 w_x fa w g : Nat) (hlo : l_rest.LastOdd x0_0) :
    CmpRule.LoopValid n_orig x0_0 w_x l_rest fa w g (walk n_orig ih l_rest x0_0 w_x fa w g) := by
  induction l_rest generalizing x0_0 w_x fa w g with
  | nil =>
    have hx0 : x0_0 % 2 = 1 := hlo
    rw [walk_nil]
    dsimp only [walkNil, nat_add_eq, nat_sub_eq, nat_mul_eq, nat_div_eq, nat_mod_eq]
    cases hm1 : Nat.beq (fa % 4) 1 <;> dsimp only [Bool.rec]
    · trivial
    · have hfa1 : fa % 4 = 1 := Nat.eq_of_beq_eq_true hm1
      dsimp only [finishRule, nat_add_eq, nat_sub_eq, nat_mul_eq, nat_div_eq, nat_mod_eq]
      cases hcond : Bool.and (Nat.ble (n_orig + 1) (x0_0 + (fa + 2))) (Bool.and (Nat.ble 8 g) (Nat.beq (g % 8) 0)) <;>
        dsimp only [Bool.rec]
      · trivial
      · dsimp only [CmpRule.LoopValid]
        rcases Bool.and_eq_true_iff.mp hcond with ⟨hc1, hc23⟩
        rcases Bool.and_eq_true_iff.mp hc23 with ⟨hc2, hc3⟩
        have hge_n : n_orig + 1 ≤ x0_0 + (fa + 2) := Nat.le_of_ble_eq_true hc1
        have hg8_le : 8 ≤ g := Nat.le_of_ble_eq_true hc2
        have hg8 : g % 8 = 0 := Nat.eq_of_beq_eq_true hc3
        refine ⟨g, hg8_le, hg8, Nat.dvd_refl g, rfl, ?_⟩
        intro t hwh_init hwx _ hw hsum
        have hg0 : 0 < g := by omega
        have hwsum : w_x + w = sInit := by dsimp [LList.weightSum] at hsum; omega
        refine (val_step_odd1_end g t x0_0 w_x fa w [] hg0 hwx hw hfa1).trans ?_
        rw [hwsum]
        exact val_finish_even g t n_orig (x0_0 + (fa + 2)) hg8_le hg8 hwh_init hge_n hn12 (by omega)
  | cons x1_0 w_x1 l_rest2 ih_walk =>
    rcases hlo with ⟨hx0, hlo2⟩
    rw [walk_cons]
    dsimp only [walkCons, nat_add_eq, nat_sub_eq, nat_mul_eq, nat_div_eq, nat_mod_eq]
    cases hm1 : Nat.beq (fa % 4) 1 <;> dsimp only [Bool.rec]
    · cases hm3 : Nat.beq (fa % 4) 3 <;> dsimp only [Bool.rec]
      · trivial
      · have hfa3 : fa % 4 = 3 := Nat.eq_of_beq_eq_true hm3
        dsimp only [walkConsOdd3, walkConsOdd3Aux1, walkConsOdd3Aux2, nat_add_eq, nat_sub_eq, nat_mul_eq, nat_div_eq, nat_mod_eq]
        cases hx3 : Nat.beq ((x0_0 + fa / 2) % 4) 3 <;> dsimp only [Bool.rec]
        · cases hge5 : Nat.ble 5 (x0_0 + fa / 2) <;> dsimp only [Bool.rec]
          · trivial
          · have hx2n1_ge5 : 5 ≤ x0_0 + fa / 2 := Nat.le_of_ble_eq_true hge5
            have hx2n1_ne3 : (x0_0 + fa / 2) % 4 ≠ 3 := Nat.ne_of_beq_eq_false hx3
            have hfa_sub : (x0_0 + fa / 2 - 2) % 4 = 3 := by omega
            have hexc0 := excCons_spec 0 0 l_rest2 x1_0 w_x1 (x0_0 + fa / 2 - 2) (w_x + w / 2) (Nat.gcd g (w / 2)) hfa_sub hlo2
            cases hexc : excCons l_rest2 x1_0 w_x1 (x0_0 + fa / 2 - 2) (w_x + w / 2) (Nat.gcd g (w / 2)) with
            | none =>
              dsimp only [InnRes.rec, CmpRule.LoopValid]
            | some g_out q_top w_qtop l_inner =>
              rw [hexc] at hexc0
              rcases hexc0 with ⟨hg_dvd, hq2, hlo_in, _⟩
              dsimp only [InnRes.rec, walkCallUnified]
              have hcomp := hih_compile q_top w_qtop l_inner (fa / 2) (w / 2) g_out hlo_in
              cases hres : ih q_top w_qtop l_inner (fa / 2) (w / 2) g_out with
              | none =>
                dsimp only [CmpRule.LoopValid]
              | some rs rd =>
                rw [hres] at hcomp
                rcases hcomp with ⟨g_f, hg8_le, hg8, hgf_gout, hrs, hcomp_imp⟩
                have hgf_g1 : g_f ∣ Nat.gcd g (w / 2) := Nat.dvd_trans hgf_gout hg_dvd
                rcases Nat.dvd_gcd_iff.mp hgf_g1 with ⟨hgf_g, hwh⟩
                refine ⟨g_f, hg8_le, hg8, hgf_g, hrs, ?_⟩
                intro t hwh_init hwx hl_dvd hw hsum
                have hg0 : 0 < g_f := by omega
                have hw8 := dvd_eight_of_dvd g_f w hg8 hw
                have hwrec : g_f ∣ (w_x + w / 2) := Nat.dvd_add hwx hwh
                have hexc_t := excCons_spec g_f t l_rest2 x1_0 w_x1 (x0_0 + fa / 2 - 2) (w_x + w / 2) (Nat.gcd g (w / 2)) hfa_sub hlo2
                rw [hexc] at hexc_t
                rcases hexc_t.2.2.2 hg0 hg8 hl_dvd.1 hl_dvd.2 hwrec hgf_gout with ⟨hwqt, hall_in, hsum_in, hreach_in⟩
                refine (val_step_down_cons_r g_f t x0_0 w_x fa w (evalLList g_f t (LList.cons x1_0 w_x1 l_rest2)) []
                  hg0 hg8 hwx hw hwh hfa3 (by omega)).trans ?_
                refine (hreach_in _).trans ?_
                refine (val_step_up_walk_odd3 g_f t fa w q_top w_qtop (evalLList g_f t l_inner)
                  hg0 hg8 hw hwh hfa3 hq2).trans ?_
                exact hcomp_imp t hwh_init hwqt hall_in hwh (by dsimp [LList.weightSum] at hsum ⊢; omega)
        · have hx2n1_3 : (x0_0 + fa / 2) % 4 = 3 := Nat.eq_of_beq_eq_true hx3
          have hlo_new : l_rest2.LastOdd (x1_0 + (x0_0 + fa / 2 + 3)) :=
            LList.LastOdd_add_even l_rest2 x1_0 (x0_0 + fa / 2 + 3) hlo2 (by omega)
          have hwk := ih_walk (x1_0 + (x0_0 + fa / 2 + 3)) (w_x1 + (w_x + w / 2)) (fa / 2) (w / 2) (Nat.gcd g (w / 2)) hlo_new
          cases hres : walk n_orig ih l_rest2 (x1_0 + (x0_0 + fa / 2 + 3)) (w_x1 + (w_x + w / 2)) (fa / 2) (w / 2) (Nat.gcd g (w / 2)) with
          | none =>
            dsimp only [CmpRule.LoopValid]
          | some rs rd =>
            rw [hres] at hwk
            rcases hwk with ⟨g_f, hg8_le, hg8, hgf_g1, hrs, hwk_imp⟩
            rcases Nat.dvd_gcd_iff.mp hgf_g1 with ⟨hgf_g, hwh⟩
            refine ⟨g_f, hg8_le, hg8, hgf_g, hrs, ?_⟩
            intro t hwh_init hwx hl_dvd hw hsum
            have hg0 : 0 < g_f := by omega
            have hw8 := dvd_eight_of_dvd g_f w hg8 hw
            refine (val_step_walk_odd3_mod3 g_f t x0_0 w_x x1_0 w_x1 fa w (evalLList g_f t l_rest2)
              hg0 hg8 hwx hl_dvd.1 hw hwh hfa3 hx2n1_3).trans ?_
            exact hwk_imp t hwh_init (Nat.dvd_add hl_dvd.1 (Nat.dvd_add hwx hwh)) hl_dvd.2 hwh
              (by dsimp [LList.weightSum] at hsum ⊢; omega)
    · have hfa1 : fa % 4 = 1 := Nat.eq_of_beq_eq_true hm1
      have hwk := ih_walk x1_0 w_x1 (x0_0 + (fa + 2)) (w_x + w) g hlo2
      cases hres : walk n_orig ih l_rest2 x1_0 w_x1 (x0_0 + (fa + 2)) (w_x + w) g with
      | none =>
        dsimp only [CmpRule.LoopValid]
      | some rs rd =>
        rw [hres] at hwk
        rcases hwk with ⟨g_f, hg8_le, hg8, hgf_g, hrs, hwk_imp⟩
        refine ⟨g_f, hg8_le, hg8, hgf_g, hrs, ?_⟩
        intro t hwh_init hwx hl_dvd hw hsum
        have hg0 : 0 < g_f := by omega
        refine (val_step_odd1_end g_f t x0_0 w_x fa w (evalLList g_f t (LList.cons x1_0 w_x1 l_rest2))
          hg0 hwx hw hfa1).trans ?_
        exact hwk_imp t hwh_init hl_dvd.1 hl_dvd.2 (Nat.dvd_add hwx hw)
          (by dsimp [LList.weightSum] at hsum ⊢; omega)

theorem compileLoop_spec (fuel n_orig x0_0 w_x : Nat) (l_rest : LList) (fa w g : Nat)
    (hn12 : 12 ≤ n_orig) (hlo : l_rest.LastOdd x0_0) :
    CmpRule.LoopValid n_orig x0_0 w_x l_rest fa w g (compileLoop fuel n_orig x0_0 w_x l_rest fa w g) := by
  induction fuel generalizing x0_0 w_x l_rest fa w g with
  | zero => trivial
  | succ fuel ih =>
    rw [compileLoop_succ]
    exact walk_spec n_orig (compileLoop fuel n_orig)
      (fun x0_0 w_x l_rest fa w g hlo => ih x0_0 w_x l_rest fa w g hlo)
      hn12 l_rest x0_0 w_x fa w g hlo

def CmpRule.Valid (n : Nat) : CmpRule → Prop
  | .none => True
  | .some rs rd => valid n rs rd

theorem fastCompileSome_spec (n arec_0 g_out q_top w_qtop : Nat) (l_inner : LList)
    (hn12 : 12 ≤ n) (hn8 : n % 8 = 4) (harec_eq : arec_0 = n / 4 - 3)
    (hgo_wq : g_out ∣ wQtrInit) (harec2 : arec_0 % 2 = 0) (hq2 : 2 ≤ q_top)
    (hlo : l_inner.LastOdd q_top)
    (hmid : ∀ g_f t, 0 < g_f → g_f % 8 = 0 → g_f ∣ g_out →
      g_f ∣ w_qtop ∧
      l_inner.AllDvd g_f ∧
      w_qtop + l_inner.weightSum = wQtrInit ∧
      ∀ r, ReachesStar target_tm
        (CfgS [] (val g_f t arec_0 wQtrInit) (0 :: 1 :: r))
        (CfgT (evalLList g_f t l_inner) (val g_f t q_top w_qtop - 2) (0 :: r))) :
    CmpRule.Valid n (fastCompileSome n arec_0 g_out q_top w_qtop l_inner) := by
  unfold fastCompileSome
  rw [nat_mul_eq, nat_add_eq, nat_add_eq, nat_add_eq, nat_add_eq]
  have hlo_start : l_inner.LastOdd (q_top + (2 * arec_0 + 10)) :=
    LList.LastOdd_add_even l_inner q_top (2 * arec_0 + 10) hlo (by omega)
  have hloop := compileLoop_spec 40 n (q_top + (2 * arec_0 + 10)) (w_qtop + wHalfInit) l_inner (arec_0 + 3) wQtrInit g_out hn12 hlo_start
  cases hres : compileLoop 40 n (q_top + (2 * arec_0 + 10)) (w_qtop + wHalfInit) l_inner (arec_0 + 3) wQtrInit g_out with
  | none =>
    dsimp only [CmpRule.Valid]
  | some rs rd =>
    rw [hres] at hloop
    dsimp only [CmpRule.Valid, valid]
    rcases hloop with ⟨g_f, hg8_le, hg8, hgf_gout, hrs, hloop_imp⟩
    have hg0 : 0 < g_f := by omega
    have hwQ : g_f ∣ wQtrInit := Nat.dvd_trans hgf_gout hgo_wq
    have hwH : g_f ∣ wHalfInit := dvd_of_eq_mul g_f wHalfInit wQtrInit 2 rfl hwQ
    have hsinit : g_f ∣ sInit := dvd_of_eq_mul g_f sInit wQtrInit 4 rfl hwQ
    intro t
    rcases hmid g_f t hg0 hg8 hgf_gout with ⟨hwqt, hall_in, hsum_in, hreach_mid⟩
    have hval_n : n + rs * t = val g_f t n sInit := by
      rcases hsinit with ⟨k, hk⟩
      have hs4 : sInit4 = g_f * (4 * k) := by
        have : sInit4 = 4 * sInit := rfl
        rw [this, hk]; ring
      have hdiv1 : sInit / g_f = k := by rw [hk, Nat.mul_div_right _ hg0]
      have hdiv4 : sInit4 / g_f = 4 * k := by rw [hs4, Nat.mul_div_right _ hg0]
      dsimp [val]
      rw [hrs, hdiv1, hdiv4]
      ring
    change ReachesStar target_tm (CfgS [] (n + rs * t) [0, 1]) (Cn (n + rd + rs * t))
    rw [hval_n]
    have hdown := val_step_down_nil4 g_f t n sInit [] hg0 hg8 hsinit hwQ hn8 hn12
    dsimp only at hdown
    rw [← harec_eq] at hdown
    have hwq_eq : sInit / 2 / 2 = wQtrInit := rfl
    rw [hwq_eq] at hdown
    refine hdown.trans ?_
    refine (hreach_mid _).trans ?_
    refine (val_step_start_loop g_f t arec_0 wQtrInit wHalfInit q_top w_qtop (evalLList g_f t l_inner)
      hg0 hg8 hwH hwQ hwqt rfl harec2 hq2).trans ?_
    have hsum_tot : (w_qtop + wHalfInit) + l_inner.weightSum + wQtrInit = sInit := by
      have : wHalfInit + wQtrInit + wQtrInit = sInit := rfl
      omega
    exact hloop_imp t hwH (Nat.dvd_add hwqt hwH) hall_in hwQ hsum_tot

theorem fastCompile_spec (n : Nat) : CmpRule.Valid n (fastCompile n) := by
  unfold fastCompile
  rw [nat_div_eq, nat_sub_eq, nat_mod_eq]
  cases hcond : Bool.and (Nat.ble 12 n) (Nat.beq (n % 8) 4) <;> dsimp only [Bool.rec]
  · trivial
  · rcases Bool.and_eq_true_iff.mp hcond with ⟨hc1, hc2⟩
    have hn12 : 12 ≤ n := Nat.le_of_ble_eq_true hc1
    have hn8 : n % 8 = 4 := Nat.eq_of_beq_eq_true hc2
    unfold fastCompileAux
    rw [nat_mod_eq, nat_mod_eq, nat_add_eq]
    cases hm4 : Nat.beq ((n / 4 - 3) % 4) 2 <;> dsimp only [Bool.rec]
    · cases hm8 : Nat.beq ((n / 4 - 3) % 8) 0 <;> dsimp only [Bool.rec]
      · have hnil0 := excNil4_spec 0 0 20 (n / 4 - 3) wQtrInit wQtrInit
        cases hres : excNil4 20 (n / 4 - 3) wQtrInit wQtrInit with
        | none =>
          dsimp only [InnRes.rec, CmpRule.Valid]
        | some g_out q_top w_qtop l_inner =>
          rw [hres] at hnil0
          rcases hnil0 with ⟨hgo_wq, harec2, hq2, hlo, _⟩
          dsimp only [InnRes.rec]
          refine fastCompileSome_spec n (n / 4 - 3) g_out q_top w_qtop l_inner hn12 hn8 rfl hgo_wq harec2 hq2 hlo ?_
          intro g_f t hg0 hg8 hgf_gout
          have hnil_t := excNil4_spec g_f t 20 (n / 4 - 3) wQtrInit wQtrInit
          rw [hres] at hnil_t
          exact hnil_t.2.2.2.2 hg0 hg8 (Nat.dvd_trans hgf_gout hgo_wq) hgf_gout
      · have harec8 : (n / 4 - 3) % 8 = 0 := Nat.eq_of_beq_eq_true hm8
        unfold fastCompileLeaf8
        rw [nat_div_eq]
        cases hge8 : Nat.ble 8 (n / 4 - 3) <;> dsimp only [Bool.rec]
        · trivial
        · have harec_ge8 : 8 ≤ n / 4 - 3 := Nat.le_of_ble_eq_true hge8
          unfold fastCompileLeaf8Aux
          rw [nat_add_eq, nat_add_eq]
          have hw8_wq : wEighthInit ∣ wQtrInit := dvd_of_eq_mul wEighthInit wQtrInit wEighthInit 2 (by decide) (Nat.dvd_refl _)
          refine fastCompileSome_spec n (n / 4 - 3) wEighthInit ((n / 4 - 3) / 2 + 4) wEighthInit
            (LList.cons ((n / 4 - 3) / 2 + 3) wEighthInit LList.nil)
            hn12 hn8 rfl hw8_wq (by omega) (by omega) (by dsimp [LList.LastOdd]; omega) ?_
          intro g_f t hg0 hg8 hgf_w8
          have hwQ : g_f ∣ wQtrInit := Nat.dvd_trans hgf_w8 hw8_wq
          refine ⟨hgf_w8, ⟨hgf_w8, trivial⟩, by dsimp [LList.weightSum]; decide, ?_⟩
          intro r
          exact val_step_leaf_mod8_0 g_f t (n / 4 - 3) wQtrInit r hg0 hg8 hwQ hgf_w8 harec8 harec_ge8
    · have harec4 : (n / 4 - 3) % 4 = 2 := Nat.eq_of_beq_eq_true hm4
      refine fastCompileSome_spec n (n / 4 - 3) wQtrInit (n / 4 - 3 + 6) wQtrInit
        (LList.cons 1 0 LList.nil)
        hn12 hn8 rfl (Nat.dvd_refl _) (by omega) (by omega) (by dsimp [LList.LastOdd]; omega) ?_
      intro g_f t hg0 hg8 hgf_wq
      refine ⟨hgf_wq, ⟨Nat.dvd_zero g_f, trivial⟩, by dsimp [LList.weightSum], ?_⟩
      intro r
      exact val_step_leaf_mod4_2 g_f t (n / 4 - 3) wQtrInit r harec4

-- Fast evaluator for Stage 2 and its soundness proof

inductive NList where
  | nil : NList
  | cons : Nat → NList → NList

def nlistWrap1Some (p_top q_top : Nat) (l_in : NList) (_ : NList) : NList :=
  NList.cons p_top (NList.cons q_top l_in)

def nlistWrap1 (p_top : Nat) (res : NList) : NList :=
  NList.rec NList.nil (nlistWrap1Some p_top) res

def nlistWrap2Some (p_top po_0 q_top : Nat) (l_in : NList) (_ : NList) : NList :=
  NList.cons p_top (NList.cons po_0 (NList.cons q_top l_in))

def nlistWrap2 (p_top po_0 : Nat) (res : NList) : NList :=
  NList.rec NList.nil (nlistWrap2Some p_top po_0) res

def evalNil4Leaf8Aux (p_top po_0 ah : Nat) : NList :=
  NList.cons p_top (NList.cons po_0 (NList.cons (Nat.add ah 4) (NList.cons (Nat.add ah 3) NList.nil)))

def evalNil4Leaf8 (p_top po_0 arec_0 : Nat) : NList :=
  Bool.rec NList.nil (evalNil4Leaf8Aux p_top po_0 (Nat.div arec_0 2)) (Nat.ble 8 arec_0)

def evalNil4StepAux2 (ih : Nat → NList) (arec_0 p_top po_0 : Nat) : NList :=
  Bool.rec
    (Bool.rec
      (nlistWrap2 p_top po_0 (ih arec_0))
      (evalNil4Leaf8 p_top po_0 arec_0)
      (Nat.beq (Nat.mod arec_0 8) 0))
    (NList.cons p_top (NList.cons po_0 (NList.cons (Nat.add arec_0 6) (NList.cons 1 NList.nil))))
    (Nat.beq (Nat.mod arec_0 4) 2)

def evalNil4StepAux1 (ih : Nat → NList) (arec_0 : Nat) : NList :=
  evalNil4StepAux2 ih arec_0 (Nat.add (Nat.mul 2 arec_0) 10) (Nat.add arec_0 4)

def evalNil4Step (_ : Nat) (ih : Nat → NList) (fa : Nat) : NList :=
  Bool.rec
    NList.nil
    (evalNil4StepAux1 ih (Nat.sub (Nat.div fa 4) 3))
    (Bool.and (Nat.ble 12 fa) (Nat.beq (Nat.mod fa 8) 4))

def evalNilBase (_ : Nat) : NList := NList.nil

def evalNil4 (fuel fa : Nat) : NList :=
  Nat.rec evalNilBase evalNil4Step fuel fa

def evalConsNilLeaf8Aux (p_top ah : Nat) : NList :=
  NList.cons p_top (NList.cons (Nat.add ah 4) (NList.cons (Nat.add ah 3) NList.nil))

def evalConsNilLeaf8 (p_top arec_0 : Nat) : NList :=
  Bool.rec NList.nil (evalConsNilLeaf8Aux p_top (Nat.div arec_0 2)) (Nat.ble 8 arec_0)

def evalConsNilBody2 (p_top arec_0 : Nat) : NList :=
  Bool.rec
    (Bool.rec
      (nlistWrap1 p_top (evalNil4 20 arec_0))
      (evalConsNilLeaf8 p_top arec_0)
      (Nat.beq (Nat.mod arec_0 8) 0))
    (NList.cons p_top (NList.cons (Nat.add arec_0 6) (NList.cons 1 NList.nil)))
    (Nat.beq (Nat.mod arec_0 4) 2)

def evalConsNilBody1 (fa_half x2n1 : Nat) : NList :=
  Bool.rec NList.nil (evalConsNilBody2 (Nat.add fa_half 3) (Nat.sub x2n1 2)) (Nat.ble 2 x2n1)

def evalConsNilAux (x0_0 fa_half : Nat) : NList :=
  evalConsNilBody1 fa_half (Nat.add x0_0 fa_half)

def evalConsNil (x0_0 fa : Nat) : NList :=
  evalConsNilAux x0_0 (Nat.div fa 2)

def evalConsStepAux2 (x1_0 : Nat) (l_rest2 : NList) (ih : Nat → Nat → NList) (fa_half x2n1 : Nat) : NList :=
  Bool.rec
    (Bool.rec
      NList.nil
      (nlistWrap1 (Nat.add fa_half 3) (ih x1_0 (Nat.sub x2n1 2)))
      (Nat.ble 5 x2n1))
    (NList.cons (Nat.add fa_half 3) (NList.cons (Nat.add x1_0 (Nat.add x2n1 3)) l_rest2))
    (Nat.beq (Nat.mod x2n1 4) 3)

def evalConsStepAux1 (x1_0 : Nat) (l_rest2 : NList) (ih : Nat → Nat → NList) (x0_0 fa_half : Nat) : NList :=
  evalConsStepAux2 x1_0 l_rest2 ih fa_half (Nat.add x0_0 fa_half)

def evalConsStep (x1_0 : Nat) (l_rest2 : NList) (ih : Nat → Nat → NList) (x0_0 fa : Nat) : NList :=
  evalConsStepAux1 x1_0 l_rest2 ih x0_0 (Nat.div fa 2)

def evalCons (l_rest : NList) (x0_0 fa : Nat) : NList :=
  NList.rec evalConsNil evalConsStep l_rest x0_0 fa

def finishEval (fa : Nat) : Nat :=
  Bool.rec 0
    (Nat.add fa (Nat.mul 6 (Nat.mod (Nat.div (Nat.sub fa 4) 2) 4)))
    (Bool.and (Nat.ble 6 fa) (Nat.beq (Nat.mod fa 2) 0))

def evalWalkNil (x0_0 fa : Nat) : Nat :=
  Bool.rec 0 (finishEval (Nat.add x0_0 (Nat.add fa 2))) (Nat.beq (Nat.mod fa 4) 1)

def evalWalkConsOdd3Aux2 (ih_eval : NList → Nat → Nat) (x1_0 : Nat) (l_rest2 : NList)
    (ih_walk : Nat → Nat → Nat) (fa_half x2n1 : Nat) : Nat :=
  Bool.rec
    (Bool.rec
      0
      (ih_eval (evalCons l_rest2 x1_0 (Nat.sub x2n1 2)) fa_half)
      (Nat.ble 5 x2n1))
    (ih_walk (Nat.add x1_0 (Nat.add x2n1 3)) fa_half)
    (Nat.beq (Nat.mod x2n1 4) 3)

def evalWalkConsOdd3Aux1 (ih_eval : NList → Nat → Nat) (x1_0 : Nat) (l_rest2 : NList)
    (ih_walk : Nat → Nat → Nat) (x0_0 fa_half : Nat) : Nat :=
  evalWalkConsOdd3Aux2 ih_eval x1_0 l_rest2 ih_walk fa_half (Nat.add x0_0 fa_half)

def evalWalkConsOdd3 (ih_eval : NList → Nat → Nat) (x1_0 : Nat) (l_rest2 : NList)
    (ih_walk : Nat → Nat → Nat) (x0_0 fa : Nat) : Nat :=
  evalWalkConsOdd3Aux1 ih_eval x1_0 l_rest2 ih_walk x0_0 (Nat.div fa 2)

def evalWalkCons (ih_eval : NList → Nat → Nat) (x1_0 : Nat) (l_rest2 : NList)
    (ih_walk : Nat → Nat → Nat) (x0_0 fa : Nat) : Nat :=
  Bool.rec
    (Bool.rec 0 (evalWalkConsOdd3 ih_eval x1_0 l_rest2 ih_walk x0_0 fa) (Nat.beq (Nat.mod fa 4) 3))
    (ih_walk x1_0 (Nat.add x0_0 (Nat.add fa 2)))
    (Nat.beq (Nat.mod fa 4) 1)

def evalStepCons (ih_eval : NList → Nat → Nat) (x0_0 : Nat) (l_rest : NList) (_ : Nat → Nat) (fa : Nat) : Nat :=
  NList.rec evalWalkNil (evalWalkCons ih_eval) l_rest x0_0 fa

def evalStepNil (_ : Nat) : Nat := 0

def evalStep (_ : Nat) (ih : NList → Nat → Nat) (l : NList) (fa : Nat) : Nat :=
  NList.rec evalStepNil (evalStepCons ih) l fa

def evalBase (_ : NList) (_ : Nat) : Nat := 0

def evalLoop (fuel : Nat) (l : NList) (fa : Nat) : Nat :=
  Nat.rec evalBase evalStep fuel l fa

def fastEvalStartCons (arec_0 q_top : Nat) (l_inner : NList) (_ : Nat) : Nat :=
  evalLoop 40 (NList.cons (Nat.add q_top (Nat.add (Nat.mul 2 arec_0) 10)) l_inner) (Nat.add arec_0 3)

def fastEvalFromList (arec_0 : Nat) (l : NList) : Nat :=
  NList.rec 0 (fastEvalStartCons arec_0) l

def fastEvalLeaf8Aux (arec_0 ah : Nat) : Nat :=
  evalLoop 40 (NList.cons (Nat.add (Nat.add ah 4) (Nat.add (Nat.mul 2 arec_0) 10)) (NList.cons (Nat.add ah 3) NList.nil)) (Nat.add arec_0 3)

def fastEvalLeaf8 (arec_0 : Nat) : Nat :=
  Bool.rec 0 (fastEvalLeaf8Aux arec_0 (Nat.div arec_0 2)) (Nat.ble 8 arec_0)

def fastEvalAux (arec_0 : Nat) : Nat :=
  Bool.rec
    (Bool.rec
      (fastEvalFromList arec_0 (evalNil4 20 arec_0))
      (fastEvalLeaf8 arec_0)
      (Nat.beq (Nat.mod arec_0 8) 0))
    (evalLoop 40 (NList.cons (Nat.add (Nat.add arec_0 6) (Nat.add (Nat.mul 2 arec_0) 10)) (NList.cons 1 NList.nil)) (Nat.add arec_0 3))
    (Nat.beq (Nat.mod arec_0 4) 2)

def fastEval (n : Nat) : Nat :=
  Bool.rec 0 (fastEvalAux (Nat.sub (Nat.div n 4) 3)) (Bool.and (Nat.ble 12 n) (Nat.beq (Nat.mod n 8) 4))

def NList.toList : NList → List Nat
  | .nil => []
  | .cons x l => x :: l.toList

def NList.LastOdd : NList → Nat → Prop
  | .nil, x0 => x0 % 2 = 1
  | .cons x1 l, x0 => x0 % 2 = 0 ∧ l.LastOdd x1

theorem NList.LastOdd_add_even (l : NList) (x d : Nat) (h1 : l.LastOdd x) (h2 : d % 2 = 0) :
    l.LastOdd (x + d) := by
  cases l with
  | nil => dsimp [NList.LastOdd] at h1 ⊢; omega
  | cons x1 l2 =>
    rcases h1 with ⟨h1a, h1b⟩
    exact ⟨by omega, h1b⟩

theorem evalNil4_zero (fa : Nat) : evalNil4 0 fa = .nil := rfl
theorem evalNil4_succ (fuel fa : Nat) : evalNil4 (fuel + 1) fa = evalNil4Step fuel (evalNil4 fuel) fa := rfl
theorem evalCons_nil (x0_0 fa : Nat) : evalCons .nil x0_0 fa = evalConsNil x0_0 fa := rfl
theorem evalCons_cons (x1_0 : Nat) (l_rest2 : NList) (x0_0 fa : Nat) :
    evalCons (.cons x1_0 l_rest2) x0_0 fa = evalConsStep x1_0 l_rest2 (evalCons l_rest2) x0_0 fa := rfl

def NList.NilValid (fa : Nat) : NList → Prop
  | .nil => True
  | .cons q_top l_in =>
      fa % 2 = 0 ∧
      2 ≤ q_top ∧
      l_in.LastOdd q_top ∧
      ∀ r, ReachesStar target_tm (CfgS [] fa (0 :: 1 :: r)) (CfgT l_in.toList (q_top - 2) (0 :: r))

theorem evalNil4_spec (fuel fa : Nat) : NList.NilValid fa (evalNil4 fuel fa) := by
  induction fuel generalizing fa with
  | zero => trivial
  | succ fuel ih =>
    rw [evalNil4_succ]
    dsimp only [evalNil4Step, nat_add_eq, nat_sub_eq, nat_mul_eq, nat_div_eq, nat_mod_eq]
    cases hcond : Bool.and (Nat.ble 12 fa) (Nat.beq (fa % 8) 4) <;> dsimp only [Bool.rec]
    · trivial
    · rcases Bool.and_eq_true_iff.mp hcond with ⟨hc1, hc2⟩
      have hfa12 : 12 ≤ fa := Nat.le_of_ble_eq_true hc1
      have hfa8 : fa % 8 = 4 := Nat.eq_of_beq_eq_true hc2
      dsimp only [evalNil4StepAux1, evalNil4StepAux2, nat_add_eq, nat_sub_eq, nat_mul_eq, nat_div_eq, nat_mod_eq]
      cases hm4 : Nat.beq ((fa / 4 - 3) % 4) 2 <;> dsimp only [Bool.rec]
      · cases hm8 : Nat.beq ((fa / 4 - 3) % 8) 0 <;> dsimp only [Bool.rec]
        · have hih := ih (fa / 4 - 3)
          cases hres : evalNil4 fuel (fa / 4 - 3) with
          | nil =>
            dsimp only [nlistWrap2, NList.rec, NList.NilValid]
          | cons q_top l_inner =>
            rw [hres] at hih
            rcases hih with ⟨harec2, hq2, hlo, hreach⟩
            dsimp only [nlistWrap2, NList.rec, nlistWrap2Some, NList.NilValid, NList.toList]
            refine ⟨by omega, by omega, ⟨by omega, by omega, hlo⟩, ?_⟩
            intro r
            refine (step_down_nil4 fa r hfa8 hfa12).trans ?_
            refine (hreach _).trans ?_
            have hup := step_up_nil4 (fa / 4 - 3) q_top l_inner.toList r harec2 hq2
            have hpt : 2 * (fa / 4 - 3) + 8 = 2 * (fa / 4 - 3) + 10 - 2 := by omega
            rw [hpt] at hup
            exact hup
        · have harec8 : (fa / 4 - 3) % 8 = 0 := Nat.eq_of_beq_eq_true hm8
          dsimp only [evalNil4Leaf8, nat_add_eq, nat_sub_eq, nat_mul_eq, nat_div_eq, nat_mod_eq]
          cases hge8 : Nat.ble 8 (fa / 4 - 3) <;> dsimp only [Bool.rec]
          · trivial
          · have harec_ge8 : 8 ≤ fa / 4 - 3 := Nat.le_of_ble_eq_true hge8
            dsimp only [evalNil4Leaf8Aux, NList.NilValid, NList.toList, nat_add_eq, nat_sub_eq, nat_mul_eq, nat_div_eq, nat_mod_eq]
            refine ⟨by omega, by omega, by dsimp [NList.LastOdd]; omega, ?_⟩
            intro r
            refine (step_down_nil4 fa r hfa8 hfa12).trans ?_
            refine (step_leaf_mod8_0 (fa / 4 - 3) _ harec8 harec_ge8).trans ?_
            have hup := step_up_nil4 (fa / 4 - 3) ((fa / 4 - 3) / 2 + 4) [(fa / 4 - 3) / 2 + 3] r (by omega) (by omega)
            have ha1 : (fa / 4 - 3) / 2 + 2 = (fa / 4 - 3) / 2 + 4 - 2 := by omega
            have ha2 : 2 * (fa / 4 - 3) + 8 = 2 * (fa / 4 - 3) + 10 - 2 := by omega
            rw [← ha1, ha2] at hup
            exact hup
      · have harec4 : (fa / 4 - 3) % 4 = 2 := Nat.eq_of_beq_eq_true hm4
        dsimp only [NList.NilValid, NList.toList, nat_add_eq, nat_sub_eq, nat_mul_eq, nat_div_eq, nat_mod_eq]
        refine ⟨by omega, by omega, by dsimp [NList.LastOdd]; omega, ?_⟩
        intro r
        refine (step_down_nil4 fa r hfa8 hfa12).trans ?_
        refine (step_leaf_mod4_2 (fa / 4 - 3) _ harec4).trans ?_
        have hup := step_up_nil4 (fa / 4 - 3) (fa / 4 - 3 + 6) [1] r (by omega) (by omega)
        have ha1 : fa / 4 - 3 + 4 = fa / 4 - 3 + 6 - 2 := by omega
        have ha2 : 2 * (fa / 4 - 3) + 8 = 2 * (fa / 4 - 3) + 10 - 2 := by omega
        rw [← ha1, ha2] at hup
        exact hup

def NList.ConsValid (l_rest : NList) (x0_0 fa : Nat) : NList → Prop
  | .nil => True
  | .cons q_top l_in =>
      2 ≤ q_top ∧
      l_in.LastOdd q_top ∧
      ∀ r, ReachesStar target_tm (CfgS (x0_0 :: l_rest.toList) fa (0 :: 1 :: r)) (CfgT l_in.toList (q_top - 2) (0 :: r))

theorem evalCons_spec (l_rest : NList) (x0_0 fa : Nat)
    (hfa : fa % 4 = 3) (hlo : l_rest.LastOdd x0_0) :
    NList.ConsValid l_rest x0_0 fa (evalCons l_rest x0_0 fa) := by
  induction l_rest generalizing x0_0 fa with
  | nil =>
    have hx0 : x0_0 % 2 = 1 := hlo
    rw [evalCons_nil]
    dsimp only [evalConsNil, evalConsNilAux, evalConsNilBody1, nat_add_eq, nat_sub_eq, nat_mul_eq, nat_div_eq, nat_mod_eq]
    cases hge2 : Nat.ble 2 (x0_0 + fa / 2) <;> dsimp only [Bool.rec]
    · trivial
    · have hx2n1_ge2 : 2 ≤ x0_0 + fa / 2 := Nat.le_of_ble_eq_true hge2
      dsimp only [evalConsNilBody2, nat_add_eq, nat_sub_eq, nat_mul_eq, nat_div_eq, nat_mod_eq]
      cases hm4 : Nat.beq ((x0_0 + fa / 2 - 2) % 4) 2 <;> dsimp only [Bool.rec]
      · cases hm8 : Nat.beq ((x0_0 + fa / 2 - 2) % 8) 0 <;> dsimp only [Bool.rec]
        · have hnil := evalNil4_spec 20 (x0_0 + fa / 2 - 2)
          cases hres : evalNil4 20 (x0_0 + fa / 2 - 2) with
          | nil =>
            dsimp only [nlistWrap1, NList.rec, NList.ConsValid]
          | cons q_top l_inner =>
            rw [hres] at hnil
            rcases hnil with ⟨_, hq2, hlo_in, hreach⟩
            dsimp only [nlistWrap1, NList.rec, nlistWrap1Some, NList.ConsValid, NList.toList]
            refine ⟨by omega, ⟨by omega, hlo_in⟩, ?_⟩
            intro r
            refine (step_down_cons_r [] x0_0 fa r hfa hx2n1_ge2).trans ?_
            refine (hreach _).trans ?_
            have hup := step_up_cons_r fa q_top l_inner.toList r hfa hq2
            have ha : fa / 2 + 1 = fa / 2 + 3 - 2 := by omega
            rw [ha] at hup
            exact hup
        · have harec8 : (x0_0 + fa / 2 - 2) % 8 = 0 := Nat.eq_of_beq_eq_true hm8
          dsimp only [evalConsNilLeaf8, nat_add_eq, nat_sub_eq, nat_mul_eq, nat_div_eq, nat_mod_eq]
          cases hge8 : Nat.ble 8 (x0_0 + fa / 2 - 2) <;> dsimp only [Bool.rec]
          · trivial
          · have harec_ge8 : 8 ≤ x0_0 + fa / 2 - 2 := Nat.le_of_ble_eq_true hge8
            dsimp only [evalConsNilLeaf8Aux, NList.ConsValid, NList.toList, nat_add_eq, nat_sub_eq, nat_mul_eq, nat_div_eq, nat_mod_eq]
            refine ⟨by omega, by dsimp [NList.LastOdd]; omega, ?_⟩
            intro r
            refine (step_down_cons_r [] x0_0 fa r hfa hx2n1_ge2).trans ?_
            refine (step_leaf_mod8_0 (x0_0 + fa / 2 - 2) _ harec8 harec_ge8).trans ?_
            have hup := step_up_cons_r fa ((x0_0 + fa / 2 - 2) / 2 + 4) [(x0_0 + fa / 2 - 2) / 2 + 3] r hfa (by omega)
            have ha1 : (x0_0 + fa / 2 - 2) / 2 + 2 = (x0_0 + fa / 2 - 2) / 2 + 4 - 2 := by omega
            have ha2 : fa / 2 + 1 = fa / 2 + 3 - 2 := by omega
            rw [← ha1, ha2] at hup
            exact hup
      · have harec4 : (x0_0 + fa / 2 - 2) % 4 = 2 := Nat.eq_of_beq_eq_true hm4
        dsimp only [NList.ConsValid, NList.toList, nat_add_eq, nat_sub_eq, nat_mul_eq, nat_div_eq, nat_mod_eq]
        refine ⟨by omega, by dsimp [NList.LastOdd]; omega, ?_⟩
        intro r
        refine (step_down_cons_r [] x0_0 fa r hfa hx2n1_ge2).trans ?_
        refine (step_leaf_mod4_2 (x0_0 + fa / 2 - 2) _ harec4).trans ?_
        have hup := step_up_cons_r fa (x0_0 + fa / 2 - 2 + 6) [1] r hfa (by omega)
        have ha1 : x0_0 + fa / 2 - 2 + 4 = x0_0 + fa / 2 - 2 + 6 - 2 := by omega
        have ha2 : fa / 2 + 1 = fa / 2 + 3 - 2 := by omega
        rw [← ha1, ha2] at hup
        exact hup
  | cons x1_0 l_rest2 ih =>
    rcases hlo with ⟨hx0, hlo2⟩
    rw [evalCons_cons]
    dsimp only [evalConsStep, evalConsStepAux1, evalConsStepAux2, nat_add_eq, nat_sub_eq, nat_mul_eq, nat_div_eq, nat_mod_eq]
    cases hm3 : Nat.beq ((x0_0 + fa / 2) % 4) 3 <;> dsimp only [Bool.rec]
    · cases hge5 : Nat.ble 5 (x0_0 + fa / 2) <;> dsimp only [Bool.rec]
      · trivial
      · have hx2n1_ge5 : 5 ≤ x0_0 + fa / 2 := Nat.le_of_ble_eq_true hge5
        have hx2n1_ne3 : (x0_0 + fa / 2) % 4 ≠ 3 := Nat.ne_of_beq_eq_false hm3
        have hfa_sub : (x0_0 + fa / 2 - 2) % 4 = 3 := by omega
        have hih := ih x1_0 (x0_0 + fa / 2 - 2) hfa_sub hlo2
        cases hres : evalCons l_rest2 x1_0 (x0_0 + fa / 2 - 2) with
        | nil =>
          dsimp only [nlistWrap1, NList.rec, NList.ConsValid]
        | cons q_top l_inner =>
          rw [hres] at hih
          rcases hih with ⟨hq2, hlo_in, hreach⟩
          dsimp only [nlistWrap1, NList.rec, nlistWrap1Some, NList.ConsValid, NList.toList]
          refine ⟨by omega, ⟨by omega, hlo_in⟩, ?_⟩
          intro r
          refine (step_down_cons_r (x1_0 :: l_rest2.toList) x0_0 fa r hfa (by omega)).trans ?_
          refine (hreach _).trans ?_
          have hup := step_up_cons_r fa q_top l_inner.toList r hfa hq2
          have ha : fa / 2 + 1 = fa / 2 + 3 - 2 := by omega
          rw [ha] at hup
          exact hup
    · have hx2n1_3 : (x0_0 + fa / 2) % 4 = 3 := Nat.eq_of_beq_eq_true hm3
      dsimp only [NList.ConsValid, NList.toList, nat_add_eq, nat_sub_eq, nat_mul_eq, nat_div_eq, nat_mod_eq]
      refine ⟨by omega, ⟨by omega, NList.LastOdd_add_even l_rest2 x1_0 (x0_0 + fa / 2 + 3) hlo2 (by omega)⟩, ?_⟩
      intro r
      have h := step_cons_mod3_r l_rest2.toList x0_0 x1_0 fa r hfa hx2n1_3
      have ha : fa / 2 + 1 = fa / 2 + 3 - 2 := by omega
      rw [ha] at h
      exact h

def evalWalk (ih_eval : NList → Nat → Nat) (l_rest : NList) (x0_0 fa : Nat) : Nat :=
  NList.rec evalWalkNil (evalWalkCons ih_eval) l_rest x0_0 fa

theorem evalLoop_zero (l : NList) (fa : Nat) : evalLoop 0 l fa = 0 := rfl
theorem evalLoop_nil (fuel fa : Nat) : evalLoop fuel .nil fa = 0 := by cases fuel <;> rfl
theorem evalLoop_succ_cons (fuel x0_0 : Nat) (l_rest : NList) (fa : Nat) :
    evalLoop (fuel + 1) (.cons x0_0 l_rest) fa = evalWalk (evalLoop fuel) l_rest x0_0 fa := rfl
theorem evalWalk_nil (ih_eval : NList → Nat → Nat) (x0_0 fa : Nat) :
    evalWalk ih_eval .nil x0_0 fa = evalWalkNil x0_0 fa := rfl
theorem evalWalk_cons (ih_eval : NList → Nat → Nat) (x1_0 : Nat) (l_rest2 : NList) (x0_0 fa : Nat) :
    evalWalk ih_eval (.cons x1_0 l_rest2) x0_0 fa =
      evalWalkCons ih_eval x1_0 l_rest2 (evalWalk ih_eval l_rest2) x0_0 fa := rfl

def EvalValid (l : NList) (fa res : Nat) : Prop :=
  res = 0 ∨ ReachesStar target_tm (CfgS l.toList fa [0, 1]) (Cn res)

theorem evalWalk_spec (ih_eval : NList → Nat → Nat)
    (hih_nil : ∀ fa, ih_eval .nil fa = 0)
    (hih_cons : ∀ x0_0 l_rest fa, l_rest.LastOdd x0_0 → EvalValid (.cons x0_0 l_rest) fa (ih_eval (.cons x0_0 l_rest) fa))
    (l_rest : NList) (x0_0 fa : Nat) (hlo : l_rest.LastOdd x0_0) :
    EvalValid (.cons x0_0 l_rest) fa (evalWalk ih_eval l_rest x0_0 fa) := by
  induction l_rest generalizing x0_0 fa with
  | nil =>
    rw [evalWalk_nil]
    dsimp only [evalWalkNil, nat_add_eq, nat_sub_eq, nat_mul_eq, nat_div_eq, nat_mod_eq]
    cases hm1 : Nat.beq (fa % 4) 1 <;> dsimp only [Bool.rec]
    · exact Or.inl rfl
    · have hfa1 : fa % 4 = 1 := Nat.eq_of_beq_eq_true hm1
      dsimp only [finishEval, nat_add_eq, nat_sub_eq, nat_mul_eq, nat_div_eq, nat_mod_eq]
      cases hcond : Bool.and (Nat.ble 6 (x0_0 + (fa + 2))) (Nat.beq ((x0_0 + (fa + 2)) % 2) 0) <;> dsimp only [Bool.rec]
      · exact Or.inl rfl
      · rcases Bool.and_eq_true_iff.mp hcond with ⟨hc1, hc2⟩
        have hge6 : 6 ≤ x0_0 + (fa + 2) := Nat.le_of_ble_eq_true hc1
        have heven : (x0_0 + (fa + 2)) % 2 = 0 := Nat.eq_of_beq_eq_true hc2
        refine Or.inr ?_
        dsimp only [NList.toList]
        have h1 := step_odd1_end [] x0_0 fa hfa1
        have ha : x0_0 + fa + 2 = x0_0 + (fa + 2) := by omega
        rw [ha] at h1
        exact h1.trans (finish_even_spec (x0_0 + (fa + 2)) heven hge6)
  | cons x1_0 l_rest2 ih_walk =>
    rcases hlo with ⟨hx0, hlo2⟩
    rw [evalWalk_cons]
    dsimp only [evalWalkCons, nat_add_eq, nat_sub_eq, nat_mul_eq, nat_div_eq, nat_mod_eq]
    cases hm1 : Nat.beq (fa % 4) 1 <;> dsimp only [Bool.rec]
    · cases hm3 : Nat.beq (fa % 4) 3 <;> dsimp only [Bool.rec]
      · exact Or.inl rfl
      · have hfa3 : fa % 4 = 3 := Nat.eq_of_beq_eq_true hm3
        dsimp only [evalWalkConsOdd3, evalWalkConsOdd3Aux1, evalWalkConsOdd3Aux2, nat_add_eq, nat_sub_eq, nat_mul_eq, nat_div_eq, nat_mod_eq]
        cases hx3 : Nat.beq ((x0_0 + fa / 2) % 4) 3 <;> dsimp only [Bool.rec]
        · cases hge5 : Nat.ble 5 (x0_0 + fa / 2) <;> dsimp only [Bool.rec]
          · exact Or.inl rfl
          · have hx2n1_ge5 : 5 ≤ x0_0 + fa / 2 := Nat.le_of_ble_eq_true hge5
            have hx2n1_ne3 : (x0_0 + fa / 2) % 4 ≠ 3 := Nat.ne_of_beq_eq_false hx3
            have hfa_sub : (x0_0 + fa / 2 - 2) % 4 = 3 := by omega
            have hexc := evalCons_spec l_rest2 x1_0 (x0_0 + fa / 2 - 2) hfa_sub hlo2
            cases hres : evalCons l_rest2 x1_0 (x0_0 + fa / 2 - 2) with
            | nil =>
              exact Or.inl (hih_nil (fa / 2))
            | cons q_top l_inner =>
              rw [hres] at hexc
              rcases hexc with ⟨hq2, hlo_in, hreach_in⟩
              rcases hih_cons q_top l_inner (fa / 2) hlo_in with h0 | hstep
              · exact Or.inl h0
              · refine Or.inr ?_
                dsimp only [NList.toList] at hstep ⊢
                refine (step_down_cons_r (x1_0 :: l_rest2.toList) x0_0 fa [] hfa3 (by omega)).trans ?_
                refine (hreach_in _).trans ?_
                exact (step_up_walk_odd3 fa q_top l_inner.toList hfa3 hq2).trans hstep
