def setRootEmpty (rb rs rd : Nat) : RuleTrie :=
  RuleTrie.rule rb rs rd RuleTrie.empty RuleTrie.empty RuleTrie.empty RuleTrie.empty

def setRootPass (rb rs rd : Nat) (c0 c1 c2 c3 : RuleTrie) (_ _ _ _ : RuleTrie) : RuleTrie :=
