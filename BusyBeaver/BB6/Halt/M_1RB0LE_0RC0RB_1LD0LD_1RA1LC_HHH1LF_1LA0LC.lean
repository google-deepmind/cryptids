-- Part 1: RuleTrie, chainRight, jumpRight, runEvalJump, and runTwoStage

inductive OptRule where
  | none : OptRule
  | some : Nat → Nat → Nat → OptRule

inductive RuleTrie where
  | empty : RuleTrie
  | pass : RuleTrie → RuleTrie → RuleTrie → RuleTrie → RuleTrie
  | rule : Nat → Nat → Nat → RuleTrie → RuleTrie → RuleTrie → RuleTrie → RuleTrie

def applies (base stride n : Nat) : Bool :=
  Bool.rec
    false
    (Bool.rec
      (Nat.beq (Nat.mod (Nat.sub n base) stride) 0)
      false
      (Nat.beq stride 0))
    (Nat.ble base n)

def lookupPass (_ _ _ _ : RuleTrie) (ih0 ih1 ih2 ih3 : Nat → OptRule → OptRule)
    (rem : Nat) (best : OptRule) : OptRule :=
