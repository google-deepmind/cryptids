theorem step_cons_mod3_r (l : List Nat) (x0 x1 fa : Nat) (r : List Nat)
    (h1 : fa % 4 = 3) (h2 : (x0 + fa / 2) % 4 = 3) :
    ReachesStar target_tm
      (CfgS (x0 :: x1 :: l) fa (0 :: 1 :: r))
      (CfgT ((x1 + (x0 + fa / 2 + 3)) :: l) (fa / 2 + 1) (0 :: r)) := by
  have hge2 : 2 ≤ x0 + fa / 2 := by omega
  refine (step_down_cons_r (x1 :: l) x0 fa r h1 hge2).trans ?_
  have hodd1 : (x0 + fa / 2 - 2) % 4 = 1 := by omega
  have hr : (0 :: 1 :: 2 :: (List.replicate (fa / 4 + 1) 1 ++ r) : List Nat) =
      0 :: (List.replicate (0 + 1) 1 ++ (2 :: (List.replicate (fa / 4 + 1) 1 ++ r))) := rfl
  rw [hr]
  refine (step_odd1_r l x1 (x0 + fa / 2 - 2) 0 (2 :: (List.replicate (fa / 4 + 1) 1 ++ r)) hodd1).trans ?_
  have ha1 : x1 + (x0 + fa / 2 - 2) + 2 * 0 + 3 = (x1 + (x0 + fa / 2 + 3)) - 2 := by omega
  rw [ha1]
  exact step_up_cons_r fa (x1 + (x0 + fa / 2 + 3)) l r h1 (by omega)

theorem step_walk_odd3_mod3 (l : List Nat) (x0 x1 fa : Nat)
    (h1 : fa % 4 = 3) (h2 : (x0 + fa / 2) % 4 = 3) :
    ReachesStar target_tm
      (CfgS (x0 :: x1 :: l) fa [0, 1])
      (CfgS ((x1 + (x0 + fa / 2 + 3)) :: l) (fa / 2) [0, 1]) := by
  refine (step_cons_mod3_r l x0 x1 fa [] h1 h2).trans ?_
  have ha : fa / 2 + 1 = 1 + fa / 2 := by omega
  rw [ha]
  exact T_end_lemma ((x1 + (x0 + fa / 2 + 3)) :: l) (fa / 2)

theorem step_plus_6 (m : Nat) (h1 : m % 2 = 0) (h2 : m % 8 ≠ 4) (h3 : 6 ≤ m) :
    ReachesStar target_tm (Cn m) (Cn (m + 6)) := by
  rcases (by omega : m % 4 = 2 ∨ (m % 8 = 0 ∧ 8 ≤ m)) with hm2 | ⟨hm8, hmge⟩
  · refine (step_leaf_mod4_2 m [] hm2).trans ?_
    have ha1 : m + 4 = 1 + (m + 3) := by omega
    rw [ha1]
    refine (T_end_lemma [1] (m + 3)).trans ?_
    have hodd : (m + 3) % 4 = 1 := by omega
    refine (step_odd1_end [] 1 (m + 3) hodd).trans ?_
    have ha2 : 1 + (m + 3) + 2 = m + 6 := by omega
    rw [ha2]; exact ReachesStar.refl _ _
  · refine (step_leaf_mod8_0 m [] hm8 hmge).trans ?_
    have ha1 : m / 2 + 2 = 1 + (m / 2 + 1) := by omega
    rw [ha1]
    refine (T_end_lemma [m / 2 + 3] (m / 2 + 1)).trans ?_
    have hodd : (m / 2 + 1) % 4 = 1 := by omega
    refine (step_odd1_end [] (m / 2 + 3) (m / 2 + 1) hodd).trans ?_
    have ha2 : (m / 2 + 3) + (m / 2 + 1) + 2 = m + 6 := by omega
    rw [ha2]; exact ReachesStar.refl _ _

theorem finish_even_spec (fa_f : Nat) (h1 : fa_f % 2 = 0) (h2 : 6 ≤ fa_f) :
    ReachesStar target_tm (Cn fa_f) (Cn (fa_f + 6 * (((fa_f - 4) / 2) % 4))) := by
  rcases (by omega : ((fa_f - 4) / 2) % 4 = 0 ∨ ((fa_f - 4) / 2) % 4 = 1 ∨
      ((fa_f - 4) / 2) % 4 = 2 ∨ ((fa_f - 4) / 2) % 4 = 3) with hr0 | hr1 | hr2 | hr3
  · rw [hr0, Nat.mul_zero, Nat.add_zero]; exact ReachesStar.refl _ _
  · rw [hr1, Nat.mul_one]
    exact step_plus_6 fa_f h1 (by omega) h2
  · rw [hr2]
    refine (step_plus_6 fa_f h1 (by omega) h2).trans ?_
    exact step_plus_6 (fa_f + 6) (by omega) (by omega) (by omega)
  · rw [hr3]
    refine (step_plus_6 fa_f h1 (by omega) h2).trans ?_
    refine (step_plus_6 (fa_f + 6) (by omega) (by omega) (by omega)).trans ?_
    exact step_plus_6 (fa_f + 6 + 6) (by omega) (by omega) (by omega)


def val (g_f t x w : Nat) : Nat := x + 4 * ((w / g_f) * t)

theorem dvd_eight_of_dvd (g_f w : Nat) (hg8 : g_f % 8 = 0) (hw : g_f ∣ w) : w % 8 = 0 := by
  have h8 : 8 ∣ w := Nat.dvd_trans (Nat.dvd_of_mod_eq_zero hg8) hw
  exact Nat.mod_eq_zero_of_dvd h8

theorem val_mod2 (g_f t x w : Nat) : (val g_f t x w) % 2 = x % 2 := by
  dsimp [val]; omega

theorem val_mod4 (g_f t x w : Nat) : (val g_f t x w) % 4 = x % 4 := by
  dsimp [val]; omega

theorem val_mod8 (g_f t x w : Nat) (hg0 : 0 < g_f) (hg8 : g_f % 8 = 0)
    (hw : g_f ∣ w) (hw2 : g_f ∣ (w / 2)) :
    (val g_f t x w) % 8 = x % 8 := by
  have hw8 := dvd_eight_of_dvd g_f w hg8 hw
  have hw_eq : w = 2 * (w / 2) := by omega
  rcases hw2 with ⟨k, hk⟩
  have hweq : w = g_f * (2 * k) := by rw [hw_eq, hk]; ring
  have hdiv : w / g_f = 2 * k := by rw [hweq, Nat.mul_div_right _ hg0]
  dsimp [val]
  rw [hdiv]
  have hring : 4 * ((2 * k) * t) = 8 * (k * t) := by ring
  rw [hring]
  omega

theorem val_add (g_f t x1 w1 x2 w2 : Nat) (hg0 : 0 < g_f) (hw1 : g_f ∣ w1) (hw2 : g_f ∣ w2) :
    val g_f t (x1 + x2) (w1 + w2) = val g_f t x1 w1 + val g_f t x2 w2 := by
  rcases hw1 with ⟨k1, rfl⟩
  rcases hw2 with ⟨k2, rfl⟩
  have hsum : g_f * k1 + g_f * k2 = g_f * (k1 + k2) := by ring
  dsimp [val]
  rw [hsum, Nat.mul_div_right _ hg0, Nat.mul_div_right _ hg0, Nat.mul_div_right _ hg0]
  ring

theorem val_div2 (g_f t x w : Nat) (hg0 : 0 < g_f) (hg8 : g_f % 8 = 0)
    (hw : g_f ∣ w) (hw2 : g_f ∣ (w / 2)) :
    (val g_f t x w) / 2 = val g_f t (x / 2) (w / 2) := by
  have hw8 := dvd_eight_of_dvd g_f w hg8 hw
  have hw_eq : w = 2 * (w / 2) := by omega
  rcases hw2 with ⟨k, hk⟩
  have hweq : w = g_f * (2 * k) := by rw [hw_eq, hk]; ring
  have hdiv1 : w / g_f = 2 * k := by rw [hweq, Nat.mul_div_right _ hg0]
  have hdiv2 : (w / 2) / g_f = k := by rw [hk, Nat.mul_div_right _ hg0]
  dsimp [val]
  rw [hdiv1, hdiv2]
  have hring : 4 * ((2 * k) * t) = 2 * (4 * (k * t)) := by ring
  rw [hring]
  omega

theorem val_div4 (g_f t x w : Nat) (hg0 : 0 < g_f) (hg8 : g_f % 8 = 0)
    (hw : g_f ∣ w) (hw4 : g_f ∣ (w / 4)) :
    (val g_f t x w) / 4 = val g_f t (x / 4) (w / 4) := by
  have hw8 := dvd_eight_of_dvd g_f w hg8 hw
  have hw_eq : w = 4 * (w / 4) := by omega
  rcases hw4 with ⟨k, hk⟩
  have hweq : w = g_f * (4 * k) := by rw [hw_eq, hk]; ring
  have hdiv1 : w / g_f = 4 * k := by rw [hweq, Nat.mul_div_right _ hg0]
  have hdiv4 : (w / 4) / g_f = k := by rw [hk, Nat.mul_div_right _ hg0]
  dsimp [val]
  rw [hdiv1, hdiv4]
  have hring : 4 * ((4 * k) * t) = 4 * (4 * (k * t)) := by ring
  rw [hring]
  omega

theorem dvd_half_of_dvd_qtr (g_f w : Nat) (hg8 : g_f % 8 = 0)
    (hw : g_f ∣ w) (hw4 : g_f ∣ (w / 4)) : g_f ∣ (w / 2) := by
  have hw8 := dvd_eight_of_dvd g_f w hg8 hw
  have hw_eq : w / 2 = 2 * (w / 4) := by omega
  rcases hw4 with ⟨k, hk⟩
  refine ⟨2 * k, ?_⟩
  rw [hw_eq, hk]; ring

theorem val_ge (g_f t x w : Nat) : x ≤ val g_f t x w := by
  dsimp [val]; omega

theorem val_add_const (g_f t x c w : Nat) : val g_f t (x + c) w = val g_f t x w + c := by
  dsimp [val]; omega

theorem val_sub_const (g_f t x c w : Nat) (h : c ≤ x) : val g_f t (x - c) w = val g_f t x w - c := by
  dsimp [val]; omega

theorem val_mul2 (g_f t x w : Nat) (hg0 : 0 < g_f) (hg8 : g_f % 8 = 0)
    (hw : g_f ∣ w) (hw2 : g_f ∣ (w / 2)) (hx : x % 2 = 0) :
    2 * val g_f t (x / 2) (w / 2) = val g_f t x w := by
  have h := val_div2 g_f t x w hg0 hg8 hw hw2
  have hm := val_mod2 g_f t x w
  omega

theorem val_2mul (g_f t x w : Nat) (hg0 : 0 < g_f) (hg8 : g_f % 8 = 0)
    (hw : g_f ∣ w) (hw2 : g_f ∣ (w / 2)) :
    2 * val g_f t x (w / 2) = val g_f t (2 * x) w := by
  have hw8 := dvd_eight_of_dvd g_f w hg8 hw
  have hw_eq : w = 2 * (w / 2) := by omega
  rcases hw2 with ⟨k, hk⟩
  have hweq : w = g_f * (2 * k) := by rw [hw_eq, hk]; ring
  have hdiv1 : w / g_f = 2 * k := by rw [hweq, Nat.mul_div_right _ hg0]
  have hdiv2 : (w / 2) / g_f = k := by rw [hk, Nat.mul_div_right _ hg0]
  dsimp [val]
  rw [hdiv1, hdiv2]
  ring

theorem div_2_2_eq_div_4 (w : Nat) : w / 2 / 2 = w / 4 := by omega

theorem val_step_down_nil4 (g_f t fa w : Nat) (r : List Nat)
    (hg0 : 0 < g_f) (hg8 : g_f % 8 = 0) (hw : g_f ∣ w) (hwq : g_f ∣ (w / 2 / 2))
    (h1 : fa % 8 = 4) (h2 : 12 ≤ fa) :
    let arec_0 := fa / 4 - 3
    let w_qtr := w / 2 / 2
    let AREC := val g_f t arec_0 w_qtr
    ReachesStar target_tm
      (CfgS [] (val g_f t fa w) (0 :: 1 :: r))
      (CfgS [] AREC (0 :: 1 :: 2 :: (List.replicate (AREC / 2 + 1) 1 ++ 2 :: (List.replicate (AREC + 4) 1 ++ r)))) := by
  intro arec_0 w_qtr AREC
  have hw4 : g_f ∣ (w / 4) := by rw [← div_2_2_eq_div_4]; exact hwq
  have hwh : g_f ∣ (w / 2) := dvd_half_of_dvd_qtr g_f w hg8 hw hw4
  have hm8 : (val g_f t fa w) % 8 = 4 := by rw [val_mod8 g_f t fa w hg0 hg8 hw hwh, h1]
  have hge12 : 12 ≤ val g_f t fa w := by have := val_ge g_f t fa w; omega
  have h := step_down_nil4 (val g_f t fa w) r hm8 hge12
  dsimp only at h
  have harec : (val g_f t fa w) / 4 - 3 = AREC := by
    dsimp [AREC, arec_0, w_qtr]
    rw [div_2_2_eq_div_4, val_div4 g_f t fa w hg0 hg8 hw hw4, val_sub_const _ _ _ _ _ (by omega)]
  rw [harec] at h
  exact h

theorem val_step_leaf_mod4_2 (g_f t arec_0 w_qtr : Nat) (r : List Nat)
    (h1 : arec_0 % 4 = 2) :
    ReachesStar target_tm
      (CfgS [] (val g_f t arec_0 w_qtr) (0 :: 1 :: r))
      (CfgT [val g_f t 1 0] (val g_f t (arec_0 + 6) w_qtr - 2) (0 :: r)) := by
  have hm4 : (val g_f t arec_0 w_qtr) % 4 = 2 := by rw [val_mod4, h1]
  have h := step_leaf_mod4_2 (val g_f t arec_0 w_qtr) r hm4
  have h1_0 : val g_f t 1 0 = 1 := by dsimp [val]; simp
  have ha : val g_f t arec_0 w_qtr + 4 = val g_f t (arec_0 + 6) w_qtr - 2 := by dsimp [val]; omega
  rw [h1_0, ← ha]
  exact h

theorem val_step_leaf_mod8_0 (g_f t arec_0 w_qtr : Nat) (r : List Nat)
    (hg0 : 0 < g_f) (hg8 : g_f % 8 = 0) (hwq : g_f ∣ w_qtr) (hwqh : g_f ∣ (w_qtr / 2))
    (h1 : arec_0 % 8 = 0) (h2 : 8 ≤ arec_0) :
    let ah := arec_0 / 2
    let wq_h := w_qtr / 2
    ReachesStar target_tm
      (CfgS [] (val g_f t arec_0 w_qtr) (0 :: 1 :: r))
      (CfgT [val g_f t (ah + 3) wq_h] (val g_f t (ah + 4) wq_h - 2) (0 :: r)) := by
  intro ah wq_h
  have hm8 : (val g_f t arec_0 w_qtr) % 8 = 0 := by rw [val_mod8 g_f t arec_0 w_qtr hg0 hg8 hwq hwqh, h1]
  have hge8 : 8 ≤ val g_f t arec_0 w_qtr := by have := val_ge g_f t arec_0 w_qtr; omega
  have h := step_leaf_mod8_0 (val g_f t arec_0 w_qtr) r hm8 hge8
  dsimp only at h
  have hah : (val g_f t arec_0 w_qtr) / 2 = val g_f t ah wq_h := val_div2 g_f t arec_0 w_qtr hg0 hg8 hwq hwqh
  have ha1 : val g_f t ah wq_h + 3 = val g_f t (ah + 3) wq_h := by dsimp [val]; omega
  have ha2 : val g_f t ah wq_h + 2 = val g_f t (ah + 4) wq_h - 2 := by dsimp [val]; omega
  rw [hah, ha1, ha2] at h
  exact h

theorem val_step_up_nil4 (g_f t arec_0 w_half q_top w_qtop : Nat) (l r : List Nat)
    (hg0 : 0 < g_f) (hg8 : g_f % 8 = 0) (hwh : g_f ∣ w_half) (hwq : g_f ∣ (w_half / 2))
    (h1 : arec_0 % 2 = 0) (h2 : 2 ≤ q_top) :
    let w_qtr := w_half / 2
    let AREC := val g_f t arec_0 w_qtr
    let QTOP := val g_f t q_top w_qtop
    ReachesStar target_tm
      (CfgT l (QTOP - 2) (0 :: 2 :: (List.replicate (AREC / 2 + 1) 1 ++ 2 :: (List.replicate (AREC + 4) 1 ++ r))))
      (CfgT (val g_f t (arec_0 + 4) w_qtr :: QTOP :: l) (val g_f t (2 * arec_0 + 10) w_half - 2) (0 :: r)) := by
  intro w_qtr AREC QTOP
  have hm2 : AREC % 2 = 0 := by dsimp [AREC]; rw [val_mod2, h1]
  have hq2 : 2 ≤ QTOP := by dsimp [QTOP]; have := val_ge g_f t q_top w_qtop; omega
  have h := step_up_nil4 AREC QTOP l r hm2 hq2
  have hpo : AREC + 4 = val g_f t (arec_0 + 4) w_qtr := by dsimp [AREC, val]; omega
  have hpt : 2 * AREC + 8 = val g_f t (2 * arec_0 + 10) w_half - 2 := by
    have hmul := val_2mul g_f t arec_0 w_half hg0 hg8 hwh hwq
    have hadd10 : val g_f t (2 * arec_0 + 10) w_half = val g_f t (2 * arec_0) w_half + 10 := by dsimp [val]; omega
    dsimp [AREC, w_qtr]
    omega
  refine h.trans ?_
  rw [hpo, hpt]
  exact ReachesStar.refl _ _

theorem val_step_start_loop (g_f t arec_0 wQtr wHalf q_top w_qtop : Nat) (l : List Nat)
    (hg0 : 0 < g_f) (hg8 : g_f % 8 = 0) (hwH : g_f ∣ wHalf) (hwQ : g_f ∣ wQtr) (hwqt : g_f ∣ w_qtop)
    (hWQ : wQtr = wHalf / 2) (h1 : arec_0 % 2 = 0) (h2 : 2 ≤ q_top) :
    let AREC := val g_f t arec_0 wQtr
    let QTOP := val g_f t q_top w_qtop
    ReachesStar target_tm
      (CfgT l (QTOP - 2) (0 :: 2 :: (List.replicate (AREC / 2 + 1) 1 ++ 2 :: (List.replicate (AREC + 4) 1 ++ []))))
      (CfgS (val g_f t (q_top + (2 * arec_0 + 10)) (w_qtop + wHalf) :: l) (val g_f t (arec_0 + 3) wQtr) [0, 1]) := by
  intro AREC QTOP
  have hm2 : AREC % 2 = 0 := by dsimp [AREC]; rw [val_mod2, h1]
  have hq2 : 2 ≤ QTOP := by dsimp [QTOP]; have := val_ge g_f t q_top w_qtop; omega
  have h := step_start_loop AREC QTOP l hm2 hq2
  have hx0 : QTOP + (2 * AREC + 10) = val g_f t (q_top + (2 * arec_0 + 10)) (w_qtop + wHalf) := by
    rw [val_add g_f t q_top w_qtop (2 * arec_0 + 10) wHalf hg0 hwqt hwH]
    have hmul := val_2mul g_f t arec_0 wHalf hg0 hg8 hwH (by rw [← hWQ]; exact hwQ)
    dsimp [QTOP, AREC]
    rw [hWQ]
    have hadd10 : val g_f t (2 * arec_0 + 10) wHalf = val g_f t (2 * arec_0) wHalf + 10 := by dsimp [val]; omega
    omega
  have hfa : AREC + 3 = val g_f t (arec_0 + 3) wQtr := by dsimp [AREC, val]; omega
  rw [hx0, hfa] at h
  exact h

theorem val_step_down_cons_r (g_f t x0 w_x fa w : Nat) (l r : List Nat)
    (hg0 : 0 < g_f) (hg8 : g_f % 8 = 0) (hwx : g_f ∣ w_x) (hw : g_f ∣ w) (hwh : g_f ∣ (w / 2))
    (h1 : fa % 4 = 3) (h2 : 2 ≤ x0 + fa / 2) :
    let FA := val g_f t fa w
    ReachesStar target_tm
      (CfgS (val g_f t x0 w_x :: l) FA (0 :: 1 :: r))
      (CfgS l (val g_f t (x0 + fa / 2 - 2) (w_x + w / 2)) (0 :: 1 :: 2 :: (List.replicate (FA / 4 + 1) 1 ++ r))) := by
  intro FA
  have hm4 : FA % 4 = 3 := by dsimp [FA]; rw [val_mod4, h1]
  have hdiv2 : FA / 2 = val g_f t (fa / 2) (w / 2) := val_div2 g_f t fa w hg0 hg8 hw hwh
  have hge2 : 2 ≤ val g_f t x0 w_x + FA / 2 := by
    rw [hdiv2]; have := val_ge g_f t x0 w_x; have := val_ge g_f t (fa / 2) (w / 2); omega
  have h := step_down_cons_r l (val g_f t x0 w_x) FA r hm4 hge2
  have ha : val g_f t x0 w_x + FA / 2 - 2 = val g_f t (x0 + fa / 2 - 2) (w_x + w / 2) := by
    rw [hdiv2, ← val_add g_f t x0 w_x (fa / 2) (w / 2) hg0 hwx hwh, val_sub_const _ _ _ _ _ h2]
  rw [ha] at h
