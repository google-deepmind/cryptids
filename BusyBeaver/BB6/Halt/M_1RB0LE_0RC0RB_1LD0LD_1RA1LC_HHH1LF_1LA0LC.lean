theorem storeIf_spec (rb rs rd : Nat) (t : RuleTrie) (hr : valid rb rs rd) (ht : RuleTrie.Valid t) :
    RuleTrie.Valid (storeIf rb rs rd t) := by
  unfold storeIf
  cases Nat.ble (Nat.add rb rs) 34357641212 <;> dsimp only [Bool.rec]
  · exact ht
  · exact trieStore_spec rb rs rd t (Nat.div rb 8) (Nat.div rs 8) hr ht

def ChainRes.Valid (n : Nat) : ChainRes → Prop
  | .mk cs cd t' => valid n cs cd ∧ RuleTrie.Valid t'

theorem chainJoin_spec (n rs rd : Nat) (res : ChainRes)
    (hr : valid n rs rd) (hres : ChainRes.Valid (n + rd) res) :
    ChainRes.Valid n (chainJoin n rs rd res) := by
  rcases res with ⟨cs, cd, t'⟩
  rcases hres with ⟨hcs, ht'⟩
  dsimp only [chainJoin, ChainRes.rec, chainJoinBody, chainJoinStore, nat_add_eq, nat_mod_eq]
  cases Nat.ble cs rs <;> dsimp only [Bool.rec]
  · cases hm : Nat.beq (cs % rs) 0 <;> dsimp only [Bool.rec, ChainRes.Valid]
    · exact ⟨hr, ht'⟩
    · have hjoin := join_rules_2 n rs rd cs cd hr hcs (Nat.eq_of_beq_eq_true hm)
      exact ⟨hjoin, storeIf_spec n cs (rd + cd) t' hjoin ht'⟩
  · cases hm : Nat.beq (rs % cs) 0 <;> dsimp only [Bool.rec, ChainRes.Valid]
    · exact ⟨hr, ht'⟩
    · have hjoin := join_rules_1 n rs rd cs cd hr hcs (Nat.eq_of_beq_eq_true hm)
      exact ⟨hjoin, storeIf_spec n rs (rd + cd) t' hjoin ht'⟩

theorem chainRight_spec (fuel : Nat) (t : RuleTrie) (n rs rd : Nat)
    (ht : RuleTrie.Valid t) (hr : valid n rs rd) :
    ChainRes.Valid n (chainRight fuel t n rs rd) := by
  induction fuel generalizing t n rs rd with
  | zero => exact ⟨hr, ht⟩
  | succ fuel ih =>
    dsimp only [chainRight, Nat.rec, chainStep, chainStepAux, nat_add_eq]
    have hlu := trieLookup_spec t (Nat.div (n + rd) 8) OptRule.none ht trivial
    cases hl : trieLookup t (Nat.div (n + rd) 8) OptRule.none with
    | none => dsimp only [OptRule.rec, ChainRes.Valid]; exact ⟨hr, ht⟩
    | some sb ss sd =>
      rw [hl] at hlu
      dsimp only [OptRule.rec, chainStepSome]
      cases hap : applies sb ss (n + rd) <;> dsimp only [Bool.rec, ChainRes.Valid]
      · exact ⟨hr, ht⟩
      · have hnext := valid_of_applies sb ss sd (n + rd) hlu hap
        exact chainJoin_spec n rs rd (chainRight fuel t (n + rd) ss sd) hr
          (ih t (n + rd) ss sd ht hnext)

theorem jumpRight_spec (fuel : Nat) (t : RuleTrie) (n : Nat) (ht : RuleTrie.Valid t) :
    ReachesStar target_tm (Cn n) (Cn (jumpRight fuel t n)) := by
  induction fuel generalizing n with
  | zero => exact ReachesStar.refl _ _
  | succ fuel ih =>
    dsimp only [jumpRight, Nat.rec, jumpStep]
    have hlu := trieLookup_spec t (Nat.div n 8) OptRule.none ht trivial
    cases hl : trieLookup t (Nat.div n 8) OptRule.none with
    | none => dsimp only [OptRule.rec]; exact ReachesStar.refl _ _
    | some sb ss sd =>
      rw [hl] at hlu
      dsimp only [OptRule.rec, jumpStepSome, nat_add_eq]
      cases hap : applies sb ss n <;> dsimp only [Bool.rec]
      · exact ReachesStar.refl _ _
      · exact (apply_rule sb ss sd n hlu hap).trans (ih (n + sd))

theorem runEvalJump_spec (t : RuleTrie) (steps n : Nat) (ht : RuleTrie.Valid t) :
    ReachesStar target_tm (Cn n) (Cn (runEvalJump t steps n)) := by
  induction steps generalizing n with
  | zero => exact ReachesStar.refl _ _
  | succ steps ih =>
    dsimp only [runEvalJump, Nat.rec, runEvalJumpStep, runEvalJumpStepAux, nat_add_eq]
    cases hle : Nat.ble (n + 1) (fastEval n) <;> dsimp only [Bool.rec]
    · exact ReachesStar.refl _ _
    · have hgt : n + 1 ≤ fastEval n := Nat.le_of_ble_eq_true hle
      rcases fastEval_spec n with h0 | hstep
      · omega
      · exact hstep.trans ((jumpRight_spec 20 t (fastEval n) ht).trans (ih (jumpRight 20 t (fastEval n))))

theorem runTwoStage_spec (steps1 steps2 n : Nat) (t : RuleTrie) (ht : RuleTrie.Valid t) :
    ReachesStar target_tm (Cn n) (Cn (runTwoStage steps1 steps2 n t)) := by
  induction steps1 generalizing n t with
  | zero =>
    dsimp only [runTwoStage, Nat.rec, runAdvBase]
    exact runEvalJump_spec t steps2 n ht
  | succ steps1 ih =>
    dsimp only [runTwoStage, Nat.rec, runAdvStep]
    have hcomp := fastCompile_spec n
    cases hc : fastCompile n with
    | none =>
      dsimp only [CmpRule.rec, runEvalJumpStepAux, nat_add_eq]
      cases hle : Nat.ble (n + 1) (fastEval n) <;> dsimp only [Bool.rec]
      · exact ReachesStar.refl _ _
      · have hgt : n + 1 ≤ fastEval n := Nat.le_of_ble_eq_true hle
        rcases fastEval_spec n with h0 | hstep
        · omega
        · exact hstep.trans ((jumpRight_spec 20 t (fastEval n) ht).trans (ih (jumpRight 20 t (fastEval n)) t ht))
    | some rs rd =>
      rw [hc] at hcomp
      dsimp only [CmpRule.rec, runAdvStepSome, nat_add_eq]
      cases Nat.ble (n + rs) 34357641212 <;> dsimp only [Bool.rec]
      · exact (valid_zero n rs rd hcomp).trans
          ((jumpRight_spec 20 t (n + rd) ht).trans (ih (jumpRight 20 t (n + rd)) t ht))
      · have hch := chainRight_spec 20 t n rs rd ht hcomp
        rcases hcr : chainRight 20 t n rs rd with ⟨ss, sd, t'⟩
        rw [hcr] at hch
        rcases hch with ⟨hss, ht'⟩
        dsimp only [runAdvAfterChain, ChainRes.rec, runAdvAfterChainBody, nat_add_eq]
        have hstep := valid_zero n ss sd hss
        cases Nat.beq sd rd <;> dsimp only [Bool.rec]
        · exact hstep.trans (ih (n + sd) t' ht')
        · exact hstep.trans (ih (n + sd) (storeIf n ss sd t') (storeIf_spec n ss sd t' hss ht'))


structure Ops where
  num : Type
  sample : num → Nat
  con : Nat → num
  add : num → num → num
  sub : num → num → Option num
  div : num → Nat → Option (num × Nat)
  eq : num → num → Bool

structure Laws (o : Ops) (v : o.num → Nat) : Prop where
  con_ok : ∀ x, v (o.con x) = x
  add_ok : ∀ x y, v (o.add x y) = v x + v y
  sub_ok : ∀ x y z, o.sub x y = some z → v z + v y = v x
  div_ok : ∀ x n q d, o.div x n = some (q, d) → v q * n + d = v x
  eq_ok : ∀ x y, o.eq x y = true → v x = v y

inductive Phase where
  | PS | PT | PU | PV
  deriving DecidableEq

structure Frame (num : Type) where
  p : Phase
  l : List (num × num)
  a : num
  r : List (num × num)

def push (o : Ops) (x n : o.num) (l : List (o.num × o.num)) : List (o.num × o.num) :=
  if o.eq n (o.con 0) then l else
  match l with
  | (y, m) :: l' => if o.eq x y then (y, o.add n m) :: l' else (x, n) :: l
  | [] => [(x, n)]

def pop (o : Ops) : List (o.num × o.num) → Option (o.num × List (o.num × o.num))
  | [] => some (o.con 0, [])
  | (x, n) :: l' =>
    if o.eq n (o.con 0) then pop o l'
    else match o.sub n (o.con 1) with
      | some n' => some (x, if o.eq n' (o.con 0) then l' else (x, n') :: l')
      | none => none

def near (o : Ops) : List (o.num × o.num) → o.num
  | [] => o.con 0
  | (x, _) :: _ => x

def expand (o : Ops) (v : o.num → Nat) : List (o.num × o.num) → List Nat
  | [] => []
  | (x, n) :: l' => List.replicate (v n) (v x) ++ expand o v l'

def meaning (o : Ops) (v : o.num → Nat) (x : Frame o.num) : Cfg (Fin 2) (Fin 6) :=
  match x.p with
  | .PS => CfgS (expand o v x.l) (v x.a) (expand o v x.r)
  | .PT => CfgT (expand o v x.l) (v x.a) (expand o v x.r)
  | .PU => CfgU (expand o v x.l) (v x.a) (expand o v x.r)
  | .PV => CfgV (expand o v x.l) (v x.a) (expand o v x.r)

theorem push_ok (o : Ops) (v : o.num → Nat) (H : Laws o v) (x n : o.num) (l : List (o.num × o.num)) :
    expand o v (push o x n l) = List.replicate (v n) (v x) ++ expand o v l := by
  unfold push
  cases h1 : o.eq n (o.con 0)
  · simp only [Bool.false_eq_true, ↓reduceIte]
    cases l with
    | nil => simp [expand]
    | cons ym l' =>
      rcases ym with ⟨y, m⟩
      cases h2 : o.eq x y
      · simp [h2, expand]
      · simp only [h2, ↓reduceIte, expand, H.add_ok, H.eq_ok _ _ h2, List.replicate_add, List.append_assoc]
  · simp only [↓reduceIte, H.eq_ok _ _ h1, H.con_ok, List.replicate_zero, List.nil_append]

theorem pop_ok (o : Ops) (v : o.num → Nat) (H : Laws o v) (l : List (o.num × o.num)) (x : o.num) (l' : List (o.num × o.num))
    (hp : pop o l = some (x, l')) :
    LC (expand o v l) = LC (v x :: expand o v l') ∧ RC (expand o v l) = RC (v x :: expand o v l') := by
  induction l generalizing x l' with
  | nil =>
    simp only [pop, Option.some.injEq, Prod.mk.injEq] at hp
    rcases hp with ⟨rfl, rfl⟩
    simp only [expand, H.con_ok]
    exact ⟨Lblank, Rblank []⟩
  | cons yn l ih =>
    rcases yn with ⟨y, n⟩
    simp only [pop] at hp
    cases h1 : o.eq n (o.con 0)
    · simp only [h1, Bool.false_eq_true, ↓reduceIte] at hp
      cases h2 : o.sub n (o.con 1) with
      | none => simp [h2] at hp
      | some k =>
        simp only [h2, Option.some.injEq, Prod.mk.injEq] at hp
        rcases hp with ⟨rfl, rfl⟩
        have hk := H.sub_ok n (o.con 1) k h2
        rw [H.con_ok] at hk
        cases h3 : o.eq k (o.con 0)
        · simp only [h3, Bool.false_eq_true, ↓reduceIte, expand, ← hk, List.replicate_succ, List.cons_append, and_self]
        · simp only [h3, ↓reduceIte, expand, ← hk, H.eq_ok _ _ h3, H.con_ok, List.replicate, List.cons_append, List.nil_append, and_self]
    · simp only [h1, ↓reduceIte] at hp
      simp only [expand, H.eq_ok _ _ h1, H.con_ok, List.replicate_zero, List.nil_append]
      exact ih x l' hp

def drain_T (o : Ops) : Nat → List (o.num × o.num) → o.num → List (o.num × o.num) →
    List (o.num × o.num) × o.num × List (o.num × o.num)
  | 0, l, a, r2 => (l, a, r2)
  | fuel + 1, l, a, (d2, n2) :: (d1, k) :: r3 =>
    if o.eq d2 (o.con 2) && o.eq n2 (o.con 1) && o.eq d1 (o.con 1) then
      drain_T o fuel (push o (o.add (o.con 2) a) (o.con 1) l) (o.add k k) r3
    else
      (l, a, (d2, n2) :: (d1, k) :: r3)
  | _ + 1, l, a, r2 => (l, a, r2)

theorem drain_T_spec (o : Ops) (v : o.num → Nat) (H : Laws o v) (fuel : Nat)
    (l : List (o.num × o.num)) (a : o.num) (r2 : List (o.num × o.num)) :
    let res := drain_T o fuel l a r2
    ReachesStar target_tm
      (CfgT (expand o v l) (v a) (0 :: expand o v r2))
      (CfgT (expand o v res.1) (v res.2.1) (0 :: expand o v res.2.2)) := by
  induction fuel generalizing l a r2 with
  | zero => exact ReachesStar.refl _ _
  | succ fuel ih =>
    rcases r2 with _ | ⟨⟨d2, n2⟩, _ | ⟨⟨d1, k⟩, r3⟩⟩
    · exact ReachesStar.refl _ _
    · exact ReachesStar.refl _ _
    · dsimp only [drain_T]
      cases h1 : o.eq d2 (o.con 2) <;> cases h2 : o.eq n2 (o.con 1) <;> cases h3 : o.eq d1 (o.con 1) <;>
        simp only [Bool.and_self, Bool.and_false, Bool.false_and, Bool.false_eq_true, ↓reduceIte]
      any_goals exact ReachesStar.refl _ _
      have hd2 := H.eq_ok _ _ h1; rw [H.con_ok] at hd2
      have hn2 := H.eq_ok _ _ h2; rw [H.con_ok] at hn2
      have hd1 := H.eq_ok _ _ h3; rw [H.con_ok] at hd1
      have hexp : expand o v ((d2, n2) :: (d1, k) :: r3) = 2 :: (List.replicate (v k) 1 ++ expand o v r3) := by
        simp only [expand, hd2, hn2, hd1, List.replicate, List.cons_append, List.nil_append]
      rw [hexp]
      refine (T_21_lemma (v k) (expand o v l) (v a) (expand o v r3)).trans ?_
      have hpush : expand o v (push o (o.add (o.con 2) a) (o.con 1) l) = (2 + v a) :: expand o v l := by
        simp only [push_ok o v H, H.con_ok, H.add_ok, List.replicate, List.cons_append, List.nil_append]
      have hadd : v (o.add k k) = v k * 2 := by
        rw [H.add_ok]; omega
      rw [← hpush, ← hadd]
      exact ih (push o (o.add (o.con 2) a) (o.con 1) l) (o.add k k) r3

def step_PV (o : Ops) (l : List (o.num × o.num)) (a : o.num) (r : List (o.num × o.num)) :
    Option (Option (Frame o.num)) :=
  if Nat.beq (o.sample a) 0 then
    if o.eq a (o.con 0) then
      match pop o l with
      | some (x, l') => some (some ⟨.PT, l', o.add (o.con 1) x, r⟩)
      | none => none
    else none
  else if Nat.beq (o.sample a) 1 then
    if o.eq a (o.con 1) then some none else none
  else
    match o.sub a (o.con 2) with
    | some a' => some (some ⟨.PU, l, a', push o (o.con 1) (o.con 1) r⟩)
    | none => none

theorem step_PV_spec (o : Ops) (v : o.num → Nat) (H : Laws o v)
    (l : List (o.num × o.num)) (a : o.num) (r : List (o.num × o.num)) :
    match step_PV o l a r with
    | some (some y) => ReachesStar target_tm (CfgV (expand o v l) (v a) (expand o v r)) (meaning o v y)
    | some none => HaltsFrom target_tm (CfgV (expand o v l) (v a) (expand o v r))
    | none => True := by
  unfold step_PV
  split_ifs with h1 h2 h3 h4
  · cases hp : pop o l with
    | none => trivial
    | some xl =>
      rcases xl with ⟨x, l'⟩
      dsimp only [meaning]
      have ha := H.eq_ok _ _ h2; rw [H.con_ok] at ha
      have hpop := (pop_ok o v H l x l' hp).1
      rw [ha, CfgV, hpop, ← CfgV, H.add_ok, H.con_ok]
      exact Vzero (expand o v l') (v x) (expand o v r)
  · trivial
  · have ha := H.eq_ok _ _ h4; rw [H.con_ok] at ha
    rw [ha]
    exact HV (expand o v l) (expand o v r)
  · trivial
  · cases hs : o.sub a (o.con 2) with
    | none => trivial
    | some a' =>
      dsimp only [meaning]
      have hsub := H.sub_ok a (o.con 2) a' hs; rw [H.con_ok] at hsub
      have ha : v a = 2 + v a' := by omega
      rw [ha, push_ok o v H, H.con_ok]
      simpa [List.replicate] using Vpos (expand o v l) (v a') (expand o v r)

def step_PU (o : Ops) (l : List (o.num × o.num)) (a : o.num) (r : List (o.num × o.num)) :
    Option (Option (Frame o.num)) :=
  if Nat.blt 0 (o.sample a) then
    match o.sub a (o.con 1) with
    | some a' => some (some ⟨.PS, l, a', push o (o.con 0) (o.con 1) r⟩)
    | none => none
  else if o.eq a (o.con 0) then
    match pop o l, pop o r with
    | some (x, l'), some (c, r') =>
      some (some ⟨.PV, l', x, push o (o.add (o.con 1) c) (o.con 1) r'⟩)
    | _, _ => none
  else none

theorem step_PU_spec (o : Ops) (v : o.num → Nat) (H : Laws o v)
    (l : List (o.num × o.num)) (a : o.num) (r : List (o.num × o.num)) :
    match step_PU o l a r with
    | some (some y) => ReachesStar target_tm (CfgU (expand o v l) (v a) (expand o v r)) (meaning o v y)
    | some none => HaltsFrom target_tm (CfgU (expand o v l) (v a) (expand o v r))
    | none => True := by
  unfold step_PU
  split_ifs with h1 h2
  · cases hs : o.sub a (o.con 1) with
    | none => trivial
    | some a' =>
      dsimp only [meaning]
      have hsub := H.sub_ok a (o.con 1) a' hs; rw [H.con_ok] at hsub
      have ha : v a = 1 + v a' := by omega
      rw [ha, push_ok o v H]
      simpa [List.replicate, H.con_ok] using Upos (expand o v l) (v a') (expand o v r)
  · cases hpl : pop o l with
    | none => trivial
    | some xl =>
      cases hpr : pop o r with
      | none => trivial
      | some cr =>
        rcases xl with ⟨x, l'⟩; rcases cr with ⟨c, r'⟩
        dsimp only [meaning]
        have ha := H.eq_ok _ _ h2; rw [H.con_ok] at ha
        rw [ha, CfgU, (pop_ok o v H l x l' hpl).1, (pop_ok o v H r c r' hpr).2, ← CfgU]
        rw [push_ok o v H]
        simpa [List.replicate, H.con_ok, H.add_ok] using Uzero (expand o v l') (v x) (v c) (expand o v r')
  · trivial

def step_PT (o : Ops) (l : List (o.num × o.num)) (a : o.num) (r : List (o.num × o.num)) :
    Option (Option (Frame o.num)) :=
  match pop o r with
  | some (c, r') =>
    if Nat.blt 0 (o.sample c) then
      match o.sub c (o.con 1) with
      | some n =>
        some (some ⟨.PT, push o (o.con 0) n (push o a (o.con 1) l), o.con 0,
          push o (o.con 0) (o.con 1) r'⟩)
      | none => none
    else if o.eq c (o.con 0) then
      match r' with
      | (d, n) :: r'' =>
        if Nat.beq (o.sample d) 1 then
          if o.eq d (o.con 1) then
            some (some ⟨.PT, l, o.add a (o.add n n), push o (o.con 0) (o.con 1) r''⟩)
          else none
        else
          match pop o ((d, n) :: r'') with
          | some (d0, r2) =>
            if Nat.beq (o.sample d0) 0 then
              if o.eq d0 (o.con 0) then
                some (some ⟨.PU, l, a, push o (o.con 1) (o.con 1) r2⟩)
              else none
            else
              match o.sub d0 (o.con 1) with
              | some d' =>
                some (some ⟨.PT, l, o.add (o.con 2) a, push o d' (o.con 1) r2⟩)
              | none => none
          | none => none
      | [] => some (some ⟨.PU, l, a, push o (o.con 1) (o.con 1) []⟩)
    else none
  | none => none

theorem step_PT_spec (o : Ops) (v : o.num → Nat) (H : Laws o v)
    (l : List (o.num × o.num)) (a : o.num) (r : List (o.num × o.num)) :
    match step_PT o l a r with
    | some (some y) => ReachesStar target_tm (CfgT (expand o v l) (v a) (expand o v r)) (meaning o v y)
    | some none => HaltsFrom target_tm (CfgT (expand o v l) (v a) (expand o v r))
    | none => True := by
  unfold step_PT
  cases hpr : pop o r with
  | none => trivial
  | some cr =>
    rcases cr with ⟨c, r'⟩
    dsimp only
    have hrc := (pop_ok o v H r c r' hpr).2
    split_ifs with h1 h2
    · cases hs : o.sub c (o.con 1) with
      | none => trivial
      | some n =>
        dsimp only [meaning]
        have hsub := H.sub_ok c (o.con 1) n hs; rw [H.con_ok] at hsub
        have hc : v c = 1 + v n := by omega
        rw [CfgT, hrc, ← CfgT, hc]
        rw [push_ok o v H, push_ok o v H, push_ok o v H]
        simpa [List.replicate, H.con_ok] using Trights (v n) (expand o v l) (v a) (expand o v r')
    · have hc := H.eq_ok _ _ h2; rw [H.con_ok] at hc
      cases r' with
      | nil =>
        dsimp only [meaning]
        rw [CfgT, hrc, hc, expand, Rblank [0], ← CfgT]
        rw [push_ok o v H, expand]
        simpa [List.replicate, H.con_ok] using Tzero (expand o v l) (v a) []
      | cons dn r'' =>
        rcases dn with ⟨d, n⟩
        dsimp only
        split_ifs with h3 h4
        · dsimp only [meaning]
          have hd := H.eq_ok _ _ h4; rw [H.con_ok] at hd
          rw [CfgT, hrc, hc, expand, hd, ← CfgT]
          rw [push_ok o v H, H.add_ok, H.add_ok]
          have ha : v a + (v n + v n) = v n * 2 + v a := by omega
          rw [ha]
          simpa [List.replicate, H.con_ok] using Tmixs (v n) (expand o v l) (v a) (expand o v r'')
        · trivial
        · cases hpr2 : pop o ((d, n) :: r'') with
          | none => trivial
          | some dr2 =>
            rcases dr2 with ⟨d0, r2⟩
            dsimp only
            have hrc2 := (pop_ok o v H ((d, n) :: r'') d0 r2 hpr2).2
            split_ifs with h5 h6
            · dsimp only [meaning]
              have hd0 := H.eq_ok _ _ h6; rw [H.con_ok] at hd0
              rw [CfgT, hrc, hc, RC, hrc2, hd0, ← RC, ← CfgT]
              rw [push_ok o v H]
              simpa [List.replicate, H.con_ok] using Tzero (expand o v l) (v a) (expand o v r2)
            · trivial
            · cases hs2 : o.sub d0 (o.con 1) with
              | none => trivial
              | some d' =>
                dsimp only [meaning]
                have hsub := H.sub_ok d0 (o.con 1) d' hs2; rw [H.con_ok] at hsub
                have hd0 : v d0 = 1 + v d' := by omega
                rw [CfgT, hrc, hc, RC, hrc2, hd0, ← RC, ← CfgT]
                rw [push_ok o v H]
                simpa [List.replicate, H.con_ok, H.add_ok] using Tmix (expand o v l) (v a) (v d') (expand o v r2)
    · trivial

def step_PS_odd3 (o : Ops) (l : List (o.num × o.num)) (a : o.num) (r : List (o.num × o.num)) :
    Option (Option (Frame o.num)) :=
  match o.sub a (o.con 7), pop o l, pop o r with
  | some b, some (xv, l'), some (c, r') =>
    match o.div b 4 with
    | some (n, 0) =>
      if o.eq c (o.con 0) then
        some (some ⟨.PS, l', o.add xv (o.add (o.add n n) (o.con 1)),
          push o (o.con 0) (o.con 1)
            (push o (o.con 1) (o.con 1)
              (push o (o.con 2) (o.con 1)
                (push o (o.con 1) (o.add n (o.con 1)) r')))⟩)
      else none
    | some (_, _ + 1) => none
    | none => none
  | _, _, _ => none

theorem step_PS_odd3_spec (o : Ops) (v : o.num → Nat) (H : Laws o v)
    (l : List (o.num × o.num)) (a : o.num) (r : List (o.num × o.num)) :
    match step_PS_odd3 o l a r with
    | some (some y) => ReachesStar target_tm (CfgS (expand o v l) (v a) (expand o v r)) (meaning o v y)
    | some none => HaltsFrom target_tm (CfgS (expand o v l) (v a) (expand o v r))
    | none => True := by
  unfold step_PS_odd3
  cases hs : o.sub a (o.con 7) with
  | none => trivial
  | some b =>
    cases hpl : pop o l with
    | none => trivial
    | some xvl' =>
      cases hpr : pop o r with
      | none => trivial
      | some cr' =>
        rcases xvl' with ⟨xv, l'⟩; rcases cr' with ⟨c, r'⟩
        dsimp only
        cases hd : o.div b 4 with
        | none => trivial
        | some nd =>
          rcases nd with ⟨n, d⟩
          cases d with
          | succ d => trivial
          | zero =>
            dsimp only
            split_ifs with hc0
            · dsimp only [meaning]
              have hsub := H.sub_ok a (o.con 7) b hs; rw [H.con_ok] at hsub
              have hdiv := H.div_ok b 4 n 0 hd
              have ha : v a = v n * 4 + 7 := by omega
              have hc := H.eq_ok _ _ hc0; rw [H.con_ok] at hc
              rw [CfgS, (pop_ok o v H l xv l' hpl).1, (pop_ok o v H r c r' hpr).2, hc, ← CfgS, ha]
              rw [push_ok o v H, push_ok o v H, push_ok o v H, push_ok o v H]
              have hna : v (o.add xv (o.add (o.add n n) (o.con 1))) = v xv + v n * 2 + 1 := by
                simp only [H.add_ok, H.con_ok]; omega
              rw [hna]
              simpa [List.replicate, H.con_ok, H.add_ok] using S_odd3_lemma (v n) (expand o v l') (v xv) (expand o v r')
            · trivial

def step_PS_odd1_qmr2 (o : Ops) (q1 : o.num) (r' : List (o.num × o.num)) : o.num × List (o.num × o.num) :=
  match r' with
  | (d1, m) :: r2 => if o.eq d1 (o.con 1) then (o.add q1 m, r2) else (q1, r')
  | [] => (q1, [])

def step_PS_odd1_finish (o : Ops) : List (o.num × o.num) × o.num × List (o.num × o.num) →
    Option (Option (Frame o.num))
  | (l2, a2, []) =>
    if Nat.ble 1 (o.sample a2) then
      match o.sub a2 (o.con 1) with
      | some a3 => some (some ⟨.PS, l2, a3, [(o.con 0, o.con 1), (o.con 1, o.con 1)]⟩)
      | none => some (some ⟨.PT, l2, a2, push o (o.con 0) (o.con 1) []⟩)
    else some (some ⟨.PT, l2, a2, push o (o.con 0) (o.con 1) []⟩)
  | (l2, a2, r3) => some (some ⟨.PT, l2, a2, push o (o.con 0) (o.con 1) r3⟩)

theorem S_odd1_q_lemma (q1 m : Nat) (l : List Nat) (x : Nat) (r : List Nat) :
    ReachesStar target_tm (CfgS (x :: l) (q1 * 4 + 1) (0 :: (List.replicate m 1 ++ r)))
      (CfgT l ((q1 + m) * 2 + (2 + (q1 * 2 + x))) (0 :: r)) := by
  have h1 : q1 * 4 + 1 = q1 * 4 + 1 + 0 * 2 := by omega
  rw [h1]
  refine (Incs q1 0 l x (List.replicate m 1 ++ r)).trans ?_
  refine (Sone l (q1 * 2 + x) (0 :: (List.replicate q1 1 ++ (List.replicate m 1 ++ r)))).trans ?_
  have h3 : List.replicate q1 1 ++ (List.replicate m 1 ++ r) = List.replicate (q1 + m) 1 ++ r := by
    rw [← List.append_assoc, ← List.replicate_add]
  rw [h3]
  exact Tmixs (q1 + m) l (2 + (q1 * 2 + x)) r

def step_PS_odd1 (o : Ops) (l : List (o.num × o.num)) (a : o.num) (r : List (o.num × o.num)) :
    Option (Option (Frame o.num)) :=
  match o.sub a (o.con 1), pop o l, pop o r with
  | some b, some (xv, l'), some (c, r') =>
    match o.div b 4 with
    | some (q1, 0) =>
      if o.eq c (o.con 0) then
        let qmr2 := step_PS_odd1_qmr2 o q1 r'
        let a_init := o.add (o.add qmr2.1 qmr2.1) (o.add (o.con 2) (o.add (o.add q1 q1) xv))
        step_PS_odd1_finish o (drain_T o 64 l' a_init qmr2.2)
      else none
    | some (_, _ + 1) => none
    | none => none
  | _, _, _ => none

theorem step_PS_odd1_spec (o : Ops) (v : o.num → Nat) (H : Laws o v)
    (l : List (o.num × o.num)) (a : o.num) (r : List (o.num × o.num)) :
    match step_PS_odd1 o l a r with
    | some (some y) => ReachesStar target_tm (CfgS (expand o v l) (v a) (expand o v r)) (meaning o v y)
    | some none => HaltsFrom target_tm (CfgS (expand o v l) (v a) (expand o v r))
    | none => True := by
  unfold step_PS_odd1
  cases hs : o.sub a (o.con 1) with
  | none => trivial
  | some b =>
    cases hpl : pop o l with
    | none => trivial
    | some xvl' =>
      cases hpr : pop o r with
      | none => trivial
      | some cr' =>
        rcases xvl' with ⟨xv, l'⟩; rcases cr' with ⟨c, r'⟩
        dsimp only
        cases hd : o.div b 4 with
        | none => trivial
        | some nd =>
          rcases nd with ⟨q1, d⟩
          cases d with
          | succ d => trivial
          | zero =>
            dsimp only
            cases hc0 : o.eq c (o.con 0)
            · simp only [Bool.false_eq_true, ↓reduceIte]
            · simp only [↓reduceIte]
              have hsub := H.sub_ok a (o.con 1) b hs; rw [H.con_ok] at hsub
              have hdiv := H.div_ok b 4 q1 0 hd
              have ha : v a = v q1 * 4 + 1 := by omega
              have hc := H.eq_ok _ _ hc0; rw [H.con_ok] at hc
              rw [CfgS, (pop_ok o v H l xv l' hpl).1, (pop_ok o v H r c r' hpr).2, hc, ← CfgS, ha]
              let qmr2 := step_PS_odd1_qmr2 o q1 r'
              let a_init := o.add (o.add qmr2.1 qmr2.1) (o.add (o.con 2) (o.add (o.add q1 q1) xv))
              have hstep1 : ReachesStar target_tm
                  (CfgS (v xv :: expand o v l') (v q1 * 4 + 1) (0 :: expand o v r'))
                  (CfgT (expand o v l') (v a_init) (0 :: expand o v qmr2.2)) := by
                cases r' with
                | nil =>
                  have ha_init : v a_init = (v q1 + 0) * 2 + (2 + (v q1 * 2 + v xv)) := by
                    dsimp [a_init, qmr2, step_PS_odd1_qmr2]; simp only [H.add_ok, H.con_ok]; omega
                  rw [ha_init]
                  simpa [qmr2, step_PS_odd1_qmr2, expand] using S_odd1_q_lemma (v q1) 0 (expand o v l') (v xv) []
                | cons d1m r2 =>
                  rcases d1m with ⟨d1, m⟩
                  dsimp only [qmr2, step_PS_odd1_qmr2]
                  cases hd1 : o.eq d1 (o.con 1)
                  · simp only [hd1, Bool.false_eq_true, ↓reduceIte]
                    have ha_init : v a_init = (v q1 + 0) * 2 + (2 + (v q1 * 2 + v xv)) := by
                      dsimp [a_init, qmr2, step_PS_odd1_qmr2]; simp only [hd1, Bool.false_eq_true, ↓reduceIte, H.add_ok, H.con_ok]; omega
                    rw [ha_init]
                    simpa using S_odd1_q_lemma (v q1) 0 (expand o v l') (v xv) (expand o v ((d1, m) :: r2))
                  · simp only [hd1, ↓reduceIte]
                    have hd1_eq := H.eq_ok _ _ hd1; rw [H.con_ok] at hd1_eq
                    have ha_init : v a_init = (v q1 + v m) * 2 + (2 + (v q1 * 2 + v xv)) := by
                      dsimp [a_init, qmr2, step_PS_odd1_qmr2]; simp only [hd1, ↓reduceIte, H.add_ok, H.con_ok]; omega
                    rw [ha_init, expand, hd1_eq]
                    exact S_odd1_q_lemma (v q1) (v m) (expand o v l') (v xv) (expand o v r2)
              have hdrain := drain_T_spec o v H 64 l' a_init qmr2.2
              have hstep2 := hstep1.trans hdrain
              generalize hres : drain_T o 64 l' a_init qmr2.2 = res at hstep2 ⊢
              rcases res with ⟨l2, a2, r3⟩
              dsimp only [step_PS_odd1_finish] at hstep2 ⊢
              cases r3 with
              | cons x xs =>
                dsimp only [meaning]
                rw [push_ok o v H]
                simpa [List.replicate, H.con_ok] using hstep2
              | nil =>
                dsimp only
                split_ifs with hge
                · cases hs2 : o.sub a2 (o.con 1) with
                  | none =>
                    dsimp only [meaning]
                    rw [push_ok o v H]
                    simpa [List.replicate, H.con_ok] using hstep2
                  | some a3 =>
                    dsimp only [meaning]
                    have hsub2 := H.sub_ok a2 (o.con 1) a3 hs2; rw [H.con_ok] at hsub2
                    have ha2 : v a2 = 1 + v a3 := by omega
                    rw [expand, ha2] at hstep2
                    refine hstep2.trans ?_
                    simpa [expand, List.replicate, H.con_ok] using T_end_lemma (expand o v l2) (v a3)
                · dsimp only [meaning]
                  rw [push_ok o v H]
                  simpa [List.replicate, H.con_ok] using hstep2

def step_PS_even_empty (o : Ops) (a : o.num) (r : List (o.num × o.num)) : Option (Frame o.num) :=
  match r with
  | (z, nz) :: r1 =>
    if o.eq z (o.con 0) && o.eq nz (o.con 1) then
      match o.sub a (o.con 2) with
      | some b =>
        match o.div b 2 with
        | some (q, 0) =>
          let (m1, r2) :=
            match r1 with
            | (d1, m) :: r2 => if o.eq d1 (o.con 1) then (o.add m (o.con 1), r2) else (o.con 1, r1)
            | [] => (o.con 1, [])
          some ⟨.PS, [(o.con 0, o.con 1), (o.con 1, o.con 1)],
            o.add (o.add q q) (o.con 1),
            push o (o.con 0) (o.con 1) (push o (o.con 1) m1 r2)⟩
        | _ => none
      | none => none
    else none
  | [] => none

theorem step_PS_even_empty_spec (o : Ops) (v : o.num → Nat) (H : Laws o v)
    (a : o.num) (r : List (o.num × o.num)) (y : Frame o.num)
    (h : step_PS_even_empty o a r = some y) :
    ReachesStar target_tm (CfgS [] (v a) (expand o v r)) (meaning o v y) := by
  unfold step_PS_even_empty at h
  rcases r with _ | ⟨⟨z, nz⟩, r1⟩; · simp at h
  dsimp only at h
  cases hz : o.eq z (o.con 0) <;> cases hnz : o.eq nz (o.con 1) <;>
    simp only [hz, hnz, Bool.and_self, Bool.and_false, Bool.false_and, Bool.false_eq_true, ↓reduceIte] at h <;>
    try contradiction
  cases hs : o.sub a (o.con 2) with
  | none => simp [hs] at h
  | some b =>
    rw [hs] at h
    dsimp only at h
    cases hd : o.div b 2 with
    | none => simp [hd] at h
    | some qd =>
      rcases qd with ⟨q, d⟩
      cases d with
      | succ d => simp [hd] at h
      | zero =>
        simp only [hd, Option.some.injEq] at h
        subst h
        dsimp only [meaning]
        have hzv := H.eq_ok _ _ hz; rw [H.con_ok] at hzv
        have hnzv := H.eq_ok _ _ hnz; rw [H.con_ok] at hnzv
        have hsub := H.sub_ok a (o.con 2) b hs; rw [H.con_ok] at hsub
        have hdiv := H.div_ok b 2 q 0 hd
        have ha : v a = (v q + 1) * 2 := by omega
        have hq : v (o.add (o.add q q) (o.con 1)) = v q * 2 + 1 := by
          simp only [H.add_ok, H.con_ok]; omega
        have hl : expand o v [(o.con 0, o.con 1), (o.con 1, o.con 1)] = [0, 1] := by
          simp [expand, H.con_ok]
        rw [ha, hq, hl, expand, hzv, hnzv, List.replicate, List.replicate, List.singleton_append]
        rw [push_ok o v H, push_ok o v H]
        cases r1 with
        | nil =>
          simpa [List.replicate, H.con_ok, expand] using S_even_empty_lemma (v q) 0 []
        | cons d1m r2 =>
          rcases d1m with ⟨d1, m⟩
          dsimp only
          cases hd1 : o.eq d1 (o.con 1)
          · simp only [hd1, Bool.false_eq_true, ↓reduceIte]
            simpa [List.replicate, H.con_ok] using S_even_empty_lemma (v q) 0 (expand o v ((d1, m) :: r2))
          · simp only [hd1, ↓reduceIte]
            have hd1v := H.eq_ok _ _ hd1; rw [H.con_ok] at hd1v
            rw [expand, hd1v]
            simpa [List.replicate, H.con_ok, H.add_ok] using S_even_empty_lemma (v q) (v m) (expand o v r2)

def step_PS_base (o : Ops) (l : List (o.num × o.num)) (a : o.num) (r : List (o.num × o.num)) :
    Option (Option (Frame o.num)) :=
  if Nat.ble 2 (o.sample a) then
    match o.div a 2 with
    | some (n, d) => some (some ⟨.PS, l, o.con d, push o (o.con 1) n r⟩)
    | none => none
  else if Nat.beq (o.sample a) 1 then
    if o.eq a (o.con 1) then
      match pop o l with
      | some (x, l') => some (some ⟨.PT, l', o.add (o.con 2) x, r⟩)
      | none => none
    else none
  else if o.eq a (o.con 0) then
    match pop o l with
    | some (x, l') =>
      if Nat.blt 0 (o.sample x) then
        match o.sub x (o.con 1), pop o r with
        | some x', some (c, r') =>
          some (some ⟨.PS, l', x', push o (o.add (o.con 2) c) (o.con 1) r'⟩)
        | _, _ => none
      else if o.eq x (o.con 0) then
        match pop o l' with
        | some (y, l'') => some (some ⟨.PU, l'', y, push o (o.con 1) (o.con 1) r⟩)
        | none => none
      else none
    | none => none
  else none

theorem step_PS_base_spec (o : Ops) (v : o.num → Nat) (H : Laws o v)
    (l : List (o.num × o.num)) (a : o.num) (r : List (o.num × o.num)) :
    match step_PS_base o l a r with
    | some (some y) => ReachesStar target_tm (CfgS (expand o v l) (v a) (expand o v r)) (meaning o v y)
    | some none => HaltsFrom target_tm (CfgS (expand o v l) (v a) (expand o v r))
    | none => True := by
  unfold step_PS_base
  split_ifs with h1 h2 h3 h4
  · cases hd : o.div a 2 with
    | none => trivial
    | some nd =>
      rcases nd with ⟨n, d⟩
      dsimp only [meaning]
      have hdiv := H.div_ok a 2 n d hd
      rw [← hdiv, H.con_ok, push_ok o v H, H.con_ok]
      exact Slefts (v n) (expand o v l) d (expand o v r)
  · cases hpl : pop o l with
    | none => trivial
    | some xl' =>
      rcases xl' with ⟨x, l'⟩
      dsimp only [meaning]
      have ha := H.eq_ok _ _ h3; rw [H.con_ok] at ha
      rw [CfgS, (pop_ok o v H l x l' hpl).1, ha, ← CfgS, H.add_ok, H.con_ok]
      exact Sone (expand o v l') (v x) (expand o v r)
  · trivial
  · cases hpl : pop o l with
    | none => trivial
    | some xl' =>
      rcases xl' with ⟨x, l'⟩
      dsimp only
      have ha := H.eq_ok _ _ h4; rw [H.con_ok] at ha
      have hlc := (pop_ok o v H l x l' hpl).1
      split_ifs with h5 h6
      · cases hs : o.sub x (o.con 1) with
        | none => trivial
        | some x' =>
          cases hpr : pop o r with
          | none => trivial
          | some cr' =>
            rcases cr' with ⟨c, r'⟩
            dsimp only [meaning]
            have hsub := H.sub_ok x (o.con 1) x' hs; rw [H.con_ok] at hsub
            have hx : v x = 1 + v x' := by omega
            rw [CfgS, hlc, (pop_ok o v H r c r' hpr).2, ha, hx, ← CfgS]
            rw [push_ok o v H]
            simpa [List.replicate, H.con_ok, H.add_ok] using Sleft (expand o v l') (v x') (v c) (expand o v r')
      · cases hpl2 : pop o l' with
        | none => trivial
        | some yl'' =>
          rcases yl'' with ⟨y, l''⟩
          dsimp only [meaning]
          have hx := H.eq_ok _ _ h6; rw [H.con_ok] at hx
          have hlc2 := (pop_ok o v H l' y l'' hpl2).1
          rw [CfgS, hlc, hx, LC, hlc2, ← LC, ha, ← CfgS]
          rw [push_ok o v H]
          simpa [List.replicate, H.con_ok] using Szero (expand o v l'') (v y) (expand o v r)
      · trivial
  · trivial

def step_PS (o : Ops) (l : List (o.num × o.num)) (a : o.num) (r : List (o.num × o.num)) :
    Option (Option (Frame o.num)) :=
  if (Nat.ble 5 (o.sample a) && Nat.beq (o.sample a % 2) 1 || Nat.beq (o.sample a % 4) 1) && Nat.beq (o.sample (near o r)) 0 then
    if o.eq (near o r) (o.con 0) then
      if Nat.beq (o.sample a % 4) 3 && Nat.ble 7 (o.sample a) then
        step_PS_odd3 o l a r
      else if Nat.beq (o.sample a % 4) 1 then
        step_PS_odd1 o l a r
      else none
    else none
  else if Nat.ble 2 (o.sample a) && Nat.beq (o.sample a % 2) 0 then
    match l with
    | [] =>
      match step_PS_even_empty o a r with
      | some y => some (some y)
      | none => step_PS_base o [] a r
    | _ => step_PS_base o l a r
  else step_PS_base o l a r

theorem step_PS_spec (o : Ops) (v : o.num → Nat) (H : Laws o v)
    (l : List (o.num × o.num)) (a : o.num) (r : List (o.num × o.num)) :
    match step_PS o l a r with
    | some (some y) => ReachesStar target_tm (CfgS (expand o v l) (v a) (expand o v r)) (meaning o v y)
    | some none => HaltsFrom target_tm (CfgS (expand o v l) (v a) (expand o v r))
    | none => True := by
  unfold step_PS
  split_ifs with h1 h2 h3 h4 h5
  · exact step_PS_odd3_spec o v H l a r
  · exact step_PS_odd1_spec o v H l a r
  · trivial
  · trivial
  · cases l with
    | cons _ _ => exact step_PS_base_spec o v H _ a r
    | nil =>
      dsimp only
      cases he : step_PS_even_empty o a r with
      | some y => exact step_PS_even_empty_spec o v H a r y he
      | none => exact step_PS_base_spec o v H [] a r
  · exact step_PS_base_spec o v H l a r

def step (o : Ops) (x : Frame o.num) : Option (Option (Frame o.num)) :=
  match x.p with
  | .PS => step_PS o x.l x.a x.r
  | .PT => step_PT o x.l x.a x.r
  | .PU => step_PU o x.l x.a x.r
  | .PV => step_PV o x.l x.a x.r

theorem step_spec (o : Ops) (v : o.num → Nat) (H : Laws o v) (x : Frame o.num) :
    match step o x with
    | some (some y) => ReachesStar target_tm (meaning o v x) (meaning o v y)
    | some none => HaltsFrom target_tm (meaning o v x)
    | none => True := by
  rcases x with ⟨p, l, a, r⟩
  cases p
  · exact step_PS_spec o v H l a r
  · exact step_PT_spec o v H l a r
  · exact step_PU_spec o v H l a r
  · exact step_PV_spec o v H l a r

def withNat {α : Type*} (x : Nat) (k : Nat → α) : α :=
  match x + 1 with
  | 0 => k 0
  | v + 1 => k v

theorem withNat_eq {α : Type*} (x : Nat) (k : Nat → α) : withNat x k = k x := rfl

def nadd (x y : Nat) : Nat := withNat (x + y) id
def nsub (x y : Nat) : Option Nat := if Nat.ble y x then withNat (x - y) some else none
def ndiv (x n : Nat) : Option (Nat × Nat) :=
  if Nat.beq n 0 then none else withNat (x / n) fun q => withNat (x % n) fun r => some (q, r)

abbrev numbers : Ops where
  num := Nat
  sample x := x
  con x := x
  add := nadd
  sub := nsub
  div := ndiv
  eq := Nat.beq

theorem number_laws : Laws numbers id where
  con_ok _ := rfl
  add_ok _ _ := rfl
  sub_ok x y z h := by
    dsimp [numbers, nsub, withNat] at h
    cases hle : Nat.ble y x <;> rw [hle] at h
    · contradiction
    · simp only [↓reduceIte, Option.some.injEq] at h
      subst h
      have := Nat.le_of_ble_eq_true hle
      dsimp [id]; omega
  div_ok x n q d h := by
    dsimp [numbers, ndiv, withNat] at h
    cases hne : Nat.beq n 0 <;> rw [hne] at h
    · simp only [Bool.false_eq_true, ↓reduceIte, Option.some.injEq, Prod.mk.injEq] at h
      rcases h with ⟨rfl, rfl⟩
      dsimp [id]
      rw [Nat.mul_comm]
      exact Nat.div_add_mod x n
    · contradiction
  eq_ok x y h := Nat.eq_of_beq_eq_true h


def den : Frame Nat → Cfg (Fin 2) (Fin 6) := meaning numbers id
def normal (n : Nat) : Frame Nat := ⟨.PS, [], n, [(0, 1), (1, 1)]⟩
def initial : Frame Nat := ⟨.PT, [], 1, []⟩

def cut (o : Ops) (x : Frame o.num) : Option o.num :=
  match x.p, x.l, x.r with
  | .PS, [], [(z, n), (u, m)] =>
    if o.eq z (o.con 0) && o.eq n (o.con 1) && o.eq u (o.con 1) && o.eq m (o.con 1) then
      some x.a
    else none
  | _, _, _ => none

theorem cut_spec (o : Ops) (v : o.num → Nat) (H : Laws o v) (x : Frame o.num) (a : o.num)
    (h : cut o x = some a) :
    meaning o v x = CfgS [] (v a) [0, 1] := by
  rcases x with ⟨p, l, b, r⟩
  cases p <;> try simp [cut] at h
  cases l <;> try simp [cut] at h
  rcases r with _ | ⟨⟨z, n⟩, _ | ⟨⟨u, m⟩, _ | _⟩⟩ <;> try simp [cut] at h
  rcases h with ⟨⟨⟨⟨h1, h2⟩, h3⟩, h4⟩, rfl⟩
  have hz := H.eq_ok _ _ h1; rw [H.con_ok] at hz
  have hn := H.eq_ok _ _ h2; rw [H.con_ok] at hn
  have hu := H.eq_ok _ _ h3; rw [H.con_ok] at hu
  have hm := H.eq_ok _ _ h4; rw [H.con_ok] at hm
  simp [meaning, expand, hz, hn, hu, hm]

def run_to_20Step (x : Frame Nat) (ih : Frame Nat → Bool) : Bool :=
  match step numbers x with
  | some (some y) => ih y
  | _ => false

def run_to_20 : Nat → Frame Nat → Bool
  | 0, _ => false
  | fuel + 1, x =>
    match cut numbers x with
    | some n =>
      if Nat.beq n 20 then true
      else run_to_20Step x (run_to_20 fuel)
    | none => run_to_20Step x (run_to_20 fuel)

theorem run_to_20Step_spec (x : Frame Nat) (ih : Frame Nat → Bool)
    (hih : ∀ y, ih y = true → ReachesStar target_tm (den y) (Cn 20))
    (h : run_to_20Step x ih = true) :
    ReachesStar target_tm (den x) (Cn 20) := by
  unfold run_to_20Step at h
  have hs := step_spec numbers id number_laws x
  cases hst : step numbers x with
  | none => rw [hst] at h; contradiction
  | some oy =>
    cases oy with
    | none => rw [hst] at h; contradiction
    | some y =>
      rw [hst] at h hs
      exact hs.trans (hih y h)

theorem run_to_20_spec (fuel : Nat) (x : Frame Nat) (h : run_to_20 fuel x = true) :
    ReachesStar target_tm (den x) (Cn 20) := by
  induction fuel generalizing x with
  | zero => contradiction
  | succ fuel ih =>
    unfold run_to_20 at h
    cases hcut : cut numbers x with
    | none =>
      rw [hcut] at h
      exact run_to_20Step_spec x (run_to_20 fuel) ih h
    | some n =>
      rw [hcut] at h
      dsimp only at h
      cases h20 : Nat.beq n 20 <;> rw [h20] at h
      · exact run_to_20Step_spec x (run_to_20 fuel) ih h
      · have hn20 : n = 20 := Nat.eq_of_beq_eq_true h20
        subst hn20
        unfold den
        rw [cut_spec numbers id number_laws x 20 hcut]
        exact ReachesStar.refl _ _

def run_to_halt : Nat → Frame Nat → Bool
  | 0, _ => false
  | fuel + 1, x =>
    match step numbers x with
    | some (some y) => run_to_halt fuel y
    | some none => true
    | none => false

theorem run_to_halt_spec (fuel : Nat) (x : Frame Nat) (h : run_to_halt fuel x = true) :
    HaltsFrom target_tm (den x) := by
  induction fuel generalizing x with
  | zero => contradiction
  | succ fuel ih =>
    unfold run_to_halt at h
    have hs := step_spec numbers id number_laws x
    cases hst : step numbers x with
    | none => rw [hst] at h; contradiction
    | some oy =>
      cases oy with
      | none => rw [hst] at hs; exact hs
      | some y =>
        rw [hst] at h hs
        exact HaltsFrom.of_reachesStar hs (ih y h)

theorem phase_a_eq : run_to_20 50 initial = true := by decide +kernel
theorem phase_c_eq : run_to_halt 200 (normal 34357641212) = true := by decide +kernel

