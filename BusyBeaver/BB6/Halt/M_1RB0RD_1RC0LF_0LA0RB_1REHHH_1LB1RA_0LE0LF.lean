/-! ## Tape Encodings and Raw TM Transition Soundness -/

private abbrev Side := ListBlank (Fin 2)

private def fin6OfNat : Nat → Fin 6
  | 0 => 0
  | 1 => 1
  | 2 => 2
  | 3 => 3
  | 4 => 4
  | _ => 5

private def bitToFin2 : Bool → Fin 2
  | false => 0
  | true => 1

private def bitsToFin2 : List Bool → List (Fin 2)
  | [] => []
  | b :: bs => bitToFin2 b :: bitsToFin2 bs

private def bitsToLB (xs : List Bool) (s : Side) : Side :=
  bitsToFin2 xs +> s

private theorem forceN_eq {α : Type} (z : α) (x : Nat) (k : Nat → α) :
    forceN z x k = k x := rfl

private theorem bitsToFin2_append (xs ys : List Bool) :
    bitsToFin2 (xs ++ ys) = bitsToFin2 xs ++ bitsToFin2 ys := by
  induction xs with
  | nil => rfl
  | cons x xs ih => simp [bitsToFin2, ih]

private theorem bitsToLB_nil (s : Side) : bitsToLB [] s = s := rfl

private theorem bitsToLB_cons (b : Bool) (xs : List Bool) (s : Side) :
    bitsToLB (b :: xs) s = bitToFin2 b >> bitsToLB xs s := rfl

private theorem bitsToLB_append (xs ys : List Bool) (s : Side) :
    bitsToLB (xs ++ ys) s = bitsToLB xs (bitsToLB ys s) := by
  unfold bitsToLB
  rw [bitsToFin2_append, listblank_append_right_assoc]

private theorem bitsToLB_consTrim (b : Bool) (xs : List Bool) :
    bitsToLB (consTrim b xs) default = bitToFin2 b >> bitsToLB xs default := by
  cases b <;> cases xs with
  | nil =>
    simp [consTrim, bitsToLB, bitsToFin2, bitToFin2, ListBlank.cons_zero_default]
  | cons y ys => rfl

private theorem revBoolK_eq (xs acc : List Bool) :
    revBoolK xs acc = xs.reverse ++ acc := by
  induction xs generalizing acc with
  | nil => rfl
  | cons x xs ih =>
    simp [revBoolK, ih, List.reverse_cons, List.append_assoc]

private theorem revNatK_eq (xs acc : List Nat) :
    revNatK xs acc = xs.reverse ++ acc := by
  induction xs generalizing acc with
  | nil => rfl
  | cons x xs ih =>
    simp [revNatK, ih, List.reverse_cons, List.append_assoc]

private theorem boolListBeq_eq (xs ys : List Bool) (h : boolListBeq xs ys = true) :
    xs = ys := by
  induction xs generalizing ys with
  | nil =>
    cases ys with
    | nil => rfl
    | cons _ _ => simp [boolListBeq] at h
  | cons x xs ih =>
    cases ys with
    | nil => simp [boolListBeq] at h
    | cons y ys =>
      simp only [boolListBeq, Bool.and_eq_true] at h
      have hxy : x = y := by
        cases x <;> cases y <;> simp [boolEq] at h ⊢
      subst hxy
      exact congrArg (List.cons x) (ih ys h.2)

private theorem tmStepRaw_some {q nq : Nat} {sym w dir : Bool}
    (h : tmStepRaw q sym = some (nq, w, dir)) :
    q < 6 ∧ nq < 6 ∧
    target_tm (fin6OfNat q) (bitToFin2 sym) =
      some (some (fin6OfNat nq), Stmt.write (bitToFin2 w) (if dir then Dir.right else Dir.left)) :=
          by
  match q with
  | 0 | 1 | 2 | 3 | 4 | 5 =>
    cases sym <;> dsimp [tmStepRaw] at h <;> cases h <;> exact ⟨by decide, by decide, rfl⟩
  | q + 6 => simp [tmStepRaw] at h

private theorem tmStepRaw_none {q : Nat} {sym : Bool}
    (hq : q < 6) (h : tmStepRaw q sym = none) :
    target_tm (fin6OfNat q) (bitToFin2 sym) = none := by
  match q with
  | 0 | 1 | 2 | 3 | 4 | 5 =>
    cases sym <;> simp [tmStepRaw] at h <;> rfl
  | q + 6 => omega

private theorem step_raw_right {q nq : Nat} {sym w : Bool}
    (h : tmStepRaw q sym = some (nq, w, true)) (L R : Side) :
    ReachesStar target_tm (Cfg.headRight (fin6OfNat q) L (bitToFin2 sym >> R))
        (Cfg.headRight (fin6OfNat nq) (bitToFin2 w >> L) R) := by
  have ⟨_, _, htm⟩ := tmStepRaw_some h
  exact ReachesStar.single (step_headRight_right (by simpa using htm) L R)

private theorem step_raw_left {q nq : Nat} {sym w : Bool}
    (h : tmStepRaw q sym = some (nq, w, false)) (L R : Side) :
    ReachesStar target_tm (Cfg.headRight (fin6OfNat q) L (bitToFin2 sym >> R))
        (Cfg.headLeft (fin6OfNat nq) L (bitToFin2 w >> R)) := by
  have ⟨_, _, htm⟩ := tmStepRaw_some h
  exact ReachesStar.single (step_headRight_left (by simpa using htm) L R)

/-! ## Link 1 Soundness (`t = 0 -> 6,818`) -/

private theorem rb_head_tail (rb : List Bool) :
    ∃ sym rbT,
      bitsToLB rb default = bitToFin2 sym >> bitsToLB rbT default ∧
      (match rb with | [] => (false, []) | c :: r => (c, r)) = (sym, rbT) := by
  cases rb with
  | nil =>
    exact ⟨false, [], by simp [bitsToLB, bitsToFin2, bitToFin2, ListBlank.cons_zero_default], rfl⟩
  | cons c r => exact ⟨c, r, rfl, rfl⟩

private theorem simRawZip_none (m : Nat) : simRawZip m none = none := by
  cases m with
  | zero => rfl
  | succ _ => rfl

private theorem simRawZipChunks_none (m chunkSize : Nat) :
    simRawZipChunks m chunkSize none = none := by
  induction m with
  | zero => rfl
  | succ m ih =>
    change simRawZipChunks m chunkSize (simRawZip chunkSize none) = none
    rw [simRawZip_none]
    exact ih

private theorem simRawZip1_eq (q : Nat) (lb rb : List Bool) {sym : Bool} {rbT : List Bool}
    (hrb : (match rb with | [] => (false, []) | c :: r => (c, r)) = (sym, rbT)) :
    simRawZip1 q lb rb =
      match tmStepRaw q sym with
      | none => none
      | some (nq, w, true) => some (nq, consTrim w lb, rbT)
      | some (nq, w, false) =>
        let rbW := consTrim w rbT
        match lb with
        | [] => some (nq, [], consTrim false rbW)
        | nl :: lb' => some (nq, lb', nl :: rbW) := by
  cases rb <;> simp only [Prod.mk.injEq] at hrb <;> rcases hrb with ⟨rfl, rfl⟩ <;> rfl

private theorem simRawZip1_sound {q q' : Nat} {lb rb lb' rb' : List Bool}
    (h : simRawZip1 q lb rb = some (q', lb', rb')) :
    ReachesStar target_tm (Cfg.headRight (fin6OfNat q) (bitsToLB lb default) (bitsToLB rb default))
        (Cfg.headRight (fin6OfNat q') (bitsToLB lb' default) (bitsToLB rb' default)) := by
  rcases rb_head_tail rb with ⟨sym, rbT, hrbEq, hrbM⟩
  rw [hrbEq]
  rw [simRawZip1_eq q lb rb hrbM] at h
  rcases hst : tmStepRaw q sym with _ | ⟨nq, w, dir⟩
  · rw [hst] at h; cases h
  · rw [hst] at h
    cases dir with
    | true =>
      dsimp only at h
      injection h with hEq
      rcases Prod.mk.inj hEq with ⟨rfl, hEq2⟩
      rcases Prod.mk.inj hEq2 with ⟨rfl, rfl⟩
      rw [bitsToLB_consTrim]
      exact step_raw_right hst _ _
    | false =>
      dsimp only at h
      have hs := step_raw_left hst (bitsToLB lb default) (bitsToLB rbT default)
      cases lb with
      | nil =>
        dsimp only at h
        injection h with hEq
        rcases Prod.mk.inj hEq with ⟨rfl, hEq2⟩
        rcases Prod.mk.inj hEq2 with ⟨rfl, rfl⟩
        rw [bitsToLB_consTrim, bitsToLB_consTrim]
        refine ReachesStar.trans hs ?_
        have hdef : (bitsToLB [] default : Side) = bitToFin2 false >> bitsToLB [] default := by
          simp [bitsToLB, bitsToFin2, bitToFin2, ListBlank.cons_zero_default]
        conv_lhs => rw [hdef]
        rw [Cfg.headLeft_cons]
      | cons nl lbT =>
        dsimp only at h
        injection h with hEq
        rcases Prod.mk.inj hEq with ⟨rfl, hEq2⟩
        rcases Prod.mk.inj hEq2 with ⟨rfl, rfl⟩
        rw [bitsToLB_cons, bitsToLB_cons, bitsToLB_consTrim]
        refine ReachesStar.trans hs ?_
        rw [bitsToLB_cons, Cfg.headLeft_cons]

private theorem simRawZip_sound (n : Nat) {q q' : Nat} {lb rb lb' rb' : List Bool}
    (h : simRawZip n (some (q, lb, rb)) = some (q', lb', rb')) :
    ReachesStar target_tm (Cfg.headRight (fin6OfNat q) (bitsToLB lb default) (bitsToLB rb default))
        (Cfg.headRight (fin6OfNat q') (bitsToLB lb' default) (bitsToLB rb' default)) := by
  induction n generalizing q lb rb with
  | zero =>
    change some (q, lb, rb) = some (q', lb', rb') at h
    injection h with hEq
    rcases Prod.mk.inj hEq with ⟨rfl, hEq2⟩
    rcases Prod.mk.inj hEq2 with ⟨rfl, rfl⟩
    exact ReachesStar.refl _ _
  | succ n ih =>
    change simRawZip n (simRawZip1 q lb rb) = some (q', lb', rb') at h
    rcases h1 : simRawZip1 q lb rb with _ | ⟨q1, lb1, rb1⟩
    · rw [h1] at h
      rw [simRawZip_none] at h; cases h
    · rw [h1] at h
      exact ReachesStar.trans (simRawZip1_sound h1) (ih h)

private theorem simRawZipChunks_sound (chunks chunkSize : Nat)
    {q q' : Nat} {lb rb lb' rb' : List Bool}
    (h : simRawZipChunks chunks chunkSize (some (q, lb, rb)) = some (q', lb', rb')) :
    ReachesStar target_tm (Cfg.headRight (fin6OfNat q) (bitsToLB lb default) (bitsToLB rb default))
        (Cfg.headRight (fin6OfNat q') (bitsToLB lb' default) (bitsToLB rb' default)) := by
  induction chunks generalizing q lb rb with
  | zero =>
    change some (q, lb, rb) = some (q', lb', rb') at h
    injection h with hEq
    rcases Prod.mk.inj hEq with ⟨rfl, hEq2⟩
    rcases Prod.mk.inj hEq2 with ⟨rfl, rfl⟩
    exact ReachesStar.refl _ _
  | succ k ih =>
    change simRawZipChunks k chunkSize (simRawZip chunkSize (some (q, lb, rb))) =
      some (q', lb', rb') at h
    rcases h1 : simRawZip chunkSize (some (q, lb, rb)) with _ | ⟨q1, lb1, rb1⟩
    · rw [h1] at h
      rw [simRawZipChunks_none] at h; cases h
    · rw [h1] at h
      exact ReachesStar.trans (simRawZip_sound chunkSize h1) (ih h)

private theorem link1_reaches :
