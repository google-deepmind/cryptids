private theorem nat_land_48 (x : Nat) :
    Nat.land x 281474976710655 = x % 281474976710656 := by
  have h := Nat.and_two_pow_sub_one_eq_mod x 48
  simpa using h

private theorem nat_shiftRight_8 (x : Nat) : Nat.shiftRight x 8 = x / 256 := by
  have h := Nat.shiftRight_eq_div_pow x 8
