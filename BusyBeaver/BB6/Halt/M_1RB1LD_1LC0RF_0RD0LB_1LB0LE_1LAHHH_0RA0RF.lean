private theorem link1b_reaches :
    ∃ R0, NodeTape 0 0 (stageInitLid 0) R0 ∧
      ReachesStar target_tm (init ([] : List (Fin 2)))
        (Cfg.headLeft (fin6OfNat (stageInitQ 0)) (bytesToLeft (stageInitBytes 0) default) R0) := by
  have h1 := link1_reaches
  rw [rb303_eq_crysTape, lb303_split, bitsToLB_append, tail0_21_eq_stage0] at h1
  obtain ⟨c1, hcb⟩ := crystal_bounce 0 1 (by decide)
    (bitsToLB [false, false, false, false, false] (bytesToLeft (stageInitBytes 0) default))
  have hv := link1b_valid
  unfold checkLink1b at hv
  rcases hw : simCrysWall 120 1 2 [false, false, false, false, false] [] with _ | ⟨ph', q', rb'⟩
  · rw [hw] at hv; cases hv
  · rw [hw] at hv
    simp only [Bool.and_eq_true] at hv
    have hph' : ph' = crysBasePh (stageInitLid 0) := Nat.eq_of_beq_eq_true hv.1.1
    have hq' : q' = stageInitQ 0 := Nat.eq_of_beq_eq_true hv.1.2
    have hrb' : rb' = crysBaseBits (stageInitLid 0) := boolListBeq_eq rb' _ hv.2
    subst hph'; subst hq'; subst hrb'
    have ⟨_, hrun⟩ := simCrysWall_sound 120 (by decide) hw
    obtain ⟨c2, hrc⟩ := hrun c1 (bytesToLeft (stageInitBytes 0) default)
    refine ⟨bitsToLB (crysBaseBits (stageInitLid 0)) (crysTape (crysBasePh (stageInitLid 0)) c2),
      ⟨c2, rfl⟩, ReachesStar.trans h1 (ReachesStar.trans hcb hrc)⟩


