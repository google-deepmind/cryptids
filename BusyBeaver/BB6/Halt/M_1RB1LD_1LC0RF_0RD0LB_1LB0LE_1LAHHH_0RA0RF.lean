private theorem ruleSound_stage0 (d : Nat) (hd : d ≤ stageDepth 0) : RuleSound 0 d := by
  have r0 : RuleSound 0 0 := ruleSound_stage0_base
  have r1 : RuleSound 0 1 := ruleSound_succ 0 0 r0 (by decide) range_L1
