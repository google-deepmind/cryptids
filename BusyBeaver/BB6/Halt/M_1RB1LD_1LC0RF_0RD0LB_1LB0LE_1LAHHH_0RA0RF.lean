/-! ## Pure-Kernel Evaluators (B8, Link 1, Crystal Base, 14-Stage Wall-Tower DAG, Bridges, Halt) -/

private def forceN {α : Type} (z : α) (x : Nat) (k : Nat → α) : α :=
  @Nat.rec (fun _ => α) z (fun v _ => k v) (Nat.add x 1)

private def revNatK : List Nat → List Nat → List Nat
  | [], acc => acc
  | x :: xs, acc => revNatK xs (x :: acc)

private def revBoolK : List Bool → List Bool → List Bool
  | [], acc => acc
  | x :: xs, acc => revBoolK xs (x :: acc)

private def unpackBytesK : Nat → Nat → List Nat
  | 0, _ => []
  | n + 1, x =>
    forceN [] (Nat.land x 255) fun b =>
    forceN [] (Nat.shiftRight x 8) fun x' =>
      b :: unpackBytesK n x'

private def packBytesK : List Nat → Nat
  | [] => 0
  | b :: bs =>
    forceN 0 (packBytesK bs) fun rest =>
      Nat.add b (Nat.mul 256 rest)

private def unpackTailAux : Nat → Nat → List Nat → Nat × List Nat
  | 0, x, acc => (Nat.land x 255, acc)
  | n + 1, x, acc =>
    forceN (0, []) (Nat.land x 255) fun b =>
    forceN (0, []) (Nat.shiftRight x 8) fun x' =>
      unpackTailAux n x' (b :: acc)

private noncomputable def b8Entry (side : Bool) (q b : Nat) : Nat :=
  Nat.land (Nat.shiftRight (b8Blk side q) (Nat.mul 16 b)) 65535

private inductive SliceOut where
  | exitWall (qOut : Nat) (curB : Nat) (lBytes : List Nat)
  | exitTail (qOut : Nat) (outBits : Nat)
  | halt (qOut : Nat)
  | fail

private noncomputable def simSliceBytes (fuel : Nat) (side : Bool) (q : Nat)
    (rBytes : List Nat) (curB : Nat) (lBytes : List Nat) : SliceOut :=
  @Nat.rec (fun _ => Bool → Nat → List Nat → Nat → List Nat → SliceOut)
    (fun _ _ _ _ _ => SliceOut.fail)
    (fun _ ih s qq rb cb lb =>
      forceN SliceOut.fail (b8Entry s qq cb) fun e =>
      forceN SliceOut.fail (Nat.land e 255) fun outB =>
      forceN SliceOut.fail (Nat.land (Nat.shiftRight e 8) 7) fun qOut =>
      forceN SliceOut.fail (Nat.shiftRight e 11) fun st =>
        match st with
        | 0 =>
          match rb with
          | [] => SliceOut.exitWall qOut outB lb
          | pb :: rb' => ih true qOut rb' pb (outB :: lb)
        | 1 =>
          match lb with
          | [] =>
            forceN SliceOut.fail (packBytesK (revNatK rb [outB])) fun bits =>
              SliceOut.exitTail qOut bits
          | nb :: lb' => ih false qOut (outB :: rb) nb lb'
        | 2 => SliceOut.halt qOut
        | _ => SliceOut.fail)
    fuel side q rBytes curB lBytes

private noncomputable def getRuleFromBlk (rBlk : Nat → Nat) (id q : Nat) : Nat :=
  match q with
  | 0 => Nat.land (entFromBlkF rBlk id) 65535
  | 1 => Nat.land (Nat.shiftRight (entFromBlkF rBlk id) 16) 65535
  | 3 => Nat.land (Nat.shiftRight (entFromBlkF rBlk id) 32) 65535
  | 5 => Nat.land (Nat.shiftRight (entFromBlkF rBlk id) 48) 65535
  | _ => 0

private noncomputable def checkRuleLoop (pCnt : Nat) (pRBlk : Nat → Nat)
    (tgtP tgtS tgtQ : Nat) (fuel : Nat)
    (curP : Nat) (side : Bool) (q : Nat)
    (rb : List Nat) (cb : Nat) (lb : List Nat) : Bool :=
  @Nat.rec (fun _ => Nat → Bool → Nat → List Nat → Nat → List Nat → Bool)
    (fun _ _ _ _ _ _ => false)
    (fun _ ih cp s qq r c l =>
      match simSliceBytes 160 s qq r c l with
      | SliceOut.exitTail qOut outBits =>
        Nat.beq qOut tgtQ && Nat.beq cp tgtP && Nat.beq outBits tgtS
      | SliceOut.exitWall qOut outB l' =>
        @Bool.rec (fun _ => Bool) false
          (forceN false (getRuleFromBlk pRBlk cp qOut) fun pe =>
            @Bool.rec (fun _ => Bool)
              (forceN false (Nat.sub pe 1) fun pe1 =>
               forceN false (Nat.div pe1 5) fun nextP =>
               forceN false (Nat.mod pe1 5) fun nextQ =>
                 ih nextP false nextQ [] outB l')
              false
              (Nat.beq pe 0))
          (Nat.ble (Nat.add cp 1) pCnt)
      | _ => false)
    fuel curP side q rb cb lb

private noncomputable def checkSlot (cntCur pCnt : Nat) (nBlk pRBlk : Nat → Nat)
    (srcP cb0 : Nat) (rb0 : List Nat) (qin e : Nat) : Bool :=
  @Bool.rec (fun _ => Bool)
    (forceN false (Nat.sub e 1) fun e1 =>
     forceN false (Nat.div e1 5) fun idOut =>
     forceN false (Nat.mod e1 5) fun qOut =>
      @Bool.rec (fun _ => Bool) false
        (forceN false (entFromBlkF nBlk idOut) fun tgtW =>
         forceN false (Nat.shiftRight tgtW 48) fun tgtP =>
         forceN false (Nat.land tgtW 281474976710655) fun tgtS =>
           checkRuleLoop pCnt pRBlk tgtP tgtS qOut 360 srcP true qin rb0 cb0 [])
        (Nat.ble (Nat.add idOut 1) cntCur))
    true
    (Nat.beq e 0)

private noncomputable def checkNodeFast (nbytes cntCur pCnt : Nat)
    (nBlk rBlk pRBlk : Nat → Nat) (id : Nat) : Bool :=
  forceN false (entFromBlkF rBlk id) fun rW =>
  forceN false (entFromBlkF nBlk id) fun nW =>
  forceN false (Nat.shiftRight nW 48) fun srcP =>
  forceN false (Nat.land nW 281474976710655) fun srcS =>
  match unpackTailAux (Nat.sub nbytes 1) srcS [] with
  | (cb0, rb0) =>
    forceN false (Nat.land rW 65535) fun e0 =>
    @Bool.rec (fun _ => Bool) false
      (forceN false (Nat.land (Nat.shiftRight rW 16) 65535) fun e1 =>
       @Bool.rec (fun _ => Bool) false
         (forceN false (Nat.land (Nat.shiftRight rW 32) 65535) fun e2 =>
          @Bool.rec (fun _ => Bool) false
            (forceN false (Nat.land (Nat.shiftRight rW 48) 65535) fun e3 =>
              checkSlot cntCur pCnt nBlk pRBlk srcP cb0 rb0 5 e3)
            (checkSlot cntCur pCnt nBlk pRBlk srcP cb0 rb0 3 e2))
         (checkSlot cntCur pCnt nBlk pRBlk srcP cb0 rb0 1 e1))
      (checkSlot cntCur pCnt nBlk pRBlk srcP cb0 rb0 0 e0)

private noncomputable def checkRangeLoop (nbytes cntCur pCnt : Nat)
    (nBlk rBlk pRBlk : Nat → Nat) (lo cnt : Nat) : Bool :=
  @Nat.rec (fun _ => Nat → Bool)
    (fun _ => true)
    (fun _ ih i =>
      @Bool.rec (fun _ => Bool)
        false
        (forceN false (Nat.add i 1) ih)
        (checkNodeFast nbytes cntCur pCnt nBlk rBlk pRBlk i))
    cnt lo

private noncomputable def checkRange (d lo cnt : Nat) : Bool :=
  checkRangeLoop (nbytesOf d) (nodeCntOf d) (nodeCntOf (Nat.sub d 1))
    (nodeBlkOf d) (ruleBlkOf d) (ruleBlkOf (Nat.sub d 1)) lo cnt

private inductive RangeOK (d : Nat) : Nat → Nat → Prop where
  | seg (lo cnt : Nat) : checkRange d lo cnt = true → RangeOK d lo (lo + cnt)
  | trans {a b c : Nat} : RangeOK d a b → RangeOK d b c → RangeOK d a c

/-! ## Wall Closure Checker (for Stages 0..12) -/

private noncomputable def checkWallSlot (topL wallCnt : Nat) (id q we : Nat) : Bool :=
  @Bool.rec (fun _ => Bool)
    (forceN false (Nat.mod (Nat.sub we 1) 5) fun expQ =>
     forceN false (getRuleFromBlk (ruleBlkOf topL) id q) fun e =>
      @Bool.rec (fun _ => Bool)
        (forceN false (Nat.sub e 1) fun e1 =>
         forceN false (Nat.div e1 5) fun idOut =>
         forceN false (Nat.mod e1 5) fun qOut =>
           Nat.ble (Nat.add idOut 1) wallCnt && Nat.beq qOut expQ)
        false
        (Nat.beq e 0))
    true
    (Nat.beq we 0)

private noncomputable def checkWallNode (topL nextBaseL wallCnt id : Nat) : Bool :=
  forceN false (entFromBlkF (ruleBlkOf nextBaseL) 0) fun wW =>
  forceN false (Nat.land wW 65535) fun w0 =>
  @Bool.rec (fun _ => Bool) false
    (forceN false (Nat.land (Nat.shiftRight wW 16) 65535) fun w1 =>
     @Bool.rec (fun _ => Bool) false
       (forceN false (Nat.land (Nat.shiftRight wW 32) 65535) fun w2 =>
        @Bool.rec (fun _ => Bool) false
          (forceN false (Nat.land (Nat.shiftRight wW 48) 65535) fun w3 =>
            checkWallSlot topL wallCnt id 5 w3)
          (checkWallSlot topL wallCnt id 3 w2))
       (checkWallSlot topL wallCnt id 1 w1))
    (checkWallSlot topL wallCnt id 0 w0)

private noncomputable def checkWallLoop (topL nextBaseL wallCnt lo cnt : Nat) : Bool :=
  @Nat.rec (fun _ => Nat → Bool)
    (fun _ => true)
    (fun _ ih i =>
      @Bool.rec (fun _ => Bool) false
        (forceN false (Nat.add i 1) ih)
        (checkWallNode topL nextBaseL wallCnt i))
    cnt lo

private noncomputable def checkStageWall (s : Nat) : Bool :=
  let topL := Nat.add (stageBase s) (stageDepth s)
  let nextBaseL := stageBase (Nat.add s 1)
  let wc := stageWallCnt s
  Nat.ble 1 wc && Nat.ble wc (nodeCntOf topL) &&
  checkWallLoop topL nextBaseL wc 0 wc

private noncomputable def checkAllWalls : Bool :=
  checkStageWall 0 && checkStageWall 1 && checkStageWall 2 && checkStageWall 3 &&
  checkStageWall 4 && checkStageWall 5 && checkStageWall 6 && checkStageWall 7 &&
  checkStageWall 8 && checkStageWall 9 && checkStageWall 10 && checkStageWall 11 &&
  checkStageWall 12

/-! ## Unified Stage Bridge & Final Halt Byte-Zipper Evaluators -/

private def isAllZeroBytes : List Nat → Bool
  | [] => true
  | x :: xs => Nat.beq x 0 && isAllZeroBytes xs

private def bytesEqZeroPad : List Nat → List Nat → Bool
  | [], ys => isAllZeroBytes ys
  | xs, [] => isAllZeroBytes xs
  | x :: xs, y :: ys => Nat.beq x y && bytesEqZeroPad xs ys

private def popByte (xs : List Nat) : Nat × List Nat :=
  match xs with
  | [] => (0, [])
  | b :: bs => (b, bs)

private def popNBytes : Nat → List Nat → List Nat × List Nat
  | 0, xs => ([], xs)
  | n + 1, xs =>
    let (b, xs') := popByte xs
    let (bs, rest) := popNBytes n xs'
    (b :: bs, rest)

private noncomputable def simTailBridge (topL tgtLid tgtQ : Nat) (tgtBytes : List Nat)
    (fuel lid : Nat) (side : Bool) (q : Nat)
    (rb : List Nat) (cb : Nat) (lb : List Nat) : Bool :=
  @Nat.rec (fun _ => Nat → Bool → Nat → List Nat → Nat → List Nat → Bool)
    (fun _ _ _ _ _ _ => false)
    (fun _ ih id s qq r c l =>
      let hit :=
        match r, s with
        | [], false =>
          Nat.beq id tgtLid && Nat.beq qq tgtQ && bytesEqZeroPad (c :: l) tgtBytes
        | _, _ => false
      @Bool.rec (fun _ => Bool)
        (forceN false (b8Entry s qq c) fun e =>
         forceN false (Nat.land e 255) fun outB =>
         forceN false (Nat.land (Nat.shiftRight e 8) 7) fun qOut =>
         forceN false (Nat.shiftRight e 11) fun st =>
           match st with
           | 0 =>
             match r with
             | [] =>
               @Bool.rec (fun _ => Bool) false
                 (forceN false (getRuleFromBlk (ruleBlkOf topL) id qOut) fun pe =>
                   @Bool.rec (fun _ => Bool)
                     (forceN false (Nat.sub pe 1) fun pe1 =>
                      forceN false (Nat.div pe1 5) fun nextId =>
                      forceN false (Nat.mod pe1 5) fun nextQ =>
                        ih nextId false nextQ [] outB l)
                     false
                     (Nat.beq pe 0))
                 (Nat.ble (Nat.add id 1) (nodeCntOf topL))
             | pb :: r' => ih id true qOut r' pb (outB :: l)
           | 1 =>
             let (nb, l') := popByte l
             ih id false qOut (outB :: r) nb l'
           | _ => false)
        true
        hit)
    fuel lid side q rb cb lb

private noncomputable def simTailHalt (topL : Nat) (fuel lid : Nat) (side : Bool) (q : Nat)
    (rb : List Nat) (cb : Nat) (lb : List Nat) : Bool :=
  @Nat.rec (fun _ => Nat → Bool → Nat → List Nat → Nat → List Nat → Bool)
    (fun _ _ _ _ _ _ => false)
    (fun _ ih id s qq r c l =>
      forceN false (b8Entry s qq c) fun e =>
      forceN false (Nat.land e 255) fun outB =>
      forceN false (Nat.land (Nat.shiftRight e 8) 7) fun qOut =>
      forceN false (Nat.shiftRight e 11) fun st =>
        match st with
        | 0 =>
          match r with
          | [] =>
            @Bool.rec (fun _ => Bool) false
              (forceN false (getRuleFromBlk (ruleBlkOf topL) id qOut) fun pe =>
                @Bool.rec (fun _ => Bool)
                  (forceN false (Nat.sub pe 1) fun pe1 =>
                   forceN false (Nat.div pe1 5) fun nextId =>
                   forceN false (Nat.mod pe1 5) fun nextQ =>
                     ih nextId false nextQ [] outB l)
                  false
                  (Nat.beq pe 0))
              (Nat.ble (Nat.add id 1) (nodeCntOf topL))
          | pb :: r' => ih id true qOut r' pb (outB :: l)
        | 1 =>
          let (nb, l') := popByte l
          ih id false qOut (outB :: r) nb l'
        | 2 => true
        | _ => false)
    fuel lid side q rb cb lb

private noncomputable def simStagePush
    (isHalt : Bool) (baseL tgtLid tgtQ : Nat) (tgtBytes : List Nat)
    (tailFuel fuel cd lid : Nat) (side : Bool) (q cb : Nat) (lb rest : List Nat) (pushes : List
        Nat) : Bool :=
  @Nat.rec (fun _ => Nat → Nat → Bool → Nat → Nat → List Nat → List Nat → List Nat → Bool)
    (fun _ _ _ _ _ _ _ _ => false)
    (fun _ ih cdd id s qq c l rst ps =>
      match simSliceBytes 160 s qq [] c l with
      | SliceOut.halt _ => isHalt
      | SliceOut.exitWall qOut outB l' =>
        forceN false (Nat.add baseL cdd) fun curL =>
        @Bool.rec (fun _ => Bool) false
          (forceN false (getRuleFromBlk (ruleBlkOf curL) id qOut) fun pe =>
            @Bool.rec (fun _ => Bool)
              (forceN false (Nat.sub pe 1) fun pe1 =>
               forceN false (Nat.div pe1 5) fun nextId =>
               forceN false (Nat.mod pe1 5) fun nextQ =>
                 ih cdd nextId false nextQ outB l' rst ps)
              false
              (Nat.beq pe 0))
          (Nat.ble (Nat.add id 1) (nodeCntOf curL))
      | SliceOut.exitTail qOut outBits =>
        match ps with
        | [] => false
        | nid :: ps' =>
          forceN false (Nat.add cdd 1) fun cdd' =>
          forceN false (Nat.add baseL cdd') fun nxtL =>
          @Bool.rec (fun _ => Bool) false
            (forceN false (entFromBlkF (nodeBlkOf nxtL) nid) fun nw =>
             forceN false (Nat.add (Nat.shiftLeft id 48) outBits) fun expected =>
              @Bool.rec (fun _ => Bool) false
                (match ps' with
                 | [] =>
                   let (tcb, tlb) := popByte rst
                   if isHalt then
                     simTailHalt nxtL tailFuel nid false qOut [] tcb tlb
                   else
                     simTailBridge nxtL tgtLid tgtQ tgtBytes tailFuel nid false qOut [] tcb tlb
                 | _ :: _ =>
                   match popNBytes (nbytesOf (Nat.add nxtL 1)) rst with
                   | (nb :: lNext, rst') => ih cdd' nid false qOut nb lNext rst' ps'
                   | ([], _) => false)
                (Nat.beq nw expected))
            (Nat.ble (Nat.add nid 1) (nodeCntOf nxtL))
      | _ => false)
    fuel cd lid side q cb lb rest pushes

private noncomputable def checkStageBridge (s : Nat) : Bool :=
  let bL := stageBase s
  match popNBytes (nbytesOf (Nat.add bL 1)) (stageInitBytes s) with
  | (cb :: lb, rest) =>
    simStagePush false bL 0 (stageInitQ (Nat.add s 1)) (stageInitBytes (Nat.add s 1))
      (stageBridgeFuel s) (stageBridgeFuel s) 0 (stageInitLid s) false (stageInitQ s) cb lb rest
          (stagePushIds s)
  | ([], _) => false

private noncomputable def checkStageHalt : Bool :=
  let bL := stageBase 13
  match popNBytes (nbytesOf (Nat.add bL 1)) (stageInitBytes 13) with
  | (cb :: lb, rest) =>
    simStagePush true bL 0 0 [] (stageBridgeFuel 13) (stageBridgeFuel 13) 0 (stageInitLid 13) false
      (stageInitQ 13) cb lb rest (stagePushIds 13)
  | ([], _) => false

private noncomputable def checkAllBridges : Bool :=
  checkStageBridge 0 && checkStageBridge 1 && checkStageBridge 2 && checkStageBridge 3 &&
  checkStageBridge 4 && checkStageBridge 5 && checkStageBridge 6 && checkStageBridge 7 &&
  checkStageBridge 8 && checkStageBridge 9 && checkStageBridge 10 && checkStageBridge 11 &&
  checkStageBridge 12

/-! ## Raw TM, B8 Exhaustive Check, Link 1 (t=0..303), and Crystal Base Checkers -/

private def tmStepRaw (q : Nat) (sym : Bool) : Option (Nat × Bool × Bool) :=
  match q, sym with
  | 0, false => some (1, true, true)
  | 0, true  => some (3, true, false)
  | 1, false => some (2, true, false)
  | 1, true  => some (5, false, true)
  | 2, false => some (3, false, true)
  | 2, true  => some (1, false, false)
  | 3, false => some (1, true, false)
  | 3, true  => some (4, false, false)
  | 4, false => some (0, true, false)
  | 4, true  => none
  | 5, false => some (0, false, true)
  | 5, true  => some (5, false, true)
  | _, _     => none

private def byteBits (b : Nat) : List Bool :=
  [Nat.beq (Nat.land b 1) 1,
   Nat.beq (Nat.land (Nat.shiftRight b 1) 1) 1,
   Nat.beq (Nat.land (Nat.shiftRight b 2) 1) 1,
   Nat.beq (Nat.land (Nat.shiftRight b 3) 1) 1,
   Nat.beq (Nat.land (Nat.shiftRight b 4) 1) 1,
   Nat.beq (Nat.land (Nat.shiftRight b 5) 1) 1,
   Nat.beq (Nat.land (Nat.shiftRight b 6) 1) 1,
   Nat.beq (Nat.land (Nat.shiftRight b 7) 1) 1]

private def packBitsLSB : List Bool → Nat
  | [] => 0
  | b :: bs => Nat.add (if b then 1 else 0) (Nat.mul 2 (packBitsLSB bs))

-- Mirror of the 8-bit `simB8Raw` transition helper:
-- `lb` = bits toward LEFT/tail (higher Y index); `rb` = bits toward RIGHT/wall (lower Y index).
-- Internal config: Cfg.headLeft q (bitsToLB (cur :: lb) L) (bitsToLB rb R).
private def simB8Raw (fuel : Nat) (q : Nat) (rb : List Bool) (cur : Bool) (lb : List Bool) : Nat :=
  @Nat.rec (fun _ => Nat → List Bool → Bool → List Bool → Nat)
    (fun _ _ _ _ => 65535)
    (fun _ ih qq r c l =>
      match tmStepRaw qq c with
      | none =>
        Nat.add (packBitsLSB (revBoolK r (c :: l))) (Nat.add (Nat.mul 256 qq) 4096)
      | some (nq, w, false) =>
        match l with
        | [] => Nat.add (packBitsLSB (revBoolK r [w])) (Nat.add (Nat.mul 256 nq) 2048)
        | nl :: l' => ih nq (w :: r) nl l'
      | some (nq, w, true) =>
        match r with
        | [] => Nat.add (packBitsLSB (w :: l)) (Nat.mul 256 nq)
        | nr :: r' => ih nq r' nr (w :: l))
    fuel q rb cur lb

private noncomputable def checkB8Entry (side : Bool) (q b : Nat) : Bool :=
  match side with
  | false =>
    match byteBits b with
    | c :: l => Nat.beq (simB8Raw 45 q [] c l) (b8Entry false q b)
    | [] => false
  | true =>
    match revBoolK (byteBits b) [] with
    | c :: r => Nat.beq (simB8Raw 45 q r c []) (b8Entry true q b)
    | [] => false

private noncomputable def checkB8Range (side : Bool) (q lo cnt : Nat) : Bool :=
  @Nat.rec (fun _ => Nat → Bool)
    (fun _ => true)
    (fun _ ih b =>
      @Bool.rec (fun _ => Bool) false
        (forceN false (Nat.add b 1) ih)
        (checkB8Entry side q b))
    cnt lo

private noncomputable def checkB8All : Bool :=
  checkB8Range false 0 0 256 && checkB8Range false 1 0 256 &&
  checkB8Range false 2 0 256 && checkB8Range false 3 0 256 &&
  checkB8Range false 4 0 256 && checkB8Range false 5 0 256 &&
  checkB8Range true 0 0 256 && checkB8Range true 1 0 256 &&
  checkB8Range true 2 0 256 && checkB8Range true 3 0 256 &&
  checkB8Range true 4 0 256 && checkB8Range true 5 0 256

private def consTrim (b : Bool) (xs : List Bool) : List Bool :=
  match b, xs with
  | false, [] => []
  | _, _ => b :: xs

private def boolEq : Bool → Bool → Bool
  | true, true => true
  | false, false => true
  | _, _ => false

private def boolListBeq : List Bool → List Bool → Bool
  | [], [] => true
  | x :: xs, y :: ys => boolEq x y && boolListBeq xs ys
  | _, _ => false

private def simRawZip1 (q : Nat) (lb rb : List Bool) : Option (Nat × List Bool × List Bool) :=
  let (sym, rb') := match rb with | [] => (false, []) | c :: r => (c, r)
  match tmStepRaw q sym with
  | none => none
  | some (nq, w, true) => some (nq, consTrim w lb, rb')
  | some (nq, w, false) =>
    let rbW := consTrim w rb'
    match lb with
    | [] => some (nq, [], consTrim false rbW)
    | nl :: lb' => some (nq, lb', nl :: rbW)

private def simRawZip (n : Nat) (st : Option (Nat × List Bool × List Bool)) :
    Option (Nat × List Bool × List Bool) :=
  @Nat.rec (fun _ => Option (Nat × List Bool × List Bool) → Option (Nat × List Bool × List Bool))
    (fun s => s)
    (fun _ ih s =>
      match s with
      | none => none
      | some (q, lb, rb) =>
        forceN none q fun qv => ih (simRawZip1 qv lb rb))
    n st

private def simRawZipChunks (chunks chunkSize : Nat) (st : Option (Nat × List Bool × List Bool)) :
    Option (Nat × List Bool × List Bool) :=
  @Nat.rec (fun _ => Option (Nat × List Bool × List Bool) → Option (Nat × List Bool × List Bool))
    (fun s => s)
    (fun _ ih s => ih (simRawZip chunkSize s))
    chunks st

private def wallStepSpec : Nat → Nat × Nat
  | 0 => (5, 2)
  | 1 => (3, 4)
  | 2 => (5, 1)
  | 3 => (5, 2)
  | 4 => (3, 4)
  | 5 => (5, 1)
  | 6 => (0, 3)
  | 7 => (5, 1)
  | 8 => (0, 3)
  | 9 => (5, 0)
  | 10 => (1, 2)
  | _ => (1, 0)

-- Right-wall crystal simulator for 5-bit base layer (0, 0)!
-- Internal config: Cfg.headLeft (fin6OfNat q) (bitsToLB lb L) (bitsToLB rb (crysTape ph c))
-- exits when lb == [] (head exits LEFT to tail in state q with rb' = new 5-bit prefix!)
private def simCrysWall (fuel : Nat) (ph q : Nat) (lb rb : List Bool) :
    Option (Nat × Nat × List Bool) :=
  @Nat.rec (fun _ => Nat → Nat → List Bool → List Bool → Option (Nat × Nat × List Bool))
    (fun _ _ _ _ => none)
    (fun _ ih phv qv l r =>
      match l with
      | [] => some (phv, qv, r)
      | sym :: l' =>
        match tmStepRaw qv sym with
        | none => none
        | some (nq, w, false) => ih phv nq l' (w :: r)
        | some (nq, w, true) =>
          let lw := w :: l'
          match r with
          | nr :: r' => ih phv nq (nr :: lw) r'
          | [] =>
            let (expIn, qOut) := wallStepSpec phv
            if Nat.beq nq expIn then
              forceN none (Nat.mod (Nat.add phv 1) 12) fun ph' =>
                ih ph' qOut lw []
            else none)
    fuel ph q lb rb

private noncomputable def checkCrysBaseSlot (id q : Nat) : Bool :=
  forceN false (getRuleFromBlk (ruleBlkOf 0) id q) fun e =>
  @Bool.rec (fun _ => Bool)
    (forceN false (Nat.sub e 1) fun e1 =>
     forceN false (Nat.div e1 5) fun idOut =>
     forceN false (Nat.mod e1 5) fun qOut =>
       @Bool.rec (fun _ => Bool) false
         (match crysBaseBits id with
          | [] => false
          | c :: r =>
            match simCrysWall 120 (crysBasePh id) q [c] r with
            | some (ph', q', rb') =>
              Nat.beq ph' (crysBasePh idOut) && Nat.beq q' qOut &&
              boolListBeq rb' (crysBaseBits idOut)
            | none => false)
         (Nat.ble (Nat.add idOut 1) (nodeCntOf 0)))
    true
    (Nat.beq e 0)

private noncomputable def checkCrysBaseNode (id : Nat) : Bool :=
  checkCrysBaseSlot id 0 && checkCrysBaseSlot id 1 &&
  checkCrysBaseSlot id 3 && checkCrysBaseSlot id 5

private noncomputable def checkCrysBaseLoop (lo cnt : Nat) : Bool :=
  @Nat.rec (fun _ => Nat → Bool)
    (fun _ => true)
    (fun _ ih i =>
      @Bool.rec (fun _ => Bool) false
        (forceN false (Nat.add i 1) ih)
        (checkCrysBaseNode i))
    cnt lo

private noncomputable def checkCrysBase : Bool :=
  checkCrysBaseLoop 0 (nodeCntOf 0)

private def lb303 : List Bool :=
  [false, false, false, false, false, true, false, false, true, false, false, false, false, false,
      false, true, false, false, true, false, false, false, true, false, false, true]

private def rb303 : List Bool :=
  [true, false, false, true, true, true, true, true, false, false, true]

private def checkLink1 : Bool :=
  match simRawZip 3 (simRawZipChunks 3 100 (some (0, [], []))) with
  | some (q, lb, rb) => Nat.beq q 5 && boolListBeq lb lb303 && boolListBeq rb rb303
  | none => false

private def checkLink1b : Bool :=
  match simCrysWall 120 1 2 [false, false, false, false, false] [] with
  | some (ph', q', rb') =>
    Nat.beq ph' (crysBasePh (stageInitLid 0)) && Nat.beq q' (stageInitQ 0) &&
