theorem full_halt_of_steps (tm : Machine (Fin 2) (Fin 6)) [HasCertRules tm] (ov1 ov2 : Nat)
    (s0 : run_tree tm ov1 ov2 st_0 fc_0 = .inl fc_1)
    (s1 : run_tree tm ov1 ov2 st_1 fc_1 = .inl fc_2)
    (s2 : run_tree tm ov1 ov2 st_2 fc_2 = .inl fc_3)
    (s3 : run_tree tm ov1 ov2 st_3 fc_3 = .inl fc_4)
    (s4 : run_tree tm ov1 ov2 st_4 fc_4 = .inl fc_5)
    (s5 : run_tree tm ov1 ov2 st_5 fc_5 = .inl fc_6)
    (s6 : run_tree tm ov1 ov2 st_6 fc_6 = .inl fc_7)
    (s7 : run_tree tm ov1 ov2 st_7 fc_7 = .inl fc_8)
    (s8 : run_tree tm ov1 ov2 st_8 fc_8 = .inr true) :
    HaltsFrom tm (init []) := by
  have hinit : (flush_fc fc_0).denote = init [] := by
    simp [fc_0, flush_fc, flush_d_runs, Runs.push, SymWord.isEmpty, Mode.payload,
      Mode.mq, Mode.md, RMConfig.denote, Runs.denote, init_nil_eq_headRight, A]
  rw [← hinit]
  have hwf0 : fc_0.WF := trivial
  exact chain_tree tm ov1 ov2 hwf0 s0 fun hwf1 =>
    chain_tree tm ov1 ov2 hwf1 s1 fun hwf2 =>
    chain_tree tm ov1 ov2 hwf2 s2 fun hwf3 =>
    chain_tree tm ov1 ov2 hwf3 s3 fun hwf4 =>
    chain_tree tm ov1 ov2 hwf4 s4 fun hwf5 =>
    chain_tree tm ov1 ov2 hwf5 s5 fun hwf6 =>
    chain_tree tm ov1 ov2 hwf6 s6 fun hwf7 =>
    chain_tree tm ov1 ov2 hwf7 s7 fun hwf8 =>
    done_tree tm ov1 ov2 hwf8 s8

